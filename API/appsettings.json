  // Stale-pending Leave Application reminders/escalation notices - see
  // API/BackgroundServices/LeaveEscalationService.cs. ReminderAfterHours: how
  // long a leave can sit Pending at the same approval level before a single
  // reminder notification is sent to the current approver (and their active
  // delegate, if any). EscalateAfterHours: how much longer beyond that
  // before the NEXT level approver is also notified as an FYI heads-up -
  // this is a read-only notification widening, NOT an automatic
  // reassignment of CurrentLevel/approval ownership (see the comment on
  // LeaveEscalationService for why true auto-escalation was intentionally
  // not implemented).
  "LeaveEscalation": {
    "ReminderAfterHours": 24,
    "EscalateAfterHours": 72
  },
  // Phase 15 - Loan & Advance reminders, see
  // API/BackgroundServices/LoanAdvanceReminderService.cs.
  // ApprovalReminderAfterHours: how long a loan/advance can sit
  // PendingApproval before the current approver is reminded (at most once
  // per calendar day). DueSoonDays: how many days ahead of an EMI/
  // installment's DueDate the employee gets an "upcoming due" reminder;
  // already-overdue Pending installments are always reminded (also capped
  // at once per calendar day).
