<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Salary Processing revision (attendance-based proration) verification
    tests. Mirrors Tests/EsslIntegration.Tests's structure/package set
    exactly (same reasoning applies here - see that project's own comment).

      Integration/SalaryCalculationServiceTests.cs -
          Application.Services.PayrollService.SalaryCalculationService
          exercised against a REAL ApplicationDbContext backed by EF Core's
          InMemory provider, with a REAL
          Application.Services.Attendances.AttendancePolicyService
          (constructor only takes ApplicationDbContext - nothing to mock).
          Covers the 4 test cases given in the original requirement plus
          two regression scenarios (duplicate Attendance rows must not
          inflate Present Days; Unpaid Leave must reduce Payable Days
          rather than being silently ignored).

    NOTE: no `dotnet` CLI was available in the sandbox this was authored
    in, so - like EsslIntegration.Tests/LoanAdvance.Tests - this project
    has been reviewed carefully against the real entity/service shapes but
    could not actually be restored/built/run here. Run `dotnet test` from
    this folder as the first verification step after pulling these
    changes.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="FluentAssertions" Version="6.12.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Domain\Domain.csproj" />
    <ProjectReference Include="..\..\Application\Application.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

</Project>
