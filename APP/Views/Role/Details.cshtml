@model APP.Models.DTOs.RoleDetailDto

@{
    ViewData["Title"] = "Role Details";
}

<div class="row">
    <div class="col-lg-8">

        <div class="panel panel-flat">

            <div class="panel-heading">
                <h5 class="panel-title"><i class="icon-shield2 position-left"></i> @Model.Name - Permissions</h5>
                <div class="heading-elements">
                    <span class="label @(Model.IsActive ? "bg-success" : "bg-grey")">@(Model.IsActive ? "Active" : "Inactive")</span>
                    <a asp-action="Index" class="btn btn-default"><i class="icon-arrow-left13"></i> Back</a>
                </div>
            </div>

            <form asp-action="AssignPermissions" asp-controller="Role" method="post">
                <input type="hidden" name="roleId" value="@Model.Id" />

                <div class="panel-body">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p class="text-muted">@Model.Description</p>
                    }

                    @if (Model.PermissionGroups != null && Model.PermissionGroups.Any())
                    {
                        foreach (var group in Model.PermissionGroups)
                        {
                            <h6 class="text-semibold m-t-15"><i class="icon-folder2 position-left"></i> @group.Module</h6>
                            <div class="row">
                                @foreach (var perm in group.Permissions)
                                {
                                    <div class="col-md-4">
                                        <label class="checkbox-inline" style="display:block; margin-bottom:6px;">
                                            <input type="checkbox" name="permissionIds" value="@perm.PermissionId" @(perm.IsAssigned ? "checked" : "") />
                                            @(perm.FeatureName ?? perm.FeatureId) - @perm.Action
                                        </label>
                                    </div>
                                }
                            </div>
                            <hr />
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center" style="padding:20px;">No permissions defined yet.</p>
                    }
                </div>

                <div class="panel-footer text-right">
                    <button type="submit" class="btn bg-primary"><i class="icon-floppy-disk"></i> Save Permissions</button>
                </div>
            </form>
        </div>

    </div>

    <div class="col-lg-4">

        <div class="panel panel-flat">
            <div class="panel-heading">
                <h6 class="panel-title"><i class="icon-users position-left"></i> Assigned Users</h6>
                <div class="heading-elements">
                    <span class="badge bg-info">@Model.Users.Count</span>
                </div>
            </div>
            <ul class="ent-feed-list" style="list-style:none; margin:0; padding:4px 0;">
                @if (Model.Users != null && Model.Users.Any())
                {
                    foreach (var u in Model.Users)
                    {
                        <li style="padding:10px 18px; border-bottom:1px solid #f4f6f9;">
                            <div class="text-semibold">@u.Username</div>
                            <span class="text-muted text-size-small">
                                @(u.EmployeeName ?? "-")
                                @if (!u.IsActive)
                                {
                                    <span class="label bg-grey">Inactive</span>
                                }
                            </span>
                        </li>
                    }
                }
                else
                {
                    <li class="text-muted text-center" style="padding:15px 0;">No users assigned to this role yet.</li>
                }
            </ul>
        </div>

    </div>
</div>

@section Scripts {
    @if (TempData["Success"] != null)
    {
        <script>$(function(){ swal({ title:"Success", text:"@TempData["Success"]", type:"success" }); });</script>
    }
}
