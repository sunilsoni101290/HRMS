@model APP.Models.DTOs.RoleDto

@{
    ViewData["Title"] = "Role";
    bool isEdit = !string.IsNullOrEmpty(Model?.Id);
}

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-controller="Role" asp-route-id="@Model?.Id" method="post">

    <input asp-for="Id" type="hidden" />
    <input asp-for="TenantId" type="hidden" />
    <input asp-for="CreatedBy" type="hidden" />

    <div class="panel panel-flat">

        <div class="panel-heading">
            <h5 class="panel-title">
                <i class="icon-shield2 position-left"></i>
                @(isEdit ? "Edit Role" : "Add Role")
            </h5>
            <div class="heading-elements">
                <a asp-action="Index" class="btn btn-default"><i class="icon-arrow-left13"></i> Back</a>
            </div>
        </div>

        <div class="panel-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Name"></label> <span class="text-danger">*</span>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Payroll Manager" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="Code"></label>
                        @if (isEdit)
                        {
                            <input asp-for="Code" class="form-control" readonly />
                            <small class="text-muted">Code can't be changed after creation.</small>
                        }
                        else
                        {
                            <input asp-for="Code" class="form-control" placeholder="Auto-generated if left blank" />
                        }
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group" style="margin-top:28px;">
                        <label class="checkbox-inline">
                            <input asp-for="IsActive" type="checkbox" /> Active
                        </label>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="What is this role for?"></textarea>
            </div>

            @if (isEdit)
            {
                <div class="alert alert-info">
                    <i class="icon-info22 position-left"></i>
                    Manage this role's permissions and see who's assigned to it from the
                    <a asp-action="Details" asp-route-id="@Model.Id">role details page</a>.
                </div>
            }
        </div>

        <div class="panel-footer text-right">
            <button type="submit" class="btn bg-primary"><i class="icon-floppy-disk"></i> @(isEdit ? "Update" : "Save")</button>
        </div>
    </div>
</form>

@section Scripts {
    @if (TempData["GlobalError"] != null)
    {
        <script>$(function(){ swal({ title:"Error", text:"@TempData["GlobalError"]", type:"error" }); });</script>
    }
    <partial name="_ValidationScriptsPartial" />
}
