@model IEnumerable<WeekOffDto>

@{
    ViewData["Title"] = "Week Off Management";
}

<div class="panel panel-flat">

    <!-- Header -->

    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-calendar52 position-left"></i>

            Week Off Management

        </h5>

        <div class="heading-elements">

            <a asp-action="Create"
               class="btn bg-primary">

                <i class="icon-plus22 position-left"></i>

                Add Week Off

            </a>

        </div>

    </div>

    <!-- Dashboard -->

    <div class="panel-body">

        <div class="row">

            <!-- Total Week Off -->

            <div class="col-md-4">

                <div class="panel bg-primary-400">

                    <div class="panel-body">

                        <div class="media">

                            <div class="media-left">

                                <i class="icon-calendar3 icon-3x"></i>

                            </div>

                            <div class="media-body text-right">

                                <h3 class="no-margin">

                                    @Model.Count()

                                </h3>

                                <span>

                                    Total Week Offs

                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Weekend Days -->

            <div class="col-md-4">

                <div class="panel bg-success-400">

                    <div class="panel-body">

                        <div class="media">

                            <div class="media-left">

                                <i class="icon-calendar22 icon-3x"></i>

                            </div>

                            <div class="media-body text-right">

                                <h3 class="no-margin">

                                    @Model.Count()

                                </h3>

                                <span>

                                    Configured Days

                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Active -->

            <div class="col-md-4">

                <div class="panel bg-info-400">

                    <div class="panel-body">

                        <div class="media">

                            <div class="media-left">

                                <i class="icon-checkmark-circle icon-3x"></i>

                            </div>

                            <div class="media-body text-right">

                                <h3 class="no-margin">

                                    Active

                                </h3>

                                <span>

                                    Current Status

                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <hr />

        <!-- Search Panel -->

        <div class="row">

            <div class="col-md-5">

                <div class="form-group">

                    <input type="text"
                           id="searchInput"
                           class="form-control"
                           placeholder="Search Week Off..." />

                </div>

            </div>

            <div class="col-md-5">

                <div class="form-group">

                    <select id="DayFilter"
                            class="form-control select-search">

                        <option value="">

                            All Days

                        </option>

                        @foreach (var day in Enum.GetNames(typeof(DayOfWeek)))
                        {
                            <option value="@day">

                                @day

                            </option>
                        }

                    </select>

                </div>

            </div>

            <div class="col-md-2">

                <button class="btn bg-primary btn-block">

                    <i class="icon-search4 position-left"></i>

                    Search

                </button>

            </div>

        </div>

    </div>

    <!-- Grid -->

    <table class="table table-hover table-striped datatable-basic">

        <thead>

            <tr>

                <th width="60">

                    #

                </th>

                <th>

                    Week Off Day

                </th>

                <th width="140">

                    Status

                </th>

                <th width="180"
                    class="text-center">

                    Action

                </th>

            </tr>

        </thead>

        <tbody id="weekOffTable">
            @{
                int sr = 1;
            }

            @foreach (var item in Model)
            {
                <tr>

                    <!-- Sr No -->

                    <td>

                        @sr

                    </td>

                    <!-- Week Off Day -->

                    <td>

                        <div class="text-semibold">

                            <i class="icon-calendar22 text-primary position-left"></i>

                            @item.Day

                        </div>

                        <small class="text-muted">

                            Weekly Holiday

                        </small>

                    </td>

                    <!-- Status -->

                    <td>

                        <span class="label bg-success">

                            Active

                        </span>

                    </td>

                    <!-- Action -->

                    <td class="text-center">

                        <div class="btn-group">

                            <!-- Details -->

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-default btn-icon"
                               data-popup="tooltip"
                               title="View Details">

                                <i class="icon-eye"></i>

                            </a>

                            <!-- Edit -->

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn bg-primary btn-icon"
                               data-popup="tooltip"
                               title="Edit">

                                <i class="icon-pencil7"></i>

                            </a>

                            <!-- Delete -->

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-danger btn-icon"
                               data-popup="tooltip"
                               title="Delete"
                               onclick="return confirm('Are you sure you want to delete this Week Off?');">

                                <i class="icon-trash"></i>

                            </a>

                        </div>

                    </td>

                </tr>

                sr++;
            }

        </tbody>

    </table>

</div>
@section Scripts {
    <script>

        // Search Table

        document.getElementById("searchInput")
            .addEventListener("keyup", function () {

                let value = this.value.toLowerCase();

                let rows = document.querySelectorAll("#weekOffTable tr");

                rows.forEach(function (row) {

                    let text = row.innerText.toLowerCase();

                    row.style.display =
                        text.includes(value) ? "" : "none";

                });

            });

    </script>

    <script>

        $(document).ready(function () {

            //=========================================
            // Bootstrap Tooltip
            //=========================================

            $('[data-popup="tooltip"]').tooltip();

            //=========================================
            // Chosen Dropdown
            //=========================================

            if ($(".select-search").length) {

                $(".select-search").chosen({

                    width: "100%",
                    search_contains: true,
                    allow_single_deselect: true

                });

            }

            //=========================================
            // Search
            //=========================================

            $("#searchInput").keyup(function () {

                filterTable();

            });

            //=========================================
            // Day Filter
            //=========================================

            $("#DayFilter").change(function () {

                filterTable();

            });

            //=========================================
            // Filter Function
            //=========================================

            function filterTable() {

                var keyword =
                    $("#searchInput").val().toLowerCase();

                var day =
                    $("#DayFilter").val().toLowerCase();

                $("#weekOffTable tr").each(function () {

                    var row = $(this);

                    var weekDay =
                        row.find("td:eq(1)").text().toLowerCase();

                    var searchMatch =
                        keyword == "" ||
                        weekDay.indexOf(keyword) > -1;

                    var dayMatch =
                        day == "" ||
                        weekDay.indexOf(day) > -1;

                    row.toggle(searchMatch && dayMatch);

                });

            }

            //=========================================
            // DataTable
            //=========================================

            if ($.fn.DataTable) {

                $(".datatable-basic").DataTable({

                    autoWidth: false,

                    ordering: true,

                    paging: true,

                    searching: false,

                    info: true,

                    pageLength: 10,

                    lengthMenu: [

                        [10, 25, 50, 100],

                        [10, 25, 50, 100]

                    ],

                    language: {

                        search: "_INPUT_",

                        searchPlaceholder: "Search..."

                    }

                });

            }

        });

    </script>

    <style>

        /*=========================================
                    Panel
                =========================================*/

        .panel-heading {
            padding: 18px 20px;
        }

        .panel-title {
            font-weight: 600;
        }

        .panel-body {
            padding: 20px;
        }

        /*=========================================
                    Dashboard Cards
                =========================================*/

        .panel.bg-primary-400,
        .panel.bg-success-400,
        .panel.bg-info-400 {
            margin-bottom: 20px;
            border-radius: 3px;
        }

            .panel.bg-primary-400 h3,
            .panel.bg-success-400 h3,
            .panel.bg-info-400 h3 {
                color: #fff;
                font-weight: 600;
            }

        /*=========================================
                    Table
                =========================================*/

        .table > thead > tr > th {
            background: #fafafa;
            font-size: 13px;
            font-weight: 600;
            vertical-align: middle;
        }

        .table > tbody > tr > td {
            font-size: 13px;
            vertical-align: middle;
        }

        .table-hover tbody tr:hover {
            background: #f8f8f8;
        }

        .text-semibold {
            font-weight: 600;
        }

        /*=========================================
                    Badge
                =========================================*/

        .label {
            font-size: 11px;
            padding: 5px 10px;
        }

        /*=========================================
                    Buttons
                =========================================*/

        .btn-group .btn {
            margin-right: 2px;
        }

        .btn-icon {
            width: 34px;
            height: 34px;
            padding: 7px;
        }

        /*=========================================
                    Dashboard
                =========================================*/

        .media {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .media-left i {
            opacity: .9;
        }

        /*=========================================
                    Chosen
                =========================================*/

        .chosen-container {
            width: 100% !important;
        }

        .chosen-container-single .chosen-single {
            height: 36px !important;
            line-height: 34px !important;
        }

        /*=========================================
                    DataTable
                =========================================*/

        .datatable-basic tbody tr:hover {
            background: #f5f5f5;
        }

        /*=========================================
                    Text
                =========================================*/

        .text-muted {
            color: #999;
        }

        /*=========================================
                    Responsive
                =========================================*/

        @@media (max-width:768px) {

            .heading-elements {
                margin-top: 15px;
                float: none;
            }

            .btn-block {
                margin-top: 10px;
            }
        }

    </style>

}