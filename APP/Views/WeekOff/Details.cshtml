@model WeekOffDto

@{
    ViewData["Title"] = "Week Off Details";
    var isNth = Model != null && Model.PatternType == Domain.Enums.EnumExtensions.WeekOffPatternType.NthWeekdayOfMonth;
    var occurrences = (Model?.Occurrences ?? new List<int>()).OrderBy(o => o).ToList();
    var ordinalMap = new Dictionary<int, string> { { 1, "1st" }, { 2, "2nd" }, { 3, "3rd" }, { 4, "4th" }, { 5, "5th" } };
    var occurrenceText = occurrences.Count > 0
        ? string.Join(" & ", occurrences.Select(o => ordinalMap.ContainsKey(o) ? ordinalMap[o] : o + "th"))
        : "-";
}

<div class="ent-page">
    <div class="ent-panel">

        <div class="d-flex align-items-center gap-2 mb-2 wko-header-row">
            <span class="ent-icon-badge" style="background:#eaf0fe;color:#2b6fd9;"><i class="bi bi-calendar-week"></i></span>
            <div>
                <h5 class="mb-0" style="font-weight:700;color:#1b2a4a;">Week Off Details</h5>
            </div>
            <div style="margin-left:auto;">
                <a asp-action="Index" class="btn btn-default"><i class="bi bi-arrow-left"></i> Back</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
            </div>
        </div>

        <!-- Summary -->
        <div class="row wko-tiles">
            <div class="col-md-4 col-sm-4">
                <div class="wko-tile" style="background:#2b6fd9;">
                    <i class="bi bi-calendar3"></i>
                    <div>
                        <h3>@Model.Day</h3>
                        <span>Week Off Day</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-4">
                <div class="wko-tile" style="background:@(isNth ? "#7a5cf0" : "#2e9e6c");">
                    <i class="bi @(isNth ? "bi-calendar2-check" : "bi-arrow-repeat")"></i>
                    <div>
                        <h3>@(isNth ? "Nth Occurrence" : "Every Week")</h3>
                        <span>Pattern</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-4">
                <div class="wko-tile" style="background:#1e8a54;">
                    <i class="bi bi-check-circle"></i>
                    <div>
                        <h3>Active</h3>
                        <span>Status</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Week Off Information -->
        <div class="wko-section">
            <div class="wko-section-title"><i class="bi bi-info-circle"></i> Week Off Information</div>

            <table class="table table-bordered">
                <tr>
                    <th width="220">Week Off Day</th>
                    <td>@Model.Day</td>
                </tr>
                <tr>
                    <th>Pattern</th>
                    <td>
                        @if (isNth)
                        {
                            <span class="wko-badge wko-badge-purple"><i class="bi bi-calendar2-check"></i> Nth Occurrence of Month</span>
                        }
                        else
                        {
                            <span class="wko-badge wko-badge-green"><i class="bi bi-arrow-repeat"></i> Every Week</span>
                        }
                    </td>
                </tr>
                @if (isNth)
                {
                    <tr>
                        <th>Occurrence(s)</th>
                        <td>@occurrenceText @Model.Day of every month</td>
                    </tr>
                }
                <tr>
                    <th>Status</th>
                    <td><span class="wko-badge wko-badge-green"><i class="bi bi-check-circle"></i> Active</span></td>
                </tr>
            </table>
        </div>

        <!-- Audit Information -->
        <div class="wko-section">
            <div class="wko-section-title"><i class="bi bi-clock-history"></i> Audit Information</div>
            <table class="table table-bordered">
                <tr>
                    <th width="220">Created By</th>
                    <td>@Model.CreatedBy</td>
                </tr>
                <tr>
                    <th>Modified By</th>
                    <td>@(Model.ModifiedBy ?? "-")</td>
                </tr>
                <tr>
                    <th>Modified On</th>
                    <td>@(Model.ModifiedOn.HasValue ? Model.ModifiedOn.Value.ToString("dd MMM yyyy, hh:mm tt") : "-")</td>
                </tr>
            </table>
        </div>

    </div>
</div>

<style>
    .ent-page { background:#f4f6fb; padding:18px; border-radius:10px; }
    .ent-panel { background:#fff; border:1px solid #e7ebf3; border-radius:10px; padding:16px 18px; }
    .ent-icon-badge { width:34px; height:34px; border-radius:8px; display:inline-flex; align-items:center; justify-content:center; font-size:16px; flex:none; }

    .d-flex { display: flex !important; }
    .align-items-center { align-items: center !important; }
    .gap-2 { gap: .5rem !important; }
    .mb-0 { margin-bottom: 0 !important; }
    .mb-2 { margin-bottom: .5rem !important; }

    .wko-header-row { flex-wrap: wrap; }

    .wko-tiles { margin-top: 4px; }

    .wko-tile {
        display: flex;
        align-items: center;
        gap: 14px;
        border-radius: 8px;
        padding: 16px 18px;
        margin-bottom: 15px;
        color: #fff;
    }

        .wko-tile i {
            font-size: 26px;
            opacity: .9;
        }

        .wko-tile h3 {
            margin: 0;
            font-weight: 700;
            color: #fff;
        }

        .wko-tile span {
            font-size: 12.5px;
            opacity: .9;
        }

    .wko-section {
        border: 1px solid #e7ebf3;
        border-radius: 8px;
        padding: 16px 18px;
        margin-bottom: 16px;
    }

    .wko-section-title {
        font-weight: 700;
        font-size: 13.5px;
        color: #1b2a4a;
        margin-bottom: 14px;
    }

        .wko-section-title i {
            color: #2b6fd9;
            margin-right: 6px;
        }

    .table > tbody > tr > th {
        width: 220px;
        background: #fafafa;
        font-weight: 600;
    }

    .table > tbody > tr > td {
        vertical-align: middle;
    }

    .wko-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 11.5px;
        font-weight: 600;
        padding: 5px 10px;
        border-radius: 20px;
    }

    .wko-badge-green {
        background: #e8f7ef;
        color: #1e8a54;
    }

    .wko-badge-purple {
        background: #f0ecff;
        color: #6a45e0;
    }

    @@media (max-width:768px) {
        .wko-header-row > div:last-child {
            margin-top: 12px;
            margin-left: 0 !important;
        }
    }
</style>
