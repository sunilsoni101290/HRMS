@model WeekOffDto

@{
    ViewData["Title"] = "Week Off Details";
}

<div class="panel panel-flat">

    <!-- Header -->

    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-calendar52 position-left"></i>

            Week Off Details

        </h5>

        <div class="heading-elements">

            <a asp-action="Index"
               class="btn btn-default">

                <i class="icon-arrow-left13 position-left"></i>

                Back

            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn bg-primary">

                <i class="icon-pencil7 position-left"></i>

                Edit

            </a>

        </div>

    </div>

    <div class="panel-body">

        <!-- Summary -->

        <div class="row">

            <div class="col-md-4">

                <div class="panel bg-primary-400">

                    <div class="panel-body text-center">

                        <i class="icon-calendar22 icon-3x"></i>

                        <h3 class="no-margin mt-10">

                            @Model.Day

                        </h3>

                        <span>

                            Week Off Day

                        </span>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="panel bg-success-400">

                    <div class="panel-body text-center">

                        <i class="icon-checkmark-circle icon-3x"></i>

                        <h3 class="no-margin mt-10">

                            Active

                        </h3>

                        <span>

                            Status

                        </span>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="panel bg-info-400">

                    <div class="panel-body text-center">

                        <i class="icon-office icon-3x"></i>

                        <h3 class="no-margin mt-10">

                            Weekly

                        </h3>

                        <span>

                            Schedule

                        </span>

                    </div>

                </div>

            </div>

        </div>

        <!-- Week Off Information -->

        <div class="panel panel-bordered">

            <div class="panel-heading">

                <h6 class="panel-title">

                    <i class="icon-info22 position-left"></i>

                    Week Off Information

                </h6>

            </div>

            <table class="table table-bordered">

                <tr>

                    <th width="220">

                        Week Off Day

                    </th>

                    <td>

                        @Model.Day

                    </td>

                </tr>

                <tr>

                    <th>

                        Status

                    </th>

                    <td>

                        <span class="label bg-success">

                            Active

                        </span>

                    </td>

                </tr>

            </table>

        </div>

        <!-- Audit Information -->

        <div class="panel panel-bordered">

            <div class="panel-heading">

                <h6 class="panel-title">

                    <i class="icon-history position-left"></i>

                    Audit Information

                </h6>

            </div>

        </div>

    </div>

</div>

<style>

    .panel-bordered {
        border: 1px solid #ddd;
        margin-bottom: 20px;
    }

        .panel-bordered .panel-heading {
            background: #fafafa;
            border-bottom: 1px solid #ddd;
        }

    .table > tbody > tr > th {
        width: 220px;
        background: #fafafa;
        font-weight: 600;
    }

    .table > tbody > tr > td {
        vertical-align: middle;
    }

    .label {
        font-size: 11px;
        padding: 5px 10px;
    }

    .panel.bg-primary-400,
    .panel.bg-success-400,
    .panel.bg-info-400 {
        margin-bottom: 20px;
    }

        .panel.bg-primary-400 h3,
        .panel.bg-success-400 h3,
        .panel.bg-info-400 h3 {
            color: #fff;
            font-weight: 600;
        }

    .text-muted {
        color: #999;
    }

    .mt-10 {
        margin-top: 10px;
    }

</style>