@model APP.Models.DTOs.DailyWorkLogDto
@{
    ViewData["Title"] = "Daily Work Entry";
    var workDate = (DateTime)ViewBag.WorkDate;
    bool isReadOnly = Model.Status == 1 || Model.Status == 2; // Pending / Approved
}

<div class="panel panel-flat">
    <div class="panel-heading">
        <h5 class="panel-title"><i class="icon-calendar3 position-left"></i> My Daily Work Entry</h5>
        <div class="heading-elements">
            <a asp-controller="EmployeeWorkAssignment" asp-action="Index" class="btn btn-link btn-sm"><i class="icon-briefcase position-left"></i> My Assigned Jobs</a>
            <a asp-action="MyEntries" class="btn btn-link btn-sm"><i class="icon-list position-left"></i> My Work Entries</a>
        </div>
    </div>

    <div class="panel-body">

        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="workDate">Date</label>
                    <input type="date" id="workDate" class="form-control" value="@workDate.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" @(isReadOnly ? "disabled" : "") />
                </div>
            </div>
            <div class="col-md-3">
                <label>Employee</label>
                <p class="form-control-static"><strong>@Model.EmployeeName</strong> (@Model.EmployeeCode)</p>
            </div>
            <div class="col-md-3">
                <label>Department</label>
                <p class="form-control-static">@Model.DepartmentName</p>
            </div>
            <div class="col-md-3">
                <label>Reporting Manager</label>
                <p class="form-control-static">@Model.ReportingManagerName</p>
            </div>
        </div>

        @if (Model.Status == 3 && !string.IsNullOrEmpty(Model.RejectionReason))
        {
            <div class="alert alert-danger">
                <strong>Rejected:</strong> @Model.RejectionReason - please correct and resubmit.
            </div>
        }

        @if (isReadOnly)
        {
            <div class="alert alert-info">
                This day's entry is <strong>@Model.StatusName</strong> and is read-only.
                @if (Model.Status == 1)
                {
                    <text>Submitted @Model.SubmittedAt?.ToString("dd-MMM-yyyy hh:mm tt").</text>
                }
                else if (Model.Status == 2)
                {
                    <text>Approved by @Model.ApprovedByName on @Model.ApprovedAt?.ToString("dd-MMM-yyyy hh:mm tt").</text>
                }
            </div>
        }
        else
        {
            <div class="panel panel-bordered">
                <div class="panel-heading"><h6 class="panel-title">Add Work Item</h6></div>
                <div class="panel-body">
                    <form id="lineForm" novalidate>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="lineAssignedWork">Job / Assigned Work <span class="text-danger">*</span></label>
                                    <select id="lineAssignedWork" class="form-control select-search">
                                        <option value="__idle__">-- Idle / Downtime (no job) --</option>
                                        <option value="__adhoc__">-- Unassigned / Ad-hoc Work (needs a reason) --</option>
                                    </select>
                                    <span class="help-block text-muted">
                                        Only jobs your manager has assigned to you are listed here. Not assigned to something you're working on? Use "Unassigned / Ad-hoc Work" and explain why.
                                    </span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Client</label>
                                    <p class="form-control-static" id="lineClientName">-</p>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Job Type</label>
                                    <p class="form-control-static" id="lineJobTypeName">-</p>
                                </div>
                            </div>
                        </div>

                        <!-- Idle/Downtime path: Job Type + Activity (reason) picker -->
                        <div class="row" id="idleRow" style="display:none;">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="idleJobType">Category <span class="text-danger">*</span></label>
                                    <select id="idleJobType" class="form-control select-search"></select>
                                </div>
                            </div>
                        </div>

                        <!-- Ad-hoc path: full free Job/JobItem picker + reason -->
                        <div class="row" id="adhocRow" style="display:none;">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="adhocJobType">Job Type <span class="text-danger">*</span></label>
                                    <select id="adhocJobType" class="form-control select-search"></select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="adhocWorkJob">Job Number <span class="text-danger">*</span></label>
                                    <select id="adhocWorkJob" class="form-control select-search">
                                        <option value="">-- Select Job --</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="adhocReason">Reason this job was not pre-assigned <span class="text-danger">*</span></label>
                                    <input type="text" id="adhocReason" class="form-control" maxlength="500" placeholder="e.g. Urgent client request, covering for a teammate..." />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="lineJobItem">Structure/Equipment/Job ID</label>
                                    <select id="lineJobItem" class="form-control select-search" disabled>
                                        <option value="">-- Select Job first --</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="lineActivity">Work Activity</label>
                                    <select id="lineActivity" class="form-control select-search" disabled>
                                        <option value="">-- Select Job first --</option>
                                    </select>
                                    <span class="help-block field-error" data-field="lineActivity"></span>
                                </div>
                            </div>
                            <div class="col-md-3" id="lineReasonWrap" style="display:none;">
                                <div class="form-group">
                                    <label for="lineReason">Reason <span class="text-danger">*</span></label>
                                    <select id="lineReason" class="form-control select-search"></select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label for="lineHours">Hours <span class="text-danger">*</span></label>
                                    <input type="number" id="lineHours" class="form-control" step="0.25" min="0.25" max="24" />
                                    <span class="help-block field-error" data-field="lineHours"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group" id="workDoneTodayWrap">
                                    <label for="lineWorkDoneToday">Work Done Today</label>
                                    <textarea id="lineWorkDoneToday" class="form-control" rows="2" maxlength="1000" placeholder="Describe what was actually completed (separate from the Work Activity name above)"></textarea>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="lineRemarks">Remarks</label>
                                    <input type="text" id="lineRemarks" class="form-control" maxlength="500" placeholder="Optional" />
                                </div>
                            </div>
                        </div>

                        <button type="button" id="addLineBtn" class="btn bg-primary">
                            <i class="icon-plus3 position-left"></i> Add Work Item
                        </button>
                    </form>
                </div>
            </div>
        }

        <div class="panel panel-bordered">
            <div class="panel-heading"><h6 class="panel-title">Today's Work Summary</h6></div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table table-bordered" id="summaryTable">
                        <thead>
                            <tr>
                                <th>Job</th>
                                <th>Structure/Equipment</th>
                                <th>Activity</th>
                                <th>Work Done Today</th>
                                <th>Category</th>
                                <th>Reason</th>
                                <th>Hours</th>
                                @if (!isReadOnly)
                                {
                                    <th></th>
                                }
                            </tr>
                        </thead>
                        <tbody id="summaryBody">
                            <tr id="emptyRow">
                                <td colspan="8" class="text-center text-muted">No work items added yet.</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="6" class="text-right">Total</th>
                                <th id="totalHours">0.00</th>
                                @if (!isReadOnly)
                                {
                                    <th></th>
                                }
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        @if (!isReadOnly)
        {
            <div class="text-right">
                <button type="button" class="btn btn-default" id="saveDraftBtn"><i class="icon-file-text2 position-left"></i> Save Draft</button>
                <button type="button" class="btn bg-success" id="submitBtn"><i class="icon-checkmark3 position-left"></i> Submit</button>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/global_assets/js/plugins/notifications/sweet_alert.min.js"></script>
    <script>
        var lines = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Lines));
        var jobTypesCache = [];
        var activitiesCache = [];
        var assignedComboCache = [];

        function populateSelect(sel, items, valueKey, textKey, placeholder) {
            var $sel = $(sel);
            $sel.empty();
            if (placeholder) $sel.append($("<option>").val("").text(placeholder));
            items.forEach(function (item) {
                $sel.append($("<option>").val(item[valueKey]).text(item[textKey]));
            });
        }

        function loadJobTypes() {
            $.get("@Url.Action("GetJobTypes")", function (res) {
                jobTypesCache = res.data || [];
                populateSelect("#idleJobType", jobTypesCache, "id", "name", "-- Select Category --");
                populateSelect("#adhocJobType", jobTypesCache, "id", "name", "-- Select Job Type --");
            });
        }

        function loadAssignedWorkCombo() {
            $.get("@Url.Action("GetMyAssignedWorkCombo")", function (res) {
                assignedComboCache = res.data || [];

                var $sel = $("#lineAssignedWork");
                // Keep the two special options, rebuild the assignment options.
                $sel.find("option[data-assignment]").remove();

                assignedComboCache.forEach(function (a) {
                    var label = a.jobNumber +
                        (a.jobItemCode ? " / " + a.jobItemCode : " (any structure)") +
                        (a.workActivityName ? " - " + a.workActivityName : "");
                    $sel.append($("<option>").val(a.assignmentId).text(label).attr("data-assignment", "1"));
                });

                if (assignedComboCache.length === 0) {
                    $sel.append($("<option disabled>").text("(You have no active assigned jobs - ask your manager to assign work, or use Unassigned/Ad-hoc)").attr("data-assignment", "1"));
                }
            });
        }

        function loadAdhocJobsDropdown() {
            $.get("@Url.Action("GetJobsDropdown")", function (res) {
                populateSelect("#adhocWorkJob", res.data || [], "value", "text", "-- Select Job --");
            });
        }

        // ===== Mode switch: assigned job / idle-downtime / ad-hoc =====
        function resetDependentFields() {
            $("#lineJobItem").prop("disabled", true).empty().append($("<option>").val("").text("-- Select Job first --"));
            $("#lineActivity").prop("disabled", true).empty().append($("<option>").val("").text("-- Select Job first --"));
            $("#lineReasonWrap").hide();
            $("#lineClientName").text("-");
            $("#lineJobTypeName").text("-");
        }

        $("#lineAssignedWork").on("change", function () {
            var val = $(this).val();
            $("#idleRow, #adhocRow").hide();
            resetDependentFields();
            $("#workDoneTodayWrap").show();

            if (val === "__idle__") {
                $("#idleRow").show();
                $("#workDoneTodayWrap").hide();
                return;
            }

            if (val === "__adhoc__") {
                $("#adhocRow").show();
                return;
            }

            // A real assignment was picked.
            var a = assignedComboCache.find(function (x) { return x.assignmentId === val; });
            if (!a) return;

            $("#lineJobTypeName").text(jobTypesCache.find(function (jt) { return jt.id === a.jobTypeId; })?.name || "-");

            if (a.jobItemId) {
                // Pinned to one exact structure - no picking needed.
                $("#lineJobItem").empty().append($("<option>").val(a.jobItemId).text(a.jobItemCode));
            } else {
                // Job-level assignment - load that job's structures so the
                // employee can pick which one they worked on, still scoped
                // to this one job only.
                $.get("@Url.Action("GetJobItems")", { jobId: a.workJobId }, function (res) {
                    populateSelect("#lineJobItem", res.data || [], "id", "code", "-- Select (optional) --");
                    $("#lineJobItem").prop("disabled", false);
                });
            }

            if (a.workActivityId) {
                $("#lineActivity").empty().append($("<option>").val(a.workActivityId).text(a.workActivityName));
                $.get("@Url.Action("GetWorkActivities")", { jobTypeId: a.jobTypeId }, function (res) {
                    activitiesCache = res.data || [];
                });
            } else {
                $.get("@Url.Action("GetWorkActivities")", { jobTypeId: a.jobTypeId }, function (res) {
                    activitiesCache = res.data || [];
                    populateSelect("#lineActivity", activitiesCache, "id", "name", "-- Select Activity --");
                    $("#lineActivity").prop("disabled", false);
                });
            }
        });

        $("#idleJobType").on("change", function () {
            var jobTypeId = $(this).val();
            $("#lineActivity").prop("disabled", true).empty().append($("<option>").val("").text("-- Loading... --"));
            $("#lineReasonWrap").hide();

            if (!jobTypeId) {
                $("#lineActivity").empty().append($("<option>").val("").text("-- Select Category first --"));
                return;
            }

            $.get("@Url.Action("GetWorkActivities")", { jobTypeId: jobTypeId }, function (res) {
                activitiesCache = res.data || [];
                populateSelect("#lineActivity", activitiesCache, "id", "name", "-- Select Activity --");
                $("#lineActivity").prop("disabled", false);
            });
        });

        $("#adhocJobType").on("change", function () {
            var jobTypeId = $(this).val();
            $("#lineActivity").prop("disabled", true).empty().append($("<option>").val("").text("-- Loading... --"));

            if (!jobTypeId) {
                $("#lineActivity").empty().append($("<option>").val("").text("-- Select Job Type first --"));
                return;
            }

            $.get("@Url.Action("GetWorkActivities")", { jobTypeId: jobTypeId }, function (res) {
                activitiesCache = res.data || [];
                populateSelect("#lineActivity", activitiesCache, "id", "name", "-- Select Activity --");
                $("#lineActivity").prop("disabled", false);
            });
        });

        $("#adhocWorkJob").on("change", function () {
            var jobId = $(this).val();
            $("#lineJobItem").prop("disabled", true).empty().append($("<option>").val("").text("-- Loading... --"));

            if (!jobId) {
                $("#lineJobItem").empty().append($("<option>").val("").text("-- No job selected --"));
                return;
            }

            $.get("@Url.Action("GetJobItems")", { jobId: jobId }, function (res) {
                populateSelect("#lineJobItem", res.data || [], "id", "code", "-- Select (optional) --");
                $("#lineJobItem").prop("disabled", false);
            });
        });

        $("#lineActivity").on("change", function () {
            var activityId = $(this).val();
            var activity = activitiesCache.find(function (a) { return a.id === activityId; });

            if (activity && (activity.workCategory === 3 || activity.workCategory === 4)) {
                // Idle = 3, Downtime = 4
                $("#lineReasonWrap").show();
                $.get("@Url.Action("GetWorkEntryReasons")", { category: activity.workCategory === 3 ? 1 : 2 }, function (res) {
                    populateSelect("#lineReason", res.data || [], "id", "name", "-- Select Reason --");
                });
            } else {
                $("#lineReasonWrap").hide();
            }
        });

        function renderSummary() {
            var $body = $("#summaryBody").empty();
            var total = 0;

            if (lines.length === 0) {
                $body.append('<tr id="emptyRow"><td colspan="8" class="text-center text-muted">No work items added yet.</td></tr>');
            }

            lines.forEach(function (l, idx) {
                total += parseFloat(l.hours || 0);
                var removeCell = @(isReadOnly ? "''" : "'<td><button type=\"button\" class=\"btn btn-xs btn-link text-danger removeLineBtn\" data-idx=\"' + idx + '\"><i class=\"icon-trash\"></i></button></td>'");
                $body.append(
                    "<tr>" +
                    "<td>" + (l.jobNumber || (l.jobTypeName ? "-" : "Idle Hours")) + (l.adhocReason ? ' <span class="label bg-warning-300">Ad-hoc</span>' : '') + "</td>" +
                    "<td>" + (l.jobItemCode || "-") + "</td>" +
                    "<td>" + (l.workActivityName || "-") + "</td>" +
                    "<td>" + (l.workDoneToday || "-") + "</td>" +
                    "<td>" + (l.workCategoryName || "-") + "</td>" +
                    "<td>" + (l.workEntryReasonName || "-") + "</td>" +
                    "<td>" + parseFloat(l.hours).toFixed(2) + "</td>" +
                    removeCell +
                    "</tr>"
                );
            });

            $("#totalHours").text(total.toFixed(2));
        }

        $(document).on("click", ".removeLineBtn", function () {
            var idx = $(this).data("idx");
            lines.splice(idx, 1);
            renderSummary();
        });

        $("#addLineBtn").on("click", function () {
            $(".field-error").text("");

            var mode = $("#lineAssignedWork").val();
            var hours = parseFloat($("#lineHours").val());
            var activityId = $("#lineActivity").val();
            var activity = activitiesCache.find(function (a) { return a.id === activityId; });

            var valid = true;
            var jobTypeId = null, workJobId = null, jobNumber = null, jobItemId = null, jobItemCode = null;
            var assignmentId = null, adhocReason = null;

            if (mode === "__idle__") {
                jobTypeId = $("#idleJobType").val();
                if (!jobTypeId) { swal("Missing Category", "Please select an Idle/Downtime category.", "warning"); valid = false; }
            } else if (mode === "__adhoc__") {
                jobTypeId = $("#adhocJobType").val();
                workJobId = $("#adhocWorkJob").val();
                jobNumber = $("#adhocWorkJob option:selected").text();
                jobItemId = $("#lineJobItem").val() || null;
                jobItemCode = $("#lineJobItem option:selected").text();
                adhocReason = $.trim($("#adhocReason").val());

                if (!jobTypeId || !workJobId) { swal("Missing Job", "Please select a Job Type and Job Number.", "warning"); valid = false; }
                if (valid && !adhocReason) { swal("Reason Required", "Please explain why this job was not pre-assigned to you.", "warning"); valid = false; }
            } else {
                var a = assignedComboCache.find(function (x) { return x.assignmentId === mode; });
                if (!a) { swal("Select Job", "Please select an assigned job, or Idle/Downtime, or Unassigned/Ad-hoc Work.", "warning"); valid = false; }
                else {
                    jobTypeId = a.jobTypeId;
                    workJobId = a.workJobId;
                    jobNumber = a.jobNumber;
                    jobItemId = $("#lineJobItem").val() || null;
                    jobItemCode = $("#lineJobItem option:selected").text();
                    assignmentId = a.assignmentId;
                }
            }

            if (valid && (!hours || hours <= 0 || hours > 24)) {
                $(".field-error[data-field='lineHours']").text("Hours must be greater than 0 and no more than 24.");
                valid = false;
            }

            if (valid && activity && (activity.workCategory === 3 || activity.workCategory === 4) && !$("#lineReason").val()) {
                swal("Reason Required", "Please select a reason for Idle/Downtime hours.", "warning");
                valid = false;
            }

            if (!valid) return;

            lines.push({
                workJobId: workJobId,
                jobNumber: jobNumber,
                jobTypeId: jobTypeId,
                jobTypeName: $("#lineJobTypeName").text() !== "-" ? $("#lineJobTypeName").text() : (jobTypesCache.find(function (jt) { return jt.id === jobTypeId; })?.name || null),
                jobItemId: jobItemId,
                jobItemCode: jobItemCode !== "-- Select (optional) --" ? jobItemCode : null,
                workActivityId: activityId || null,
                workActivityName: activity ? activity.name : (mode !== "__idle__" && mode !== "__adhoc__" ? (assignedComboCache.find(function (x) { return x.assignmentId === mode; })?.workActivityName) : null),
                workCategory: activity ? activity.workCategory : null,
                workCategoryName: activity ? activity.workCategoryName : null,
                workEntryReasonId: $("#lineReasonWrap").is(":visible") ? $("#lineReason").val() : null,
                workEntryReasonName: $("#lineReasonWrap").is(":visible") ? $("#lineReason option:selected").text() : null,
                hours: hours,
                remarks: $("#lineRemarks").val(),
                workDoneToday: $("#lineWorkDoneToday").val(),
                assignmentId: assignmentId,
                adhocReason: adhocReason
            });

            renderSummary();

            // Reset the line form for the next entry.
            $("#lineAssignedWork").val("__idle__").trigger("change");
            $("#lineHours").val("");
            $("#lineRemarks").val("");
            $("#lineWorkDoneToday").val("");
            $("#adhocReason").val("");
        });

        function buildPayload() {
            return {
                WorkDate: $("#workDate").val(),
                Lines: lines.map(function (l) {
                    return {
                        WorkJobId: l.workJobId,
                        JobTypeId: l.jobTypeId,
                        JobItemId: l.jobItemId,
                        WorkActivityId: l.workActivityId,
                        WorkEntryReasonId: l.workEntryReasonId,
                        Hours: l.hours,
                        Remarks: l.remarks,
                        WorkDoneToday: l.workDoneToday,
                        AssignmentId: l.assignmentId,
                        AdhocReason: l.adhocReason
                    };
                })
            };
        }

        function postJson(url, payload, onSuccess) {
            $.ajax({
                url: url, type: "POST", contentType: "application/json",
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) onSuccess(res);
                    else swal("Error", res.message || "Unable to save.", "error");
                },
                error: function () { swal("Error", "Unable to reach the server.", "error"); }
            });
        }

        $("#saveDraftBtn").on("click", function () {
            if (lines.length === 0) { swal("No Work Items", "Please add at least one work item.", "warning"); return; }
            postJson("@Url.Action("SaveDraft")", buildPayload(), function () {
                swal({ title: "Saved", text: "Draft saved successfully.", type: "success" }, function () { location.reload(); });
            });
        });

        $("#submitBtn").on("click", function () {
            if (lines.length === 0) { swal("No Work Items", "Please add at least one work item.", "warning"); return; }
            swal({
                title: "Submit for Approval?",
                text: "Once submitted, this day's entry cannot be edited until your Team Leader reviews it.",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#66BB6A",
                confirmButtonText: "Yes, submit"
            }, function (confirmed) {
                if (!confirmed) return;
                postJson("@Url.Action("Submit")", buildPayload(), function () {
                    swal({ title: "Submitted", text: "Your daily work has been submitted for approval.", type: "success" }, function () { location.reload(); });
                });
            });
        });

        $("#workDate").on("change", function () {
            window.location.href = "@Url.Action("Index")?date=" + $(this).val();
        });

        $(function () {
            renderSummary();
            @if (!isReadOnly)
            {
                <text>
                loadJobTypes();
                loadAssignedWorkCombo();
                loadAdhocJobsDropdown();
                $("#lineAssignedWork").trigger("change");
                </text>
            }
        });
    </script>
}
