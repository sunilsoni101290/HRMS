@model List<APP.Models.DTOs.DailyWorkLogSummaryDto>
@{
    ViewData["Title"] = "My Work Entries";
    string StatusBadge(int status) => status switch
    {
        0 => "label label-default",   // Draft
        1 => "label label-warning",   // Pending
        2 => "label label-success",   // Approved
        3 => "label label-danger",    // Rejected
        _ => "label label-default"
    };
}

<div class="panel panel-flat">
    <div class="panel-heading">
        <h5 class="panel-title"><i class="icon-list position-left"></i> My Work Entries</h5>
        <div class="heading-elements">
            <a asp-action="Index" class="btn btn-primary btn-sm"><i class="icon-plus3 position-left"></i> New Entry</a>
        </div>
    </div>
    <div class="panel-body">
        <div class="table-responsive">
            <table class="table table-bordered datatable-basic">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Total Hours</th>
                        <th>Status</th>
                        <th>Submitted At</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted">No work entries yet.</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.WorkDate.ToString("dd-MMM-yyyy")</td>
                            <td>@item.TotalHours.ToString("0.00")</td>
                            <td><span class="@StatusBadge(item.Status)">@item.StatusName</span></td>
                            <td>@(item.SubmittedAt?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-xs btn-link"><i class="icon-eye"></i> View</a>
                                @if (item.Status == 0 || item.Status == 3)
                                {
                                    <a asp-action="Index" asp-route-date="@item.WorkDate.ToString("yyyy-MM-dd")" class="btn btn-xs btn-link"><i class="icon-pencil"></i> Edit</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/global_assets/js/plugins/tables/datatables/datatables.min.js"></script>
    <script>
        $(".datatable-basic").DataTable({ order: [[0, "desc"]] });
    </script>
}
