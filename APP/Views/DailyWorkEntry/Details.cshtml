@model APP.Models.DTOs.DailyWorkLogDto
@{
    ViewData["Title"] = "Work Entry Details";
}

<div class="panel panel-flat">
    <div class="panel-heading">
        <h5 class="panel-title"><i class="icon-eye position-left"></i> Work Entry Details</h5>
        <div class="heading-elements">
            <a asp-action="MyEntries" class="btn btn-link btn-sm"><i class="icon-arrow-left8 position-left"></i> Back</a>
        </div>
    </div>
    <div class="panel-body">
        <div class="row">
            <div class="col-md-3"><label>Employee</label><p class="form-control-static">@Model.EmployeeName (@Model.EmployeeCode)</p></div>
            <div class="col-md-3"><label>Date</label><p class="form-control-static">@Model.WorkDate.ToString("dd-MMM-yyyy")</p></div>
            <div class="col-md-3"><label>Status</label><p class="form-control-static"><strong>@Model.StatusName</strong></p></div>
            <div class="col-md-3"><label>Total Hours</label><p class="form-control-static">@Model.TotalHours.ToString("0.00")</p></div>
        </div>

        <div class="row">
            <div class="col-md-3"><label>Direct Hours</label><p class="form-control-static">@Model.DirectHours.ToString("0.00")</p></div>
            <div class="col-md-3"><label>Indirect Hours</label><p class="form-control-static">@Model.IndirectHours.ToString("0.00")</p></div>
            <div class="col-md-3"><label>Idle Hours</label><p class="form-control-static">@Model.IdleHours.ToString("0.00")</p></div>
            <div class="col-md-3"><label>Downtime Hours</label><p class="form-control-static">@Model.DowntimeHours.ToString("0.00")</p></div>
        </div>

        @if (Model.Status == 3 && !string.IsNullOrEmpty(Model.RejectionReason))
        {
            <div class="alert alert-danger"><strong>Rejection Reason:</strong> @Model.RejectionReason</div>
        }

        <div class="table-responsive">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Job</th><th>Client</th><th>Job Type</th><th>Structure/Equipment</th>
                        <th>Activity</th><th>Category</th><th>Reason</th><th>Hours</th><th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>@(line.JobNumber ?? "-")</td>
                            <td>@(line.ClientName ?? "-")</td>
                            <td>@(line.JobTypeName ?? "-")</td>
                            <td>@(line.JobItemCode ?? "-")</td>
                            <td>@(line.WorkActivityName ?? "-")</td>
                            <td>@(line.WorkCategoryName ?? "-")</td>
                            <td>@(line.WorkEntryReasonName ?? "-")</td>
                            <td>@line.Hours.ToString("0.00")</td>
                            <td>@(line.Remarks ?? "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
