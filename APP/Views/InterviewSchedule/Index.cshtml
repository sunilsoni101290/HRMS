@model IEnumerable<InterviewScheduleListDto>

@{
    ViewData["Title"] = "Interviews";

    string StatusLabel(int s) => s switch
    {
        1 => "bg-primary",   // Scheduled
        2 => "bg-success",   // Completed
        3 => "bg-danger",    // Cancelled
        4 => "bg-grey",      // Expired
        _ => "bg-info"
    };
}

<div class="panel panel-flat">

    <div class="panel-heading">
        <h5 class="panel-title"><i class="icon-calendar position-left"></i> Interview Schedules</h5>
        <div class="heading-elements">
            <a asp-action="Create" class="btn bg-primary"><i class="icon-plus22"></i> Schedule Interview</a>
        </div>
    </div>

    <div class="panel-body">
        <div class="row">
            <div class="col-md-4">
                <input type="text" id="searchInput" class="form-control" placeholder="Search candidate, job, interviewer..." />
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-striped">
            <thead>
                <tr>
                    <th width="50">#</th>
                    <th>Candidate</th>
                    <th>Job</th>
                    <th>Interviewer</th>
                    <th>Date</th>
                    <th>Mode</th>
                    <th>Status</th>
                    <th width="230">Action</th>
                </tr>
            </thead>
            <tbody id="dataTable">
                @{ int sr = 1; }
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@sr</td>
                            <td><strong>@item.CandidateName</strong></td>
                            <td>@item.JobTitle</td>
                            <td>@item.InterviewerName</td>
                            <td>@item.InterviewDate.ToString("dd MMM yyyy HH:mm")</td>
                            <td><span class="label bg-info">@item.ModeText</span></td>
                            <td><span class="label @StatusLabel(item.Status)">@item.StatusText</span></td>
                            <td>
                                @if (item.Status == 1)
                                {
                                    <form asp-action="Complete" asp-route-id="@item.Id" method="post" style="display:inline;">
                                        <button type="submit" class="btn btn-success btn-icon" title="Complete"><i class="icon-checkmark3"></i></button>
                                    </form>
                                    <form asp-action="Cancel" asp-route-id="@item.Id" method="post" style="display:inline;"
                                          onsubmit="return confirm('Cancel this interview?');">
                                        <button type="submit" class="btn btn-warning btn-icon" title="Cancel"><i class="icon-cross2"></i></button>
                                    </form>
                                }
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-default btn-icon" title="View"><i class="icon-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-icon" title="Edit"><i class="icon-pencil7"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   onclick="return confirm('Delete this interview?');"
                                   class="btn btn-danger btn-icon" title="Delete"><i class="icon-trash"></i></a>
                            </td>
                        </tr>
                        sr++;
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center text-muted" style="padding:30px;"><i class="icon-calendar" style="font-size:32px;"></i><br />No interviews scheduled.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    @if (TempData["Success"] != null)
    {
        <script>$(function(){ swal({ title:"Success", text:"@TempData["Success"]", type:"success" }); });</script>
    }
    <script>
        $(function () {
            $("#searchInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#dataTable tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
        });
    </script>
    <style>
        .table > thead > tr > th { font-weight: 600; }
        .table > tbody > tr > td { vertical-align: middle; }
        .label { font-size: 11px; }
        .btn-icon { width: 34px; }
    </style>
}
