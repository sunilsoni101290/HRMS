@model FinanceUploadViewModel

@{
    ViewData["Title"] = "Upload Payslip";
}

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">
            <i class="icon-upload7 position-left"></i>
            Upload Payslip
        </h5>

        <div class="heading-elements">

            <a asp-action="FinanceQueue"
               class="btn btn-default">
                <i class="icon-arrow-left13"></i>
                Back
            </a>

        </div>

    </div>

    <div class="panel-body">

        <form asp-action="FinanceUpload"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <input asp-for="Id" type="hidden" />

            <div class="form-group">

                <label asp-for="UploadFile"></label>

                <input asp-for="UploadFile" type="file" class="form-control" accept="application/pdf" />

                <span asp-validation-for="UploadFile" class="text-danger"></span>

                <span class="text-muted text-size-small">PDF only, up to 5 MB.</span>

            </div>

            <div class="form-group">

                <label asp-for="Remarks"></label>

                <textarea asp-for="Remarks" rows="3" maxlength="500" class="form-control"></textarea>

                <span asp-validation-for="Remarks" class="text-danger"></span>

            </div>

            <hr />

            <div class="text-right">

                <a asp-action="FinanceQueue" class="btn btn-default">
                    Cancel
                </a>

                <button type="submit" class="btn bg-primary">
                    <i class="icon-upload7"></i>
                    Upload
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
