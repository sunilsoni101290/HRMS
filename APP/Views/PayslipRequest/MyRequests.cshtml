@model IEnumerable<PayslipRequestDto>

@{
    ViewData["Title"] = "My Payslip Requests";
    bool noEmployeeProfile = ViewBag.NoEmployeeProfile ?? false;

    string StatusBadgeClass(int status) => status switch
    {
        (int)EnumExtensions.PayslipRequestStatus.PendingManagerApproval => "bg-warning",
        (int)EnumExtensions.PayslipRequestStatus.RejectedByManager => "bg-danger",
        (int)EnumExtensions.PayslipRequestStatus.ApprovedByManager => "bg-info",
        (int)EnumExtensions.PayslipRequestStatus.PendingFinanceAction => "bg-warning",
        (int)EnumExtensions.PayslipRequestStatus.PayslipGenerated => "bg-info",
        (int)EnumExtensions.PayslipRequestStatus.Completed => "bg-success",
        (int)EnumExtensions.PayslipRequestStatus.RejectedByFinance => "bg-danger",
        _ => "bg-grey"
    };

    string StatusText(PayslipRequestDto item) =>
        !string.IsNullOrEmpty(item.StatusName)
            ? item.StatusName
            : ((EnumExtensions.PayslipRequestStatus)item.Status).ToString();
}

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">
            <i class="icon-cash3 position-left"></i>
            My Payslip Requests
        </h5>

        <div class="heading-elements">

            <a asp-action="PendingApprovals" class="btn btn-default">
                <i class="icon-checkmark4"></i>
                Pending My Approval
            </a>

            <a asp-action="Create" class="btn bg-primary">
                <i class="icon-plus22"></i>
                Request Payslip
            </a>

        </div>

    </div>

    <div class="panel-body">

        <div class="alert bg-slate-100 alert-styled-left">
            You can no longer view or download a payslip directly. Submit a request for the payroll
            period you need - it must be approved by your Reporting Manager and then generated/released
            by Finance before you can view and download it.
        </div>

        @if (noEmployeeProfile)
        {
            <div class="alert alert-danger">
                Your login isn't linked to an employee profile, so you can't submit a payslip request.
            </div>
        }

    </div>

    <div class="table-responsive">

        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>Period</th>
                    <th>Status</th>
                    <th>Requested On</th>
                    <th width="140">Action</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.PayrollMonth/@item.PayrollYear</td>

                            <td>
                                <span class="label @StatusBadgeClass(item.Status)">@StatusText(item)</span>
                            </td>

                            <td>@item.CreatedOn.ToString("dd-MMM-yyyy HH:mm")</td>

                            <td style="padding: 10px 15px;">

                                <div class="btn-group">

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-default btn-icon"
                                       data-popup="tooltip"
                                       title="View">

                                        <i class="icon-eye"></i>

                                    </a>

                                    @if (item.Status == (int)EnumExtensions.PayslipRequestStatus.Completed)
                                    {
                                        <a asp-action="Download"
                                           asp-route-id="@item.Id"
                                           class="btn btn-success btn-icon"
                                           data-popup="tooltip"
                                           title="Download">

                                            <i class="icon-download7"></i>

                                        </a>
                                    }

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted" style="padding:30px;">
                            <i class="icon-cash3" style="font-size:32px;"></i><br />
                            No payslip requests found.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<script src="~/global_assets/js/plugins/notifications/sweet_alert.min.js"></script>

@section Scripts {

    <script>

        @if (TempData["Success"] != null)
        {
            <text>
                swal({
                    title: 'Success',
                    text: '@Html.Raw(TempData["Success"])',
                    type: 'success',
                    confirmButtonColor: '#66BB6A'
                });
            </text>
        }

        @if (TempData["GlobalError"] != null)
        {
            <text>
                swal({
                    title: 'Error',
                    text: '@Html.Raw(TempData["GlobalError"])',
                    type: 'error',
                    confirmButtonColor: '#EF5350'
                });
            </text>
        }

    </script>

    <script>

        $(document).ready(function () {
            $('[data-popup="tooltip"]').tooltip();
        });

    </script>

}
