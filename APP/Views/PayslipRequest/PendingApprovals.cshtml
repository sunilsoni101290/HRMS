@model IEnumerable<PayslipRequestDto>

@{
    ViewData["Title"] = "Pending My Approval - Payslip Requests";

    string StatusBadgeClass(int status) => status switch
    {
        (int)EnumExtensions.PayslipRequestStatus.PendingManagerApproval => "bg-warning",
        _ => "bg-grey"
    };

    string StatusText(PayslipRequestDto item) =>
        !string.IsNullOrEmpty(item.StatusName)
            ? item.StatusName
            : ((EnumExtensions.PayslipRequestStatus)item.Status).ToString();
}

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">
            <i class="icon-checkmark4 position-left"></i>
            Payslip Requests - Pending My Approval
        </h5>

        <div class="heading-elements">

            <a asp-action="MyRequests" class="btn btn-default">
                <i class="icon-list"></i>
                My Requests
            </a>

        </div>

    </div>

    <div class="table-responsive">

        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>Period</th>
                    <th>Requested On</th>
                    <th>Status</th>
                    <th width="160">Action</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.EmployeeName</td>

                            <td>@(item.DepartmentName ?? "-")</td>

                            <td>@item.PayrollMonth/@item.PayrollYear</td>

                            <td>@item.CreatedOn.ToString("dd-MMM-yyyy HH:mm")</td>

                            <td>
                                <span class="label @StatusBadgeClass(item.Status)">@StatusText(item)</span>
                            </td>

                            <td style="padding: 10px 15px;">

                                <div class="btn-group">

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-default btn-icon"
                                       data-popup="tooltip"
                                       title="View">

                                        <i class="icon-eye"></i>

                                    </a>

                                    <button type="button"
                                            class="btn btn-success btn-icon btnApprove"
                                            data-id="@item.Id"
                                            data-popup="tooltip"
                                            title="Approve">

                                        <i class="icon-checkmark4"></i>

                                    </button>

                                    <button type="button"
                                            class="btn btn-danger btn-icon btnReject"
                                            data-id="@item.Id"
                                            data-popup="tooltip"
                                            title="Reject">

                                        <i class="icon-cross2"></i>

                                    </button>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted" style="padding:30px;">
                            <i class="icon-checkmark-circle" style="font-size:32px;"></i><br />
                            Nothing pending your approval.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<form id="approveForm" asp-action="ManagerApprove" method="post" style="display:none;">
    <input type="hidden" id="ApprovePayslipRequestId" name="id" />
</form>

<div class="modal fade" id="rejectModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5>Reject Payslip Request</h5></div>
            <form asp-action="ManagerReject" method="post">
                <div class="modal-body">
                    <input type="hidden" id="RejectPayslipRequestId" name="id" />
                    <label>Reason</label>
                    <textarea class="form-control" name="reason" required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-danger">Reject</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/global_assets/js/plugins/notifications/sweet_alert.min.js"></script>

@section Scripts {

    <script>

        @if (TempData["Success"] != null)
        {
            <text>
                swal({
                    title: 'Success',
                    text: '@Html.Raw(TempData["Success"])',
                    type: 'success',
                    confirmButtonColor: '#66BB6A'
                });
            </text>
        }

        @if (TempData["GlobalError"] != null)
        {
            <text>
                swal({
                    title: 'Error',
                    text: '@Html.Raw(TempData["GlobalError"])',
                    type: 'error',
                    confirmButtonColor: '#EF5350'
                });
            </text>
        }

    </script>

    <script>

        $(document).ready(function () {

            $('[data-popup="tooltip"]').tooltip();

            $(document).on('click', '.btnApprove', function () {

                var id = $(this).data('id');

                swal({
                    title: 'Approve this request?',
                    text: 'It will be forwarded to Finance for payslip generation.',
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#66BB6A',
                    confirmButtonText: 'Yes, approve it'
                }, function (isConfirm) {
                    if (isConfirm) {
                        $('#ApprovePayslipRequestId').val(id);
                        $('#approveForm').submit();
                    }
                });

            });

            $(document).on('click', '.btnReject', function () {

                var id = $(this).data('id');

                $('#RejectPayslipRequestId').val(id);

                $('#rejectModal').modal('show');

            });

        });

    </script>

}
