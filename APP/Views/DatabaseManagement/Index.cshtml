            </div>
            <div class="modal-body">
                <p class="text-muted" style="font-size:12.5px;">This application cannot launch SQL Server Management Studio directly. Copy these details into SSMS's "Connect to Server" dialog - you will still need to supply your own SSMS login/credentials there.</p>
                <div class="form-group">
                    <label>Server Name</label>
                    <div class="input-group">
                        <span class="form-control" id="ssmsServerName">—</span>
                        <span class="input-group-btn">
                            <button class="btn btn-default dbm-copy-btn" type="button" data-target="ssmsServerName"><i class="bi bi-clipboard"></i> Copy</button>
                        </span>
                    </div>
                </div>
                <div class="form-group">
                    <label>Database Name</label>
                    <div class="input-group">
                        <span class="form-control" id="ssmsDatabaseName">—</span>
                        <span class="input-group-btn">
                            <button class="btn btn-default dbm-copy-btn" type="button" data-target="ssmsDatabaseName"><i class="bi bi-clipboard"></i> Copy</button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
