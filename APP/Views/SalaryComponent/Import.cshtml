@model SalaryComponentImportResultDto

@{
    ViewData["Title"] = "Import Salary Components";
    bool hasResult = Model != null && Model.TotalRows > 0;
}

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">
            <i class="icon-file-spreadsheet position-left"></i>
            Import Salary Components
        </h5>

        <div class="heading-elements">

            <a asp-action="Index" class="btn btn-default">
                <i class="icon-arrow-left13"></i>
                Back
            </a>

        </div>

    </div>

    <div class="panel-body">

        <div class="alert alert-info alert-styled-left">
            <span class="text-semibold">How this works:</span>
            <ol class="no-margin-bottom" style="padding-left:18px;margin-top:6px;">
                <li>Download the template below.</li>
                <li>Fill in one row per salary component - Component Name, Code, and Component Type (Earning or Deduction) are required.</li>
                <li>Upload the completed file. Each row is validated and imported independently, so a mistake in one row won't block the rest.</li>
            </ol>
        </div>

        <a asp-action="DownloadImportTemplate" class="btn bg-success mb-15">
            <i class="icon-file-download"></i>
            Download Excel Template
        </a>

        <form asp-action="Import" method="post" enctype="multipart/form-data">

            <div class="form-group">

                <label class="text-semibold">Select Excel File</label>

                <input type="file"
                       name="file"
                       accept=".xlsx,.xls"
                       class="form-control"
                       required />

            </div>

            <button type="submit" class="btn bg-primary">
                <i class="icon-upload3"></i>
                Upload &amp; Import
            </button>

        </form>

        @if (hasResult)
        {
            <hr />

            <div class="row text-center">

                <div class="col-md-4">
                    <div class="panel panel-body bg-slate-400">
                        <h3 class="no-margin">@Model.TotalRows</h3>
                        <span class="text-uppercase text-size-mini">Total Rows</span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="panel panel-body bg-success-400">
                        <h3 class="no-margin">@Model.SuccessCount</h3>
                        <span class="text-uppercase text-size-mini">Imported</span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="panel panel-body bg-danger-400">
                        <h3 class="no-margin">@Model.FailureCount</h3>
                        <span class="text-uppercase text-size-mini">Failed</span>
                    </div>
                </div>

            </div>

            <table class="table table-bordered table-striped">

                <thead>
                    <tr>
                        <th width="80">Row</th>
                        <th>Code</th>
                        <th>Component Name</th>
                        <th width="100">Status</th>
                        <th>Message</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>@row.RowNumber</td>
                            <td>@row.Code</td>
                            <td>@row.Name</td>
                            <td>
                                @if (row.Success)
                                {
                                    <span class="label bg-success">Success</span>
                                }
                                else
                                {
                                    <span class="label bg-danger">Failed</span>
                                }
                            </td>
                            <td>@row.Message</td>
                        </tr>
                    }
                </tbody>

            </table>
        }

    </div>

</div>
