@model IEnumerable<SalaryComponentListDto>

@{
    ViewData["Title"] = "Salary Components";
}

<div class="panel panel-flat">

    <div class="panel-heading">
        <h5 class="panel-title">
            <i class="icon-calculator position-left"></i> Salary Components
        </h5>
        <div class="heading-elements">
            <a asp-action="Export" class="btn btn-default">
                <i class="icon-file-download"></i> Export
            </a>
            <a asp-action="DownloadImportTemplate" class="btn bg-slate">
                <i class="icon-file-spreadsheet"></i> Download Template
            </a>
            <a asp-action="Import" class="btn bg-info">
                <i class="icon-upload3"></i> Import
            </a>
            <a asp-action="Create" class="btn bg-primary">
                <i class="icon-plus22"></i> Add Component
            </a>
        </div>
    </div>

    <div class="panel-body">
        <div class="row">
            <div class="col-md-4">
                <input type="text" id="searchInput" class="form-control"
                       placeholder="Search component..." />
            </div>
        </div>
    </div>

    <table class="table table-hover table-striped datatable-basic">
        <thead>
            <tr>
                <th width="60">#</th>
                <th>Component</th>
                <th>Code</th>
                <th>Type</th>
                <th class="text-center">Taxable</th>
                <th class="text-center">PF</th>
                <th class="text-center">ESIC</th>
                <th width="170">Action</th>
            </tr>
        </thead>
        <tbody id="dataTable">
            @{ int sr = 1; }
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@sr</td>
                        <td><strong>@item.Name</strong></td>
                        <td><span class="label bg-primary">@item.Code</span></td>
                        <td>
                            <span class="label @(item.ComponentType == 1 ? "bg-success" : "bg-danger")">
                                @(item.ComponentType == 1 ? "Earning" : "Deduction")
                            </span>
                        </td>
                        <td class="text-center">
                            @if (item.IsTaxable) { <i class="icon-checkmark3 text-success"></i> } else { <span class="text-muted">-</span> }
                        </td>
                        <td class="text-center">
                            @if (item.IsPFApplicable) { <i class="icon-checkmark3 text-success"></i> } else { <span class="text-muted">-</span> }
                        </td>
                        <td class="text-center">
                            @if (item.IsESICApplicable) { <i class="icon-checkmark3 text-success"></i> } else { <span class="text-muted">-</span> }
                        </td>
                        <td>
                            <div class="btn-group">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-default btn-icon" title="View"><i class="icon-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-icon" title="Edit"><i class="icon-pencil7"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   onclick="return confirmSweetDelete(event, this, 'Delete this component?');"
                                   class="btn btn-danger btn-icon" title="Delete"><i class="icon-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                    sr++;
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted" style="padding:30px;">
                        <i class="icon-calculator" style="font-size:32px;"></i><br />
                        No salary components found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(function () {
            $("#searchInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#dataTable tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
        });
    </script>
    <style>
        .table > thead > tr > th { font-weight: 600; }
        .table > tbody > tr > td { vertical-align: middle; }
        .label { font-size: 11px; }
        .btn-icon { width: 34px; }
    </style>

    <script>
        // Auto-added: client-side pagination for this Index page's listing
        // table (DataTables). Safe to run even if this page already
        // initializes '.datatable-basic' itself above - 'retrieve: true'
        // makes DataTables return the existing instance instead of
        // re-initializing (and throwing) when that's the case.
        $(document).ready(function () {
            if ($.fn.DataTable) {
                var __indexDataTable = $('.datatable-basic').DataTable({
                    autoWidth: false,
                    paging: true,
                    ordering: true,
                    searching: false,
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                    language: { search: "_INPUT_", searchPlaceholder: "Search..." },
                    retrieve: true
                });

            // Rewire the page's existing search box to drive DataTables'
            // own filtering pipeline (instead of any legacy row .toggle()
            // logic still bound above), so search results stay correct once
            // rows are split across pages.
            $('#searchInput').on('keyup', function () {
                __indexDataTable.search($(this).val() || '').draw();
            });
            }
        });
    </script>
}
