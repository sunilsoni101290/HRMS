@model Application.DTOs.Dashboard.EmployeeDashboardDto

@{
    Layout = "~/Views/Shared/EmployeeLayout/_EmployeeLayout.cshtml";
    ViewData["Title"] = "My Dashboard";

    string DayColor(string s) => s switch
    {
        "Present" or "Late" or "WorkFromHome" or "OnDuty" or "Overtime" or "CompOff" => "bg-success",
        "HalfDay" => "bg-warning",
        "Absent" => "bg-danger",
        "Leave" => "bg-blue",
        "Holiday" => "bg-teal",
        "WeekOff" => "bg-grey-300",
        _ => "bg-grey-100"
    };

    var trendLabels = string.Join(",", Model.AttendanceTrend.Select(x => "'" + x.Label + "'"));
    var trendValues = string.Join(",", Model.AttendanceTrend.Select(x => x.Value));
    var leaveData = string.Join(",", Model.LeaveDistribution.Select(x => "{value:" + x.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) + ",name:'" + (x.Name ?? "") + "'}"));

    string LeaveChip(string? name)
    {
        var n = (name ?? "").ToLower();
        if (n.Contains("casual")) return "bg-blue";
        if (n.Contains("earned") || n.Contains("privilege")) return "bg-success";
        if (n.Contains("sick")) return "bg-danger";
        if (n.Contains("comp")) return "bg-purple";
        if (n.Contains("mater") || n.Contains("pater")) return "bg-pink";
        return "bg-slate";
    }
    var photoSrc = string.IsNullOrWhiteSpace(Model.PhotoUrl)
        ? Url.Content("~/global_assets/images/placeholders/placeholder.jpg")
        : Url.Content(Model.PhotoUrl);

    string LeaveCode(string? name)
    {
        var n = (name ?? "").ToLower();
        if (n.Contains("casual")) return "CL";
        if (n.Contains("earned") || n.Contains("privilege")) return "EL";
        if (n.Contains("sick")) return "SL";
        if (n.Contains("comp")) return "CO";
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? ("" + parts[0][0] + parts[1][0]).ToUpper()
             : (string.IsNullOrEmpty(name) ? "LV" : name!.Substring(0, Math.Min(2, name.Length)).ToUpper());
    }

    // Model.AttendanceStatus / CheckIn default to a bare "—" when the
    // employee hasn't punched in yet today - show that as a clear
    // "Not Marked" label instead of a lone dash.
    bool notMarkedToday = string.IsNullOrWhiteSpace(Model.AttendanceStatus) || Model.AttendanceStatus == "—";
    string attendanceLabel = notMarkedToday ? "Not Marked" : Model.AttendanceStatus;
    string attendanceBadgeCss = notMarkedToday ? "bg-slate-300" : "bg-success";
}

<!-- Welcome -->
<div class="panel panel-flat employee-welcome">
    <div class="panel-body">
        <div class="row">
            <div class="col-md-8">
                <div class="media">
                    <div class="media-left">
                        <img src="@photoSrc" class="img-circle" alt="@Model.FullName" style="width:80px;height:80px;" />
                    </div>
                    <div class="media-body">
                        <h2 class="no-margin">Welcome back, <strong>@Model.FullName</strong></h2>
                        <br />
                        <span class="text-size-large">Employee Code: <strong>@Model.EmployeeCode</strong></span>
                        <br />
                        <span>@Model.DesignationName | @Model.DepartmentName</span>
                        <br />
                        <span class="text-size-small text-muted">
                            Profile @Model.ProfileCompletionPercent% complete
                            <div class="progress" style="height:6px;width:200px;display:inline-block;vertical-align:middle;margin-left:8px;">
                                <div class="progress-bar bg-primary" style="width:@(Model.ProfileCompletionPercent)%"></div>
                            </div>
                        </span>
                    </div>
                </div>
            </div>
            <div class="col-md-4 text-right">
                <h3>@DateTime.Now.ToString("dddd")</h3>
                <h4>@DateTime.Now.ToString("dd MMMM yyyy")</h4>
                <br />
                <span class="label @attendanceBadgeCss">@attendanceLabel</span>
            </div>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row">

    <!-- Attendance Today -->
    <div class="col-md-3">
        <div class="panel panel-body bg-teal-400">
            <div class="media no-margin">
                <div class="media-left media-middle">
                    <i class="icon-alarm icon-3x opacity-75"></i>
                </div>
                <div class="media-body text-right">
                    <h3 class="no-margin">@(Model.CheckIn?.ToString("hh:mm tt") ?? "--:--")</h3>
                    <span class="text-uppercase text-size-mini">
                        @attendanceLabel
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Leave Balance -->
    <div class="col-md-3">
        <div class="panel panel-body bg-blue-400">
            <div class="media no-margin">
                <div class="media-left media-middle">
                    <i class="icon-calendar3 icon-3x opacity-75"></i>
                </div>
                <div class="media-body text-right">
                    <h3 class="no-margin">@Model.TotalLeaveBalance.ToString("0.#")</h3>
                    <span class="text-uppercase text-size-mini">
                        Leave Balance (days)
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Upcoming Holiday -->
    <div class="col-md-3">
        <div class="panel panel-body bg-indigo-400">
            <div class="media no-margin">
                <div class="media-left media-middle">
                    <i class="icon-gift icon-3x opacity-75"></i>
                </div>
                <div class="media-body text-right">
                    <h3 class="no-margin">@(Model.UpcomingHolidays.Any() ? Model.UpcomingHolidays.First().Date.ToString("dd MMM") : "N/A")</h3>
                    <span class="text-uppercase text-size-mini">
                        @(Model.UpcomingHolidays.Any() ? Model.UpcomingHolidays.First().Name : "No upcoming holiday")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Tasks -->
    <div class="col-md-3">
        <div class="panel panel-body bg-pink-400">
            <div class="media no-margin">
                <div class="media-left media-middle">
                    <i class="icon-checkmark-circle icon-3x opacity-75"></i>
                </div>
                <div class="media-body text-right">
                    <h3 class="no-margin">@Model.PendingTaskCount</h3>
                    <span class="text-uppercase text-size-mini">
                        Pending Tasks
                    </span>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="row">
    <!-- Leave Balance -->
    <div class="col-md-4">
        <div class="panel panel-flat">
            <div class="panel-heading">
                <h6 class="panel-title"><i class="icon-list position-left"></i> My Leave Balance</h6>
                <div class="heading-elements">
                    <span class="badge bg-blue">@Model.TotalLeaveBalance.ToString("0.#")</span>
                </div>
            </div>
            <table class="table table-striped">
                <thead><tr><th>Leave Type</th><th class="text-right">Available</th></tr></thead>
                <tbody>
                    @if (Model.LeaveBalances.Any())
                    {
                        foreach (var b in Model.LeaveBalances)
                        {
                            <tr>
                                <td>
                                    <span class="label @LeaveChip(b.LeaveTypeName)" style="min-width:34px;display:inline-block;text-align:center;">@LeaveCode(b.LeaveTypeName)</span>
                                    <span class="position-left">@b.LeaveTypeName</span>
                                </td>
                                <td class="text-right"><strong>@b.Balance.ToString("0.#")</strong></td>
                            </tr>
                        }
                    }
                    else { <tr><td colspan="2" class="text-muted text-center">No leave balance.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Recent Payslip -->
    <div class="col-md-4">
        <div class="panel panel-flat">
            <div class="panel-heading"><h6 class="panel-title"><i class="icon-coins position-left"></i> Recent Payslip</h6></div>
            <div class="panel-body text-center">
                @if (Model.RecentPayslip != null)
                {
                    <h6 class="text-muted no-margin">@Model.RecentPayslip.MonthName @Model.RecentPayslip.Year</h6>
                    <h3 class="text-success">₹ @Model.RecentPayslip.NetSalary.ToString("N2")</h3>
                    <span class="text-muted">Net Salary · @Model.RecentPayslip.Status</span>
                    <div class="text-muted text-size-small">Pay date: @Model.RecentPayslip.PayDate.ToString("dd MMM yyyy")</div>
                }
                else { <p class="text-muted" style="padding:20px;">No payslip yet.</p> }
            </div>
        </div>
    </div>

    <!-- Week attendance -->
    <div class="col-md-4">
        <div class="panel panel-flat">
            <div class="panel-heading"><h6 class="panel-title"><i class="icon-calendar2 position-left"></i> My Attendance (This Week)</h6></div>
            <div class="panel-body">
                <div class="row text-center">
                    @foreach (var d in Model.WeekAttendance)
                    {
                        <div class="col-xs-1" style="width:14.28%;padding:2px;">
                            <div class="text-muted text-size-mini">@d.DayName</div>
                            <div class="@DayColor(d.Status)" title="@d.Status"
                                 style="height:26px;border-radius:4px;margin-top:3px;"></div>
                        </div>
                    }
                </div>
                <hr />
                <div class="text-muted text-size-small">
                    <span class="text-success">●</span> Present &nbsp;
                    <span class="text-warning">●</span> Half Day &nbsp;
                    <span class="text-danger">●</span> Absent
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Upcoming Events -->
    <div class="col-md-4">
        <div class="panel panel-flat">
            <div class="panel-heading">
                <h6 class="panel-title"><i class="icon-calendar3 position-left"></i> Upcoming Events</h6>
                <div class="heading-elements">
                    <span class="badge bg-primary">@Model.UpcomingEvents.Count</span>
                    <a asp-controller="Event" asp-action="Index" class="text-size-small">View All</a>
                </div>
            </div>
            <div class="panel-body">
                <ul class="media-list">
                    @if (Model.UpcomingEvents.Any())
                    {
                        foreach (var e in Model.UpcomingEvents)
                        {
                            <li class="media" style="padding:6px 0;">
                                <div class="media-body">
                                    <strong>@e.Title</strong>
                                    <div class="text-muted text-size-small">@e.StartDate.ToString("dd MMM yyyy") @(string.IsNullOrEmpty(e.Location) ? "" : "· " + e.Location)</div>
                                </div>
                            </li>
                        }
                    }
                    else { <li class="text-muted">No upcoming events.</li> }
                </ul>
            </div>
        </div>
    </div>

    <!-- Announcements -->
    <div class="col-md-4">
        <div class="panel panel-flat">
            <div class="panel-heading">
                <h6 class="panel-title"><i class="icon-bullhorn position-left"></i> Company Announcements</h6>
                <div class="heading-elements">
                    <span class="badge bg-warning">@Model.Announcements.Count</span>
                    <a asp-controller="Announcement" asp-action="Index" class="text-size-small">View All</a>
                </div>
            </div>
            <div class="panel-body">
                <ul class="media-list">
                    @if (Model.Announcements.Any())
                    {
                        foreach (var a in Model.Announcements)
                        {
                            <li class="media" style="padding:6px 0;">
                                <div class="media-body">
                                    <strong>@a.Title</strong>
                                    <div class="text-muted text-size-small">@a.PublishDate.ToString("dd MMM yyyy")</div>
                                </div>
                            </li>
                        }
                    }
                    else { <li class="text-muted">No announcements.</li> }
                </ul>
            </div>
        </div>
    </div>

    <!-- Quick Links -->
    <div class="col-md-4">
        <div class="panel panel-flat">
            <div class="panel-heading"><h6 class="panel-title"><i class="icon-grid position-left"></i> Quick Links</h6></div>
            <div class="panel-body">
                <div class="row text-center">
                    <div class="col-xs-4" style="margin-bottom:12px;">
                        <a asp-controller="Attendance" asp-action="Create"><i class="icon-alarm icon-2x text-primary"></i><div class="text-size-small">Punch In/Out</div></a>
                    </div>
                    <div class="col-xs-4" style="margin-bottom:12px;">
                        <a asp-controller="LeaveApplication" asp-action="Create"><i class="icon-calendar2 icon-2x text-primary"></i><div class="text-size-small">Apply Leave</div></a>
                    </div>
                    <div class="col-xs-4" style="margin-bottom:12px;">
                        <a asp-controller="Employee" asp-action="Details" asp-route-id="@Model.EmployeeId"><i class="icon-user icon-2x text-primary"></i><div class="text-size-small">My Profile</div></a>
                    </div>
                    <div class="col-xs-4" style="margin-bottom:12px;">
                        <a asp-controller="Payroll" asp-action="MyPayslips"><i class="icon-cash3 icon-2x text-primary"></i><div class="text-size-small">Payslip</div></a>
                    </div>
                    <div class="col-xs-4">
                        <a asp-controller="EmployeeDocument" asp-action="MyDocuments"><i class="icon-folder icon-2x text-primary"></i><div class="text-size-small">Documents</div></a>
                    </div>
                    <div class="col-xs-4">
                        <a asp-controller="EmployeeTask" asp-action="MyTasks"><i class="icon-checkmark-circle icon-2x text-primary"></i><div class="text-size-small">Tasks</div></a>
                    </div>
                    <div class="col-xs-4">
                        <a asp-controller="Notification" asp-action="Index"><i class="icon-bell2 icon-2x text-primary"></i><div class="text-size-small">Notifications</div></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Upcoming Holidays -->
    <div class="col-md-12">
        <div class="panel panel-flat">
            <div class="panel-heading">
                <h6 class="panel-title"><i class="icon-gift position-left"></i> Upcoming Holidays</h6>
                <div class="heading-elements">
                    <span class="badge bg-indigo">@Model.UpcomingHolidays.Count</span>
                </div>
            </div>
            <div class="panel-body">
                @if (Model.UpcomingHolidays.Any())
                {
                    <div class="row text-center">
                        @foreach (var h in Model.UpcomingHolidays)
                        {
                            <div class="col-sm-2 col-xs-4" style="margin-bottom:12px;">
                                <div class="text-size-small text-muted">@h.Date.ToString("dddd")</div>
                                <div class="text-size-large text-bold text-indigo-400">@h.Date.ToString("dd MMM")</div>
                                <div class="text-size-small">@h.Name</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted text-center" style="padding:10px 0;">No upcoming holidays.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Charts -->
<div class="row">
    <div class="col-md-7">
        <div class="panel panel-flat">
            <div class="panel-heading"><h6 class="panel-title"><i class="icon-stats-bars position-left"></i> Attendance Trend (6 months)</h6></div>
            <div class="panel-body"><div id="attTrend" style="height:260px;"></div></div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="panel panel-flat">
            <div class="panel-heading"><h6 class="panel-title"><i class="icon-pie-chart3 position-left"></i> Leave Utilization</h6></div>
            <div class="panel-body"><div id="leavePie" style="height:260px;"></div></div>
        </div>
    </div>
</div>

<!-- My Tasks -->
<div class="panel panel-flat">
    <div class="panel-heading">
        <h6 class="panel-title"><i class="icon-checkmark-circle position-left"></i> My Tasks</h6>
        <div class="heading-elements">
            <span class="badge bg-pink">@Model.PendingTaskCount</span>
            <a asp-controller="EmployeeTask" asp-action="MyTasks" class="text-size-small">View All</a>
        </div>
    </div>
    <table class="table table-striped">
        <thead><tr><th>Task</th><th>Due Date</th><th>Priority</th><th>Status</th></tr></thead>
        <tbody>
            @if (Model.MyTasks.Any())
            {
                foreach (var t in Model.MyTasks)
                {
                    <tr>
                        <td><strong>@t.Title</strong></td>
                        <td>@(t.DueDate?.ToString("dd MMM yyyy") ?? "-")</td>
                        <td><span class="label @(t.Priority == "High" ? "bg-danger" : t.Priority == "Low" ? "bg-info" : "bg-warning")">@t.Priority</span></td>
                        <td><span class="label @(t.Status == "InProgress" ? "bg-primary" : "bg-warning")">@t.Status</span></td>
                    </tr>
                }
            }
            else { <tr><td colspan="4" class="text-muted text-center" style="padding:20px;">No pending tasks.</td></tr> }
        </tbody>
    </table>
</div>

<!-- Birthdays / Anniversaries / Pending Leaves / Activity -->
<div class="row">
    <div class="col-md-3">
        <div class="panel panel-flat">
            <div class="panel-heading"><h6 class="panel-title"><i class="icon-cake position-left"></i> Birthdays</h6></div>
            <div class="panel-body">
                <ul class="media-list">
                    @if (Model.Birthdays.Any())
                    {
                        foreach (var b in Model.Birthdays)
                        {
                            <li class="media" style="padding:5px 0;"><div class="media-body"><strong>@b.Name</strong><div class="text-muted text-size-small">@b.Date.ToString("dd MMM") · @b.DepartmentName</div></div></li>
                        }
                    }
                    else { <li class="text-muted">None this month.</li> }
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="panel panel-flat">
            <div class="panel-heading"><h6 class="panel-title"><i class="icon-trophy2 position-left"></i> Work Anniversaries</h6></div>
            <div class="panel-body">
                <ul class="media-list">
                    @if (Model.WorkAnniversaries.Any())
                    {
                        foreach (var w in Model.WorkAnniversaries)
                        {
                            <li class="media" style="padding:5px 0;"><div class="media-body"><strong>@w.Name</strong><div class="text-muted text-size-small">@w.Years yr(s) · @w.Date.ToString("dd MMM")</div></div></li>
                        }
                    }
                    else { <li class="text-muted">None this month.</li> }
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="panel panel-flat">
            <div class="panel-heading">
                <h6 class="panel-title"><i class="icon-calendar2 position-left"></i> Pending Leave Requests</h6>
                <div class="heading-elements">
                    <span class="badge bg-warning">@Model.PendingLeaveRequests.Count</span>
                </div>
            </div>
            <div class="panel-body">
                <ul class="media-list">
                    @if (Model.PendingLeaveRequests.Any())
                    {
                        foreach (var l in Model.PendingLeaveRequests)
                        {
                            <li class="media" style="padding:5px 0;"><div class="media-body"><strong>@l.LeaveTypeName</strong><div class="text-muted text-size-small">@l.FromDate.ToString("dd MMM") - @l.ToDate.ToString("dd MMM") · @l.TotalDays.ToString("0.#")d</div></div></li>
                        }
                    }
                    else { <li class="text-muted">No pending requests.</li> }
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="panel panel-flat">
            <div class="panel-heading"><h6 class="panel-title"><i class="icon-history position-left"></i> Recent Activity</h6></div>
            <div class="panel-body">
                <ul class="media-list">
                    @if (Model.RecentActivity.Any())
                    {
                        foreach (var r in Model.RecentActivity)
                        {
                            <li class="media" style="padding:5px 0;"><div class="media-body">@r.Text<div class="text-muted text-size-small">@r.Date.ToString("dd MMM yyyy")</div></div></li>
                        }
                    }
                    else { <li class="text-muted">No recent activity.</li> }
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/global_assets/js/plugins/visualization/echarts/echarts.min.js"></script>
    <script>
        $(function () {
            if (typeof echarts !== 'undefined') {
                var t = document.getElementById('attTrend');
                if (t) {
                    var c1 = echarts.init(t);
                    c1.setOption({
                        tooltip: { trigger: 'axis' },
                        grid: { left: '3%', right: '4%', bottom: '3%', containLabel: true },
                        xAxis: { type: 'category', data: [@Html.Raw(trendLabels)] },
                        yAxis: { type: 'value' },
                        series: [{ type: 'bar', barWidth: '50%', itemStyle: { color: '#26A69A' }, data: [@Html.Raw(trendValues)] }]
                    });
                    window.addEventListener('resize', function () { c1.resize(); });
                }
                var p = document.getElementById('leavePie');
                if (p) {
                    var c2 = echarts.init(p);
                    var pieData = [@Html.Raw(leaveData)];
                    c2.setOption({
                        tooltip: { trigger: 'item' },
                        series: [{
                            type: 'pie', radius: ['45%', '70%'],
                            data: pieData.length ? pieData : [{ value: 1, name: 'No leave used' }],
                            label: { formatter: '{b}: {c}' }
                        }]
                    });
                    window.addEventListener('resize', function () { c2.resize(); });
                }
            }
        });
    </script>
}
