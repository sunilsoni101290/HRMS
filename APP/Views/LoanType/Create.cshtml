@model LoanTypeDto
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var isEdit = !string.IsNullOrEmpty(Model.Id);
    ViewData["Title"] = isEdit ? "Edit Loan Type" : "New Loan Type";
}

<div class="panel panel-flat">

    <div class="panel-heading">
        <h5 class="panel-title">
            <i class="bi bi-tags-fill position-left"></i>
            @ViewData["Title"]
        </h5>
        <div class="heading-elements">
            <a asp-action="Index" class="btn btn-default">
                <i class="icon-arrow-left13"></i>
                Back
            </a>
        </div>
    </div>

    <div class="panel-body">

        <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row">

                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="Code"></label>
                        <input asp-for="Code" class="form-control" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="form-group">
                        <label asp-for="Name"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="InterestMethod"></label>
                        <select asp-for="InterestMethod" class="form-control">
                            @if (ViewBag.InterestMethodList is List<SelectListItem> imList)
                            {
                                foreach (var item in imList)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="InterestMethod" class="text-danger"></span>
                    </div>
                </div>

            </div>

            <div class="row">

                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="DefaultInterestRatePercent"></label>
                        <input asp-for="DefaultInterestRatePercent" class="form-control" />
                        <span asp-validation-for="DefaultInterestRatePercent" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="MaxTenureMonths"></label>
                        <input asp-for="MaxTenureMonths" class="form-control" />
                        <span asp-validation-for="MaxTenureMonths" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label>&nbsp;</label>
                        <div>
                            <label class="checkbox-inline"><input asp-for="RequiresGuarantor" /> Requires Guarantor</label>
                            <label class="checkbox-inline"><input asp-for="RequiresCollateral" /> Requires Collateral</label>
                        </div>
                    </div>
                </div>

            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="Description"></label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>
            </div>

            @if (isEdit)
            {
                <div class="form-group">
                    <label class="checkbox-inline"><input asp-for="IsActive" /> Active</label>
                </div>
            }

            <input type="hidden" asp-for="Id" />

            <div class="text-right">
                <button type="submit" class="btn btn-primary">
                    <i class="icon-checkmark3"></i>
                    Save
                </button>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
