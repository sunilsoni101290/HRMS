@model APP.Excel.ExcelImportResult

@{
    ViewData["Title"] = "Import Employee Biometric Mappings";
}

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">
            <i class="icon-file-spreadsheet position-left"></i>
            Import Employee Biometric Mappings
        </h5>

        <div class="heading-elements">

            <a asp-action="Bulk" class="btn btn-default">
                <i class="icon-arrow-left13"></i>
                Back to Bulk Mapping
            </a>

        </div>

    </div>

    <div class="panel-body">

        <div class="alert alert-info alert-styled-left">
            <span class="text-semibold">How this works:</span>
            <ol class="no-margin-bottom" style="padding-left:18px;margin-top:6px;">
                <li>Download the template below.</li>
                <li>Fill in one row per employee - Employee Code and Biometric Employee Code are required.</li>
                <li>Upload the completed file. An existing mapping for that employee is updated; otherwise a new one is created. Each row is validated and imported independently, so a mistake in one row won't block the rest.</li>
            </ol>
        </div>

        <a asp-action="DownloadImportTemplate" class="btn bg-success mb-15">
            <i class="icon-file-download"></i>
            Download Excel Template
        </a>

        <form asp-action="Import" method="post" enctype="multipart/form-data">

            <div class="form-group">

                <label class="text-semibold">Select Excel File</label>

                <input type="file"
                       name="file"
                       accept=".xlsx,.xls"
                       class="form-control"
                       required />

            </div>

            <button type="submit" class="btn bg-primary">
                <i class="icon-upload3"></i>
                Upload &amp; Import
            </button>

        </form>

        <partial name="_ExcelImportResult" model="Model" />

    </div>

</div>

@section Scripts {

    @if (TempData["Success"] != null)
    {
        <script>
            $(function () {
                swal({ title: "Success", text: @Html.Raw(Json.Serialize(TempData["Success"])), type: "success" });
            });
        </script>
    }

    @if (TempData["Info"] != null)
    {
        <script>
            $(function () {
                swal({ title: "Import Finished", text: @Html.Raw(Json.Serialize(TempData["Info"])), type: "info" });
            });
        </script>
    }

    @if (TempData["GlobalError"] != null)
    {
        <script>
            $(function () {
                swal({ title: "Error", text: @Html.Raw(Json.Serialize(TempData["GlobalError"])), type: "error" });
            });
        </script>
    }

}
