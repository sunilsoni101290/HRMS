@model LeaveTypeDto

@{
    ViewData["Title"] = "Add Leave Type";
}

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-calendar52 position-left"></i>

            @(string.IsNullOrEmpty(Model.Id)
                ? "Create Leave Type"
                : "Edit Leave Type")

        </h5>

    </div>

    <div class="panel-body">

        <form asp-action="@(Model.Id == null ? "Create" : "Edit")" method="post">

            <input asp-for="Id" type="hidden" />

            <fieldset>

                <legend class="text-semibold">

                    Leave Information

                </legend>

                <div class="row">

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="Name"></label>

                            <input asp-for="Name"
                                   class="form-control" />

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="MaxDaysPerYear"></label>

                            <input asp-for="MaxDaysPerYear"
                                   class="form-control"
                                   type="number" />

                        </div>

                    </div>

                </div>

            </fieldset>

            <fieldset>

                <legend class="text-semibold">

                    Leave Rules

                </legend>

                <div class="row">

                    <div class="col-md-4">

                        <div class="checkbox">

                            <label>
                                <input asp-for="IsPaid" />
                                Paid Leave
                            </label>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="checkbox">

                            <label>
                                <input asp-for="AllowCarryForward"
                                       id="AllowCarryForward" />
                                Allow Carry Forward
                            </label>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="checkbox">

                            <label>
                                <input asp-for="AllowHalfDay" />
                                Allow Half Day
                            </label>

                        </div>

                    </div>

                </div>

                <div class="row"
                     id="carryForwardPanel">

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="MaxCarryForwardDays"></label>

                            <input asp-for="MaxCarryForwardDays"
                                   type="number"
                                   class="form-control" />

                        </div>

                    </div>

                </div>

            </fieldset>

            <fieldset>

                <legend class="text-semibold">
                    <i class="icon-clock position-left"></i>
                    Eligibility &amp; Accrual
                </legend>

                <div class="row">

                    <div class="col-md-4">

                        <div class="form-group">

                            <label asp-for="MinServiceDaysRequired"></label>

                            <input asp-for="MinServiceDaysRequired"
                                   type="number"
                                   min="0"
                                   class="form-control" />

                            <span class="help-block">
                                Minimum days of service before an employee becomes eligible for this leave type. 0 = eligible from day one.
                            </span>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="form-group">

                            <label asp-for="AccrualFrequency"></label>

                            <select asp-for="AccrualFrequency"
                                    asp-items="Html.GetEnumSelectList<EnumExtensions.LeaveAccrualFrequency>()"
                                    id="AccrualFrequency"
                                    class="form-control">
                            </select>

                        </div>

                    </div>

                    <div class="col-md-4"
                         id="accrualDaysPanel">

                        <div class="form-group">

                            <label asp-for="AccrualDaysPerCycle"></label>

                            <input asp-for="AccrualDaysPerCycle"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control" />

                            <span class="help-block">
                                Days credited per accrual cycle - only meaningful when Accrual Frequency isn't "None".
                            </span>

                        </div>

                    </div>

                </div>

            </fieldset>

            <fieldset>

                <legend class="text-semibold">
                    <i class="icon-cash3 position-left"></i>
                    Encashment &amp; Applicability
                </legend>

                <div class="row">

                    <div class="col-md-4">

                        <div class="checkbox">

                            <label>
                                <input asp-for="IsEncashable"
                                       id="IsEncashable" />
                                Is Encashable
                            </label>

                        </div>

                    </div>

                    <div class="col-md-4"
                         id="encashableDaysPanel">

                        <div class="form-group">

                            <label asp-for="MaxEncashableDays"></label>

                            <input asp-for="MaxEncashableDays"
                                   type="number"
                                   min="0"
                                   class="form-control" />

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="form-group">

                            <label asp-for="ApplicableGender"></label>

                            <select asp-for="ApplicableGender"
                                    asp-items="Html.GetEnumSelectList<EnumExtensions.LeaveApplicableGender>()"
                                    class="form-control">
                            </select>

                        </div>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-12">

                        <div class="checkbox">

                            <label>
                                <input asp-for="IsRestrictedHolidayType" />
                                Is Restricted Holiday Type
                            </label>

                        </div>

                        <span class="help-block">
                            Marks this as the special Restricted Holiday leave type - only one should typically be marked this way.
                        </span>

                    </div>

                </div>

            </fieldset>

            <div class="text-right">

                <a asp-action="Index"
                   class="btn btn-default">

                    Back

                </a>

                <button type="submit"
                        class="btn bg-primary">

                    @(string.IsNullOrEmpty(Model?.Id)
                                    ? "Save"
                                    : "Update")

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <script>

        $(function () {

            // Accrual Days Per Cycle is only meaningful when Accrual
            // Frequency isn't "None" - purely a display nicety, the field
            // still posts/validates normally either way.
            function toggleAccrualDaysPanel() {

                var isNone = $("#AccrualFrequency").val() === "@((int)EnumExtensions.LeaveAccrualFrequency.None)";

                $("#accrualDaysPanel").toggle(!isNone);

            }

            // Max Encashable Days is only meaningful when Is Encashable is
            // checked.
            function toggleEncashableDaysPanel() {

                $("#encashableDaysPanel").toggle($("#IsEncashable").is(":checked"));

            }

            toggleAccrualDaysPanel();
            toggleEncashableDaysPanel();

            $("#AccrualFrequency").on("change", toggleAccrualDaysPanel);
            $("#IsEncashable").on("change", toggleEncashableDaysPanel);

        });

    </script>

}
