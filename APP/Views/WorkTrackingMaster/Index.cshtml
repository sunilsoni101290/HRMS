@using APP.Models.DTOs
@{
    ViewData["Title"] = "Daily Work Entry - Masters";
    var clients = (List<ClientDto>)ViewBag.Clients;
    var jobs = (List<WorkJobDto>)ViewBag.Jobs;
    var jobTypes = (List<JobTypeDto>)ViewBag.JobTypes;
    var reasons = (List<WorkEntryReasonDto>)ViewBag.Reasons;
    var docStatuses = (List<DocumentStatusDto>)ViewBag.DocumentStatuses;
}

<div class="panel panel-flat">
    <div class="panel-heading">
        <h5 class="panel-title"><i class="icon-cog3 position-left"></i> Daily Work Entry - Master Data</h5>
    </div>
    <div class="panel-body">
        <ul class="nav nav-tabs">
            <li class="active"><a href="#tab-clients" data-toggle="tab">Clients</a></li>
            <li><a href="#tab-jobs" data-toggle="tab">Jobs</a></li>
            <li><a href="#tab-jobitems" data-toggle="tab">Job Items</a></li>
            <li><a href="#tab-jobtypes" data-toggle="tab">Job Types</a></li>
            <li><a href="#tab-activities" data-toggle="tab">Work Activities</a></li>
            <li><a href="#tab-reasons" data-toggle="tab">Idle / Downtime Reasons</a></li>
            <li><a href="#tab-docstatus" data-toggle="tab">Document Status</a></li>
        </ul>

        <div class="tab-content" style="margin-top:15px;">

            <!-- CLIENTS -->
            <div class="tab-pane active" id="tab-clients">
                <button class="btn btn-primary btn-sm" onclick="openModal('client')"><i class="icon-plus3 position-left"></i> Add Client</button>
                <table class="table table-bordered" style="margin-top:10px;">
                    <thead><tr><th>Name</th><th>Code</th><th>Active</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var c in clients)
                        {
                            <tr>
                                <td>@c.Name</td><td>@c.Code</td><td>@(c.IsActive ? "Yes" : "No")</td>
                                <td><button class="btn btn-xs btn-link" onclick='openModal("client", @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(c)))'>Edit</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- JOBS -->
            <div class="tab-pane" id="tab-jobs">
                <button class="btn btn-primary btn-sm" onclick="openModal('job')"><i class="icon-plus3 position-left"></i> Add Job</button>
                <table class="table table-bordered" style="margin-top:10px;">
                    <thead><tr><th>Job Number</th><th>Job Name</th><th>Client</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var j in jobs)
                        {
                            <tr>
                                <td>@j.JobNumber</td><td>@j.JobName</td><td>@j.ClientName</td><td>@j.StatusName</td>
                                <td><button class="btn btn-xs btn-link" onclick='openModal("job", @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(j)))'>Edit</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- JOB ITEMS -->
            <div class="tab-pane" id="tab-jobitems">
                <div class="form-inline" style="margin-bottom:10px;">
                    <label>Job:</label>
                    <select id="jobItemJobFilter" class="form-control" style="width:250px;">
                        <option value="">-- Select Job --</option>
                        @foreach (var j in jobs)
                        {
                            <option value="@j.Id">@j.JobNumber - @j.JobName</option>
                        }
                    </select>
                    <button class="btn btn-primary btn-sm" onclick="openJobItemModal()"><i class="icon-plus3 position-left"></i> Add Job Item</button>
                </div>
                <table class="table table-bordered">
                    <thead><tr><th>Code</th><th>Type</th><th>Weight (MT)</th><th>Document Status</th><th></th></tr></thead>
                    <tbody id="jobItemsBody"><tr><td colspan="5" class="text-center text-muted">Select a job to view its items.</td></tr></tbody>
                </table>
            </div>

            <!-- JOB TYPES -->
            <div class="tab-pane" id="tab-jobtypes">
                <button class="btn btn-primary btn-sm" onclick="openModal('jobtype')"><i class="icon-plus3 position-left"></i> Add Job Type</button>
                <table class="table table-bordered" style="margin-top:10px;">
                    <thead><tr><th>Name</th><th>Order</th><th>Has Disciplines</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var jt in jobTypes)
                        {
                            <tr>
                                <td>@jt.Name</td><td>@jt.DisplayOrder</td><td>@(jt.HasDisciplines ? "Yes" : "No")</td>
                                <td><button class="btn btn-xs btn-link" onclick='openModal("jobtype", @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(jt)))'>Edit</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- WORK ACTIVITIES -->
            <div class="tab-pane" id="tab-activities">
                <div class="form-inline" style="margin-bottom:10px;">
                    <label>Job Type:</label>
                    <select id="activityJobTypeFilter" class="form-control" style="width:250px;">
                        <option value="">-- Select Job Type --</option>
                        @foreach (var jt in jobTypes)
                        {
                            <option value="@jt.Id">@jt.Name</option>
                        }
                    </select>
                    <button class="btn btn-primary btn-sm" onclick="openActivityModal()"><i class="icon-plus3 position-left"></i> Add Activity</button>
                </div>
                <table class="table table-bordered">
                    <thead><tr><th>Name</th><th>Category</th><th>Discipline</th><th>Order</th><th></th></tr></thead>
                    <tbody id="activitiesBody"><tr><td colspan="5" class="text-center text-muted">Select a job type to view its activities.</td></tr></tbody>
                </table>
            </div>

            <!-- REASONS -->
            <div class="tab-pane" id="tab-reasons">
                <button class="btn btn-primary btn-sm" onclick="openModal('reason')"><i class="icon-plus3 position-left"></i> Add Reason</button>
                <table class="table table-bordered" style="margin-top:10px;">
                    <thead><tr><th>Category</th><th>Name</th><th>Order</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var r in reasons)
                        {
                            <tr>
                                <td>@r.CategoryName</td><td>@r.Name</td><td>@r.DisplayOrder</td>
                                <td><button class="btn btn-xs btn-link" onclick='openModal("reason", @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(r)))'>Edit</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- DOCUMENT STATUS -->
            <div class="tab-pane" id="tab-docstatus">
                <button class="btn btn-primary btn-sm" onclick="openModal('docstatus')"><i class="icon-plus3 position-left"></i> Add Document Status</button>
                <table class="table table-bordered" style="margin-top:10px;">
                    <thead><tr><th>Code</th><th>Display Name</th><th>Order</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var d in docStatuses)
                        {
                            <tr>
                                <td>@d.Code</td><td>@d.DisplayName</td><td>@d.DisplayOrder</td>
                                <td><button class="btn btn-xs btn-link" onclick='openModal("docstatus", @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(d)))'>Edit</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Generic modal (fields shown/hidden per master type) -->
<div class="modal fade" id="masterModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h5 class="modal-title" id="masterModalTitle">Add</h5>
            </div>
            <div class="modal-body">
                <form id="masterForm">
                    <input type="hidden" id="m_id" />
                    <input type="hidden" id="m_type" />

                    <div class="form-group m-field" data-for="client,jobtype,reason,docstatus" style="display:none;">
                        <label>Name / Display Name</label>
                        <input type="text" id="m_name" class="form-control" />
                    </div>
                    <div class="form-group m-field" data-for="client,jobtype,docstatus" style="display:none;">
                        <label>Code</label>
                        <input type="text" id="m_code" class="form-control" />
                    </div>
                    <div class="form-group m-field" data-for="job" style="display:none;">
                        <label>Job Number</label>
                        <input type="text" id="m_jobNumber" class="form-control" />
                    </div>
                    <div class="form-group m-field" data-for="job" style="display:none;">
                        <label>Job Name</label>
                        <input type="text" id="m_jobName" class="form-control" />
                    </div>
                    <div class="form-group m-field" data-for="job" style="display:none;">
                        <label>Client</label>
                        <select id="m_clientId" class="form-control">
                            @foreach (var c in clients)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group m-field" data-for="job,jobitem" style="display:none;">
                        <label>Status</label>
                        <select id="m_status" class="form-control">
                            <option value="1">Active</option>
                            <option value="2">On Hold</option>
                            <option value="3">Closed</option>
                        </select>
                    </div>
                    <div class="form-group m-field" data-for="jobitem" style="display:none;">
                        <label>Item Code (STR/EQPT/JOB ID)</label>
                        <input type="text" id="m_itemCode" class="form-control" />
                    </div>
                    <div class="form-group m-field" data-for="jobitem" style="display:none;">
                        <label>Item Type</label>
                        <select id="m_itemType" class="form-control">
                            <option value="1">Structure</option>
                            <option value="2">Equipment</option>
                            <option value="3">Other</option>
                        </select>
                    </div>
                    <div class="form-group m-field" data-for="jobitem" style="display:none;">
                        <label>Total Weight (MT) - structural only</label>
                        <input type="number" id="m_weight" class="form-control" step="0.01" />
                    </div>
                    <div class="form-group m-field" data-for="jobitem" style="display:none;">
                        <label>Document Status</label>
                        <select id="m_docStatusId" class="form-control">
                            <option value="">-- None --</option>
                            @foreach (var d in docStatuses)
                            {
                                <option value="@d.Id">@d.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="form-group m-field" data-for="jobtype" style="display:none;">
                        <label>Display Order</label>
                        <input type="number" id="m_displayOrder" class="form-control" />
                    </div>
                    <div class="form-group m-field" data-for="jobtype" style="display:none;">
                        <label><input type="checkbox" id="m_hasDisciplines" /> Has Disciplines (e.g. Skids Packages)</label>
                    </div>
                    <div class="form-group m-field" data-for="activity" style="display:none;">
                        <label>Activity Name</label>
                        <input type="text" id="m_activityName" class="form-control" />
                    </div>
                    <div class="form-group m-field" data-for="activity" style="display:none;">
                        <label>Work Category</label>
                        <select id="m_workCategory" class="form-control">
                            <option value="1">Direct</option>
                            <option value="2">Indirect</option>
                            <option value="3">Idle</option>
                            <option value="4">Downtime</option>
                        </select>
                    </div>
                    <div class="form-group m-field" data-for="activity" style="display:none;">
                        <label>Skids Discipline (only if Job Type has disciplines)</label>
                        <select id="m_skidsDiscipline" class="form-control">
                            <option value="">-- None --</option>
                            <option value="1">Piping</option>
                            <option value="2">Equipment</option>
                            <option value="3">Structural</option>
                            <option value="4">E&amp;I</option>
                        </select>
                    </div>
                    <div class="form-group m-field" data-for="reason" style="display:none;">
                        <label>Category</label>
                        <select id="m_reasonCategory" class="form-control">
                            <option value="1">Idle</option>
                            <option value="2">Downtime</option>
                        </select>
                    </div>
                    <div class="form-group m-field" data-for="reason,activity" style="display:none;">
                        <label>Display Order</label>
                        <input type="number" id="m_order2" class="form-control" />
                    </div>
                    <div class="form-group m-field" data-for="docstatus" style="display:none;">
                        <label>Display Order</label>
                        <input type="number" id="m_order3" class="form-control" />
                    </div>
                    <div class="checkbox">
                        <label><input type="checkbox" id="m_isActive" checked /> Active</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn bg-primary" id="masterSaveBtn">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/global_assets/js/plugins/notifications/sweet_alert.min.js"></script>
    <script>
        function showFields(type) {
            $(".m-field").hide();
            $(".m-field[data-for*='" + type + "']").show();
        }

        function resetModal() {
            $("#masterForm")[0].reset();
            $("#m_id").val(""); $("#m_isActive").prop("checked", true);
        }

        function openModal(type, data) {
            resetModal();
            $("#m_type").val(type);
            showFields(type);
            $("#masterModalTitle").text((data ? "Edit " : "Add ") + type);

            if (data) {
                $("#m_id").val(data.id);
                $("#m_isActive").prop("checked", data.isActive);
                if (type === "client") { $("#m_name").val(data.name); $("#m_code").val(data.code); }
                if (type === "jobtype") { $("#m_name").val(data.name); $("#m_code").val(data.code); $("#m_displayOrder").val(data.displayOrder); $("#m_hasDisciplines").prop("checked", data.hasDisciplines); }
                if (type === "job") { $("#m_jobNumber").val(data.jobNumber); $("#m_jobName").val(data.jobName); $("#m_clientId").val(data.clientId); $("#m_status").val(data.status); }
                if (type === "reason") { $("#m_name").val(data.name); $("#m_reasonCategory").val(data.category); $("#m_order2").val(data.displayOrder); }
                if (type === "docstatus") { $("#m_name").val(data.displayName); $("#m_code").val(data.code); $("#m_order3").val(data.displayOrder); }
            }

            $("#masterModal").modal("show");
        }

        function openJobItemModal(data) {
            var jobId = $("#jobItemJobFilter").val();
            if (!jobId && !data) { swal("Select a Job", "Please select a job first.", "warning"); return; }

            resetModal();
            $("#m_type").val("jobitem");
            showFields("jobitem");
            $("#masterModalTitle").text(data ? "Edit Job Item" : "Add Job Item");
            $("#masterModal").data("jobId", data ? data.workJobId : jobId);

            if (data) {
                $("#m_id").val(data.id);
                $("#m_itemCode").val(data.code);
                $("#m_itemType").val(data.itemType);
                $("#m_weight").val(data.totalWeightMT);
                $("#m_docStatusId").val(data.documentStatusId || "");
                $("#m_isActive").prop("checked", data.isActive);
            }

            $("#masterModal").modal("show");
        }

        function openActivityModal(data) {
            var jobTypeId = $("#activityJobTypeFilter").val();
            if (!jobTypeId && !data) { swal("Select a Job Type", "Please select a job type first.", "warning"); return; }

            resetModal();
            $("#m_type").val("activity");
            showFields("activity");
            $("#masterModalTitle").text(data ? "Edit Activity" : "Add Activity");
            $("#masterModal").data("jobTypeId", data ? data.jobTypeId : jobTypeId);

            if (data) {
                $("#m_id").val(data.id);
                $("#m_activityName").val(data.name);
                $("#m_workCategory").val(data.workCategory);
                $("#m_skidsDiscipline").val(data.skidsDiscipline || "");
                $("#m_order2").val(data.displayOrder);
                $("#m_isActive").prop("checked", data.isActive);
            }

            $("#masterModal").modal("show");
        }

        $("#jobItemJobFilter").on("change", function () {
            var jobId = $(this).val();
            if (!jobId) { $("#jobItemsBody").html('<tr><td colspan="5" class="text-center text-muted">Select a job to view its items.</td></tr>'); return; }

            $.get("@Url.Action("GetJobItems")", { jobId: jobId }, function (res) {
                var rows = (res.data || []).map(function (d) {
                    return "<tr><td>" + d.code + "</td><td>" + (d.itemTypeName || "") + "</td><td>" + (d.totalWeightMT || "-") + "</td><td>" + (d.documentStatusName || "-") +
                        "</td><td><button class='btn btn-xs btn-link' onclick='openJobItemModal(" + JSON.stringify(d).replace(/'/g, "&#39;") + ")'>Edit</button></td></tr>";
                }).join("");
                $("#jobItemsBody").html(rows || '<tr><td colspan="5" class="text-center text-muted">No items yet.</td></tr>');
            });
        });

        $("#activityJobTypeFilter").on("change", function () {
            var jobTypeId = $(this).val();
            if (!jobTypeId) { $("#activitiesBody").html('<tr><td colspan="5" class="text-center text-muted">Select a job type to view its activities.</td></tr>'); return; }

            $.get("@Url.Action("GetWorkActivities")", { jobTypeId: jobTypeId }, function (res) {
                var rows = (res.data || []).map(function (d) {
                    return "<tr><td>" + d.name + "</td><td>" + (d.workCategoryName || "") + "</td><td>" + (d.skidsDisciplineName || "-") + "</td><td>" + d.displayOrder +
                        "</td><td><button class='btn btn-xs btn-link' onclick='openActivityModal(" + JSON.stringify(d).replace(/'/g, "&#39;") + ")'>Edit</button></td></tr>";
                }).join("");
                $("#activitiesBody").html(rows || '<tr><td colspan="5" class="text-center text-muted">No activities yet.</td></tr>');
            });
        });

        $("#masterSaveBtn").on("click", function () {
            var type = $("#m_type").val();
            var isActive = $("#m_isActive").is(":checked");
            var payload, url;

            switch (type) {
                case "client":
                    payload = { Id: $("#m_id").val() || null, Name: $("#m_name").val(), Code: $("#m_code").val(), IsActive: isActive };
                    url = "@Url.Action("SaveClient")"; break;
                case "jobtype":
                    payload = { Id: $("#m_id").val() || null, Name: $("#m_name").val(), Code: $("#m_code").val(), DisplayOrder: parseInt($("#m_displayOrder").val()) || 0, HasDisciplines: $("#m_hasDisciplines").is(":checked"), IsActive: isActive };
                    url = "@Url.Action("SaveJobType")"; break;
                case "job":
                    payload = { Id: $("#m_id").val() || null, JobNumber: $("#m_jobNumber").val(), JobName: $("#m_jobName").val(), ClientId: $("#m_clientId").val(), Status: parseInt($("#m_status").val()), IsActive: isActive };
                    url = "@Url.Action("SaveJob")"; break;
                case "jobitem":
                    payload = { Id: $("#m_id").val() || null, WorkJobId: $("#masterModal").data("jobId"), Code: $("#m_itemCode").val(), ItemType: parseInt($("#m_itemType").val()), TotalWeightMT: $("#m_weight").val() || null, DocumentStatusId: $("#m_docStatusId").val() || null, IsActive: isActive };
                    url = "@Url.Action("SaveJobItem")"; break;
                case "activity":
                    payload = { Id: $("#m_id").val() || null, JobTypeId: $("#masterModal").data("jobTypeId"), Name: $("#m_activityName").val(), WorkCategory: parseInt($("#m_workCategory").val()), SkidsDiscipline: $("#m_skidsDiscipline").val() || null, DisplayOrder: parseInt($("#m_order2").val()) || 0, IsActive: isActive };
                    url = "@Url.Action("SaveWorkActivity")"; break;
                case "reason":
                    payload = { Id: $("#m_id").val() || null, Category: parseInt($("#m_reasonCategory").val()), Name: $("#m_name").val(), DisplayOrder: parseInt($("#m_order2").val()) || 0, IsActive: isActive };
                    url = "@Url.Action("SaveWorkEntryReason")"; break;
                case "docstatus":
                    payload = { Id: $("#m_id").val() || null, Code: $("#m_code").val(), DisplayName: $("#m_name").val(), DisplayOrder: parseInt($("#m_order3").val()) || 0, IsActive: isActive };
                    url = "@Url.Action("SaveDocumentStatus")"; break;
            }

            $.ajax({
                url: url, type: "POST", contentType: "application/json", data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        swal({ title: "Saved", type: "success" }, function () { location.reload(); });
                    } else {
                        swal("Error", res.message || "Unable to save.", "error");
                    }
                },
                error: function () { swal("Error", "Unable to reach the server.", "error"); }
            });
        });
    </script>
}
