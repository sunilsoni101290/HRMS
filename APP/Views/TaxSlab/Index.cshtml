@model IEnumerable<TaxSlabDto>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Tax Slabs";
}

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">
            <i class="icon-calculator position-left"></i>
            Tax Slabs
        </h5>

        <div class="heading-elements">
            <a asp-action="Create" class="btn bg-primary">
                <i class="icon-plus22"></i>
                New Slab
            </a>
        </div>

    </div>

    <div class="panel-body">

        <form asp-action="Index" method="get" class="row">

            <div class="col-md-4">
                <select name="financialYearId" class="form-control">
                    <option value="">-- All Financial Years --</option>
                    @if (ViewBag.FinancialYearList is SelectList fyList)
                    {
                        foreach (SelectListItem item in fyList)
                        {
                            <option value="@item.Value" selected="@(item.Value == (string)ViewBag.FinancialYearId)">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-4">
                <select name="regime" class="form-control">
                    <option value="">-- All Regimes --</option>
                    @if (ViewBag.RegimeList is List<SelectListItem> regimeList)
                    {
                        foreach (var item in regimeList)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-4">
                <button type="submit" class="btn btn-default">
                    <i class="icon-search4"></i>
                    Filter
                </button>
            </div>

        </form>

    </div>

    <div class="table-responsive">

        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>Financial Year</th>
                    <th>Regime</th>
                    <th>Order</th>
                    <th>Min Income</th>
                    <th>Max Income</th>
                    <th>Rate</th>
                    <th width="120">Action</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FinancialYearName</td>
                            <td>@item.RegimeName</td>
                            <td>@item.SlabOrder</td>
                            <td>@item.MinIncome.ToString("N0")</td>
                            <td>@(item.MaxIncome.HasValue ? item.MaxIncome.Value.ToString("N0") : "and above")</td>
                            <td>@item.RatePercent.ToString("N2")%</td>
                            <td style="padding: 10px 15px;">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-default btn-icon" title="Edit">
                                    <i class="icon-pencil7"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;"
                                      onsubmit="return confirmSweetDeleteForm(event, this, 'Delete this Tax Slab?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-default btn-icon" title="Delete">
                                        <i class="icon-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted" style="padding:30px;">
                            <i class="icon-calculator" style="font-size:32px;"></i><br />
                            No Tax Slabs configured yet.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<script src="~/global_assets/js/plugins/notifications/sweet_alert.min.js"></script>

@section Scripts {

    <script>

        @if (TempData["Success"] != null)
        {
            <text>
                swal({
                    title: 'Success',
                    text: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(TempData["Success"]?.ToString() ?? string.Empty)),
                    type: 'success',
                    confirmButtonColor: '#66BB6A'
                });
            </text>
        }

        @if (TempData["GlobalError"] != null)
        {
            <text>
                swal({
                    title: 'Error',
                    text: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(TempData["GlobalError"]?.ToString() ?? string.Empty)),
                    type: 'error',
                    confirmButtonColor: '#EF5350'
                });
            </text>
        }

    </script>

}
