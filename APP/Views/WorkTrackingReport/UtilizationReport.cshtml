@using APP.Models.DTOs
@model List<UtilizationReportDto>
@{
    ViewData["Title"] = "Work Utilization Report";
    var filter = (WorkReportFilterDto)ViewBag.Filter;
}

<div class="panel panel-flat">
    <div class="panel-heading">
        <h5 class="panel-title"><i class="icon-meter position-left"></i> Work Utilization Report</h5>
    </div>
    <div class="panel-body">
        <form method="get" class="form-inline" style="margin-bottom:15px;">
            <input type="date" name="FromDate" class="form-control" value="@filter.FromDate?.ToString("yyyy-MM-dd")" />
            <input type="date" name="ToDate" class="form-control" value="@filter.ToDate?.ToString("yyyy-MM-dd")" />
            <button type="submit" class="btn btn-primary"><i class="icon-search4 position-left"></i> Filter</button>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered datatable-basic">
                <thead>
                    <tr>
                        <th>Employee</th><th>Department</th><th>Clocked</th><th>Direct</th>
                        <th>Indirect</th><th>Idle</th><th>Downtime</th><th>Utilization %</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted">No data found.</td></tr>
                    }
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>@u.EmployeeName (@u.EmployeeCode)</td><td>@u.DepartmentName</td>
                            <td>@u.ClockedHours.ToString("0.00")</td><td>@u.DirectHours.ToString("0.00")</td>
                            <td>@u.IndirectHours.ToString("0.00")</td><td>@u.IdleHours.ToString("0.00")</td>
                            <td>@u.DowntimeHours.ToString("0.00")</td>
                            <td><strong>@u.UtilizationPercent.ToString("0.0")%</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/global_assets/js/plugins/tables/datatables/datatables.min.js"></script>
    <script>$(".datatable-basic").DataTable({ order: [[7, "desc"]] });</script>
}
