@using APP.Models.DTOs
@model List<JobWiseWorkReportDto>
@{
    ViewData["Title"] = "Job-wise Work Report";
    var filter = (WorkReportFilterDto)ViewBag.Filter;
}

<div class="panel panel-flat">
    <div class="panel-heading">
        <h5 class="panel-title"><i class="icon-briefcase position-left"></i> Job-wise Work Report</h5>
    </div>
    <div class="panel-body">
        <form method="get" class="form-inline" style="margin-bottom:15px;">
            <input type="date" name="FromDate" class="form-control" value="@filter.FromDate?.ToString("yyyy-MM-dd")" />
            <input type="date" name="ToDate" class="form-control" value="@filter.ToDate?.ToString("yyyy-MM-dd")" />
            <button type="submit" class="btn btn-primary"><i class="icon-search4 position-left"></i> Filter</button>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered datatable-basic">
                <thead><tr><th>Job Number</th><th>Job Name</th><th>Client</th><th>Direct Hours</th><th>Indirect Hours</th><th>Total Hours</th></tr></thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted">No data found.</td></tr>
                    }
                    @foreach (var j in Model)
                    {
                        <tr>
                            <td>@j.JobNumber</td><td>@j.JobName</td><td>@j.ClientName</td>
                            <td>@j.DirectHours.ToString("0.00")</td><td>@j.IndirectHours.ToString("0.00")</td>
                            <td><strong>@j.TotalHours.ToString("0.00")</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/global_assets/js/plugins/tables/datatables/datatables.min.js"></script>
    <script>$(".datatable-basic").DataTable({ order: [[5, "desc"]] });</script>
}
