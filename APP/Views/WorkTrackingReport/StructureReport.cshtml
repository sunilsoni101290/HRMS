@using APP.Models.DTOs
@model List<StructureWorkReportDto>
@{
    ViewData["Title"] = "Structure/Equipment Work Report";
    var filter = (WorkReportFilterDto)ViewBag.Filter;
}

<div class="panel panel-flat">
    <div class="panel-heading">
        <h5 class="panel-title"><i class="icon-construction position-left"></i> Structure/Equipment Work Report</h5>
    </div>
    <div class="panel-body">
        <form method="get" class="form-inline" style="margin-bottom:15px;">
            <input type="date" name="FromDate" class="form-control" value="@filter.FromDate?.ToString("yyyy-MM-dd")" />
            <input type="date" name="ToDate" class="form-control" value="@filter.ToDate?.ToString("yyyy-MM-dd")" />
            <button type="submit" class="btn btn-primary"><i class="icon-search4 position-left"></i> Filter</button>
        </form>

        @if (!Model.Any())
        {
            <div class="alert alert-info">No data found for the selected filters.</div>
        }

        @foreach (var s in Model)
        {
            <div class="panel panel-bordered">
                <div class="panel-heading">
                    <h6 class="panel-title">Job @s.JobNumber - @s.ClientName - Structure/Equipment @s.StructureId</h6>
                </div>
                <div class="panel-body">
                    <table class="table table-condensed">
                        <tbody>
                            @foreach (var kv in s.DirectActivityHours)
                            {
                                <tr><td>@kv.Key</td><td class="text-right">@kv.Value.ToString("0.00")</td></tr>
                            }
                            <tr class="active"><th>Total Direct Hours</th><th class="text-right">@s.TotalDirectHours.ToString("0.00")</th></tr>
                            @foreach (var kv in s.IndirectActivityHours)
                            {
                                <tr><td>@kv.Key</td><td class="text-right">@kv.Value.ToString("0.00")</td></tr>
                            }
                            <tr class="active"><th>Total Indirect Hours</th><th class="text-right">@s.TotalIndirectHours.ToString("0.00")</th></tr>
                            <tr class="success"><th>Total Hours</th><th class="text-right">@s.TotalHours.ToString("0.00")</th></tr>
                            @if (s.TotalWeightMT.HasValue)
                            {
                                <tr><td>Total Weight (MT)</td><td class="text-right">@s.TotalWeightMT.Value.ToString("0.00")</td></tr>
                                <tr><td><strong>Engineering Hours / MT</strong></td><td class="text-right"><strong>@s.HoursPerMT?.ToString("0.00")</strong></td></tr>
                            }
                            <tr><td>Document Status</td><td class="text-right">@(s.DocumentStatusName ?? "-")</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
