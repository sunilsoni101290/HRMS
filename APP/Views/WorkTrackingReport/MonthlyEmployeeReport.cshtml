@using APP.Models.DTOs
@model PagedResult<MonthlyEmployeeWorkReportDto>
@{
    ViewData["Title"] = "Employee Work Report - Monthly";
    var filter = (WorkReportFilterDto)ViewBag.Filter;
}

<div class="panel panel-flat">
    <div class="panel-heading">
        <h5 class="panel-title"><i class="icon-stats-bars position-left"></i> Employee Work Report - Monthly</h5>
    </div>
    <div class="panel-body">
        <form method="get" class="form-inline" style="margin-bottom:15px;">
            <input type="date" name="FromDate" class="form-control" value="@filter.FromDate?.ToString("yyyy-MM-dd")" placeholder="From" />
            <input type="date" name="ToDate" class="form-control" value="@filter.ToDate?.ToString("yyyy-MM-dd")" placeholder="To" />
            <button type="submit" class="btn btn-primary"><i class="icon-search4 position-left"></i> Filter</button>
        </form>

        @if (!Model.Data.Any())
        {
            <div class="alert alert-info">No data found for the selected filters.</div>
        }

        @foreach (var emp in Model.Data)
        {
            <div class="panel panel-bordered">
                <div class="panel-heading">
                    <h6 class="panel-title">@emp.EmployeeName (@emp.EmployeeCode) - @emp.Position</h6>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-2"><label>Report Period</label><p>@emp.ReportFrom.ToString("dd-MMM") - @emp.ReportTo.ToString("dd-MMM-yyyy")</p></div>
                        <div class="col-md-2"><label>Clocked Hours</label><p>@emp.TotalClockedHours.ToString("0.00")</p></div>
                        <div class="col-md-2"><label>Direct Hours</label><p>@emp.DirectHours.ToString("0.00")</p></div>
                        <div class="col-md-2"><label>Indirect Hours</label><p>@emp.IndirectHours.ToString("0.00")</p></div>
                        <div class="col-md-2"><label>Idle / Downtime</label><p>@emp.IdleHours.ToString("0.00") / @emp.DowntimeHours.ToString("0.00")</p></div>
                        <div class="col-md-2"><label>Utilization</label><p><strong>@emp.UtilizationPercent.ToString("0.0")%</strong></p></div>
                    </div>

                    <table class="table table-bordered table-condensed">
                        <thead><tr><th>Job Number</th><th>Client</th><th>Structure/Equipment/Job ID</th><th>Hours</th><th>Document Status</th></tr></thead>
                        <tbody>
                            @foreach (var line in emp.JobLines)
                            {
                                <tr>
                                    <td>@line.JobNumber</td><td>@line.ClientName</td><td>@line.JobItemCode</td>
                                    <td>@line.Hours.ToString("0.00")</td><td>@(line.DocumentStatusName ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (Model.TotalRecords > Model.PageSize)
        {
            <nav>
                <ul class="pagination">
                    @for (int p = 1; p <= Math.Ceiling((double)Model.TotalRecords / Model.PageSize); p++)
                    {
                        <li class="@(p == Model.PageNumber ? "active" : "")">
                            <a href="?PageNumber=@p&FromDate=@filter.FromDate?.ToString("yyyy-MM-dd")&ToDate=@filter.ToDate?.ToString("yyyy-MM-dd")">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>
