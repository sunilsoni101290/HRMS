@model IEnumerable<OnDutyRequestDto>

@{
    ViewData["Title"] = "My On Duty Requests";

    string StatusBadgeClass(int status) => status switch
    {
        (int)EnumExtensions.OnDutyRequestStatus.Pending => "bg-warning",
        (int)EnumExtensions.OnDutyRequestStatus.Approved => "bg-success",
        (int)EnumExtensions.OnDutyRequestStatus.Rejected => "bg-danger",
        (int)EnumExtensions.OnDutyRequestStatus.Cancelled => "bg-grey",
        _ => "bg-grey"
    };

    string StatusText(OnDutyRequestDto item) =>
        !string.IsNullOrEmpty(item.StatusName)
            ? item.StatusName
            : ((EnumExtensions.OnDutyRequestStatus)item.Status).ToString();
}

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">
            <i class="icon-briefcase position-left"></i>
            My On Duty Requests
        </h5>

        <div class="heading-elements">

            <a asp-action="PendingApprovals" class="btn btn-default">
                <i class="icon-checkmark4"></i>
                Pending My Approval
            </a>

            <a asp-action="Create" class="btn bg-primary">
                <i class="icon-plus22"></i>
                New Request
            </a>

        </div>

    </div>

    <div class="table-responsive">

        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>From Date</th>
                    <th>To Date</th>
                    <th>Total Days</th>
                    <th>Purpose</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Approved By</th>
                    <th width="140">Action</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.FromDate.ToString("dd-MMM-yyyy")</td>

                            <td>@item.ToDate.ToString("dd-MMM-yyyy")</td>

                            <td class="text-center">@item.TotalDays</td>

                            <td>
                                <span class="text-muted text-size-small">
                                    @(item.Purpose?.Length > 40 ? item.Purpose.Substring(0, 40) + "..." : item.Purpose)
                                </span>
                            </td>

                            <td>@(string.IsNullOrEmpty(item.Location) ? "-" : item.Location)</td>

                            <td>
                                <span class="label @StatusBadgeClass(item.Status)">@StatusText(item)</span>
                            </td>

                            <td>
                                @(string.IsNullOrEmpty(item.ApprovedByName) ? "-" : item.ApprovedByName)
                            </td>

                            <td style="padding: 10px 15px;">

                                <div class="btn-group">

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-default btn-icon"
                                       data-popup="tooltip"
                                       title="View">

                                        <i class="icon-eye"></i>

                                    </a>

                                    @if (item.Status == (int)EnumExtensions.OnDutyRequestStatus.Pending)
                                    {
                                        <button type="button"
                                                class="btn bg-slate btn-icon btnCancel"
                                                data-id="@item.Id"
                                                data-popup="tooltip"
                                                title="Cancel">

                                            <i class="icon-blocked"></i>

                                        </button>
                                    }

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted" style="padding:30px;">
                            <i class="icon-briefcase" style="font-size:32px;"></i><br />
                            No On Duty requests found.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<partial name="_CancelModal" />

<script src="~/global_assets/js/plugins/notifications/sweet_alert.min.js"></script>

@section Scripts {

    <script>

        @if (TempData["Success"] != null)
        {
            <text>
                swal({
                    title: 'Success',
                    text: '@Html.Raw(TempData["Success"])',
                    type: 'success',
                    confirmButtonColor: '#66BB6A'
                });
            </text>
        }

        @if (TempData["GlobalError"] != null)
        {
            <text>
                swal({
                    title: 'Error',
                    text: '@Html.Raw(TempData["GlobalError"])',
                    type: 'error',
                    confirmButtonColor: '#EF5350'
                });
            </text>
        }

    </script>

    <script>

        $(document).ready(function () {

            $('[data-popup="tooltip"]').tooltip();

            $(document).on('click', '.btnCancel', function () {

                var id = $(this).data('id');

                $('#CancelOnDutyRequestId').val(id);

                $('#cancelModal').modal('show');

            });

        });

    </script>

}
