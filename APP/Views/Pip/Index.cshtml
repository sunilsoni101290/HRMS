@model IEnumerable<PipRecordDto>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "PIP Records";

    string OutcomeBadgeClass(int outcome) => outcome switch
    {
        (int)EnumExtensions.PipFinalOutcome.InProgress => "bg-warning",
        (int)EnumExtensions.PipFinalOutcome.Successful => "bg-success",
        (int)EnumExtensions.PipFinalOutcome.Unsuccessful => "bg-danger",
        _ => "bg-grey"
    };

    string OutcomeText(PipRecordDto item) =>
        !string.IsNullOrEmpty(item.FinalOutcomeName)
            ? item.FinalOutcomeName
            : ((EnumExtensions.PipFinalOutcome)item.FinalOutcome).ToString();

    string StatusBadgeClass(int status) => status switch
    {
        (int)EnumExtensions.PipOutcomeStatus.PendingChecker => "bg-warning",
        (int)EnumExtensions.PipOutcomeStatus.Approved => "bg-success",
        (int)EnumExtensions.PipOutcomeStatus.Rejected => "bg-danger",
        _ => "bg-grey"
    };
}

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">
            <i class="icon-clipboard4 position-left"></i>
            PIP Records
        </h5>

        <div class="heading-elements">

            <a asp-action="Active" class="btn btn-default">
                <i class="icon-alarm"></i>
                Active PIPs
            </a>

        </div>

    </div>

    <div class="panel-body">

        <form asp-action="Index" method="get" class="row">

            <div class="col-md-3">
                <select name="finalOutcome" class="form-control">
                    <option value="">-- All Outcomes --</option>
                    @if (ViewBag.FinalOutcomeList is List<SelectListItem> outcomeList)
                    {
                        foreach (var item in outcomeList)
                        {
                            <option value="@item.Value" selected="@(item.Value == (string)ViewBag.FinalOutcome)">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3">
                <select name="departmentId" class="form-control">
                    <option value="">-- All Departments --</option>
                    @if (ViewBag.DepartmentList is SelectList deptList)
                    {
                        foreach (SelectListItem item in deptList)
                        {
                            <option value="@item.Value" selected="@(item.Value == (string)ViewBag.DepartmentId)">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3">
                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search by employee name/code..." />
            </div>

            <div class="col-md-3">
                <button type="submit" class="btn btn-default">
                    <i class="icon-search4"></i>
                    Filter
                </button>
            </div>

        </form>

    </div>

    <div class="table-responsive">

        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Final Outcome</th>
                    <th>Maker-Checker Status</th>
                    <th>Maker</th>
                    <th>Checker</th>
                    <th width="100">Action</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.EmployeeName
                                <br />
                                <span class="text-muted text-size-small">@item.EmployeeCode</span>
                            </td>

                            <td>@(item.DepartmentName ?? "-")</td>

                            <td>@item.StartDate.ToString("dd-MMM-yyyy")</td>

                            <td>@item.EndDate.ToString("dd-MMM-yyyy")</td>

                            <td>
                                <span class="label @OutcomeBadgeClass(item.FinalOutcome)">@OutcomeText(item)</span>
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(item.MakerId))
                                {
                                    <span class="label @StatusBadgeClass(item.Status)">@(item.StatusName ?? ((EnumExtensions.PipOutcomeStatus)item.Status).ToString())</span>
                                }
                                else
                                {
                                    <span class="text-muted">No proposal yet</span>
                                }
                            </td>

                            <td>@(item.MakerName ?? "-")</td>

                            <td>@(item.CheckerName ?? "-")</td>

                            <td style="padding: 10px 15px;">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-default btn-icon"
                                   data-popup="tooltip"
                                   title="View">

                                    <i class="icon-eye"></i>

                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted" style="padding:30px;">
                            <i class="icon-clipboard4" style="font-size:32px;"></i><br />
                            No PIP records found.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<script src="~/global_assets/js/plugins/notifications/sweet_alert.min.js"></script>

@section Scripts {

    <script>

        @if (TempData["Success"] != null)
        {
            <text>
                swal({
                    title: 'Success',
                    text: '@Html.Raw(TempData["Success"])',
                    type: 'success',
                    confirmButtonColor: '#66BB6A'
                });
            </text>
        }

        @if (TempData["GlobalError"] != null)
        {
            <text>
                swal({
                    title: 'Error',
                    text: '@Html.Raw(TempData["GlobalError"])',
                    type: 'error',
                    confirmButtonColor: '#EF5350'
                });
            </text>
        }

    </script>

    <script>

        $(document).ready(function () {
            $('[data-popup="tooltip"]').tooltip();
        });

    </script>

}
