@model IEnumerable<EmployeeShiftMappingDto>

@{
    ViewData["Title"] = "Employee Shift Mapping";
}

<div class="panel panel-flat">

    <!-- Header -->

    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-calendar52 position-left"></i>

            Employee Shift Mapping

        </h5>

        <div class="heading-elements">

            <a asp-action="Create"
               class="btn bg-primary">

                <i class="icon-plus22 position-left"></i>

                Assign Shift

            </a>

        </div>

    </div>

    <!-- Dashboard -->

    <div class="panel-body">

        <!-- Filters -->

        <div class="row">

            <!-- Search -->

            <div class="col-md-4">

                <div class="form-group">

                    <input type="text"
                           id="searchInput"
                           class="form-control"
                           placeholder="Search Employee..." />

                </div>

            </div>

            <!-- Shift -->

            <div class="col-md-3">

                <div class="form-group">

                    <select id="ShiftFilter"
                            class="form-control select-search">

                        <option value="">

                            All Shifts

                        </option>

                    </select>

                </div>

            </div>

            <!-- Status -->

            <div class="col-md-3">

                <div class="form-group">

                    <select id="StatusFilter"
                            class="form-control select-search">

                        <option value="">

                            All Status

                        </option>

                        <option value="Active">

                            Active

                        </option>

                        <option value="Inactive">

                            Inactive

                        </option>

                    </select>

                </div>

            </div>

            <!-- Filter -->

            <div class="col-md-2">

                <button type="button"
                        class="btn bg-primary btn-block">

                    <i class="icon-search4 position-left"></i>

                    Filter

                </button>

            </div>

        </div>

    </div>

    <!-- Grid -->

    <table class="table table-hover table-striped datatable-basic">

        <thead>

            <tr>

                <th width="60">#</th>

                <th>Employee</th>

                <th>Shift</th>

                <th>Effective From</th>

                <th>Effective To</th>

                <th>Status</th>

                <th width="170"
                    class="text-center">

                    Action

                </th>

            </tr>

        </thead>

        <tbody id="mappingTable">
            @{
                int sr = 1;
            }

            @foreach (var item in Model)
            {
                <tr>

                    <!-- Sr No -->

                    <td>

                        @sr

                    </td>

                    <!-- Employee -->

                    <td>

                        <div>

                            <div class="text-semibold">

                                <i class="icon-user text-primary position-left"></i>

                                @item.EmployeeName

                            </div>

                            <small class="text-muted">

                                Employee

                            </small>

                        </div>

                    </td>

                    <!-- Shift -->

                    <td>

                        <span class="label bg-primary">

                            <i class="icon-alarm position-left"></i>

                            @item.ShiftName

                        </span>

                    </td>

                    <!-- Effective From -->

                    <td>

                        <span class="text-success">

                            <i class="icon-calendar3 position-left"></i>

                            @item.EffectiveFrom.ToString("dd-MMM-yyyy")

                        </span>

                    </td>

                    <!-- Effective To -->

                    <td>

                        @if (item.EffectiveTo.HasValue)
                        {
                            <span class="text-danger">

                                <i class="icon-calendar52 position-left"></i>

                                @item.EffectiveTo.Value.ToString("dd-MMM-yyyy")

                            </span>
                        }
                        else
                        {
                            <span class="label bg-success">

                                Current

                            </span>
                        }

                    </td>

                    <!-- Status -->

                    <td>

                        @if (item.IsActive)
                        {
                            <span class="label bg-success">

                                <i class="icon-checkmark-circle position-left"></i>

                                Active

                            </span>
                        }
                        else
                        {
                            <span class="label bg-danger">

                                <i class="icon-cross2 position-left"></i>

                                Inactive

                            </span>
                        }

                    </td>

                    <!-- Action -->

                    <td class="text-center">

                        <div class="btn-group">

                            <!-- Details -->

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-default btn-icon"
                               data-popup="tooltip"
                               title="Details">

                                <i class="icon-eye"></i>

                            </a>

                            <!-- Edit -->

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-primary btn-icon"
                               data-popup="tooltip"
                               title="Edit">

                                <i class="icon-pencil7"></i>

                            </a>

                            <!-- Delete -->

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-danger btn-icon"
                               data-popup="tooltip"
                               title="Delete"
                               onclick="return confirmSweetDelete(event, this, 'Are you sure you want to delete this mapping?');">

                                <i class="icon-trash"></i>

                            </a>

                        </div>

                    </td>

                </tr>

                sr++;
            }

        </tbody>

    </table>

</div>
@section Scripts {

    <script>

        $(document).ready(function () {

            //=========================================
            // Tooltip
            //=========================================

            $('[data-popup="tooltip"]').tooltip();

            //=========================================
            // Chosen Dropdown
            //=========================================

            if ($(".select-search").length) {

                $(".select-search").chosen({

                    width: "100%",
                    search_contains: true

                });

            }

            //=========================================
            // Search
            //=========================================

            $("#searchInput").keyup(function () {

                filterTable();

            });

            //=========================================
            // Shift Filter
            //=========================================

            $("#ShiftFilter").change(function () {

                filterTable();

            });

            //=========================================
            // Status Filter
            //=========================================

            $("#StatusFilter").change(function () {

                filterTable();

            });

            //=========================================
            // Filter Function
            //=========================================

            function filterTable() {

                var keyword =
                    $("#searchInput").val().toLowerCase();

                var shift =
                    $("#ShiftFilter").val().toLowerCase();

                var status =
                    $("#StatusFilter").val().toLowerCase();

                $("#mappingTable tr").each(function () {

                    var row = $(this);

                    var employee =
                        row.find("td:eq(1)").text().toLowerCase();

                    var shiftName =
                        row.find("td:eq(2)").text().toLowerCase();

                    var rowStatus =
                        row.find("td:eq(5)").text().toLowerCase();

                    var searchMatch =
                        keyword == "" ||
                        employee.indexOf(keyword) > -1;

                    var shiftMatch =
                        shift == "" ||
                        shiftName.indexOf(shift) > -1;

                    var statusMatch =
                        status == "" ||
                        rowStatus.indexOf(status) > -1;

                    row.toggle(
                        searchMatch &&
                        shiftMatch &&
                        statusMatch
                    );

                });

            }

            //=========================================
            // DataTable
            //=========================================

            if ($.fn.DataTable) {

                $(".datatable-basic").DataTable({

                    autoWidth: false,

                    paging: true,

                    ordering: true,

                    info: true,

                    searching: false,

                    pageLength: 10,

                    lengthMenu: [

                        [10,25,50,100],

                        [10,25,50,100]

                    ],

                    language: {

                        search: "_INPUT_",

                        searchPlaceholder: "Search..."

                    }

                });

            }

        });

    </script>
    @if (TempData["Success"] != null)
    {
        <script>

            $(function () {

                swal({
                    title: "Success",
                    text: "@TempData["Success"]",
                    type: "success"
                });

            });

        </script>
    }


    <style>

        .panel-heading {
            padding: 18px 20px;
        }

        .panel-title {
            font-weight: 600;
        }

        .panel-body {
            padding: 20px;
        }

        .table > thead > tr > th {
            background: #fafafa;
            font-weight: 600;
            font-size: 13px;
            vertical-align: middle;
        }

        .table > tbody > tr > td {
            vertical-align: middle;
            font-size: 13px;
        }

        .table-hover tbody tr:hover {
            background: #f8f9fa;
        }

        .text-semibold {
            font-weight: 600;
        }

        .btn-icon {
            width: 34px;
            height: 34px;
            padding: 7px;
        }

        .btn-group .btn {
            margin-right: 2px;
        }

        .label {
            font-size: 11px;
            padding: 5px 10px;
        }

        .panel.bg-primary-400,
        .panel.bg-success-400,
        .panel.bg-info-400,
        .panel.bg-warning-400 {
            margin-bottom: 20px;
            border-radius: 4px;
        }

        .media {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .media-left i {
            opacity: .85;
        }

        .datatable-basic tbody tr:hover {
            background: #f5f5f5;
        }

        .chosen-container {
            width: 100% !important;
        }

        .chosen-single {
            height: 36px !important;
            line-height: 34px !important;
        }

        .panel {
            box-shadow: 0 1px 3px rgba(0,0,0,.08);
        }

    </style>

}