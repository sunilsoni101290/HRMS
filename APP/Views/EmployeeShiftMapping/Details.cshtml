@model EmployeeShiftMappingDto

@{
    ViewData["Title"] = "Employee Shift Mapping Details";
}

<div class="panel panel-flat">

    <!-- Header -->

    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-calendar52 position-left"></i>

            Employee Shift Mapping Details

        </h5>

        <div class="heading-elements">

            <a asp-action="Index"
               class="btn btn-default">

                <i class="icon-arrow-left13"></i>

                Back

            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn bg-primary">

                <i class="icon-pencil7"></i>

                Edit

            </a>

        </div>

    </div>

    <div class="panel-body">

        <!-- Header -->

        <div class="row">

            <div class="col-md-2 text-center">

                <div class="content-group">

                    <div class="icon-object border-primary text-primary"
                         style="width:100px;
                        height:100px;
                        line-height:100px;
                        font-size:42px;
                        margin:auto;">

                        <i class="icon-user-check"></i>

                    </div>

                </div>

            </div>

            <div class="col-md-6">

                <h2 class="text-semibold no-margin">

                    @Model.EmployeeName

                </h2>

                <br />

                <span class="label bg-primary">

                    @Model.ShiftName

                </span>

                @if (Model.IsActive)
                {
                    <span class="label bg-success">

                        Active

                    </span>
                }
                else
                {
                    <span class="label bg-danger">

                        Inactive

                    </span>
                }

            </div>

            <div class="col-md-4">

                <div class="panel bg-primary-400">

                    <div class="panel-body">

                        <h3 class="no-margin">

                            @Model.ShiftName

                        </h3>

                        Current Shift

                    </div>

                </div>

            </div>

        </div>

        <hr />

        <div class="row">

            <!-- Employee -->

            <div class="col-md-6">

                <div class="panel panel-bordered">

                    <div class="panel-heading">

                        <h6 class="panel-title">

                            <i class="icon-user position-left"></i>

                            Employee Information

                        </h6>

                    </div>

                    <table class="table table-bordered">

                        <tr>

                            <th width="220">

                                Employee

                            </th>

                            <td>

                                @Model.EmployeeName

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Employee Id

                            </th>

                            <td>

                                @Model.EmployeeId

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

            <!-- Shift -->

            <div class="col-md-6">

                <div class="panel panel-bordered">

                    <div class="panel-heading">

                        <h6 class="panel-title">

                            <i class="icon-alarm position-left"></i>

                            Shift Information

                        </h6>

                    </div>

                    <table class="table table-bordered">

                        <tr>

                            <th width="220">

                                Shift

                            </th>

                            <td>

                                @Model.ShiftName

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Shift Id

                            </th>

                            <td>

                                @Model.ShiftId

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

        </div>

        <!-- Effective Period -->

        <div class="panel panel-bordered">

            <div class="panel-heading">

                <h6 class="panel-title">

                    <i class="icon-calendar3 position-left"></i>

                    Effective Period

                </h6>

            </div>

            <table class="table table-bordered">

                <tr>

                    <th width="220">

                        Effective From

                    </th>

                    <td>

                        @Model.EffectiveFrom.ToString("dd-MMM-yyyy")

                    </td>

                </tr>

                <tr>

                    <th>

                        Effective To

                    </th>

                    <td>

                        @(Model.EffectiveTo.HasValue
                            ? Model.EffectiveTo.Value.ToString("dd-MMM-yyyy")
                            : "Current")

                    </td>

                </tr>

                <tr>

                    <th>

                        Status

                    </th>

                    <td>

                        @if (Model.IsActive)
                        {
                            <span class="label bg-success">

                                Active

                            </span>
                        }
                        else
                        {
                            <span class="label bg-danger">

                                Inactive

                            </span>
                        }

                    </td>

                </tr>

            </table>

        </div>

        <!-- Audit -->

        <div class="panel panel-bordered">

            <div class="panel-heading">

                <h6 class="panel-title">

                    <i class="icon-history position-left"></i>

                    Audit Information

                </h6>

            </div>

            <table class="table table-bordered">
                <tr>

                    <th>

                        Created By

                    </th>

                    <td>

                        @Model.CreatedBy

                    </td>

                </tr>

                <tr>

                    <th>

                        Modified By

                    </th>

                    <td>

                        @(string.IsNullOrEmpty(Model.ModifiedBy)
                            ? "-"
                            : Model.ModifiedBy)

                    </td>

                </tr>

            </table>

        </div>

    </div>

</div>

<style>

    .panel-bordered {
        border: 1px solid #ddd;
        margin-bottom: 20px;
    }

        .panel-bordered .panel-heading {
            background: #fafafa;
            border-bottom: 1px solid #ddd;
        }

    .table > tbody > tr > th {
        width: 220px;
        background: #fafafa;
        font-weight: 600;
    }

    .icon-object {
        border: 3px solid #2196F3;
        border-radius: 50%;
    }

    .label {
        font-size: 11px;
        margin-right: 5px;
    }

</style>