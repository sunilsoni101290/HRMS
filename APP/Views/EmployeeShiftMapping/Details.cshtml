@model EmployeeShiftMappingDto

@{
    ViewData["Title"] = "Shift Mapping Details";
}

<div class="container-fluid py-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow border-0 rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="card-header bg-primary text-white py-4">

                    <div class="d-flex align-items-center">

                        <div class="me-3">

                            <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center"
                                 style="width:70px;height:70px;">

                                <i class="bi bi-calendar2-week fs-2"></i>

                            </div>

                        </div>

                        <div>

                            <h3 class="mb-1">
                                @Model.EmployeeName
                            </h3>

                            <p class="mb-0 opacity-75">

                                Shift :
                                @Model.ShiftName

                            </p>

                        </div>

                    </div>

                </div>

                <!-- Body -->
                <div class="card-body p-4">

                    <div class="row g-4">

                        <!-- Employee Details -->
                        <div class="col-md-6">

                            <div class="card border-0 shadow-sm rounded-4 h-100">

                                <div class="card-header bg-light">

                                    <h5 class="mb-0">

                                        <i class="bi bi-person-circle text-primary"></i>
                                        Employee Details

                                    </h5>

                                </div>

                                <div class="card-body">

                                    <table class="table table-borderless mb-0">

                                        <tr>

                                            <th width="180">
                                                Employee
                                            </th>

                                            <td>
                                                @Model.EmployeeName
                                            </td>

                                        </tr>

                                        <tr>

                                            <th>
                                                Shift
                                            </th>

                                            <td>

                                                <span class="badge bg-primary">
                                                    @Model.ShiftName
                                                </span>

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>
                                                Status
                                            </th>

                                            <td>

                                                @if (Model.IsActive)
                                                {
                                                    <span class="badge bg-success">
                                                        Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">
                                                        Inactive
                                                    </span>
                                                }

                                            </td>

                                        </tr>

                                    </table>

                                </div>

                            </div>

                        </div>

                        <!-- Effective Dates -->
                        <div class="col-md-6">

                            <div class="card border-0 shadow-sm rounded-4 h-100">

                                <div class="card-header bg-light">

                                    <h5 class="mb-0">

                                        <i class="bi bi-calendar-event text-primary"></i>
                                        Effective Dates

                                    </h5>

                                </div>

                                <div class="card-body">

                                    <table class="table table-borderless mb-0">

                                        <tr>

                                            <th width="180">
                                                Effective From
                                            </th>

                                            <td>

                                                @Model.EffectiveFrom.ToString("dd MMM yyyy")

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>
                                                Effective To
                                            </th>

                                            <td>

                                                @(Model.EffectiveTo.HasValue
                                                    ? Model.EffectiveTo.Value.ToString("dd MMM yyyy")
                                                    : "-")

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>
                                                Created On
                                            </th>

                                            <td>

                                                @(Model.CreatedOn.HasValue
                                                    ? Model.CreatedOn.Value.ToString("dd MMM yyyy")
                                                    : "-")

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>
                                                Updated On
                                            </th>

                                            <td>

                                                @(Model.UpdatedOn.HasValue
                                                    ? Model.UpdatedOn.Value.ToString("dd MMM yyyy")
                                                    : "-")

                                            </td>

                                        </tr>

                                    </table>

                                </div>

                            </div>

                        </div>

                        <!-- Status Cards -->
                        <div class="col-md-12">

                            <div class="card border-0 shadow-sm rounded-4">

                                <div class="card-header bg-light">

                                    <h5 class="mb-0">

                                        <i class="bi bi-check-circle text-primary"></i>
                                        Mapping Status

                                    </h5>

                                </div>

                                <div class="card-body">

                                    <div class="row text-center">

                                        <!-- Active -->
                                        <div class="col-md-4">

                                            <div class="border rounded-4 p-4">

                                                <i class="bi bi-check-circle-fill text-success fs-1"></i>

                                                <h6 class="mt-3">
                                                    Current Status
                                                </h6>

                                                @if (Model.IsActive)
                                                {
                                                    <span class="badge bg-success">
                                                        Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">
                                                        Inactive
                                                    </span>
                                                }

                                            </div>

                                        </div>

                                        <!-- Shift -->
                                        <div class="col-md-4">

                                            <div class="border rounded-4 p-4">

                                                <i class="bi bi-clock-history text-primary fs-1"></i>

                                                <h6 class="mt-3">
                                                    Assigned Shift
                                                </h6>

                                                <span class="badge bg-primary">
                                                    @Model.ShiftName
                                                </span>

                                            </div>

                                        </div>

                                        <!-- Duration -->
                                        <div class="col-md-4">

                                            <div class="border rounded-4 p-4">

                                                <i class="bi bi-calendar-range text-warning fs-1"></i>

                                                <h6 class="mt-3">
                                                    Effective Period
                                                </h6>

                                                <span class="badge bg-warning text-dark">
                                                    Running
                                                </span>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Footer -->
                    <div class="mt-4 text-end">

                        <a asp-action="Index"
                           class="btn btn-light border rounded-3 px-4">

                            <i class="bi bi-arrow-left"></i>
                            Back

                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary rounded-3 px-4">

                            <i class="bi bi-pencil-square"></i>
                            Edit Mapping

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>