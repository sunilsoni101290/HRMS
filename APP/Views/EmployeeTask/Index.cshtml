@model IEnumerable<EmployeeTaskListDto>

@{
    ViewData["Title"] = ViewBag.ListTitle ?? "Tasks";
    bool isAdmin = ViewBag.IsAdmin ?? true;

    string StatusLabel(string s) => s switch
    {
        "Pending" => "bg-warning",
        "InProgress" => "bg-primary",
        "Completed" => "bg-success",
        _ => "bg-grey"
    };
    string PriorityLabel(string p) => p switch
    {
        "High" => "bg-danger",
        "Medium" => "bg-warning",
        "Low" => "bg-info",
        _ => "bg-grey"
    };
}

<div class="panel panel-flat">

    <div class="panel-heading">
        <h5 class="panel-title"><i class="icon-checkmark-circle position-left"></i> @ViewData["Title"]</h5>
        @if (isAdmin)
        {
            <div class="heading-elements">
                <a asp-action="Create" class="btn bg-primary"><i class="icon-plus22"></i> New Task</a>
            </div>
        }
    </div>

    <div class="panel-body">
        <div class="row">
            <div class="col-md-4">
                <input type="text" id="searchInput" class="form-control" placeholder="Search tasks..." />
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-striped datatable-basic">
            <thead>
                <tr>
                    <th width="50">#</th>
                    <th>Task</th>
                    <th>Assigned To</th>
                    <th>Due Date</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Remarks</th>
                    <th width="@(isAdmin ? "230" : "140")">Action</th>
                </tr>
            </thead>
            <tbody id="dataTable">
                @{ int sr = 1; }
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@sr</td>
                            <td><strong>@item.Title</strong></td>
                            <td>@item.EmployeeName</td>
                            <td>@(item.DueDate?.ToString("dd MMM yyyy") ?? "-")</td>
                            <td><span class="label @PriorityLabel(item.Priority)">@item.Priority</span></td>
                            <td><span class="label @StatusLabel(item.Status)">@item.Status</span></td>
                            <td class="text-muted text-size-small">@(string.IsNullOrWhiteSpace(item.Remarks) ? "-" : item.Remarks)</td>
                            <td>
                                @if (item.Status != "Completed")
                                {
                                    <button type="button"
                                            class="btn btn-primary btn-icon"
                                            title="Update Status &amp; Remarks"
                                            data-toggle="modal"
                                            data-target="#statusModal-@item.Id">
                                        <i class="icon-pencil7"></i>
                                    </button>
                                }
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-default btn-icon" title="View"><i class="icon-eye"></i></a>
                                @if (isAdmin)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-default btn-icon" title="Edit"><i class="icon-pencil"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                       onclick="return confirmSweetDelete(event, this, 'Delete this task?');"
                                       class="btn btn-danger btn-icon" title="Delete"><i class="icon-trash"></i></a>
                                }
                            </td>
                        </tr>

                        @if (item.Status != "Completed")
                        {
                            <!-- Update Status & Remarks modal -->
                            <div class="modal fade" id="statusModal-@item.Id" tabindex="-1" role="dialog">
                                <div class="modal-dialog" role="document">
                                    <div class="modal-content">
                                        <form asp-action="ChangeStatus" asp-route-id="@item.Id" method="post">
                                            <div class="modal-header">
                                                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                                                <h5 class="modal-title">Update Status - @item.Title</h5>
                                            </div>
                                            <div class="modal-body">
                                                <div class="form-group">
                                                    <label>Status</label>
                                                    <select name="status" class="form-control">
                                                        <option value="Pending" selected="@(item.Status == "Pending")">Pending</option>
                                                        <option value="InProgress" selected="@(item.Status == "InProgress")">In Progress</option>
                                                        <option value="Completed">Completed</option>
                                                    </select>
                                                </div>
                                                <div class="form-group">
                                                    <label>Remarks</label>
                                                    <textarea name="remarks" rows="3" maxlength="500" class="form-control" placeholder="Optional note, e.g. waiting on approval...">@item.Remarks</textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn bg-primary">Save</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }

                        sr++;
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center text-muted" style="padding:30px;"><i class="icon-checkmark-circle" style="font-size:32px;"></i><br />No tasks found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    @if (TempData["Success"] != null)
    {
        <script>$(function(){ swal({ title:"Success", text:"@TempData["Success"]", type:"success" }); });</script>
    }
    <script>
        $(function () {
            $("#searchInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#dataTable tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
        });
    </script>
    <style>
        .table > thead > tr > th { font-weight: 600; }
        .table > tbody > tr > td { vertical-align: middle; }
        .label { font-size: 11px; }
        .btn-icon { width: 34px; }
    </style>

    <script>
        // Auto-added: client-side pagination for this Index page's listing
        // table (DataTables). Safe to run even if this page already
        // initializes '.datatable-basic' itself above - 'retrieve: true'
        // makes DataTables return the existing instance instead of
        // re-initializing (and throwing) when that's the case.
        $(document).ready(function () {
            if ($.fn.DataTable) {
                var __indexDataTable = $('.datatable-basic').DataTable({
                    autoWidth: false,
                    paging: true,
                    ordering: true,
                    searching: false,
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                    language: { search: "_INPUT_", searchPlaceholder: "Search..." },
                    retrieve: true
                });

            // Rewire the page's existing search box to drive DataTables'
            // own filtering pipeline (instead of any legacy row .toggle()
            // logic still bound above), so search results stay correct once
            // rows are split across pages.
            $('#searchInput').on('keyup', function () {
                __indexDataTable.search($(this).val() || '').draw();
            });
            }
        });
    </script>
}
