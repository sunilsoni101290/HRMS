@model IEnumerable<DepartmentListDto>

@{
    ViewData["Title"] = "Department List";
}

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-tree6 position-left"></i>
            Department Management

        </h5>

        <div class="heading-elements">

            <a asp-action="Create"
               class="btn bg-primary btn-sm">

                <i class="icon-plus22 position-left"></i>
                Add Department

            </a>

        </div>

    </div>

    <!-- KPI Cards -->

    <div class="panel-body">

        <div class="row">

            <div class="col-md-3">

                <div class="panel bg-primary-400">
                    <div class="panel-body text-center">

                        <h3 class="no-margin">
                            @Model.Count()
                        </h3>

                        <span>Total Departments</span>

                    </div>
                </div>

            </div>

            <div class="col-md-3">

                <div class="panel bg-success-400">
                    <div class="panel-body text-center">

                        <h3 class="no-margin">
                            @Model.Select(x => x.CompanyId).Distinct().Count()
                        </h3>

                        <span>Companies</span>

                    </div>
                </div>

            </div>

            <div class="col-md-3">

                <div class="panel bg-info-400">
                    <div class="panel-body text-center">

                        <h3 class="no-margin">
                            @Model.Select(x => x.BranchId).Distinct().Count()
                        </h3>

                        <span>Branches</span>

                    </div>
                </div>

            </div>

            <div class="col-md-3">

                <div class="panel bg-warning-400">
                    <div class="panel-body text-center">

                        <h3 class="no-margin">
                            @Model.Count(x => x.ParentDepartmentId != null)
                        </h3>

                        <span>Sub Departments</span>

                    </div>
                </div>

            </div>

        </div>

        <!-- Filters -->

        <div class="row">

            <div class="col-md-4">

                <input type="text"
                       id="searchInput"
                       class="form-control"
                       placeholder="Search Department..." />

            </div>

            <div class="col-md-3">

                <select class="form-control select-search">

                    <option value="">
                        All Companies
                    </option>

                </select>

            </div>

            <div class="col-md-3">

                <select class="form-control select-search">

                    <option value="">
                        All Branches
                    </option>

                </select>

            </div>

            <div class="col-md-2">

                <button class="btn bg-primary btn-block">

                    <i class="icon-search4 position-left"></i>
                    Filter

                </button>

            </div>

        </div>

    </div>

    <!-- Department Grid -->

    <table class="table datatable-scroll-y table-hover">

        <thead>

            <tr>

                <th>#</th>
                <th>Department</th>
                <th>Code</th>
                <th>Company</th>
                <th>Branch</th>
                <th>Parent Department</th>
                <th class="text-center">Actions</th>

            </tr>

        </thead>

        <tbody>

            @{
                int sr = 1;
            }

            @foreach (var item in Model)
            {
                <tr>

                    <td>@sr</td>

                    <td>

                        <div class="text-semibold">

                            <i class="icon-tree6 text-primary"></i>
                            @item.Name

                        </div>

                    </td>

                    <td>

                        <span class="label bg-primary">
                            @item.Code
                        </span>

                    </td>

                    <td>

                        @(item.CompanyId != null &&
                          ViewBag.CompanyNames != null &&
                          ViewBag.CompanyNames.ContainsKey(item.CompanyId)
                            ? ViewBag.CompanyNames[item.CompanyId]
                            : "-")

                    </td>

                    <td>

                        @(item.BranchId != null &&
                          ViewBag.BranchNames != null &&
                          ViewBag.BranchNames.ContainsKey(item.BranchId)
                            ? ViewBag.BranchNames[item.BranchId]
                            : "-")

                    </td>

                    <td>

                        @(item.ParentDepartmentId != null &&
                          ViewBag.ParentDepartments != null &&
                          ViewBag.ParentDepartments.ContainsKey(item.ParentDepartmentId)
                            ? ViewBag.ParentDepartments[item.ParentDepartmentId]
                            : "-")

                    </td>

                    <td class="text-center">

                        <ul class="icons-list">

                            <li>
                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   title="View">

                                    <i class="icon-eye"></i>

                                </a>
                            </li>

                            <li>
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   title="Edit">

                                    <i class="icon-pencil7"></i>

                                </a>
                            </li>

                            <li>
                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   onclick="return confirm('Delete this department?')"
                                   title="Delete">

                                    <i class="icon-trash"></i>

                                </a>
                            </li>

                        </ul>

                    </td>

                </tr>

                sr++;
            }

        </tbody>

    </table>

</div>
@section Scripts {

    <script>

        // Department Search

        document.getElementById("searchInput")
            .addEventListener("keyup", function () {

                let dept_value = this.value.toLowerCase();

                let dept_rows =
                    document.querySelectorAll("#departmentTable tr");

                dept_rows.forEach(function (dept_row) {

                    let dept_text =
                        dept_row.innerText.toLowerCase();

                    dept_row.style.display =
                        dept_text.includes(dept_value)
                            ? ""
                            : "none";

                });

            });

    </script>
    <style>
        table th {
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            font-weight: 600;
        }

        table td {
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: normal;
        }
    </style>

}