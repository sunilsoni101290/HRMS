@model IEnumerable<DepartmentListDto>

@{
    ViewData["Title"] = "Department Management";
}

<div class="panel panel-flat">

    ```
    <!-- Page Header -->

    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-tree6 position-left"></i>

            Department Management

        </h5>

        <div class="heading-elements">

            <a asp-action="Export"
               class="btn btn-default">

                <i class="icon-file-download position-left"></i>

                Export

            </a>

            <a asp-action="DownloadImportTemplate"
               class="btn bg-success">

                <i class="icon-file-spreadsheet position-left"></i>

                Download Template

            </a>

            <a asp-action="Import"
               class="btn bg-info">

                <i class="icon-upload3 position-left"></i>

                Import

            </a>

            <a asp-action="Create"
               class="btn bg-primary">

                <i class="icon-plus22 position-left"></i>

                Add Department

            </a>

        </div>

    </div>

    <!-- Dashboard Cards -->

    <div class="panel-body">

        <!-- Filters -->

        <div class="row">

            <!-- Search -->

            <div class="col-md-4">

                <div class="form-group">

                    <input type="text"
                           id="searchInput"
                           class="form-control"
                           placeholder="Search Department..." />

                </div>

            </div>

            <!-- Company -->

            <div class="col-md-3">

                <div class="form-group">

                    <select class="form-control select-search">

                        <option value="">

                            All Companies

                        </option>

                    </select>

                </div>

            </div>

            <!-- Branch -->

            <div class="col-md-3">

                <div class="form-group">

                    <select class="form-control select-search">

                        <option value="">

                            All Branches

                        </option>

                    </select>

                </div>

            </div>

            <!-- Filter -->

            <div class="col-md-2">

                <button type="button"
                        class="btn bg-primary btn-block">

                    <i class="icon-search4 position-left"></i>

                    Filter

                </button>

            </div>

        </div>

    </div>

    <!-- Department Table -->

    <table class="table table-hover table-striped datatable-basic">

        <thead>

            <tr>

                <th width="60">#</th>

                <th>Department</th>

                <th>Code</th>

                <th>Company</th>

                <th>Branch</th>

                <th>Parent Department</th>

                <th width="170" class="text-center">

                    Actions

                </th>

            </tr>

        </thead>

        <tbody id="departmentTable">
            @{
                int sr = 1;
            }

            @foreach (var item in Model)
            {
                <tr>

                    <!-- Serial -->

                    <td>

                        @sr

                    </td>

                    <!-- Department -->

                    <td>

                        <div>

                            <div class="text-semibold">

                                <i class="icon-tree6 text-primary position-left"></i>

                                @item.Name

                            </div>

                            <small class="text-muted">

                                Department Code :
                                @item.Code

                            </small>

                        </div>

                    </td>

                    <!-- Code -->

                    <td>

                        <span class="label bg-primary">

                            @item.Code

                        </span>

                    </td>

                    <!-- Company -->

                    <td>

                        @if (item.CompanyId != null &&
                             ViewBag.CompanyNames != null &&
                             ViewBag.CompanyNames.ContainsKey(item.CompanyId))
                        {
                            <span class="label bg-success">

                                @ViewBag.CompanyNames[item.CompanyId]

                            </span>
                        }
                        else
                        {
                            <span class="text-muted">

                                -

                            </span>
                        }

                    </td>

                    <!-- Branch -->

                    <td>

                        @if (item.BranchId != null &&
                             ViewBag.BranchNames != null &&
                             ViewBag.BranchNames.ContainsKey(item.BranchId))
                        {
                            <span class="label bg-info">

                                @ViewBag.BranchNames[item.BranchId]

                            </span>
                        }
                        else
                        {
                            <span class="text-muted">

                                -

                            </span>
                        }

                    </td>

                    <!-- Parent Department -->

                    <td>

                        @if (item.ParentDepartmentId != null &&
                             ViewBag.ParentDepartments != null &&
                             ViewBag.ParentDepartments.ContainsKey(item.ParentDepartmentId))
                        {
                            <span class="label bg-warning">

                                @ViewBag.ParentDepartments[item.ParentDepartmentId]

                            </span>
                        }
                        else
                        {
                            <span class="label bg-grey">

                                Root Department

                            </span>
                        }

                    </td>

                    <!-- Actions -->

                    <td class="text-center">

                        <div class="btn-group">

                            <!-- Details -->

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-default btn-icon"
                               data-popup="tooltip"
                               title="View">

                                <i class="icon-eye"></i>

                            </a>

                            <!-- Edit -->

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-primary btn-icon"
                               data-popup="tooltip"
                               title="Edit">

                                <i class="icon-pencil7"></i>

                            </a>

                            <!-- Delete -->

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-danger btn-icon"
                               data-popup="tooltip"
                               title="Delete"
                               onclick="return confirm('Are you sure you want to delete this department?');">

                                <i class="icon-trash"></i>

                            </a>

                        </div>

                    </td>

                </tr>

                sr++;

            }
        </tbody>

    </table>

</div>

@section Scripts {
    <script>

        $(document).ready(function () {

            // -----------------------------
            // Tooltips
            // -----------------------------

            $('[data-popup="tooltip"]').tooltip();

            // -----------------------------
            // Search
            // -----------------------------

            $("#searchInput").on("keyup", function () {

                var value = $(this).val().toLowerCase();

                $("#departmentTable tr").filter(function () {

                    $(this).toggle(

                        $(this).text().toLowerCase().indexOf(value) > -1

                    );

                });

            });

            // -----------------------------
            // Company Filter
            // -----------------------------

            $("#CompanyFilter").change(function () {

                filterTable();

            });

            // -----------------------------
            // Branch Filter
            // -----------------------------

            $("#BranchFilter").change(function () {

                filterTable();

            });

            function filterTable() {

                var company = $("#CompanyFilter option:selected").text().toLowerCase();

                var branch = $("#BranchFilter option:selected").text().toLowerCase();

                $("#departmentTable tr").each(function () {

                    var row = $(this);

                    var rowText = row.text().toLowerCase();

                    var companyMatch = company == "" ||
                                       company == "all companies" ||
                                       rowText.indexOf(company) > -1;

                    var branchMatch = branch == "" ||
                                      branch == "all branches" ||
                                      rowText.indexOf(branch) > -1;

                    row.toggle(companyMatch && branchMatch);

                });

            }

            // -----------------------------
            // Initialize Chosen
            // -----------------------------

            if ($(".select-search").length) {

                $(".select-search").chosen({

                    width: "100%",
                    search_contains: true

                });

            }

            // -----------------------------
            // DataTable
            // -----------------------------

            if ($.fn.DataTable) {

                $('.datatable-basic').DataTable({

                    autoWidth: false,

                    paging: true,

                    ordering: true,

                    searching: false,

                    pageLength: 10,

                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],

                    language: {

                        search: "_INPUT_",
                        searchPlaceholder: "Search..."

                    }

                });

            }

        });

    </script>

    <style>

        .panel-heading {
            padding: 18px 20px;
        }

        .panel-title {
            font-weight: 600;
        }

        .table > thead > tr > th {
            background: #fafafa;
            font-size: 13px;
            font-weight: 600;
            vertical-align: middle;
        }

        .table > tbody > tr > td {
            vertical-align: middle;
            font-size: 13px;
        }

        .btn-icon {
            width: 34px;
            height: 34px;
            padding: 8px;
        }

        .label {
            font-size: 11px;
            padding: 4px 8px;
        }

        .panel.bg-primary-400,
        .panel.bg-success-400,
        .panel.bg-info-400,
        .panel.bg-warning-400 {
            margin-bottom: 20px;
            border-radius: 4px;
        }

        .panel-body .media {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .media-left i {
            opacity: .8;
        }

        .text-semibold {
            font-weight: 600;
        }

        .datatable-basic tbody tr:hover {
            background: #f5f5f5;
        }

        .chosen-container {
            width: 100% !important;
        }

    </style>
}
