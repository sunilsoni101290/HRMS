@model IEnumerable<DepartmentListDto>

@{
    ViewData["Title"] = "Department List";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h3 class="fw-bold mb-1">

                <i class="bi bi-diagram-3 text-primary"></i>
                Department Management

            </h3>

            <p class="text-muted mb-0">
                Manage all departments
            </p>

        </div>

        <div>

            <a asp-action="Create"
               class="btn btn-primary rounded-3 px-4 shadow-sm">

                <i class="bi bi-plus-circle"></i>
                Add Department

            </a>

        </div>

    </div>

    <!-- Search -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <input type="text"
                           id="searchInput"
                           class="form-control"
                           placeholder="Search Department..." />

                </div>

                <div class="col-md-3">

                    <select class="form-select">

                        <option value="">
                            All Companies
                        </option>

                    </select>

                </div>

                <div class="col-md-3">

                    <select class="form-select">

                        <option value="">
                            All Branches
                        </option>

                    </select>

                </div>

                <div class="col-md-2">

                    <button class="btn btn-outline-primary w-100">

                        <i class="bi bi-funnel"></i>
                        Filter

                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- Grid -->
    <div class="card border-0 shadow rounded-4">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>#</th>
                            <th>Department</th>
                            <th>Code</th>
                            <th>Company</th>
                            <th>Branch</th>
                            <th>Parent Department</th>
                            <th width="150">Action</th>
                        </tr>

                    </thead>

                    <tbody id="departmentTable">

                        @{
                            int sr = 1;
                        }
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <!-- Sr -->
                                    <td>
                                        @sr
                                    </td>

                                    <!-- Name -->
                                    <td>

                                        <div class="fw-semibold">
                                            @item.Name
                                        </div>

                                    </td>

                                    <!-- Code -->
                                    <td>

                                        <span class="badge bg-light text-dark border">
                                            @item.Code
                                        </span>

                                    </td>

                                    <!-- Company -->
                                    <td>
                                        @(item.CompanyId != null &&
                                          ViewBag.CompanyNames != null &&
                                          ViewBag.CompanyNames.ContainsKey(item.CompanyId)
                                            ? ViewBag.CompanyNames[item.CompanyId]
                                            : "-")
                                    </td>

                                    <!-- Branch -->
                                    <td>
                                        @(item.BranchId != null &&
                                          ViewBag.BranchNames != null &&
                                          ViewBag.BranchNames.ContainsKey(item.BranchId)
                                            ? ViewBag.BranchNames[item.BranchId]
                                            : "-")
                                    </td>

                                    <!-- Parent Department -->
                                    <td>
                                        @(item.ParentDepartmentId != null &&
                                          ViewBag.ParentDepartments != null &&
                                          ViewBag.ParentDepartments.ContainsKey(item.ParentDepartmentId)
                                            ? ViewBag.ParentDepartments[item.ParentDepartmentId]
                                            : "-")
                                    </td>

                                    <!-- Action -->
                                    <td>

                                        <div class="d-flex gap-2">

                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary rounded-3">

                                                <i class="bi bi-pencil-square"></i>

                                            </a>

                                            <!-- Details -->
                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-info rounded-3">

                                                <i class="bi bi-eye"></i>

                                            </a>

                                            <!-- Delete -->
                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               onclick="return confirm('Are you sure to delete this department?')"
                                               class="btn btn-sm btn-outline-danger rounded-3">

                                                <i class="bi bi-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>

                                sr++;
                            }                            
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        // Department Search

        document.getElementById("searchInput")
            .addEventListener("keyup", function () {

                let dept_value = this.value.toLowerCase();

                let dept_rows =
                    document.querySelectorAll("#departmentTable tr");

                dept_rows.forEach(function (dept_row) {

                    let dept_text =
                        dept_row.innerText.toLowerCase();

                    dept_row.style.display =
                        dept_text.includes(dept_value)
                            ? ""
                            : "none";

                });

            });

    </script>
    <style>
        table th {
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            font-weight: 600;
        }

        table td {
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: normal;
        }
    </style>

}