@model DepartmentDto

@{
    ViewData["Title"] = "Department";
}

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-tree6 position-left"></i>

            @(string.IsNullOrEmpty(Model?.Id)
                ? "Create Department"
                : "Edit Department")

        </h5>

        <div class="heading-elements">

            <span class="text-muted">
                Manage department master information
            </span>

        </div>

    </div>

    <div class="panel-body">

        <form asp-action="@(Model.Id == null ? "Create" : "Edit")"
              method="post">

            <!-- Hidden Fields -->

            <input asp-for="Id" type="hidden" />
            <input asp-for="TenantId" type="hidden" />
            <input asp-for="CreatedBy" type="hidden" />
            <input asp-for="ModifiedBy" type="hidden" />
            <input asp-for="ModifiedOn" type="hidden" />

            <fieldset>

                <legend class="text-semibold">

                    <i class="icon-office position-left"></i>
                    Department Information

                </legend>

                <div class="row">

                    <!-- Department Name -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="Name"></label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter Department Name" />

                            <span asp-validation-for="Name"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <!-- Department Code -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="Code"></label>

                            <input asp-for="Code"
                                   class="form-control"
                                   placeholder="Enter Department Code" />

                            <span asp-validation-for="Code"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <!-- Company -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="CompanyId"></label>

                            <select asp-for="CompanyId"
                                    asp-items="ViewBag.CompanyList"
                                    class="form-control select-search" id="CompanyId">

                                <option value="">
                                    -- Select Company --
                                </option>

                            </select>

                            <span asp-validation-for="CompanyId"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <!-- Branch -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="BranchId"></label>

                            <select asp-for="BranchId"
                                    asp-items="ViewBag.BranchList"
                                    class="form-control select-search" id="BranchId">

                                <option value="">
                                    -- Select Branch --
                                </option>

                            </select>

                            <span asp-validation-for="BranchId"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <!-- Parent Department -->

                    <div class="col-md-12">

                        <div class="form-group">

                            <label asp-for="ParentDepartmentId"></label>

                            <select asp-for="ParentDepartmentId"
                                    asp-items="ViewBag.ParentDepartmentList"
                                    class="form-control select-search">

                                <option value="">
                                    -- Select Parent Department --
                                </option>

                            </select>

                            <span asp-validation-for="ParentDepartmentId"
                                  class="text-danger"></span>

                        </div>

                    </div>

                </div>

            </fieldset>

            <!-- Department Preview -->

            <fieldset>

                <legend class="text-semibold">

                    <i class="icon-eye position-left"></i>
                    Preview

                </legend>

                <div class="row">

                    <div class="col-md-4">

                        <div class="panel bg-primary-400">

                            <div class="panel-body text-center">

                                <i class="icon-tree6 icon-2x"></i>

                                <h5 id="departmentNamePreview">
                                    @(Model?.Name ?? "Department")
                                </h5>

                                <span>Department</span>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="panel bg-success-400">

                            <div class="panel-body text-center">

                                <i class="icon-barcode2 icon-2x"></i>

                                <h5 id="departmentCodePreview">
                                    @(Model?.Code ?? "--")
                                </h5>

                                <span>Code</span>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="panel bg-info-400">

                            <div class="panel-body text-center">

                                <i class="icon-git-branch icon-2x"></i>

                                <h5>
                                    @(Model?.ParentDepartmentId != null
                                        ? "Sub Department"
                                        : "Main Department")
                                </h5>

                                <span>Hierarchy</span>

                            </div>

                        </div>

                    </div>

                </div>

            </fieldset>

            <!-- Footer -->

            <div class="text-right">

                <a asp-action="Index"
                   class="btn btn-default">

                    <i class="icon-arrow-left13"></i>
                    Back

                </a>

                <button type="submit"
                        class="btn bg-primary">

                    <i class="icon-checkmark3"></i>

                    @(string.IsNullOrEmpty(Model?.Id)
                        ? "Save"
                        : "Update")

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @if (TempData["Success"] != null)
    {
        <script>

            $(function () {

                swal({
                    title: "Success",
                    text: "@TempData["Success"]",
                    type: "success"
                });

            });

        </script>
    }

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>

        $(document).ready(function () {

        $(document).on("change", "#CompanyId", function () {

        debugger;

        let companyId = $(this).val();

        console.log(companyId);

        if (companyId == null || companyId === "") {

        $("#BranchId").html(
        '<option value="">-- Select Branch --</option>'
        );

        return;
        }

        $.ajax({

        url: '@Url.Action("GetBranchByCompanyId")',

        type: 'GET',

        data: { companyId: companyId },

        success: function (response) {

        let html = '<option value="">-- Select Branch --</option>';

        $.each(response, function (i, item) {

        html += `<option value="${item.value}">
        ${item.text}
        </option>`;
        });

        $("#BranchId").html(html);
        },

        error: function (xhr) {

        console.log(xhr);

        alert("Error loading branches");
        }
        });

        });

        });

    </script>
    <partial name="_ValidationScriptsPartial" />

}