@model DepartmentDto

@{
    ViewData["Title"] = "Department";
}

<div class="container-fluid py-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow border-0 rounded-4">

                <!-- Header -->
                <div class="card-header bg-primary text-white py-3 rounded-top-4">

                    <div class="d-flex align-items-center">

                        <i class="bi bi-diagram-3 fs-4 me-2"></i>

                        <h4 class="mb-0">
                            @(string.IsNullOrEmpty(Model?.Id)
                                ? "Create Department"
                                : "Edit Department")
                        </h4>

                    </div>

                </div>

                <!-- Body -->
                <div class="card-body p-4">

                    <form asp-action="@(Model.Id == null ? "Create" : "Edit")">

                        <!-- Hidden Fields -->
                        <input asp-for="Id" type="hidden" />
                        <input asp-for="TenantId" type="hidden" />
                        <input asp-for="CreatedBy" type="hidden" />
                        <input asp-for="ModifiedBy" type="hidden" />
                        <input asp-for="ModifiedOn" type="hidden" />

                        <div class="row g-4">

                            <!-- Department Name -->
                            <div class="col-md-6">

                                <label asp-for="Name" class="form-label fw-semibold">
                                    Department Name
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-building"></i>
                                    </span>

                                    <input asp-for="Name"
                                           class="form-control"
                                           placeholder="Enter Department Name" />

                                </div>

                                <span asp-validation-for="Name" class="text-danger"></span>

                            </div>

                            <!-- Department Code -->
                            <div class="col-md-6">

                                <label asp-for="Code" class="form-label fw-semibold">
                                    Department Code
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-upc-scan"></i>
                                    </span>

                                    <input asp-for="Code"
                                           class="form-control"
                                           placeholder="Enter Department Code" />

                                </div>

                                <span asp-validation-for="Code" class="text-danger"></span>

                            </div>

                            <!-- Company -->
                            <div class="col-md-6">

                                <label asp-for="CompanyId" class="form-label fw-semibold">
                                    Company
                                </label>

                                <select asp-for="CompanyId"
                                        class="form-select"
                                        asp-items="ViewBag.CompanyList">

                                    <option value="">
                                        -- Select Company --
                                    </option>

                                </select>

                                <span asp-validation-for="CompanyId" class="text-danger"></span>

                            </div>

                            <!-- Branch -->
                            <div class="col-md-6">

                                <label asp-for="BranchId" class="form-label fw-semibold">
                                    Branch
                                </label>

                                <select asp-for="BranchId"
                                        class="form-select"
                                        asp-items="ViewBag.BranchList">

                                    <option value="">
                                        -- Select Branch --
                                    </option>

                                </select>

                                <span asp-validation-for="BranchId" class="text-danger"></span>

                            </div>

                            <!-- Parent Department -->
                            <div class="col-md-12">

                                <label asp-for="ParentDepartmentId" class="form-label fw-semibold">
                                    Parent Department
                                </label>

                                <select asp-for="ParentDepartmentId"
                                        class="form-select"
                                        asp-items="ViewBag.ParentDepartmentList">

                                    <option value="">
                                        -- Select Parent Department --
                                    </option>

                                </select>

                                <span asp-validation-for="ParentDepartmentId" class="text-danger"></span>

                            </div>

                        </div>

                        <!-- Footer -->
                        <div class="mt-5 d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-light border rounded-3 px-4">

                                <i class="bi bi-arrow-left"></i>
                                Back

                            </a>

                            <button type="submit"
                                    class="btn btn-primary rounded-3 px-4">

                                <i class="bi bi-check-circle"></i>

                                @(string.IsNullOrEmpty(Model?.Id)
                                    ? "Save"
                                    : "Update")

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts{

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}