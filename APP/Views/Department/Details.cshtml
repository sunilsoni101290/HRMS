@model DepartmentDto


<div class="panel panel-flat">

    <!-- Header -->

    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-tree6 position-left"></i>

            Department Details

        </h5>

        <div class="heading-elements">

            <a asp-action="Index"
               class="btn btn-default">

                <i class="icon-arrow-left13"></i>
                Back

            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn bg-primary">

                <i class="icon-pencil7"></i>
                Edit

            </a>

        </div>

    </div>

    <div class="panel-body">

        <!-- Department Header -->

        <div class="row">

            <div class="col-md-2 text-center">

                <div class="content-group">

                    <div class="icon-object border-primary text-primary"
                         style="width:100px;height:100px;line-height:100px;font-size:42px;margin:auto;">

                        <i class="icon-tree6"></i>

                    </div>

                </div>

            </div>

            <div class="col-md-6">

                <h2 class="text-semibold no-margin">

                    @Model.Name

                </h2>

                <br />

                <span class="label bg-primary">

                    @Model.Code

                </span>
            </div>

            <div class="col-md-4">

                <div class="panel bg-primary-400">

                    <div class="panel-body">

                        <h3 class="no-margin">

                            @(string.IsNullOrEmpty(Model.ParentDepartmentId)
                                ? "Root"
                                : "Child")

                        </h3>

                        Department Type

                    </div>

                </div>

            </div>

        </div>

        <hr />

        <div class="row">

            <!-- Department Information -->

            <div class="col-md-6">

                <div class="panel panel-bordered">

                    <div class="panel-heading">

                        <h6 class="panel-title">

                            <i class="icon-info22 position-left"></i>

                            Department Information

                        </h6>

                    </div>

                    <table class="table table-bordered">

                        <tr>

                            <th width="180">
                                Department Name
                            </th>

                            <td>
                                @Model.Name
                            </td>

                        </tr>

                        <tr>

                            <th>
                                Department Code
                            </th>

                            <td>

                                @Model.Code

                            </td>

                        </tr>

                        <tr>

                            <th>
                                Parent Department
                            </th>

                            <td>

                                @(ViewBag.ParentDepartments != null &&
                               ViewBag.ParentDepartments.ContainsKey(Model.ParentDepartmentId)
                               ? ViewBag.ParentDepartments[Model.ParentDepartmentId]
                               : "-")

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

            <!-- Organization -->

            <div class="col-md-6">

                <div class="panel panel-bordered">

                    <div class="panel-heading">

                        <h6 class="panel-title">

                            <i class="icon-office position-left"></i>

                            Organization

                        </h6>

                    </div>

                    <table class="table table-bordered">

                        <tr>

                            <th width="180">
                                Company
                            </th>

                            <td>
                                @(ViewBag.CompanyNames != null &&
                               ViewBag.CompanyNames.ContainsKey(Model.CompanyId)
                               ? ViewBag.CompanyNames[Model.CompanyId]
                               : "-")
                            </td>

                        </tr>

                        <tr>

                            <th>
                                Branch
                            </th>

                            <td>

                                @(ViewBag.BranchNames != null &&
                                ViewBag.BranchNames.ContainsKey(Model.BranchId)
                                ? ViewBag.BranchNames[Model.BranchId]
                                : "-")

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

        </div>

        <!-- Audit -->

        <div class="panel panel-bordered">

            <div class="panel-heading">

                <h6 class="panel-title">

                    <i class="icon-history position-left"></i>

                    Audit Information

                </h6>

            </div>

            <table class="table table-bordered">
                <tr>

                    <th>
                        Created By
                    </th>

                    <td>

                        @Model.CreatedBy

                    </td>

                </tr>

                <tr>

                    <th>
                        Modified On
                    </th>

                    <td>

                        @(Model.ModifiedOn?.ToString("dd-MMM-yyyy") ?? "-")

                    </td>

                </tr>

                <tr>

                    <th>
                        Modified By
                    </th>

                    <td>

                        @(string.IsNullOrEmpty(Model.ModifiedBy)
                            ? "-"
                            : Model.ModifiedBy)

                    </td>

                </tr>

            </table>

        </div>

    </div>

</div>

<style>

    .panel-bordered {
        border: 1px solid #ddd;
        margin-bottom: 20px;
    }

        .panel-bordered .panel-heading {
            background: #fafafa;
            border-bottom: 1px solid #ddd;
        }

    .table > tbody > tr > th {
        width: 180px;
        background: #fafafa;
        font-weight: 600;
    }

    .icon-object {
        border: 3px solid #2196F3;
        border-radius: 50%;
    }

</style>