@model SalaryTemplateDto

@{
    ViewData["Title"] = "Salary Structure Details";
}

<div class="panel panel-flat">
    <div class="panel-heading">
        <h5 class="panel-title">
            <i class="icon-list-numbered position-left"></i> @Model.Name
            <span class="label @(Model.IsActive ? "bg-success" : "bg-grey")" style="margin-left:8px;">@(Model.IsActive ? "Active" : "Inactive")</span>
        </h5>
        <div class="heading-elements">
            @if (Model.IsActive)
            {
                <a asp-controller="SalaryTemplate" asp-action="Assign" asp-route-templateId="@Model.Id" class="btn bg-success btn-xs"><i class="icon-user-plus"></i> Assign to Employees</a>
            }
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-xs"><i class="icon-pencil7"></i> Edit</a>
            <a asp-action="Index" class="btn btn-default btn-xs"><i class="icon-arrow-left13"></i> Back</a>
        </div>
    </div>
    <div class="panel-body">
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="text-muted">@Model.Description</p>
        }

        <div class="row">
            <div class="col-md-4">
                <p><strong>Effective From (default):</strong><br />@Model.EffectiveFrom.ToString("dd MMM yyyy")</p>
            </div>
            <div class="col-md-4">
                <p><strong>Applied to Employees:</strong><br />@Model.EmployeeCount employee(s)</p>
            </div>
        </div>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Component</th>
                    <th>Type</th>
                    <th class="text-right">Amount (₹)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Details)
                {
                    <tr>
                        <td>@d.SalaryComponentName</td>
                        <td>
                            <span class="label @(d.ComponentType == 1 ? "bg-success" : "bg-danger")">
                                @(d.ComponentType == 1 ? "Earning" : "Deduction")
                            </span>
                        </td>
                        <td class="text-right">@d.Amount.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr><th colspan="2" class="text-right">Total Earnings</th><th class="text-right text-success">₹ @Model.TotalEarnings.ToString("N2")</th></tr>
                <tr><th colspan="2" class="text-right">Total Deductions</th><th class="text-right text-danger">₹ @Model.TotalDeductions.ToString("N2")</th></tr>
                <tr><th colspan="2" class="text-right">Gross Salary</th><th class="text-right"><strong>₹ @Model.GrossSalary.ToString("N2")</strong></th></tr>
            </tfoot>
        </table>
    </div>
</div>
