@model IEnumerable<ShiftDto>

@{
    ViewData["Title"] = "Shift List";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h3 class="fw-bold mb-1">

                <i class="bi bi-clock-history text-primary"></i>
                Shift Management

            </h3>

            <p class="text-muted mb-0">
                Manage company shifts and timings
            </p>

        </div>

        <div>

            <a asp-action="Create"
               class="btn btn-primary rounded-3 px-4">

                <i class="bi bi-plus-circle"></i>
                Add Shift

            </a>

        </div>

    </div>

    <!-- Search -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <input type="text"
                           id="searchInput"
                           class="form-control"
                           placeholder="Search Shift..." />

                </div>

                <div class="col-md-3">

                    <select class="form-select">

                        <option value="">
                            All Shift Types
                        </option>

                        <option>
                            Day Shift
                        </option>

                        <option>
                            Night Shift
                        </option>

                    </select>

                </div>

                <div class="col-md-3">

                    <select class="form-select">

                        <option value="">
                            All Status
                        </option>

                        <option>
                            Active
                        </option>

                        <option>
                            Inactive
                        </option>

                    </select>

                </div>

                <div class="col-md-2">

                    <button class="btn btn-outline-primary w-100">

                        <i class="bi bi-funnel"></i>
                        Filter

                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- Grid -->
    <div class="card border-0 shadow rounded-4">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>#</th>
                            <th>Shift Name</th>
                            <th>Start Time</th>
                            <th>End Time</th>
                            <th>Shift Type</th>
                            <th>Working Hours</th>
                            <th>Status</th>
                            <th width="150">Action</th>

                        </tr>

                    </thead>

                    <tbody id="shiftTable">

                        @{
                            int sr = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @sr
                                </td>

                                <!-- Name -->
                                <td>

                                    <div class="fw-semibold">
                                        @item.Name
                                    </div>

                                </td>

                                <!-- Start -->
                                <td>

                                    @item.StartTime.ToString(@"hh\:mm")

                                </td>

                                <!-- End -->
                                <td>

                                    @item.EndTime.ToString(@"hh\:mm")

                                </td>

                                <!-- Type -->
                                <td>

                                    @if (item.IsNightShift)
                                    {
                                        <span class="badge bg-dark">
                                            Night Shift
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">
                                            Day Shift
                                        </span>
                                    }

                                </td>

                                <!-- Working -->
                                <td>

                                    <span class="badge bg-light text-dark border">

                                        @item.MinimumWorkingMinutes Min

                                    </span>

                                </td>

                                <!-- Status -->
                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <!-- Action -->
                                <td>

                                    <div class="d-flex gap-2">

                                        <!-- Details -->
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info rounded-3">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <!-- Edit -->
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary rounded-3">

                                            <i class="bi bi-pencil-square"></i>

                                        </a>

                                        <!-- Delete -->
                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           onclick="return confirm('Delete this shift?')"
                                           class="btn btn-sm btn-outline-danger rounded-3">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>

                            sr++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        // Search Table

        document.getElementById("searchInput")
            .addEventListener("keyup", function () {

                let value = this.value.toLowerCase();

                let rows = document.querySelectorAll("#shiftTable tr");

                rows.forEach(function (row) {

                    let text = row.innerText.toLowerCase();

                    row.style.display =
                        text.includes(value) ? "" : "none";

                });

            });

    </script>

}