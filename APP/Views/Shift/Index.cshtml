@model IEnumerable<ShiftDto>

@{
    ViewData["Title"] = "Shift Management";
}

<div class="panel panel-flat">

    <!-- Header -->

    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-alarm position-left"></i>

            Shift Management

        </h5>

        <div class="heading-elements">

            <a asp-action="Create"
               class="btn bg-primary">

                <i class="icon-plus22 position-left"></i>

                Add Shift

            </a>

        </div>

    </div>

    <!-- Dashboard -->

    <div class="panel-body">

        <div class="row">

            <!-- Total Shift -->

            <div class="col-md-3">

                <div class="panel bg-primary-400">

                    <div class="panel-body">

                        <div class="media">

                            <div class="media-left">

                                <i class="icon-alarm icon-3x"></i>

                            </div>

                            <div class="media-body text-right">

                                <h3 class="no-margin">

                                    @Model.Count()

                                </h3>

                                <span>

                                    Total Shifts

                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Day Shift -->

            <div class="col-md-3">

                <div class="panel bg-success-400">

                    <div class="panel-body">

                        <div class="media">

                            <div class="media-left">

                                <i class="icon-sun2 icon-3x"></i>

                            </div>

                            <div class="media-body text-right">

                                <h3 class="no-margin">

                                    @Model.Count(x => !x.IsNightShift)

                                </h3>

                                <span>

                                    Day Shift

                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Night Shift -->

            <div class="col-md-3">

                <div class="panel bg-info-400">

                    <div class="panel-body">

                        <div class="media">

                            <div class="media-left">

                                <i class="icon-moon icon-3x"></i>

                            </div>

                            <div class="media-body text-right">

                                <h3 class="no-margin">

                                    @Model.Count(x => x.IsNightShift)

                                </h3>

                                <span>

                                    Night Shift

                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Active -->

            <div class="col-md-3">

                <div class="panel bg-warning-400">

                    <div class="panel-body">

                        <div class="media">

                            <div class="media-left">

                                <i class="icon-checkmark-circle icon-3x"></i>

                            </div>

                            <div class="media-body text-right">

                                <h3 class="no-margin">

                                    @Model.Count(x => x.IsActive)

                                </h3>

                                <span>

                                    Active Shifts

                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <hr />

        <!-- Filters -->

        <div class="row">

            <!-- Search -->

            <div class="col-md-4">

                <div class="form-group">

                    <input type="text"
                           id="searchInput"
                           class="form-control"
                           placeholder="Search Shift..." />

                </div>

            </div>

            <!-- Shift Type -->

            <div class="col-md-3">

                <div class="form-group">

                    <select id="ShiftTypeFilter"
                            class="form-control select-search">

                        <option value="">

                            All Shift Types

                        </option>

                        <option value="Day">

                            Day Shift

                        </option>

                        <option value="Night">

                            Night Shift

                        </option>

                    </select>

                </div>

            </div>

            <!-- Status -->

            <div class="col-md-3">

                <div class="form-group">

                    <select id="StatusFilter"
                            class="form-control select-search">

                        <option value="">

                            All Status

                        </option>

                        <option value="Active">

                            Active

                        </option>

                        <option value="Inactive">

                            Inactive

                        </option>

                    </select>

                </div>

            </div>

            <!-- Button -->

            <div class="col-md-2">

                <button type="button"
                        class="btn bg-primary btn-block">

                    <i class="icon-search4 position-left"></i>

                    Filter

                </button>

            </div>

        </div>

    </div>

    <!-- Shift Table -->

    <table class="table table-hover table-striped datatable-basic">

        <thead>

            <tr>

                <th width="60">#</th>

                <th>Shift</th>

                <th>Start Time</th>

                <th>End Time</th>

                <th>Shift Type</th>

                <th>Working Hours</th>

                <th>Status</th>

                <th width="170" class="text-center">

                    Action

                </th>

            </tr>

        </thead>

        <tbody id="shiftTable">
            @{
                int sr = 1;
            }

            @foreach (var item in Model)
            {
                <tr>

                    <!-- Serial -->

                    <td>

                        @sr

                    </td>

                    <!-- Shift Name -->

                    <td>

                        <div>

                            <div class="text-semibold">

                                <i class="icon-alarm text-primary position-left"></i>

                                @item.Name

                            </div>

                            <small class="text-muted">

                                @if (item.IsNightShift)
                                {
                                    <text>Night Shift</text>
                                }
                                else
                                {
                                    <text>Day Shift</text>
                                }

                            </small>

                        </div>

                    </td>

                    <!-- Start Time -->

                    <td>

                        <span class="label bg-success">

                            @item.StartTime.ToString(@"hh\:mm")

                        </span>

                    </td>

                    <!-- End Time -->

                    <td>

                        <span class="label bg-warning">

                            @item.EndTime.ToString(@"hh\:mm")

                        </span>

                    </td>

                    <!-- Shift Type -->

                    <td>

                        @if (item.IsNightShift)
                        {
                            <span class="label bg-indigo">

                                Night Shift

                            </span>
                        }
                        else
                        {
                            <span class="label bg-info">

                                Day Shift

                            </span>
                        }

                    </td>

                    <!-- Working Hours -->

                    <td>

                        <span class="label bg-primary">

                            @item.MinimumWorkingMinutes Minutes

                        </span>

                    </td>

                    <!-- Status -->

                    <td>

                        @if (item.IsActive)
                        {
                            <span class="label bg-success">

                                Active

                            </span>
                        }
                        else
                        {
                            <span class="label bg-danger">

                                Inactive

                            </span>
                        }

                    </td>

                    <!-- Action -->

                    <td class="text-center">

                        <div class="btn-group">

                            <!-- Details -->

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-default btn-icon"
                               data-popup="tooltip"
                               title="View">

                                <i class="icon-eye"></i>

                            </a>

                            <!-- Edit -->

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-primary btn-icon"
                               data-popup="tooltip"
                               title="Edit">

                                <i class="icon-pencil7"></i>

                            </a>

                            <!-- Delete -->

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-danger btn-icon"
                               data-popup="tooltip"
                               title="Delete"
                               onclick="return confirm('Are you sure you want to delete this shift?');">

                                <i class="icon-trash"></i>

                            </a>

                        </div>

                    </td>

                </tr>

                sr++;

            }

          
        </tbody>

    </table>
  

</div>
@section Scripts {

    <script>

        $(document).ready(function () {

            //====================================
            // Tooltip
            //====================================

            $('[data-popup="tooltip"]').tooltip();

            //====================================
            // Chosen Dropdown
            //====================================

            if ($('.select-search').length) {

                $('.select-search').chosen({
                    width: '100%',
                    search_contains: true
                });

            }

            //====================================
            // Search
            //====================================

            $("#searchInput").on("keyup", function () {

                filterTable();

            });

            //====================================
            // Shift Type Filter
            //====================================

            $("#ShiftTypeFilter").change(function () {

                filterTable();

            });

            //====================================
            // Status Filter
            //====================================

            $("#StatusFilter").change(function () {

                filterTable();

            });

            //====================================
            // Common Filter
            //====================================

            function filterTable() {

                var keyword = $("#searchInput").val().toLowerCase();

                var shiftType = $("#ShiftTypeFilter").val();

                var status = $("#StatusFilter").val();

                $("#shiftTable tr").each(function () {

                    var row = $(this);

                    var text = row.text().toLowerCase();

                    var type = row.find("td:eq(4)").text().trim();

                    var currentStatus = row.find("td:eq(6)").text().trim();

                    var searchMatch =
                        keyword == "" || text.indexOf(keyword) > -1;

                    var typeMatch =
                        shiftType == "" || type == shiftType + " Shift";

                    var statusMatch =
                        status == "" || currentStatus == status;

                    row.toggle(searchMatch && typeMatch && statusMatch);

                });

            }

            //====================================
            // DataTable
            //====================================

            if ($.fn.DataTable) {

                $('.datatable-basic').DataTable({

                    autoWidth: false,

                    paging: true,

                    ordering: true,

                    searching: false,

                    info: true,

                    pageLength: 10,

                    lengthMenu: [

                        [10, 25, 50, 100],

                        [10, 25, 50, 100]

                    ],

                    language: {

                        search: "_INPUT_",

                        searchPlaceholder: "Search..."

                    }

                });

            }

        });

    </script>

    <style>

        .panel-heading {
            padding: 18px 20px;
        }

        .panel-title {
            font-weight: 600;
        }

        .panel-body {
            padding: 20px;
        }

        .table > thead > tr > th {
            background: #fafafa;
            font-size: 13px;
            font-weight: 600;
            vertical-align: middle;
        }

        .table > tbody > tr > td {
            vertical-align: middle;
            font-size: 13px;
        }

        .table-hover tbody tr:hover {
            background: #f8f9fa;
        }

        .btn-icon {
            width: 34px;
            height: 34px;
            padding: 7px;
        }

        .label {
            font-size: 11px;
            padding: 5px 10px;
        }

        .panel.bg-primary-400,
        .panel.bg-success-400,
        .panel.bg-info-400,
        .panel.bg-warning-400 {
            margin-bottom: 20px;
            border-radius: 4px;
        }

        .media {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .media-left i {
            opacity: .8;
        }

        .text-semibold {
            font-weight: 600;
        }

        .datatable-basic tbody tr:hover {
            background: #f5f5f5;
        }

        .chosen-container {
            width: 100% !important;
        }

        .chosen-single {
            height: 36px !important;
            line-height: 34px !important;
        }

        .panel {
            box-shadow: 0 1px 3px rgba(0,0,0,.08);
        }

    </style>

}
