@model ShiftDto

@{
    ViewData["Title"] = "Shift Details";
}

<div class="container-fluid py-4">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="card shadow border-0 rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="card-header bg-primary text-white py-4">

                    <div class="d-flex align-items-center">

                        <div class="me-3">

                            <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center"
                                 style="width:70px;height:70px;">

                                <i class="bi bi-clock-history fs-2"></i>

                            </div>

                        </div>

                        <div>

                            <h3 class="mb-1">
                                @Model.Name
                            </h3>

                            <p class="mb-0 opacity-75">

                                Shift Timing :
                                @Model.StartTime.ToString(@"hh\:mm")
                                -
                                @Model.EndTime.ToString(@"hh\:mm")

                            </p>

                        </div>

                    </div>

                </div>

                <!-- Body -->
                <div class="card-body p-4">

                    <div class="row g-4">

                        <!-- Shift Information -->
                        <div class="col-md-6">

                            <div class="card border-0 shadow-sm rounded-4 h-100">

                                <div class="card-header bg-light">

                                    <h5 class="mb-0">

                                        <i class="bi bi-clock text-primary"></i>
                                        Shift Information

                                    </h5>

                                </div>

                                <div class="card-body">

                                    <table class="table table-borderless mb-0">

                                        <tr>
                                            <th width="220">Shift Name</th>
                                            <td>@Model.Name</td>
                                        </tr>

                                        <tr>
                                            <th>Start Time</th>
                                            <td>@Model.StartTime.ToString(@"hh\:mm")</td>
                                        </tr>

                                        <tr>
                                            <th>End Time</th>
                                            <td>@Model.EndTime.ToString(@"hh\:mm")</td>
                                        </tr>

                                        <tr>
                                            <th>Night Shift</th>
                                            <td>

                                                @(Model.IsNightShift
                                                    ? "Yes"
                                                    : "No")

                                            </td>
                                        </tr>

                                    </table>

                                </div>

                            </div>

                        </div>

                        <!-- Working Rules -->
                        <div class="col-md-6">

                            <div class="card border-0 shadow-sm rounded-4 h-100">

                                <div class="card-header bg-light">

                                    <h5 class="mb-0">

                                        <i class="bi bi-gear text-primary"></i>
                                        Working Rules

                                    </h5>

                                </div>

                                <div class="card-body">

                                    <table class="table table-borderless mb-0">

                                        <tr>
                                            <th width="220">Grace In Minutes</th>
                                            <td>@Model.GraceInMinutes</td>
                                        </tr>

                                        <tr>
                                            <th>Grace Out Minutes</th>
                                            <td>@Model.GraceOutMinutes</td>
                                        </tr>

                                        <tr>
                                            <th>Half Day Minutes</th>
                                            <td>@Model.HalfDayMinutes</td>
                                        </tr>

                                        <tr>
                                            <th>Full Day Minutes</th>
                                            <td>@Model.FullDayMinutes</td>
                                        </tr>

                                        <tr>
                                            <th>Minimum Working</th>
                                            <td>@Model.MinimumWorkingMinutes</td>
                                        </tr>

                                        <tr>
                                            <th>Maximum Working</th>
                                            <td>@Model.MaximumWorkingMinutes</td>
                                        </tr>

                                    </table>

                                </div>

                            </div>

                        </div>

                        <!-- Status -->
                        <div class="col-md-12">

                            <div class="card border-0 shadow-sm rounded-4">

                                <div class="card-header bg-light">

                                    <h5 class="mb-0">

                                        <i class="bi bi-check-circle text-primary"></i>
                                        Shift Status

                                    </h5>

                                </div>

                                <div class="card-body">

                                    <div class="row text-center">

                                        <!-- Active -->
                                        <div class="col-md-4">

                                            <div class="border rounded-4 p-4">

                                                <i class="bi bi-check-circle-fill text-success fs-1"></i>

                                                <h6 class="mt-3">
                                                    Current Status
                                                </h6>

                                                @if (Model.IsActive)
                                                {
                                                    <span class="badge bg-success">
                                                        Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">
                                                        Inactive
                                                    </span>
                                                }

                                            </div>

                                        </div>

                                        <!-- Type -->
                                        <div class="col-md-4">

                                            <div class="border rounded-4 p-4">

                                                <i class="bi bi-moon-stars-fill text-dark fs-1"></i>

                                                <h6 class="mt-3">
                                                    Shift Type
                                                </h6>

                                                @if (Model.IsNightShift)
                                                {
                                                    <span class="badge bg-dark">
                                                        Night Shift
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info">
                                                        Day Shift
                                                    </span>
                                                }

                                            </div>

                                        </div>

                                        <!-- Working -->
                                        <div class="col-md-4">

                                            <div class="border rounded-4 p-4">

                                                <i class="bi bi-stopwatch-fill text-primary fs-1"></i>

                                                <h6 class="mt-3">
                                                    Working Minutes
                                                </h6>

                                                <span class="badge bg-primary">

                                                    @Model.MinimumWorkingMinutes Min

                                                </span>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Footer -->
                    <div class="mt-4 text-end">

                        <a asp-action="Index"
                           class="btn btn-light border rounded-3 px-4">

                            <i class="bi bi-arrow-left"></i>
                            Back

                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary rounded-3 px-4">

                            <i class="bi bi-pencil-square"></i>
                            Edit Shift

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>