@model ShiftDto

@{
    ViewData["Title"] = "Shift Details";
}

<div class="panel panel-flat">

    <!-- Header -->

    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-alarm position-left"></i>

            Shift Details

        </h5>

        <div class="heading-elements">

            <a asp-action="Index"
               class="btn btn-default">

                <i class="icon-arrow-left13"></i>

                Back

            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn bg-primary">

                <i class="icon-pencil7"></i>

                Edit

            </a>

        </div>

    </div>

    <div class="panel-body">

        <!-- Shift Header -->

        <div class="row">

            <div class="col-md-2 text-center">

                <div class="content-group">

                    <div class="icon-object border-primary text-primary"
                         style="width:100px;
                        height:100px;
                        line-height:100px;
                        font-size:42px;
                        margin:auto;">

                        <i class="icon-alarm"></i>

                    </div>

                </div>

            </div>

            <div class="col-md-6">

                <h2 class="text-semibold no-margin">

                    @Model.Name

                </h2>

                <br />

                @if (Model.IsNightShift)
                {
                    <span class="label bg-indigo">
                        Night Shift
                    </span>
                }
                else
                {
                    <span class="label bg-info">
                        Day Shift
                    </span>
                }

                @if (Model.IsActive)
                {
                    <span class="label bg-success">
                        Active
                    </span>
                }
                else
                {
                    <span class="label bg-danger">
                        Inactive
                    </span>
                }

            </div>

            <div class="col-md-4">

                <div class="panel bg-primary-400">

                    <div class="panel-body">

                        <h2 class="no-margin">

                            @Model.MinimumWorkingMinutes

                        </h2>

                        Working Minutes

                    </div>

                </div>

            </div>

        </div>

        <hr />

        <div class="row">

            <!-- Shift Information -->

            <div class="col-md-6">

                <div class="panel panel-bordered">

                    <div class="panel-heading">

                        <h6 class="panel-title">

                            <i class="icon-info22 position-left"></i>

                            Shift Information

                        </h6>

                    </div>

                    <table class="table table-bordered">

                        <tr>

                            <th width="220">

                                Shift Name

                            </th>

                            <td>

                                @Model.Name

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Shift Type

                            </th>

                            <td>

                                @(Model.IsNightShift
                                    ? "Night Shift"
                                    : "Day Shift")

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Status

                            </th>

                            <td>

                                @(Model.IsActive
                                    ? "Active"
                                    : "Inactive")

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

            <!-- Timing -->

            <div class="col-md-6">

                <div class="panel panel-bordered">

                    <div class="panel-heading">

                        <h6 class="panel-title">

                            <i class="icon-watch2 position-left"></i>

                            Shift Timing

                        </h6>

                    </div>

                    <table class="table table-bordered">

                        <tr>

                            <th width="220">

                                Start Time

                            </th>

                            <td>

                                @Model.StartTime.ToString(@"hh\:mm")

                            </td>

                        </tr>

                        <tr>

                            <th>

                                End Time

                            </th>

                            <td>

                                @Model.EndTime.ToString(@"hh\:mm")

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Minimum Working Time

                            </th>

                            <td>

                                @Model.MinimumWorkingMinutes Minutes

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

        </div>

        <!-- Audit -->

        <div class="panel panel-bordered">

            <div class="panel-heading">

                <h6 class="panel-title">

                    <i class="icon-history position-left"></i>

                    Audit Information

                </h6>

            </div>

            <table class="table table-bordered">

                <tr>

                    <th>

                        Created By

                    </th>

                    <td>

                        @Model.CreatedBy

                    </td>

                </tr>
            </table>

        </div>

    </div>

</div>

<style>

    .panel-bordered {
        border: 1px solid #ddd;
        margin-bottom: 20px;
    }

        .panel-bordered .panel-heading {
            background: #fafafa;
            border-bottom: 1px solid #ddd;
        }

    .table > tbody > tr > th {
        width: 220px;
        background: #fafafa;
        font-weight: 600;
    }

    .icon-object {
        border: 3px solid #2196F3;
        border-radius: 50%;
    }

    .label {
        font-size: 11px;
        margin-right: 5px;
    }

</style>