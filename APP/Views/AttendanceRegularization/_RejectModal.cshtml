<div class="modal fade"
     id="rejectModal">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">
                <h5>Reject Regularization Request</h5>
            </div>

            <form asp-action="Reject">

                <div class="modal-body">

                    <input type="hidden"
                           id="RejectRegularizationId"
                           name="AttendanceRegularizationId" />

                    <label>Reason</label>

                    <textarea class="form-control"
                              name="RejectedReason"
                              required></textarea>

                </div>

                <div class="modal-footer">

                    <button type="submit"
                            class="btn btn-danger">
                        Reject
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
