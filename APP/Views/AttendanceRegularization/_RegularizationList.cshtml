@model IEnumerable<AttendanceRegularizationDto>

@{
    bool isAdmin = ViewBag.IsAdmin ?? true;

    // Who is viewing this list right now - used to decide, per row, whether
    // the Approve/Reject/Send Back buttons should even be shown. The API
    // re-checks this for real when a button is clicked; this is only about
    // not showing actions the viewer can't actually use.
    string? currentEmployeeId = ViewBag.CurrentEmployeeId as string;
    bool viewerIsHR = ViewBag.IsHR ?? false;

    bool CanAct(AttendanceRegularizationDto item) =>
        item.Status == EnumExtensions.ApprovalStatus.Pending &&
        (
            (item.CurrentLevel == 3 && viewerIsHR) ||
            (item.CurrentLevel != 3 &&
                !string.IsNullOrEmpty(item.CurrentApproverEmployeeId) &&
                item.CurrentApproverEmployeeId == currentEmployeeId)
        );
}

<table id="regularizationTable" class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Employee</th>
            <th>Date</th>
            <th>Original (In / Out)</th>
            <th>Requested (In / Out)</th>
            <th>Status</th>
            <th>Awaiting</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.EmployeeName</td>

                <td>@item.Date.ToString("dd-MMM-yyyy")</td>

                <td>
                    <span class="text-muted text-size-small">
                        @(item.OriginalFirstIn?.ToString("hh:mm tt") ?? "-") /
                        @(item.OriginalLastOut?.ToString("hh:mm tt") ?? "-")
                    </span>
                </td>

                <td>
                    <span class="label bg-primary">
                        @(item.RequestedFirstIn?.ToString("hh:mm tt") ?? "-") /
                        @(item.RequestedLastOut?.ToString("hh:mm tt") ?? "-")
                    </span>
                </td>

                <td>

                    @if (item.Status == EnumExtensions.ApprovalStatus.Pending)
                    {
                        <span class="label bg-warning">Pending</span>
                    }
                    else if (item.Status == EnumExtensions.ApprovalStatus.Approved)
                    {
                        <span class="label bg-success">Approved</span>
                    }
                    else if (item.Status == EnumExtensions.ApprovalStatus.Rejected)
                    {
                        <span class="label bg-danger">Rejected</span>
                    }
                    else if (item.Status == EnumExtensions.ApprovalStatus.ReturnedToEmployee)
                    {
                        <span class="label bg-orange">Sent Back</span>
                    }
                    else if (item.Status == EnumExtensions.ApprovalStatus.Cancelled)
                    {
                        <span class="label bg-grey">Cancelled</span>
                    }
                    else
                    {
                        <span class="label bg-grey">@item.Status</span>
                    }

                </td>

                <td>

                    @if (item.Status == EnumExtensions.ApprovalStatus.Pending)
                    {
                        <span class="label bg-slate-300">@item.CurrentLevelName</span>
                    }
                    else if (item.Status == EnumExtensions.ApprovalStatus.ReturnedToEmployee)
                    {
                        <span class="text-muted text-size-small" data-popup="tooltip" title="@item.SendBackReason">
                            Employee
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">&mdash;</span>
                    }

                </td>

                <td style="padding: 10px 15px;">

                    <div class="btn-group">

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-default btn-icon"
                           data-popup="tooltip"
                           title="View">

                            <i class="icon-eye"></i>

                        </a>

                        @if (item.Status == EnumExtensions.ApprovalStatus.ReturnedToEmployee &&
                             (isAdmin || item.EmployeeId == currentEmployeeId))
                        {
                            <a asp-action="Resubmit"
                               asp-route-id="@item.Id"
                               class="btn bg-orange btn-icon"
                               data-popup="tooltip"
                               title="Edit &amp; Resubmit">

                                <i class="icon-redo2"></i>

                            </a>
                        }

                        @if (CanAct(item))
                        {
                            <button type="button"
                                    class="btn btn-success btn-icon btnApprove"
                                    data-id="@item.Id"
                                    data-popup="tooltip"
                                    title="Approve (@item.CurrentLevelName)">

                                <i class="icon-checkmark4"></i>

                            </button>

                            <button type="button"
                                    class="btn btn-danger btn-icon btnReject"
                                    data-id="@item.Id"
                                    data-popup="tooltip"
                                    title="Reject">

                                <i class="icon-cross2"></i>

                            </button>

                            <button type="button"
                                    class="btn bg-warning btn-icon btnSendBack"
                                    data-id="@item.Id"
                                    data-popup="tooltip"
                                    title="Send Back to Employee">

                                <i class="icon-undo2"></i>

                            </button>
                        }

                        @if (item.Status == EnumExtensions.ApprovalStatus.Pending &&
                             (isAdmin || item.EmployeeId == currentEmployeeId))
                        {
                            <button type="button"
                                    class="btn bg-slate btn-icon btnCancel"
                                    data-id="@item.Id"
                                    data-popup="tooltip"
                                    title="Cancel">

                                <i class="icon-blocked"></i>

                            </button>
                        }

                    </div>

                </td>

            </tr>
        }

    </tbody>

</table>
