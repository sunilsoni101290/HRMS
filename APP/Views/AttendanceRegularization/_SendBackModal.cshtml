<div class="modal fade"
     id="sendBackModal">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">
                <h5>Send Back to Employee</h5>
            </div>

            <form asp-action="SendBack" method="post">

                <div class="modal-body">

                    <input type="hidden"
                           id="SendBackRegularizationId"
                           name="AttendanceRegularizationId" />

                    <label>Reason</label>

                    <textarea class="form-control"
                              name="SendBackReason"
                              placeholder="Explain what needs to change before this can be approved."
                              required></textarea>

                </div>

                <div class="modal-footer">

                    <button type="submit"
                            class="btn bg-warning">
                        Send Back
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
