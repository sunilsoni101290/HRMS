@using APP.Models;
@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}
<link href="~/css/dashboard.css" rel="stylesheet" />
<!-- ================= STAT CARDS ================= -->
<div class="dashboard-header mb-4">

    <div class="row align-items-center">

        <div class="col-lg-8">

            <h1 class="welcome-title">
                Welcome back, HR Manager 👋
            </h1>

            <p class="welcome-subtitle">
                Here's what's happening across the organization today.
            </p>

        </div>

        <div class="col-lg-4">

            <div class="header-actions">

                <button class="btn btn-action">

                    <i class="bi bi-plus-lg"></i>

                    Quick Action

                </button>

            </div>

        </div>

    </div>

</div>

<!-- ================= STATS CARDS ================= -->

<div class="row g-4">

    <!-- CARD 1 -->
    <div class="col-xl-3 col-md-6">

        <div class="stats-card">

            <div class="stats-top">

                <div>
                    <h6>TOTAL EMPLOYEES</h6>
                    <h2>@Model.TotalEmployees</h2>
                </div>

                <div class="stats-icon blue">
                    <i class="bi bi-people"></i>
                </div>

            </div>

        </div>

    </div>

    <!-- CARD 2 -->
    <div class="col-xl-3 col-md-6">

        <div class="stats-card">

            <div class="stats-top">

                <div>
                    <h6>PRESENT TODAY</h6>
                    <h2>@Model.PresentToday</h2>
                </div>

                <div class="stats-icon green">
                    <i class="bi bi-check-lg"></i>
                </div>

            </div>

        </div>

    </div>

    <!-- CARD 3 -->
    <div class="col-xl-3 col-md-6">

        <div class="stats-card">

            <div class="stats-top">

                <div>
                    <h6>ON LEAVE</h6>
                    <h2>@Model.OnLeaveToday</h2>
                </div>

                <div class="stats-icon orange">
                    <i class="bi bi-calendar-event"></i>
                </div>

            </div>

        </div>

    </div>

    <!-- CARD 4 -->
    <div class="col-xl-3 col-md-6">

        <div class="stats-card">

            <div class="stats-top">

                <div>
                    <h6>OPEN POSITIONS</h6>
                    <h2>28</h2>
                </div>

                <div class="stats-icon sky">
                    <i class="bi bi-briefcase"></i>
                </div>

            </div>

        </div>

    </div>

</div>

<div class="row g-4 mt-1">

    <!-- ================= RECENT LEAVE REQUEST ================= -->

    <div class="col-xl-8">

        <div class="custom-card">

            <div class="card-header-custom">

                <h4>Recent Leave Requests</h4>

                <a href="#" class="view-all-btn">
                    View all
                </a>

            </div>

            <div class="table-responsive">

                <table class="table leave-table align-middle">

                    <thead>
                        <tr>
                            <th>EMPLOYEE</th>
                            <th>TYPE</th>
                            <th>DURATION</th>
                            <th>STATUS</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr>
                            <td class="fw-semibold">Rahul Sharma</td>
                            <td>Annual Leave</td>
                            <td>May 13 – May 17</td>

                            <td>
                                <span class="status-badge pending">
                                    Pending
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <td class="fw-semibold">Priya Patel</td>
                            <td>Sick Leave</td>
                            <td>May 10 – May 11</td>

                            <td>
                                <span class="status-badge approved">
                                    Approved
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <td class="fw-semibold">Sunny Singh</td>
                            <td>Personal Leave</td>
                            <td>May 20 – May 20</td>

                            <td>
                                <span class="status-badge pending">
                                    Pending
                                </span>
                            </td>
                        </tr>

                        <tr class="active-row">
                            <td class="fw-semibold">Leena Roy</td>
                            <td>Annual Leave</td>
                            <td>Jun 01 – Jun 05</td>

                            <td>
                                <span class="status-badge approved">
                                    Approved
                                </span>
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <!-- ================= HEADCOUNT BY DEPT ================= -->

    <div class="col-xl-4">

        <div class="custom-card">

            <div class="card-header-custom">
                <h4>Headcount by Dept</h4>
            </div>

            <!-- ITEM -->
            <div class="dept-item">

                <div class="dept-header">
                    <span>Engineering</span>
                    <span>82</span>
                </div>

                <div class="progress custom-progress">
                    <div class="progress-bar blue-bar"
                         style="width:82%">
                    </div>
                </div>

            </div>

            <!-- ITEM -->
            <div class="dept-item">

                <div class="dept-header">
                    <span>Marketing</span>
                    <span>34</span>
                </div>

                <div class="progress custom-progress">
                    <div class="progress-bar green-bar"
                         style="width:34%">
                    </div>
                </div>

            </div>

            <!-- ITEM -->
            <div class="dept-item">

                <div class="dept-header">
                    <span>Finance</span>
                    <span>28</span>
                </div>

                <div class="progress custom-progress">
                    <div class="progress-bar orange-bar"
                         style="width:28%">
                    </div>
                </div>

            </div>

            <!-- ITEM -->
            <div class="dept-item">

                <div class="dept-header">
                    <span>Sales</span>
                    <span>52</span>
                </div>

                <div class="progress custom-progress">
                    <div class="progress-bar purple-bar"
                         style="width:52%">
                    </div>
                </div>

            </div>

            <!-- ITEM -->
            <div class="dept-item">

                <div class="dept-header">
                    <span>HR</span>
                    <span>18</span>
                </div>

                <div class="progress custom-progress">
                    <div class="progress-bar cyan-bar"
                         style="width:18%">
                    </div>
                </div>

            </div>

            <!-- ITEM -->
            <div class="dept-item mb-0">

                <div class="dept-header">
                    <span>Design</span>
                    <span>22</span>
                </div>

                <div class="progress custom-progress">
                    <div class="progress-bar red-bar"
                         style="width:22%">
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>

<!-- ================= ROW ================= -->

<div class="row g-4 mt-1">

    <!-- ================= RECENT ACTIVITY ================= -->

    <div class="col-xl-6">

        <div class="activity-card">

            <!-- HEADER -->
            <div class="card-header-custom">

                <h4>Recent Activity</h4>

                <a href="#" class="action-link">
                    Clear all
                </a>

            </div>

            <!-- BODY -->
            <div class="card-body-custom">

                <!-- ITEM -->
                <div class="activity-item">

                    <div class="activity-left">

                        <span class="activity-dot green-dot"></span>

                        <div class="activity-content">

                            <p>
                                <strong>Priya Patel</strong>
                                checked in at 9:02 AM
                            </p>

                        </div>

                    </div>

                    <span class="activity-time">
                        2m ago
                    </span>

                </div>

                <!-- ITEM -->
                <div class="activity-item">

                    <div class="activity-left">

                        <span class="activity-dot blue-dot"></span>

                        <div class="activity-content">

                            <p>
                                <strong>New employee</strong>
                                David Wilson onboarded to Sales
                            </p>

                        </div>

                    </div>

                    <span class="activity-time">
                        1h ago
                    </span>

                </div>

                <!-- ITEM -->
                <div class="activity-item">

                    <div class="activity-left">

                        <span class="activity-dot orange-dot"></span>

                        <div class="activity-content">

                            <p>
                                <strong>James Anderson</strong>
                                submitted a leave request
                            </p>

                        </div>

                    </div>

                    <span class="activity-time">
                        2h ago
                    </span>

                </div>

                <!-- ITEM -->
                <div class="activity-item">

                    <div class="activity-left">

                        <span class="activity-dot red-dot"></span>

                        <div class="activity-content">

                            <p>
                                <strong>Michael Brown</strong>
                                marked absent
                            </p>

                        </div>

                    </div>

                    <span class="activity-time">
                        3h ago
                    </span>

                </div>

                <!-- ITEM -->
                <div class="activity-item">

                    <div class="activity-left">

                        <span class="activity-dot teal-dot"></span>

                        <div class="activity-content">

                            <p>
                                <strong>May payroll</strong>
                                processing initiated
                            </p>

                        </div>

                    </div>

                    <span class="activity-time">
                        5h ago
                    </span>

                </div>

                <!-- ITEM -->
                <div class="activity-item mb-0 border-0">

                    <div class="activity-left">

                        <span class="activity-dot blue-dot"></span>

                        <div class="activity-content">

                            <p>
                                <strong>Lisa Martinez</strong>
                                leave approved by Manager
                            </p>

                        </div>

                    </div>

                    <span class="activity-time">
                        Yesterday
                    </span>

                </div>

            </div>

        </div>

    </div>

    <!-- ================= UPCOMING EVENTS ================= -->

    <div class="col-xl-6">

        <div class="activity-card">

            <!-- HEADER -->
            <div class="card-header-custom">

                <h4>Upcoming Events</h4>

                <a href="#" class="action-link">
                    Add event
                </a>

            </div>

            <!-- BODY -->
            <div class="card-body-custom">

                <!-- EVENT -->
                <div class="event-item">

                    <div class="event-left">

                        <span class="activity-dot blue-dot"></span>

                        <div>

                            <h5>Team All-Hands Meeting</h5>

                            <p>
                                May 15, 2026 • 10:00 AM
                            </p>

                        </div>

                    </div>

                    <span class="event-badge">
                        4d
                    </span>

                </div>

                <!-- EVENT -->
                <div class="event-item">

                    <div class="event-left">

                        <span class="activity-dot orange-dot"></span>

                        <div>

                            <h5>Q2 Performance Reviews</h5>

                            <p>
                                May 20–30, 2026
                            </p>

                        </div>

                    </div>

                    <span class="event-badge">
                        9d
                    </span>

                </div>

                <!-- EVENT -->
                <div class="event-item">

                    <div class="event-left">

                        <span class="activity-dot green-dot"></span>

                        <div>

                            <h5>New Hire Orientation</h5>

                            <p>
                                May 22, 2026 • 9:00 AM
                            </p>

                        </div>

                    </div>

                    <span class="event-badge">
                        11d
                    </span>

                </div>

                <!-- EVENT -->
                <div class="event-item">

                    <div class="event-left">

                        <span class="activity-dot teal-dot"></span>

                        <div>

                            <h5>Payroll Processing Deadline</h5>

                            <p>
                                May 25, 2026
                            </p>

                        </div>

                    </div>

                    <span class="event-badge">
                        14d
                    </span>

                </div>

                <!-- EVENT -->
                <div class="event-item mb-0 border-0">

                    <div class="event-left">

                        <span class="activity-dot red-dot"></span>

                        <div>

                            <h5>Annual Compliance Training</h5>

                            <p>
                                May 28, 2026
                            </p>

                        </div>

                    </div>

                    <span class="event-badge">
                        17d
                    </span>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- ================= UPCOMING BIRTHDAY ================= -->

<div class="row g-4 mt-1">

    <div class="col-xl-6">

        <div class="activity-card">

            <!-- HEADER -->
