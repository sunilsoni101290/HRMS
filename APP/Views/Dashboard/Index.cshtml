                    <td colspan="4">
                        Latest Announcements
                    </td>

                    <td class="text-right">
                        <span class="badge bg-primary">
                            @Model.AnnouncementDashboard?.ActiveAnnouncements
                        </span>
                    </td>
                </tr>

                @if (Model.AnnouncementDashboard != null && Model.AnnouncementDashboard.Announcements.Any())
                {
                    foreach (var item in Model.AnnouncementDashboard.Announcements)
                    {
                        <tr>

                            <td width="70">

                                <h5 class="text-@item.Color no-margin">
                                    @item.StartDate.ToString("dd")
                                </h5>

                                <small>
                                    @item.StartDate.ToString("MMM").ToUpper()
                                </small>

                            </td>

                            <td width="60">

                                <span class="btn bg-@item.Color btn-rounded btn-icon btn-xs">
                                    <i class="@item.Icon"></i>
                                </span>

                            </td>

                            <td>

                                <div class="text-semibold">
                                    @item.Title
                                </div>

                                <span class="text-muted">
                                    @item.Description
                                </span>

                            </td>

                            <td>

                                @{
                                    string labelCss = item.Priority switch
                                    {
                                        EnumExtensions.AnnouncementPriority.High => "danger",
                                        EnumExtensions.AnnouncementPriority.Medium => "warning",
                                        _ => "primary"
                                    };
                                }

                                <span class="label bg-@labelCss">
                                    @item.Type
                                </span>

                            </td>

                            <td class="text-right">
                                @item.Department
                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>
    </div>

</div>
