
@using APP.Models;
@model DashboardKpiDto

@{
	ViewBag.Title = "Dashboard";
}

<div class="row">

    <!-- Total Employees -->
    <div class="col-md-3">
        <div class="panel panel-body bg-primary-400">
            <div class="media no-margin">
                <div class="media-left media-middle">
                    <i class="icon-users icon-3x opacity-75"></i>
                </div>
                <div class="media-body text-right">
                    <h3 class="no-margin">@Model.TotalEmployees</h3>
                    <span class="text-uppercase text-size-mini">
                        Total Employees
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Employees -->
    <div class="col-md-3">
        <div class="panel panel-body bg-success-400">
            <div class="media no-margin">
                <div class="media-left media-middle">
                    <i class="icon-user-check icon-3x opacity-75"></i>
                </div>
                <div class="media-body text-right">
                    <h3 class="no-margin">@Model.ActiveEmployees</h3>
                    <span class="text-uppercase text-size-mini">
                        Active Employees
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- New Joiners -->
    <div class="col-md-3">
        <div class="panel panel-body bg-indigo-400">
            <div class="media no-margin">
                <div class="media-left media-middle">
                    <i class="icon-user-plus icon-3x opacity-75"></i>
                </div>
                <div class="media-body text-right">
                    <h3 class="no-margin">@Model.NewJoiners</h3>
                    <span class="text-uppercase text-size-mini">
                        New Joiners
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Resigned Employees -->
    <div class="col-md-3">
        <div class="panel panel-body bg-danger-400">
            <div class="media no-margin">
                <div class="media-left media-middle">
                    <i class="icon-user-minus icon-3x opacity-75"></i>
                </div>
                <div class="media-body text-right">
                    <h3 class="no-margin">@Model.ResignedEmployees</h3>
                    <span class="text-uppercase text-size-mini">
                        Resigned
                    </span>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="row">

    <!-- Present Today -->
    <div class="col-md-3">
        <div class="panel panel-body bg-teal-400">
            <div class="media no-margin">
                <div class="media-left media-middle">
                    <i class="icon-checkmark-circle icon-3x opacity-75"></i>
                </div>
                <div class="media-body text-right">
                    <h3 class="no-margin">@Model.PresentToday</h3>
                    <span class="text-uppercase text-size-mini">
                        Present Today
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Absent Today -->
    <div class="col-md-3">
        <div class="panel panel-body bg-warning-400">
            <div class="media no-margin">
                <div class="media-left media-middle">
                    <i class="icon-cross2 icon-3x opacity-75"></i>
                </div>
                <div class="media-body text-right">
                    <h3 class="no-margin">@Model.AbsentToday</h3>
                    <span class="text-uppercase text-size-mini">
                        Absent Today
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Late Arrivals -->
    <div class="col-md-3">
        <div class="panel panel-body bg-orange-400">
            <div class="media no-margin">
                <div class="media-left media-middle">
                    <i class="icon-alarm icon-3x opacity-75"></i>
                </div>
                <div class="media-body text-right">
                    <h3 class="no-margin">@Model.LateArrivals</h3>
                    <span class="text-uppercase text-size-mini">
                        Late Arrivals
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- On Leave -->
    <div class="col-md-3">
        <div class="panel panel-body bg-purple-400">
            <div class="media no-margin">
                <div class="media-left media-middle">
                    <i class="icon-calendar3 icon-3x opacity-75"></i>
                </div>
                <div class="media-body text-right">
                    <h3 class="no-margin">@Model.OnLeaveToday</h3>
                    <span class="text-uppercase text-size-mini">
                        On Leave
                    </span>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="row">

    <!-- Open Positions -->
    <div class="col-md-6">
        <div class="panel panel-body bg-blue-400">
            <div class="media no-margin">
                <div class="media-left media-middle">
                    <i class="icon-briefcase icon-3x opacity-75"></i>
                </div>
                <div class="media-body text-right">
                    <h3 class="no-margin">@Model.OpenPositions</h3>
                    <span class="text-uppercase text-size-mini">
                        Open Positions
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Approvals -->
    <div class="col-md-6">
        <div class="panel panel-body bg-pink-400">
            <div class="media no-margin">
                <div class="media-left media-middle">
                    <i class="icon-hour-glass icon-3x opacity-75"></i>
                </div>
                <div class="media-body text-right">
                    <h3 class="no-margin">@Model.PendingApprovals</h3>
                    <span class="text-uppercase text-size-mini">
                        Pending Approvals
                    </span>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Recent Leave Requests -->
<div class="panel panel-flat">

    <div class="panel-heading">
        <h6 class="panel-title">
            <i class="icon-airplane3 position-left"></i>
            Recent Leave Requests
        </h6>

        <div class="heading-elements">
            <span class="badge bg-warning">
                @Model.PendingRequests
            </span>
        </div>
    </div>

    <!-- Summary -->
    <div class="table-responsive">
        <table class="table table-xlg text-nowrap">
            <tbody>
                <tr>

                    <td class="col-md-4">
                        <div class="media-left media-middle">
                            <a href="#" class="btn border-warning text-warning btn-flat btn-rounded btn-icon">
                                <i class="icon-airplane3"></i>
                            </a>
                        </div>

                        <div class="media-left">
                            <h5 class="text-semibold no-margin">
                                @Model.TotalRequests
                                <small class="display-block">
                                    Total Requests
                                </small>
                            </h5>
                        </div>
                    </td>

                    <td class="col-md-3">
                        <div class="media-left media-middle">
                            <a href="#" class="btn border-success text-success btn-flat btn-rounded btn-icon">
                                <i class="icon-checkmark3"></i>
                            </a>
                        </div>

                        <div class="media-left">
                            <h5 class="text-semibold no-margin">
                                @Model.ApprovedRequests
                                <small class="display-block">
                                    Approved
                                </small>
                            </h5>
                        </div>
                    </td>

                    <td class="col-md-3">
                        <div class="media-left media-middle">
                            <a href="#" class="btn border-danger text-danger btn-flat btn-rounded btn-icon">
                                <i class="icon-cross2"></i>
                            </a>
                        </div>

                        <div class="media-left">
                            <h5 class="text-semibold no-margin">
                                @Model.RejectedRequests
                                <small class="display-block">
                                    Rejected
                                </small>
                            </h5>
                        </div>
                    </td>

                    <td class="text-right">
                        <a href="#" class="btn bg-primary">
                            View All
                        </a>
                    </td>

                </tr>
            </tbody>
        </table>
    </div>

    <!-- Leave Requests List -->
    <div class="table-responsive">

        <table class="table text-nowrap">

            <thead>
                <tr>
                    <th style="width:70px">Date</th>
                    <th>Employee</th>
                    <th>Leave Type</th>
                    <th>Duration</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>

                <tr class="active border-double">
                    <td colspan="4">Pending Approval</td>

                    <td class="text-right">
                        <span class="badge bg-warning">
                            @Model.PendingRequests
                        </span>
                    </td>
                </tr>

                @foreach (var item in Model.RecentLeaveRequests)
                {
                    <tr>

                        <td>
                            <h6 class="no-margin">
                                @item.FromDate.ToString("dd")
                                <small class="display-block">
                                    @item.FromDate.ToString("MMM").ToUpper()
                                </small>
                            </h6>
                        </td>

                        <td>
                            <div class="media-left">
                                <img src="@(string.IsNullOrEmpty(item.EmployeePhoto))"
                                     class="img-circle img-xs" />
                            </div>

                            <div class="media-body">
                                <span class="text-semibold">
                                    @item.EmployeeName
                                </span>

                                <div class="text-muted text-size-small">
                                    @item.Designation
                                </div>
                            </div>
                        </td>

                        <td>
                            @item.LeaveType
                        </td>

                        <td>
                            @item.TotalDays Day@(item.TotalDays > 1 ? "s" : "")
                        </td>

                        <td>

                            @switch (item.Status)
                            {
                                case EnumExtensions.ApprovalStatus.Pending:
                                    <span class="label bg-warning">Pending</span>
                                    break;

                                case EnumExtensions.ApprovalStatus.Approved:
                                    <span class="label bg-success">Approved</span>
                                    break;

                                case EnumExtensions.ApprovalStatus.Rejected:
                                    <span class="label bg-danger">Rejected</span>
                                    break;

                                case EnumExtensions.ApprovalStatus.OnHold:
                                    <span class="label bg-info">On Hold</span>
                                    break;
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
<!-- /Recent Leave Requests -->

<!-- Upcoming Events -->
<div class="panel panel-flat">

    <div class="panel-heading">
        <h6 class="panel-title">
            <i class="icon-calendar3 position-left"></i>
            Upcoming Events
        </h6>

        <div class="heading-elements">
            <span class="badge bg-primary">
                @Model.UpcomingEvents.TotalUpcomingEvents @Html.Raw("Upcoming")
            </span>
        </div>
    </div>

    <!-- Summary -->
    <div class="table-responsive">
        <table class="table table-xlg text-nowrap">
            <tbody>
                <tr>

                    <td class="col-md-4">
                        <div class="media-left media-middle">
                            <a href="#" class="btn border-primary text-primary btn-flat btn-rounded btn-icon">
                                <i class="icon-calendar"></i>
                            </a>
                        </div>

                        <div class="media-left">
                            <h5 class="text-semibold no-margin">
                                @Model.UpcomingEvents.TotalUpcomingEvents @Html.Raw("Upcoming")
                                <small class="display-block">
                                    Total Upcoming Events
                                </small>
                            </h5>
                        </div>
                    </td>

                    <td class="col-md-3">
                        <div class="media-left media-middle">
                            <a href="#" class="btn border-success text-success btn-flat btn-rounded btn-icon">
                                <i class="icon-gift"></i>
                            </a>
                        </div>

                        <div class="media-left">
                            <h5 class="text-semibold no-margin">
                                @Model.UpcomingEvents.BirthdayCount
                                <small class="display-block">
                                    Birthdays
                                </small>
                            </h5>
                        </div>
                    </td>

                    <td class="col-md-3">
                        <div class="media-left media-middle">
                            <a href="#" class="btn border-danger text-danger btn-flat btn-rounded btn-icon">
                                <i class="icon-flag3"></i>
                            </a>
                        </div>

                        <div class="media-left">
                            <h5 class="text-semibold no-margin">
                                @Model.UpcomingEvents.HolidayCount
                                <small class="display-block">
                                    Holidays
                                </small>
                            </h5>
                        </div>
                    </td>

                    <td class="col-md-2 text-right">
                        <a href="#" class="btn bg-primary">
                            View Calendar
                        </a>
                    </td>

                </tr>
            </tbody>
        </table>
    </div>

    <!-- Event List -->
    <div class="table-responsive">

        <table class="table text-nowrap">

            <tbody>

                <tr class="active border-double">
                    <td colspan="4">
                        Today's Events
                    </td>

                    <td class="text-right">
                        <span class="badge bg-success">
                            @Model.UpcomingEvents.TodayEventCount
                        </span>
                    </td>
                </tr>

                @foreach (var item in Model.UpcomingEvents.Events)
                {
                    <tr>
                        <td width="70">

                            <h5 class="text-@item.Color no-margin">

                                @item.EventDate.ToString("dd")

                                <small class="display-block">
                                    @item.EventDate.ToString("MMM").ToUpper()
                                </small>

                            </h5>

                        </td>

                        <td width="60">

                            <a class="btn bg-@item.Color btn-rounded btn-icon btn-xs">
                                <i class="@item.Icon"></i>
                            </a>

                        </td>

                        <td>

                            <div class="text-semibold">
                                @item.Title
                            </div>

                            <span class="text-muted">
                                @(string.IsNullOrWhiteSpace(item.Department)
                                    ? item.Description
                                    : item.Department)
                            </span>

                        </td>

                        <td>

                            @{
                                string css = item.EventType switch
                                {
                                    "Birthday" => "success",
                                    "Holiday" => "danger",
                                    "Meeting" => "primary",
                                    "Training" => "warning",
                                    "Celebration" => "success",
                                    _ => "info"
                                };
                            }

                            <span class="label bg-@css">
                                @item.EventType
                            </span>

                        </td>

                        <td class="text-right">

                            @if (item.EventDate.Date == DateTime.Today)
                            {
                                <span class="text-success text-semibold">
                                    Today
                                </span>
                            }
                            else if (item.StartTime.HasValue)
                            {
                                @item.StartTime.Value.ToString(@"hh\:mm")
                            }
                            else
                            {
                                @item.EventDate.ToString("ddd")
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
<!-- /Upcoming Events -->

<!-- Upcoming Birthdays -->
<div class="panel panel-flat">

    <div class="panel-heading">
        <h6 class="panel-title">
            <i class="icon-gift position-left"></i>
            Upcoming Birthdays
        </h6>

        <div class="heading-elements">
            <span class="badge bg-success">
                @Model.BirthdayDashboard?.BirthdaysThisMonth @Html.Raw("This Month")
            </span>
        </div>
    </div>

    <!-- Summary -->
    <div class="table-responsive">
        <table class="table table-xlg text-nowrap">
            <tbody>
                <tr>

                    <td class="col-md-4">
                        <div class="media-left media-middle">
                            <a href="#" class="btn border-success text-success btn-flat btn-rounded btn-icon">
                                <i class="icon-gift"></i>
                            </a>
                        </div>

                        <div class="media-left">
                            <h5 class="text-semibold no-margin">
                                @Model.BirthdayDashboard?.BirthdaysThisMonth
                                <small class="display-block">
                                    Birthdays This Month
                                </small>
                            </h5>
                        </div>
                    </td>

                    <td class="col-md-3">
                        <div class="media-left media-middle">
                            <a href="#" class="btn border-primary text-primary btn-flat btn-rounded btn-icon">
                                <i class="icon-calendar"></i>
                            </a>
                        </div>

                        <div class="media-left">
                            <h5 class="text-semibold no-margin">
                                @Model.BirthdayDashboard?.BirthdaysToday
                                <small class="display-block">
                                    Today
                                </small>
                            </h5>
                        </div>
                    </td>

                    <td class="col-md-3">
                        <div class="media-left media-middle">
                            <a href="#" class="btn border-warning text-warning btn-flat btn-rounded btn-icon">
                                <i class="icon-cake"></i>
                            </a>
                        </div>

                        <div class="media-left">
                            <h5 class="text-semibold no-margin">
                                @Model.BirthdayDashboard?.BirthdaysThisWeek
                                <small class="display-block">
                                    This Week
                                </small>
                            </h5>
                        </div>
                    </td>

                    <td class="text-right">
                        <a href="#" class="btn bg-success">
                            View All
                        </a>
                    </td>

                </tr>
            </tbody>
        </table>
    </div>

    <!-- Birthday List -->
    <div class="table-responsive">
        <table class="table text-nowrap">

            <tbody>

                <tr class="active border-double">
                    <td colspan="4">
                        Today's Birthdays
                    </td>

                    <td class="text-right">
                        <span class="badge bg-success">
                            @Model.BirthdayDashboard?.BirthdaysToday
                        </span>
                    </td>
                </tr>

                @if (Model.BirthdayDashboard != null && Model.BirthdayDashboard.Birthdays.Any())
                {
                    foreach (var item in Model.BirthdayDashboard.Birthdays)
                    {
                        <tr>

                            <td width="70">

                                <h5 class="@(item.DaysLeft == 0 ? "text-success" : "text-primary") no-margin">

                                    @item.Birthday.ToString("dd")

                                </h5>

                                <small>
                                    @item.Birthday.ToString("MMM").ToUpper()
                                </small>

                            </td>

                            <td width="60">

                                <img src="@(string.IsNullOrWhiteSpace(item.Photo)
                                    ? "/Content/images/user.png"
                                    : item.Photo)"
                                     class="img-circle img-xs" />

                            </td>

                            <td>

                                <div class="text-semibold">

                                    @item.EmployeeName

                                </div>

                                <span class="text-muted">

                                    @item.Designation

                                </span>

                            </td>

                            <td>

                                @if (item.DaysLeft == 0)
                                {
                                    <span class="label bg-success">
                                        Birthday
                                    </span>
                                }
                                else
                                {
                                    <span class="label bg-primary">
                                        Upcoming
                                    </span>
                                }

                            </td>

                            <td class="text-right">

                                @if (item.DaysLeft == 0)
                                {
                                    <span style="font-size:16px;">🎂 Today</span>
                                }
                                else if (item.DaysLeft == 1)
                                {
                                    <span>Tomorrow</span>
                                }
                                else
                                {
                                    <span>@item.DaysLeft Days</span>
                                }

                            </td>

                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>
<!-- /Upcoming Birthdays -->

<!-- Announcements -->
