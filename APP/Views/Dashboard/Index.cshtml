                <h4>Upcoming Birthdays</h4>

                <a href="#" class="action-link">
                    View all
                </a>

            </div>

            <!-- BODY -->
            <div class="birthday-wrapper">

                <!-- ITEM -->
                <div class="birthday-item">

                    <img src="https://i.pravatar.cc/100?img=11">

                    <div class="birthday-content">

                        <h5>Sarah Johnson</h5>

                        <p>UI/UX Designer</p>

                    </div>

                    <span class="birthday-date">
                        14 May
                    </span>

                </div>

                <!-- ITEM -->
                <div class="birthday-item">

                    <img src="https://i.pravatar.cc/100?img=12">

                    <div class="birthday-content">

                        <h5>Michael Brown</h5>

                        <p>Software Engineer</p>

                    </div>

                    <span class="birthday-date">
                        16 May
                    </span>

                </div>

                <!-- ITEM -->
                <div class="birthday-item">

                    <img src="https://i.pravatar.cc/100?img=13">

                    <div class="birthday-content">

                        <h5>Emma Wilson</h5>

                        <p>HR Executive</p>

                    </div>

                    <span class="birthday-date">
                        19 May
                    </span>

                </div>

                <!-- ITEM -->
                <div class="birthday-item border-0">

                    <img src="https://i.pravatar.cc/100?img=14">

                    <div class="birthday-content">

                        <h5>David Clark</h5>

                        <p>Marketing Manager</p>

                    </div>

                    <span class="birthday-date">
