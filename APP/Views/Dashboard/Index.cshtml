                    <td class="col-md-3">
                        <div class="media-left media-middle">
                            <a href="#" class="btn border-success text-success btn-flat btn-rounded btn-icon">
                                <i class="icon-office"></i>
                            </a>
                        </div>

                        <div class="media-left">
                            <h5 class="text-semibold no-margin">
                                @Model.DepartmentDashboard?.TotalDepartments
                                <small class="display-block">
                                    Departments
                                </small>
                            </h5>
                        </div>
                    </td>

                    <td class="col-md-3">
                        <div class="media-left media-middle">
                            <a href="#" class="btn border-warning text-warning btn-flat btn-rounded btn-icon">
                                <i class="icon-user-plus"></i>
                            </a>
                        </div>

                        <div class="media-left">
                            <h5 class="text-semibold no-margin">
                                @Model.DepartmentDashboard?.NewJoiners
                                <small class="display-block">
                                    New Joiners
                                </small>
                            </h5>
                        </div>
                    </td>

                    <td class="text-right">
                        <a href="#" class="btn bg-primary">
                            View Report
                        </a>
                    </td>

                </tr>
            </tbody>
        </table>
    </div>

    <!-- Department List -->
    <div class="table-responsive">
        <table class="table text-nowrap">

            <thead>
                <tr>
                    <th>Department</th>
                    <th>Headcount</th>
                    <th>Percentage</th>
                    <th style="width:200px;">Distribution</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.DepartmentDashboard != null && Model.DepartmentDashboard.Departments.Any())
                {
                    foreach (var item in Model.DepartmentDashboard.Departments)
                    {
                        <tr>

                            <td>
                                <span class="text-semibold">
                                    @item.DepartmentName
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-@item.Color">
                                    @item.EmployeeCount
                                </span>
                            </td>

                            <td>
                                @item.Percentage.ToString("0.##")%
                            </td>

                            <td style="width:200px;">

                                <div class="progress">
                                    <div class="progress-bar bg-@item.Color"
                                         style="width:@item.Percentage%">
                                    </div>
                                </div>

                            </td>

                        </tr>
                    }
                }
            </tbody>

        </table>
    </div>

</div>
<!-- /Headcount by Department -->
