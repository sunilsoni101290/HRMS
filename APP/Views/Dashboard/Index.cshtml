@using APP.Models;
@model DashboardViewModel

@{
	ViewBag.Title = "Dashboard";
}

<div class="row">

    <!-- Total Employees -->
    <div class="col-md-3">
        <div class="panel panel-body bg-primary-400">
            <div class="media no-margin">
                <div class="media-left media-middle">
                    <i class="icon-users icon-3x opacity-75"></i>
                </div>
                <div class="media-body text-right">
                    <h3 class="no-margin">@Model.TotalEmployees</h3>
                    <span class="text-uppercase text-size-mini">
                        Total Employees
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Employees -->
    <div class="col-md-3">
        <div class="panel panel-body bg-success-400">
            <div class="media no-margin">
                <div class="media-left media-middle">
                    <i class="icon-user-check icon-3x opacity-75"></i>
                </div>
                <div class="media-body text-right">
                    <h3 class="no-margin">@Model.ActiveEmployees</h3>
                    <span class="text-uppercase text-size-mini">
                        Active Employees
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- New Joiners -->
    <div class="col-md-3">
        <div class="panel panel-body bg-indigo-400">
            <div class="media no-margin">
                <div class="media-left media-middle">
                    <i class="icon-user-plus icon-3x opacity-75"></i>
                </div>
                <div class="media-body text-right">
                    <h3 class="no-margin">@Model.NewJoiners</h3>
                    <span class="text-uppercase text-size-mini">
                        New Joiners
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Resigned Employees -->
    <div class="col-md-3">
        <div class="panel panel-body bg-danger-400">
            <div class="media no-margin">
                <div class="media-left media-middle">
                    <i class="icon-user-minus icon-3x opacity-75"></i>
                </div>
                <div class="media-body text-right">
                    <h3 class="no-margin">@Model.ResignedEmployees</h3>
                    <span class="text-uppercase text-size-mini">
                        Resigned
                    </span>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="row">

    <!-- Present Today -->
    <div class="col-md-3">
