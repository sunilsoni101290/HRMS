@model CandidateApplicationDto

@{
    ViewData["Title"] = "Application";
    bool isEdit = !string.IsNullOrEmpty(Model?.Id);
}

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-controller="CandidateApplication" asp-route-id="@Model?.Id" method="post">

    <input asp-for="Id" type="hidden" />
    <input asp-for="TenantId" type="hidden" />
    <input asp-for="CreatedBy" type="hidden" />

    <div class="panel panel-flat">

        <div class="panel-heading">
            <h5 class="panel-title">
                <i class="icon-clipboard3 position-left"></i>
                @(isEdit ? "Edit Application" : "New Application")
            </h5>
            <div class="heading-elements">
                <a asp-action="Index" class="btn btn-default"><i class="icon-arrow-left13"></i> Back</a>
            </div>
        </div>

        <div class="panel-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="CandidateId"></label> <span class="text-danger">*</span>
                        <select asp-for="CandidateId" asp-items="ViewBag.CandidateList" class="form-control">
                            <option value="">Select Candidate</option>
                        </select>
                        <span asp-validation-for="CandidateId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="JobOpeningId"></label> <span class="text-danger">*</span>
                        <select asp-for="JobOpeningId" asp-items="ViewBag.JobList" class="form-control">
                            <option value="">Select Job Opening</option>
                        </select>
                        <span asp-validation-for="JobOpeningId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="AppliedDate"></label>
                        <input asp-for="AppliedDate" type="date" class="form-control" value="@Model?.AppliedDate.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Status"></label>
                        <select asp-for="Status" asp-items="ViewBag.StageList" class="form-control"></select>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="Remarks"></label>
                        <textarea asp-for="Remarks" class="form-control" rows="2" placeholder="Notes about this application..."></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel-footer text-right">
            <button type="submit" class="btn bg-primary"><i class="icon-floppy-disk"></i> @(isEdit ? "Update" : "Save")</button>
        </div>
    </div>
</form>

@section Scripts {
    @if (TempData["Success"] != null)
    {
        <script>$(function(){ swal({ title:"Success", text:"@TempData["Success"]", type:"success" }); });</script>
    }
    <partial name="_ValidationScriptsPartial" />
}
