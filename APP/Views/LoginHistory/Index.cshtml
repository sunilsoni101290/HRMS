@model IEnumerable<APP.Models.DTOs.LoginHistoryListDto>
@using static APP.Helpers.EnumExtensions

@{
    ViewData["Title"] = "Login History";
}

<div class="panel panel-flat">

    <div class="panel-heading">
        <h5 class="panel-title"><i class="icon-history position-left"></i> Login History</h5>
    </div>

    <div class="panel-body">
        <div class="row">
            <div class="col-md-4">
                <input type="text" id="searchInput" class="form-control" placeholder="Search by user, IP, status..." />
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-striped datatable-basic">
            <thead>
                <tr>
                    <th width="50">#</th>
                    <th>Username</th>
                    <th>Employee</th>
                    <th>Login Time</th>
                    <th>Logout Time</th>
                    <th width="100">Status</th>
                    <th>Failure Reason</th>
                    <th>IP Address</th>
                    <th>Device</th>
                    <th>Browser / OS</th>
                    <th width="90">Suspicious</th>
                </tr>
            </thead>
            <tbody id="dataTable">
                @{ int sr = 1; }
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var statusClass = item.LoginStatus == LoginStatus.Success ? "bg-success"
                            : item.LoginStatus == LoginStatus.Locked ? "bg-warning" : "bg-danger";

                        <tr>
                            <td>@sr</td>
                            <td><strong>@(item.Username ?? "-")</strong></td>
                            <td>@(item.EmployeeName ?? "-")</td>
                            <td>@item.LoginTime.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</td>
                            <td>@(item.LogoutTime == null ? "-" : item.LogoutTime.Value.ToLocalTime().ToString("dd-MMM-yyyy HH:mm"))</td>
                            <td><span class="label @statusClass">@item.LoginStatus</span></td>
                            <td>@(item.FailureReason ?? "-")</td>
                            <td>@(item.IPAddress ?? "-")</td>
                            <td>@(item.DeviceInfo ?? "-")</td>
                            <td>@((item.Browser ?? "-") + " / " + (item.OS ?? "-"))</td>
                            <td>
                                @if (item.IsSuspicious)
                                {
                                    <span class="label bg-danger">Yes</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                        sr++;
                    }
                }
                else
                {
                    <tr><td colspan="11" class="text-center text-muted" style="padding:30px;"><i class="icon-history" style="font-size:32px;"></i><br />No login history found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $("#searchInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#dataTable tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
        });
    </script>

    <script>
        // Auto-added: client-side pagination for this Index page's listing
        // table (DataTables). Safe to run even if this page already
        // initializes '.datatable-basic' itself above - 'retrieve: true'
        // makes DataTables return the existing instance instead of
        // re-initializing (and throwing) when that's the case.
        $(document).ready(function () {
            if ($.fn.DataTable) {
                var __indexDataTable = $('.datatable-basic').DataTable({
                    autoWidth: false,
                    paging: true,
                    ordering: true,
                    searching: false,
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                    language: { search: "_INPUT_", searchPlaceholder: "Search..." },
                    retrieve: true
                });

            // Rewire the page's existing search box to drive DataTables'
            // own filtering pipeline (instead of any legacy row .toggle()
            // logic still bound above), so search results stay correct once
            // rows are split across pages.
            $('#searchInput').on('keyup', function () {
                __indexDataTable.search($(this).val() || '').draw();
            });
            }
        });
    </script>
}
