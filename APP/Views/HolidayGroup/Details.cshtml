@model HolidayGroupDto

@{
    ViewData["Title"] = "Holiday Group Details";
}

<div class="panel panel-flat">

    <!-- Header -->

    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-calendar3 position-left"></i>

            Holiday Group Details

        </h5>

        <div class="heading-elements">

            <a asp-action="Index"
               class="btn btn-default">

                <i class="icon-arrow-left13 position-left"></i>

                Back

            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn bg-primary">

                <i class="icon-pencil7 position-left"></i>

                Edit

            </a>

            <a asp-action="HolidayList"
               asp-route-holidayGroupId="@Model.Id"
               class="btn bg-success">

                <i class="icon-calendar52 position-left"></i>

                Manage Holidays

            </a>

        </div>

    </div>

    <div class="panel-body">

        <!-- Dashboard -->

        <div class="row">

            <div class="col-md-4">

                <div class="panel bg-primary-400">

                    <div class="panel-body">

                        <h3 class="no-margin">

                            @Model.Name

                        </h3>

                        Holiday Group

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="panel bg-success-400">

                    <div class="panel-body">

                        <h3 class="no-margin">

                            Active

                        </h3>

                        Status

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="panel bg-warning-400">

                    <div class="panel-body">

                        <h3 class="no-margin">

                            Holiday Calendar

                        </h3>

                        Calendar Type

                    </div>

                </div>

            </div>

        </div>

        <hr />

        <!-- Basic Information -->

        <div class="panel panel-bordered">

            <div class="panel-heading">

                <h6 class="panel-title">

                    <i class="icon-info22 position-left"></i>

                    Basic Information

                </h6>

            </div>

            <table class="table table-bordered">

                <tr>

                    <th width="220">

                        Holiday Group

                    </th>

                    <td>

                        @Model.Name

                    </td>

                </tr>

                <tr>

                    <th>

                        Description

                    </th>

                    <td>

                        @if (string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <span class="text-muted">

                                No Description Available

                            </span>
                        }
                        else
                        {
                            @Model.Description
                        }

                    </td>

                </tr>

                <tr>

                    <th>

                        Status

                    </th>

                    <td>

                        <span class="label bg-success">

                            Active

                        </span>

                    </td>

                </tr>

            </table>

        </div>

        <!-- Audit Information -->

        <div class="panel panel-bordered">

            <div class="panel-heading">

                <h6 class="panel-title">

                    <i class="icon-history position-left"></i>

                    Audit Information

                </h6>

            </div>

            <table class="table table-bordered">

                
                <tr>

                    <th>

                        Created By

                    </th>

                    <td>

                        @(string.IsNullOrWhiteSpace(Model.CreatedBy)
                            ? "-"
                            : Model.CreatedBy)

                    </td>

                </tr>

                <tr>

                    <th>

                        Modified On

                    </th>

                    <td>

                        @(Model.ModifiedOn?.ToString("dd-MMM-yyyy HH:mm") ?? "-")

                    </td>

                </tr>

                <tr>

                    <th>

                        Modified By

                    </th>

                    <td>

                        @(string.IsNullOrWhiteSpace(Model.ModifiedBy)
                            ? "-"
                            : Model.ModifiedBy)

                    </td>

                </tr>

            </table>

        </div>

    </div>

</div>

<style>

    .panel-bordered {
        border: 1px solid #ddd;
        margin-bottom: 20px;
    }

        .panel-bordered .panel-heading {
            background: #fafafa;
            border-bottom: 1px solid #ddd;
        }

    .table > tbody > tr > th {
        width: 220px;
        background: #fafafa;
        font-weight: 600;
    }

    .table > tbody > tr > td {
        vertical-align: middle;
    }

    .label {
        font-size: 11px;
        padding: 5px 10px;
    }

    .panel.bg-primary-400,
    .panel.bg-success-400,
    .panel.bg-warning-400 {
        margin-bottom: 20px;
    }

        .panel.bg-primary-400 h3,
        .panel.bg-success-400 h3,
        .panel.bg-warning-400 h3 {
            color: #fff;
            font-weight: 600;
        }

    .text-muted {
        color: #999;
    }

</style>