@model HolidayGroupDto

@{
    ViewData["Title"] = "Holiday Group Details";
}

@*
    Bootstrap 3.3.7 markup, ent-page/ent-panel style - see
    Views/WeekOff/Index.cshtml / Views/HolidayGroup/Index.cshtml.
*@

<div class="ent-page">
    <div class="ent-panel">

        <div class="d-flex align-items-center gap-2 mb-2 hg-header-row">
            <span class="ent-icon-badge" style="background:#eaf0fe;color:#2b6fd9;"><i class="bi bi-calendar3"></i></span>
            <div>
                <h5 class="mb-0" style="font-weight:700;color:#1b2a4a;">Holiday Group Details</h5>
                <div class="text-muted" style="font-size:12.5px;">Read-only overview of this holiday group.</div>
            </div>
            <div style="margin-left:auto;" class="hg-header-actions">
                <a asp-action="Index" class="btn btn-default"><i class="bi bi-arrow-left"></i> Back</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
                <a asp-action="HolidayList" asp-route-holidayGroupId="@Model.Id" class="btn btn-success"><i class="bi bi-calendar2-week"></i> Manage Holidays</a>
            </div>
        </div>

        <!-- Summary tiles -->
        <div class="row hg-tiles">
            <div class="col-md-4 col-sm-4">
                <div class="hg-tile" style="background:#2b6fd9;">
                    <i class="bi bi-calendar3"></i>
                    <div>
                        <h3>@Model.Name</h3>
                        <span>Holiday Group</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-4">
                <div class="hg-tile" style="background:#2e9e6c;">
                    <i class="bi bi-check-circle"></i>
                    <div>
                        <h3>Active</h3>
                        <span>Status</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-4">
                <div class="hg-tile" style="background:#e0a12b;">
                    <i class="bi bi-calendar2-week"></i>
                    <div>
                        <h3>Holiday Calendar</h3>
                        <span>Calendar Type</span>
                    </div>
                </div>
            </div>
        </div>

        <hr />

        <!-- Basic Information -->
        <div class="hg-section">
            <div class="hg-section-title"><i class="bi bi-info-circle"></i> Basic Information</div>

            <table class="table table-bordered hg-info-table">
                <tr>
                    <th width="220">Holiday Group</th>
                    <td>@Model.Name</td>
                </tr>
                <tr>
                    <th>Description</th>
                    <td>
                        @if (string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <span class="text-muted">No Description Available</span>
                        }
                        else
                        {
                            @Model.Description
                        }
                    </td>
                </tr>
                <tr>
                    <th>Status</th>
                    <td><span class="hg-badge hg-badge-green"><i class="bi bi-check-circle"></i> Active</span></td>
                </tr>
            </table>
        </div>

        <!-- Audit Information -->
        <div class="hg-section">
            <div class="hg-section-title"><i class="bi bi-clock-history"></i> Audit Information</div>

            <table class="table table-bordered hg-info-table">
                <tr>
                    <th width="220">Created By</th>
                    <td>@(string.IsNullOrWhiteSpace(Model.CreatedBy) ? "-" : Model.CreatedBy)</td>
                </tr>
                <tr>
                    <th>Modified On</th>
                    <td>@(Model.ModifiedOn?.ToString("dd-MMM-yyyy HH:mm") ?? "-")</td>
                </tr>
                <tr>
                    <th>Modified By</th>
                    <td>@(string.IsNullOrWhiteSpace(Model.ModifiedBy) ? "-" : Model.ModifiedBy)</td>
                </tr>
            </table>
        </div>
    </div>
</div>

<style>
    /* ===================================================================
       Same enterprise card style used on Views/WeekOff/Index.cshtml /
       Views/HolidayGroup/Index.cshtml.
       =================================================================== */
    .ent-page { background:#f4f6fb; padding:18px; border-radius:10px; }
    .ent-panel { background:#fff; border:1px solid #e7ebf3; border-radius:10px; padding:16px 18px; margin-bottom:18px; }
    .ent-icon-badge { width:34px; height:34px; border-radius:8px; display:inline-flex; align-items:center; justify-content:center; font-size:16px; flex:none; }

    .d-flex { display: flex !important; }
    .align-items-center { align-items: center !important; }
    .gap-2 { gap: .5rem !important; }
    .mb-0 { margin-bottom: 0 !important; }
    .mb-2 { margin-bottom: .5rem !important; }

    .hg-header-row { flex-wrap: wrap; }
    .hg-header-actions { display: flex; flex-wrap: wrap; gap: 6px; }
    .hg-header-actions .btn { margin-left: 0; }

    /*=========================================
                Tiles
            =========================================*/
    .hg-tiles { margin-top: 4px; }

    .hg-tile {
        display: flex;
        align-items: center;
        gap: 14px;
        border-radius: 8px;
        padding: 16px 18px;
        margin-bottom: 15px;
        color: #fff;
    }

        .hg-tile i {
            font-size: 26px;
            opacity: .9;
        }

        .hg-tile h3 {
            margin: 0;
            font-weight: 700;
            color: #fff;
            font-size: 18px;
        }

        .hg-tile span {
            font-size: 12.5px;
            opacity: .9;
        }

    /*=========================================
                Section blocks
            =========================================*/
    .hg-section {
        border: 1px solid #e7ebf3;
        border-radius: 8px;
        padding: 0;
        margin-bottom: 18px;
        overflow: hidden;
    }

    .hg-section-title {
        font-weight: 600;
        font-size: 13.5px;
        color: #1b2a4a;
        padding: 12px 16px;
        background: #fafafa;
        border-bottom: 1px solid #e7ebf3;
    }

        .hg-section-title i {
            color: #2b6fd9;
            margin-right: 6px;
        }

    .hg-info-table {
        margin-bottom: 0;
    }

        .hg-info-table > tbody > tr > th {
            width: 220px;
            background: #fafafa;
            font-weight: 600;
        }

        .hg-info-table > tbody > tr > td {
            vertical-align: middle;
        }

    /*=========================================
                Badges
            =========================================*/
    .hg-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 11.5px;
        font-weight: 600;
        padding: 5px 10px;
        border-radius: 20px;
    }

    .hg-badge-green {
        background: #e8f7ef;
        color: #1e8a54;
    }

    .text-muted {
        color: #999;
    }

    /*=========================================
                Responsive
            =========================================*/
    @@media (max-width:768px) {
        .hg-header-row > div:last-child {
            margin-top: 12px;
            margin-left: 0 !important;
        }

        .hg-header-actions {
            width: 100%;
        }

            .hg-header-actions .btn {
                flex: 1 1 auto;
            }
    }
</style>
