@model HolidayGroupDetailDto

@{
    ViewData["Title"] = "Holiday";
}

<form asp-controller="HolidayGroup"
      asp-action="@(string.IsNullOrEmpty(Model?.Id) ? "CreateHoliday" : "EditHoliday")"
      method="post">

    <!-- Hidden Fields -->

    <input asp-for="Id" type="hidden" />
    <input asp-for="TenantId" type="hidden" />
    <input asp-for="HolidayGroupId" type="hidden" />

    <div class="panel panel-flat">

        <!-- Header -->

        <div class="panel-heading">

            <h5 class="panel-title">

                <i class="icon-calendar52 position-left"></i>

                @(string.IsNullOrEmpty(Model?.Id)
                    ? "Create Holiday"
                    : "Edit Holiday")

            </h5>

            <div class="heading-elements">

                <a asp-controller="HolidayGroup"
                   asp-action="HolidayList"
                   asp-route-holidayGroupId="@Model.HolidayGroupId"
                   class="btn btn-default">

                    <i class="icon-arrow-left13 position-left"></i>

                    Back

                </a>

            </div>

        </div>

        <!-- Body -->

        <div class="panel-body">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <!-- ===================================== -->
            <!-- Holiday Information -->
            <!-- ===================================== -->

            <fieldset>

                <legend class="text-semibold">

                    <i class="icon-info22 position-left"></i>

                    Holiday Information

                </legend>

                <div class="row">

                    <!-- Holiday Group -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="HolidayGroupId"></label>

                            <select asp-for="HolidayGroupId"
                                    asp-items="ViewBag.HolidayGroupList"
                                    class="form-control select-search">

                                <option value="">

                                    -- Select Holiday Group --

                                </option>

                            </select>

                            <span asp-validation-for="HolidayGroupId"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <!-- Holiday Date -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="HolidayDate"></label>

                            <input asp-for="HolidayDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="HolidayDate"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <!-- Holiday Name -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="HolidayName"></label>

                            <input asp-for="HolidayName"
                                   class="form-control"
                                   placeholder="Enter Holiday Name" />

                            <span asp-validation-for="HolidayName"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <!-- Holiday Type -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label>&nbsp;</label>

                            <div class="checkbox">

                                <label>

                                    <input asp-for="IsOptional"
                                           type="checkbox"
                                           class="styled" />

                                    Optional Holiday

                                </label>

                            </div>

                        </div>

                    </div>

                    <!-- Remarks -->

                    <div class="col-md-12">

                        <div class="form-group">

                            <label asp-for="Remarks"></label>

                            <textarea asp-for="Remarks"
                                      rows="4"
                                      class="form-control"
                                      placeholder="Enter Remarks"></textarea>

                        </div>

                    </div>

                </div>

            </fieldset>

            <!-- ===================================== -->
            <!-- Preview -->
            <!-- ===================================== -->

            <fieldset>

                <legend class="text-semibold">

                    <i class="icon-display4 position-left"></i>

                    Holiday Preview

                </legend>

                <div class="row">

                    <div class="col-md-4">

                        <div class="panel bg-primary-400">

                            <div class="panel-body">

                                <h4 class="no-margin">

                                    <span id="HolidayNamePreview">

                                        @(string.IsNullOrWhiteSpace(Model?.HolidayName)
                                            ? "-"
                                            : Model.HolidayName)

                                    </span>

                                </h4>

                                Holiday Name

                            </div>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="panel bg-success-400">

                            <div class="panel-body">

                                <h4 class="no-margin">

                                    <span id="HolidayDatePreview">

                                        @(Model.HolidayDate == DateTime.MinValue
                                            ? "-"
                                            : Model.HolidayDate.ToString("dd-MMM-yyyy"))

                                    </span>

                                </h4>

                                Holiday Date

                            </div>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="panel bg-warning-400">

                            <div class="panel-body">

                                <h4 class="no-margin">

                                    <span id="HolidayTypePreview">

                                        @(Model.IsOptional
                                            ? "Optional"
                                            : "Mandatory")

                                    </span>

                                </h4>

                                Holiday Type

                            </div>

                        </div>

                    </div>

                </div>

            </fieldset>
            <!-- ===================================== -->
            <!-- Summary -->
            <!-- ===================================== -->

            <fieldset>

                <legend class="text-semibold">

                    <i class="icon-list3 position-left"></i>

                    Summary

                </legend>

                <div class="row">

                    <div class="col-md-12">

                        <div class="alert alert-info no-margin">

                            <i class="icon-info22"></i>

                            Fill all required fields before saving.
                            The holiday will be available under the selected
                            Holiday Group calendar.

                        </div>

                    </div>

                </div>

            </fieldset>

        </div>

        <!-- Footer -->

        <div class="panel-footer text-right">

            <a asp-controller="HolidayGroup"
               asp-action="HolidayList"
               asp-route-holidayGroupId="@Model.HolidayGroupId"
               class="btn btn-default">

                <i class="icon-arrow-left13 position-left"></i>

                Back

            </a>

            <button type="reset"
                    class="btn btn-warning">

                <i class="icon-reset position-left"></i>

                Reset

            </button>

            <button type="submit"
                    class="btn bg-primary">

                <i class="icon-floppy-disk position-left"></i>

                @(string.IsNullOrEmpty(Model?.Id)
                    ? "Save Holiday"
                    : "Update Holiday")

            </button>

        </div>

    </div>

</form>
@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        $(document).ready(function () {

            //=========================================
            // Chosen Dropdown
            //=========================================

            if ($(".select-search").length) {

                $(".select-search").chosen({

                    width: "100%",
                    search_contains: true,
                    allow_single_deselect: true

                });

            }

            //=========================================
            // Holiday Name Preview
            //=========================================

            $("#HolidayName").keyup(function () {

                var value = $(this).val();

                if (value == "")
                    value = "-";

                $("#HolidayNamePreview").text(value);

            });

            //=========================================
            // Holiday Date Preview
            //=========================================

            $("#HolidayDate").change(function () {

                var value = $(this).val();

                if (value == "") {

                    $("#HolidayDatePreview").text("-");

                    return;

                }

                var date = new Date(value);

                var options = {

                    day: '2-digit',
                    month: 'short',
                    year: 'numeric'

                };

                $("#HolidayDatePreview")
                    .text(date.toLocaleDateString('en-GB', options));

            });

            //=========================================
            // Holiday Type Preview
            //=========================================

            $("#IsOptional").change(function () {

                if ($(this).is(":checked")) {

                    $("#HolidayTypePreview")
                        .text("Optional");

                }
                else {

                    $("#HolidayTypePreview")
                        .text("Mandatory");

                }

            });

            //=========================================
            // Client Validation
            //=========================================

            $("form").submit(function () {

                if ($("#HolidayGroupId").val() == "") {

                    alert("Please select Holiday Group.");

                    $("#HolidayGroupId").focus();

                    return false;

                }

                if ($("#HolidayDate").val() == "") {

                    alert("Please select Holiday Date.");

                    $("#HolidayDate").focus();

                    return false;

                }

                if ($("#HolidayName").val().trim() == "") {

                    alert("Please enter Holiday Name.");

                    $("#HolidayName").focus();

                    return false;

                }

                return true;

            });

        });

    </script>

    <style>

        /*=========================================
                    Panel
                =========================================*/

        .panel-heading {
            padding: 18px 20px;
        }

        .panel-title {
            font-weight: 600;
        }

        .panel-body {
            padding: 20px;
        }

        .panel-footer {
            background: #fafafa;
            padding: 15px 20px;
        }

        /*=========================================
                    Fieldset
                =========================================*/

        fieldset {
            border: 1px solid #e5e5e5;
            padding: 20px;
            margin-bottom: 20px;
        }

        legend {
            width: auto;
            border: none;
            padding: 0 10px;
            font-size: 15px;
            font-weight: 600;
        }

        /*=========================================
                    Form
                =========================================*/

        .form-group {
            margin-bottom: 18px;
        }

        .form-control {
            border-radius: 3px;
        }

        textarea {
            resize: vertical;
        }

        /*=========================================
                    Dashboard Cards
                =========================================*/

        .panel.bg-primary-400,
        .panel.bg-success-400,
        .panel.bg-warning-400 {
            margin-bottom: 15px;
            border-radius: 3px;
        }

            .panel.bg-primary-400 h4,
            .panel.bg-success-400 h4,
            .panel.bg-warning-400 h4 {
                color: #fff;
                font-weight: 600;
                margin-bottom: 6px;
            }

        /*=========================================
                    Validation
                =========================================*/

        .text-danger {
            font-size: 12px;
        }

        .validation-summary-errors ul {
            margin-bottom: 0;
        }

        /*=========================================
                    Buttons
                =========================================*/

        .btn {
            min-width: 110px;
        }

        /*=========================================
                    Chosen
                =========================================*/

        .chosen-container {
            width: 100% !important;
        }

        .chosen-single {
            height: 36px !important;
            line-height: 34px !important;
        }

        /*=========================================
                    Alert
                =========================================*/

        .alert {
            margin-bottom: 20px;
        }

        /*=========================================
                    Checkbox
                =========================================*/

        .checkbox {
            padding-top: 8px;
        }

        /*=========================================
                    Responsive
                =========================================*/

        @@media (max-width:768px) {

            .panel-footer {
                text-align: center !important;
            }

                .panel-footer .btn {
                    width: 100%;
                    margin-bottom: 10px;
                }
        }

    </style>

}