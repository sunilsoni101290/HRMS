@model HolidayGroupDto

@{
    ViewData["Title"] = "Holiday Group";
}

<div class="container-fluid py-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow border-0 rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="card-header bg-danger text-white py-4">

                    <div class="d-flex align-items-center">

                        <div class="me-3">

                            <div class="bg-white text-danger rounded-circle d-flex align-items-center justify-content-center"
                                 style="width:70px;height:70px;">

                                <i class="bi bi-calendar2-event-fill fs-2"></i>

                            </div>

                        </div>

                        <div>

                            <h3 class="mb-1">

                                @(string.IsNullOrEmpty(Model?.Id)
                                    ? "Create Holiday Group"
                                    : "Edit Holiday Group")

                            </h3>

                            <p class="mb-0 opacity-75">
                                Manage holiday groups for organization
                            </p>

                        </div>

                    </div>

                </div>

                <!-- Body -->
                <div class="card-body p-4">

                    <form asp-controller="HolidayGroup"
                          asp-action="@(Model.Id == null ? "Create" : "Edit")"
                          method="post">

                        <!-- Hidden -->
                        <input asp-for="Id" type="hidden" />
                        <input asp-for="TenantId" type="hidden" />
                        <input asp-for="CreatedBy" type="hidden" />
                        <input asp-for="ModifiedBy" type="hidden" />
                        <input asp-for="ModifiedOn" type="hidden" />

                        <div class="row g-4">

                            <!-- Holiday Group Name -->
                            <div class="col-md-12">

                                <label asp-for="Name"
                                       class="form-label fw-semibold">
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">

                                        <i class="bi bi-calendar-event"></i>

                                    </span>

                                    <input asp-for="Name"
                                           class="form-control"
                                           placeholder="Enter Holiday Group Name" />

                                </div>

                                <span asp-validation-for="Name"
                                      class="text-danger"></span>

                            </div>

                            <!-- Description -->
                            <div class="col-md-12">

                                <label asp-for="Description"
                                       class="form-label fw-semibold">
                                </label>

                                <textarea asp-for="Description"
                                          rows="4"
                                          class="form-control"
                                          placeholder="Enter Description"></textarea>

                            </div>

                        </div>

                        <!-- Footer -->
                        <div class="mt-5 d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-light border rounded-3 px-4">

                                <i class="bi bi-arrow-left"></i>
                                Back

                            </a>

                            <button type="submit"
                                    class="btn btn-danger rounded-3 px-4">

                                <i class="bi bi-check-circle"></i>

                                @(string.IsNullOrEmpty(Model?.Id)
                                    ? "Save"
                                    : "Update")

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts{

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}