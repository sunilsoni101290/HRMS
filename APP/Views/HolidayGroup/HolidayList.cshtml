@model IEnumerable<HolidayGroupDetailDto>

@{
    ViewData["Title"] = "Holiday Management";
    var list = (Model ?? Enumerable.Empty<HolidayGroupDetailDto>()).ToList();
    var mandatoryCount = list.Count(x => !x.IsOptional);
    var optionalCount = list.Count(x => x.IsOptional);
}

@*
    Bootstrap 3.3.7 markup, ent-page/ent-panel style - see
    Views/WeekOff/Index.cshtml / Views/HolidayGroup/Index.cshtml.
*@

<div class="ent-page">
    <div class="ent-panel">

        <div class="d-flex align-items-center gap-2 mb-2 hg-header-row">
            <span class="ent-icon-badge" style="background:#eaf0fe;color:#2b6fd9;"><i class="bi bi-calendar2-week"></i></span>
            <div>
                <h5 class="mb-0" style="font-weight:700;color:#1b2a4a;">Holiday Management</h5>
                <div class="text-muted" style="font-size:12.5px;">Holidays under this holiday group calendar.</div>
            </div>
            <div style="margin-left:auto;" class="hg-header-actions">
                <a asp-controller="HolidayGroup" asp-action="Index" class="btn btn-default"><i class="bi bi-arrow-left"></i> Back</a>
                <a asp-action="Export" class="btn btn-default" data-popup="tooltip" title="Export all holidays (across every holiday group) to Excel"><i class="bi bi-download"></i> Export</a>
                <a asp-action="DownloadImportTemplate" class="btn btn-success"><i class="bi bi-file-earmark-spreadsheet"></i> Download Template</a>
                <a asp-action="Import" class="btn btn-info" data-popup="tooltip" title="Import holiday rows into any existing holiday group from Excel"><i class="bi bi-upload"></i> Import Holidays</a>
                <a asp-action="CreateHoliday" asp-route-holidayGroupId="@ViewBag.HolidayGroupId" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Holiday</a>
            </div>
        </div>

        <!-- Summary tiles -->
        <div class="row hg-tiles">
            <div class="col-md-4 col-sm-4">
                <div class="hg-tile" style="background:#2b6fd9;">
                    <i class="bi bi-calendar3"></i>
                    <div>
                        <h3>@list.Count</h3>
                        <span>Total Holidays</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-4">
                <div class="hg-tile" style="background:#2e9e6c;">
                    <i class="bi bi-check-circle"></i>
                    <div>
                        <h3>@mandatoryCount</h3>
                        <span>Mandatory Holidays</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-4">
                <div class="hg-tile" style="background:#e0a12b;">
                    <i class="bi bi-star"></i>
                    <div>
                        <h3>@optionalCount</h3>
                        <span>Optional Holidays</span>
                    </div>
                </div>
            </div>
        </div>

        <hr />

        <!-- Search & Filter -->
        <div class="row">
            <div class="col-md-5 col-sm-5">
                <div class="form-group">
                    <input type="text" id="searchInput" class="form-control" placeholder="Search Holiday..." />
                </div>
            </div>
            <div class="col-md-3 col-sm-3">
                <div class="form-group">
                    <select id="HolidayType" class="form-control select-search">
                        <option value="">All Holidays</option>
                        <option>Mandatory</option>
                        <option>Optional</option>
                    </select>
                </div>
            </div>
            <div class="col-md-2 col-sm-2">
                <div class="form-group">
                    <input type="date" id="HolidayDate" class="form-control" />
                </div>
            </div>
            <div class="col-md-2 col-sm-2">
                <button class="btn btn-primary btn-block" type="button"><i class="bi bi-search"></i> Search</button>
            </div>
        </div>
    </div>

    <!-- Grid -->
    <div class="ent-panel hg-grid-panel">
        <table class="table table-hover table-striped datatable-basic">
            <thead>
                <tr>
                    <th width="60">#</th>
                    <th>Holiday Group</th>
                    <th>Holiday Date</th>
                    <th>Holiday Name</th>
                    <th width="130">Type</th>
                    <th width="170" class="text-center">Action</th>
                </tr>
            </thead>
            <tbody id="holidayTable">
                @{
                    int sr = 1;
                }

                @foreach (var item in list)
                {
                    <tr>
                        <td>@sr</td>
                        <td>
                            <div class="text-semibold"><i class="bi bi-calendar3 hg-row-icon"></i> @item.HolidayGroupName</div>
                        </td>
                        <td>
                            <span class="text-semibold">@item.HolidayDate.ToString("dd-MMM-yyyy")</span>
                            <br />
                            <small class="text-muted">@item.HolidayDate.ToString("dddd")</small>
                        </td>
                        <td>
                            <div class="text-semibold">@item.HolidayName</div>
                        </td>
                        <td>
                            @if (item.IsOptional)
                            {
                                <span class="hg-badge hg-badge-amber"><i class="bi bi-star"></i> Optional</span>
                            }
                            else
                            {
                                <span class="hg-badge hg-badge-green"><i class="bi bi-check-circle"></i> Mandatory</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group">
                                <a asp-action="EditHoliday" asp-route-id="@item.Id" class="btn btn-primary btn-icon" data-popup="tooltip" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="DeleteHoliday" asp-route-id="@item.Id" onclick="return confirm('Are you sure you want to delete this Holiday?');"
                                   class="btn btn-danger btn-icon" data-popup="tooltip" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                    sr++;
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            //=========================================
            // Bootstrap Tooltip
            //=========================================
            $('[data-popup="tooltip"]').tooltip();

            //=========================================
            // Chosen Dropdown
            //=========================================
            if ($(".select-search").length) {
                $(".select-search").chosen({
                    width: "100%",
                    search_contains: true,
                    allow_single_deselect: true
                });
            }

            //=========================================
            // Search
            //=========================================
            $("#searchInput").keyup(function () {
                filterTable();
            });

            //=========================================
            // Holiday Type Filter
            //=========================================
            $("#HolidayType").change(function () {
                filterTable();
            });

            //=========================================
            // Holiday Date Filter
            //=========================================
            $("#HolidayDate").change(function () {
                filterTable();
            });

            //=========================================
            // Filter Function
            //=========================================
            function filterTable() {
                var keyword = $("#searchInput").val().toLowerCase();
                var holidayType = $("#HolidayType").val().toLowerCase();
                var holidayDate = $("#HolidayDate").val();

                $("#holidayTable tr").each(function () {
                    var row = $(this);

                    var group = row.find("td:eq(1)").text().toLowerCase();
                    var date = row.find("td:eq(2)").text().toLowerCase();
                    var holiday = row.find("td:eq(3)").text().toLowerCase();
                    var type = row.find("td:eq(4)").text().toLowerCase();

                    var searchMatch = keyword == "" || group.indexOf(keyword) > -1 || holiday.indexOf(keyword) > -1;
                    var typeMatch = holidayType == "" || type.indexOf(holidayType) > -1;
                    var dateMatch = true;

                    if (holidayDate != "") {
                        var displayDate = new Date(holidayDate)
                            .toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" })
                            .replace(/ /g, "-").toLowerCase();

                        dateMatch = date.indexOf(displayDate) > -1;
                    }

                    row.toggle(searchMatch && typeMatch && dateMatch);
                });
            }

            //=========================================
            // DataTable
            //=========================================
            if ($.fn.DataTable) {
                var __holidayDataTable = $(".datatable-basic").DataTable({
                    autoWidth: false,
                    ordering: true,
                    paging: true,
                    searching: false,
                    info: true,
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                    language: { search: "_INPUT_", searchPlaceholder: "Search..." },
                    retrieve: true
                });
            }
        });
    </script>

    <style>
        /* ===================================================================
           Same enterprise card + Bootstrap 4/5 utility-class shim used on
           Views/WeekOff/Index.cshtml / Views/HolidayGroup/Index.cshtml.
           =================================================================== */
        .ent-page { background:#f4f6fb; padding:18px; border-radius:10px; }
        .ent-panel { background:#fff; border:1px solid #e7ebf3; border-radius:10px; padding:16px 18px; margin-bottom:18px; }
        .ent-icon-badge { width:34px; height:34px; border-radius:8px; display:inline-flex; align-items:center; justify-content:center; font-size:16px; flex:none; }

        .d-flex { display: flex !important; }
        .align-items-center { align-items: center !important; }
        .gap-2 { gap: .5rem !important; }
        .mb-0 { margin-bottom: 0 !important; }
        .mb-2 { margin-bottom: .5rem !important; }

        .hg-header-row { flex-wrap: wrap; }
        .hg-header-actions { display: flex; flex-wrap: wrap; gap: 6px; }
        .hg-header-actions .btn { margin-left: 0; }

        /*=========================================
                    Tiles
                =========================================*/
        .hg-tiles { margin-top: 4px; }

        .hg-tile {
            display: flex;
            align-items: center;
            gap: 14px;
            border-radius: 8px;
            padding: 16px 18px;
            margin-bottom: 15px;
            color: #fff;
        }

            .hg-tile i {
                font-size: 26px;
                opacity: .9;
            }

            .hg-tile h3 {
                margin: 0;
                font-weight: 700;
                color: #fff;
            }

            .hg-tile span {
                font-size: 12.5px;
                opacity: .9;
            }

        /*=========================================
                    Grid panel
                =========================================*/
        .hg-grid-panel { padding: 0; overflow: hidden; }

        .table > thead > tr > th {
            background: #fafafa;
            font-size: 13px;
            font-weight: 600;
            vertical-align: middle;
        }

        .table > tbody > tr > td {
            font-size: 13px;
            vertical-align: middle;
        }

        .table-hover tbody tr:hover {
            background: #f8f8f8;
        }

        .text-semibold {
            font-weight: 600;
        }

        .hg-row-icon {
            color: #2b6fd9;
            margin-right: 6px;
        }

        .text-muted {
            color: #999;
        }

        /*=========================================
                    Type badges
                =========================================*/
        .hg-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 11.5px;
            font-weight: 600;
            padding: 5px 10px;
            border-radius: 20px;
        }

        .hg-badge-green {
            background: #e8f7ef;
            color: #1e8a54;
        }

        .hg-badge-amber {
            background: #fdf1de;
            color: #b06d10;
        }

        /*=========================================
                    Buttons
                =========================================*/
        .btn-group .btn {
            margin-right: 2px;
        }

        .btn-icon {
            width: 34px;
            height: 34px;
            padding: 7px;
        }

        /*=========================================
                    Chosen
                =========================================*/
        .chosen-container {
            width: 100% !important;
        }

        .chosen-container-single .chosen-single {
            height: 36px !important;
            line-height: 34px !important;
        }

        /*=========================================
                    Responsive
                =========================================*/
        @@media (max-width:768px) {
            .hg-header-row > div:last-child {
                margin-top: 12px;
                margin-left: 0 !important;
            }

            .hg-header-actions {
                width: 100%;
            }

                .hg-header-actions .btn {
                    flex: 1 1 auto;
                }

            .btn-block {
                margin-top: 10px;
            }
        }
    </style>
}
