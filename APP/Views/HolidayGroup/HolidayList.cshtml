@model IEnumerable<HolidayGroupDetailDto>

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h3 class="fw-bold mb-1">

                <i class="bi bi-calendar-date-fill text-warning"></i>
                Holiday Management

            </h3>

            <p class="text-muted mb-0">
                Manage holiday dates and events
            </p>

        </div>

        <div>
            <a asp-controller="HolidayGroup"
               asp-action="Index"
               class="btn btn-light border rounded-3 px-4">

                <i class="bi bi-arrow-left"></i>
                Back to Group

            </a>
            <a asp-action="CreateHoliday"
               asp-route-holidayGroupId="@ViewBag.HolidayGroupId"
               class="btn btn-warning rounded-3 px-4">

                <i class="bi bi-plus-circle"></i>
                Add Holiday

            </a>

        </div>

    </div>

    <!-- Table -->
    <div class="card border-0 shadow rounded-4">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>#</th>
                            <th>Holiday Group</th>
                            <th>Holiday Date</th>
                            <th>Holiday Name</th>
                            <th>Optional</th>
                            <th width="160">Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        @{
                            int sr = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@sr</td>

                                <td>

                                    <span class="badge bg-danger">
                                        @item.HolidayGroupName
                                    </span>

                                </td>

                                <td>

                                    @item.HolidayDate.ToString("dd MMM yyyy")

                                </td>

                                <td>

                                    <div class="fw-semibold">
                                        @item.HolidayName
                                    </div>

                                </td>

                                <td>

                                    @if (item.IsOptional)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Optional
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Mandatory
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="d-flex gap-2">

                                        <a asp-action="EditHoliday"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-warning rounded-3">

                                            <i class="bi bi-pencil-square"></i>

                                        </a>

                                        <a asp-action="DeleteHoliday"
                                           asp-route-id="@item.Id"
                                           onclick="return confirm('Delete this holiday?')"
                                           class="btn btn-sm btn-outline-danger rounded-3">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>

                            sr++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>