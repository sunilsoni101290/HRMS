@model IEnumerable<HolidayGroupDto>

@{
    ViewData["Title"] = "Holiday Group List";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h3 class="fw-bold mb-1">

                <i class="bi bi-calendar2-event-fill text-danger"></i>
                Holiday Group Management

            </h3>

            <p class="text-muted mb-0">
                Manage holiday groups and calendars
            </p>

        </div>

        <div>

            <a asp-action="Create"
               class="btn btn-danger rounded-3 px-4">

                <i class="bi bi-plus-circle"></i>
                Add Holiday Group

            </a>

        </div>

    </div>

    <!-- Search -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-10">

                    <input type="text"
                           id="searchInput"
                           class="form-control"
                           placeholder="Search Holiday Group..." />

                </div>

                <div class="col-md-2">

                    <button class="btn btn-outline-danger w-100">

                        <i class="bi bi-search"></i>
                        Search

                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- Table -->
    <div class="card border-0 shadow rounded-4">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>#</th>
                            <th>Holiday Group</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th width="160">Action</th>

                        </tr>

                    </thead>

                    <tbody id="holidayGroupTable">

                        @{
                            int sr = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- Sr -->
                                <td>
                                    @sr
                                </td>

                                <!-- Name -->
                                <td>

                                    <div class="fw-semibold">

                                        <i class="bi bi-calendar-event text-danger"></i>
                                        @item.Name

                                    </div>

                                </td>

                                <!-- Description -->
                                <td>

                                    @(string.IsNullOrEmpty(item.Description)
                                        ? "-"
                                        : item.Description)

                                </td>

                                <!-- Status -->
                                <td>

                                    <span class="badge bg-success">
                                        Active
                                    </span>

                                </td>

                                <!-- Action -->
                                <td>

                                    <div class="d-flex gap-2">
                                        <!-- Manage Holidays -->
                                        <a asp-controller="HolidayGroup"
                                           asp-action="HolidayList"
                                           asp-route-holidayGroupId="@item.Id"
                                           title="Manage Holiday"
                                           class="btn btn-sm btn-outline-primary rounded-3">

                                            <i class="bi bi-calendar-event"></i>

                                        </a>

                                        <!-- Details -->
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info rounded-3">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <!-- Edit -->
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger rounded-3">

                                            <i class="bi bi-pencil-square"></i>

                                        </a>

                                        <!-- Delete -->
                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           onclick="return confirm('Delete this holiday group?')"
                                           class="btn btn-sm btn-outline-dark rounded-3">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>

                            sr++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        // Search Table

        document.getElementById("searchInput")
            .addEventListener("keyup", function () {

                let value = this.value.toLowerCase();

                let rows = document.querySelectorAll("#holidayGroupTable tr");

                rows.forEach(function (row) {

                    let text = row.innerText.toLowerCase();

                    row.style.display =
                        text.includes(value) ? "" : "none";

                });

            });

    </script>

}