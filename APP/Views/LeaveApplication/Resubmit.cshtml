@model ApplyLeaveRequestDto

@{
    ViewData["Title"] = "Resubmit Leave";
    bool isAdmin = ViewBag.IsAdmin ?? true;
    string employeeDisplayName = ViewBag.EmployeeDisplayName ?? "";
    string? sendBackReason = ViewBag.SendBackReason as string;
}

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">
            <i class="icon-redo2 position-left"></i>
            Resubmit Leave Request
        </h5>

        <div class="heading-elements">

            <a asp-action="Index"
               class="btn btn-default">
                <i class="icon-arrow-left13"></i>
                Back
            </a>

        </div>

    </div>

    <div class="panel-body">

        <div class="alert bg-orange-300 alert-styled-left">
            <span class="text-semibold">This request was sent back for correction.</span>
            @if (!string.IsNullOrEmpty(sendBackReason))
            {
                <div>Reason: @sendBackReason</div>
            }
            Update the details below and resubmit - approval will restart from the first approver.
        </div>

        <form asp-action="Resubmit"
              asp-route-id="@Model.Id"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <input asp-for="Id" type="hidden" />

            <!-- Employee Information -->

            <div class="row">

                <div class="col-md-6">

                    <div class="form-group">

                        <label>Employee</label>

                        <!-- Who the leave belongs to never changes on resubmit -
                             not editable here, even for admin. -->
                        <input type="text"
                               class="form-control bg-slate-100"
                               value="@employeeDisplayName"
                               readonly
                               disabled />

                        <input asp-for="EmployeeId" type="hidden" />

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="form-group">

                        <label asp-for="LeaveTypeId"></label>

                        <select asp-for="LeaveTypeId"
                                asp-items="ViewBag.LeaveTypeList"
                                class="form-control">
                            <option value="">Select Leave Type</option>
                        </select>

                        <span asp-validation-for="LeaveTypeId"
                              class="text-danger"></span>

                    </div>

                </div>

            </div>

            <!-- Leave Dates -->

            <fieldset>

                <legend class="text-semibold">
                    <i class="icon-calendar3"></i>
                    Leave Duration
                </legend>

                <div class="row">

                    <div class="col-md-3">

                        <div class="form-group">

                            <label asp-for="FromDate"></label>

                            <input asp-for="FromDate"
                                   type="date"
                                   class="form-control" />

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="form-group">

                            <label asp-for="ToDate"></label>

                            <input asp-for="ToDate"
                                   type="date"
                                   class="form-control" />

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="form-group">

                            <label>Total Days</label>

                            <input asp-for="TotalDays"
                                   readonly
                                   class="form-control bg-slate-100" />

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="form-group">

                            <label>Half Day Leave</label>

                            <div class="checkbox checkbox-switchery">

                                <label>

                                    <input asp-for="IsHalfDay"
                                           id="chkHalfDay"
                                           type="checkbox"
                                           class="switchery" />

                                </label>

                            </div>

                        </div>

                    </div>

                </div>

            </fieldset>

            <!-- Half Day -->

            <div id="halfDaySection"
                 style="@(Model.IsHalfDay ? "" : "display:none;")">

                <div class="row">

                    <div class="col-md-4">

                        <div class="form-group">

                            <label asp-for="HalfDayType"></label>

                            <select asp-for="HalfDayType"
                                    asp-items="Html.GetEnumSelectList<EnumExtensions.HalfDayType>()"
                                    class="form-control">
                                <option value="">
                                    Select Half Day Type
                                </option>
                            </select>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Reason -->

            <fieldset>

                <legend class="text-semibold">
                    <i class="icon-file-text2"></i>
                    Leave Reason
                </legend>

                <div class="form-group">

                    <label asp-for="Reason"></label>

                    <textarea asp-for="Reason"
                              rows="5"
                              maxlength="500"
                              class="form-control"
                              id="Reason"></textarea>

                    <small class="text-muted">
                        <span id="charCount">0</span>/500 Characters
                    </small>

                </div>

            </fieldset>

            <!-- Attachment -->

            <fieldset>

                <legend class="text-semibold">
                    <i class="icon-attachment"></i>
                    Supporting Document
                </legend>

                <div class="row">

                    <div class="col-md-6">

                        @if (!string.IsNullOrEmpty(Model.DocumentUrl))
                        {
                            <div class="mb-10">
                                <a href="@Model.DocumentUrl" target="_blank">
                                    <i class="icon-attachment"></i>
                                    View current document
                                </a>
                            </div>
                        }

                        <input type="file"
                               name="UploadDocument"
                               class="file-input" />

                        <span class="text-muted text-size-small">
                            Leave empty to keep the existing document.
                        </span>

                    </div>

                </div>

            </fieldset>

            <hr />

            <div class="text-right">

                <a asp-action="Index"
                   class="btn btn-default">

                    Cancel

                </a>

                <button type="submit"
                        class="btn bg-orange">

                    <i class="icon-redo2"></i>
                    Resubmit for Approval

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        $(function () {

            $("#chkHalfDay").change(function () {

                if ($(this).is(":checked")) {

                    $("#halfDaySection").show();

                }
                else {

                    $("#halfDaySection").hide();

                }

                calculateDays();

            });

            $("#FromDate,#ToDate").change(function () {

                calculateDays();

            });

            // Total Days must match what the server will actually save -
            // week-offs and configured holidays inside the chosen range
            // don't count as leave.
            function calculateDays() {

                var fromDate = $("#FromDate").val();
                var toDate = $("#ToDate").val();
                var isHalfDay = $("#chkHalfDay").is(":checked");

                if (!fromDate || !toDate) {
                    return;
                }

                if (new Date(toDate) < new Date(fromDate)) {
                    $("#TotalDays").val(0);
                    return;
                }

                $.ajax({

                    url: '@Url.Action("CalculateTotalDays", "LeaveApplication")',
                    type: 'GET',
                    dataType: 'json',

                    data: {
                        fromDate: fromDate,
                        toDate: toDate,
                        isHalfDay: isHalfDay
                    },

                    success: function (response) {

                        $("#TotalDays").val(response.totalDays);

                    }

                });

            }

        });

    </script>

}
