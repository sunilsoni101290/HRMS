@model ApplyLeaveRequestDto

@{
    ViewData["Title"] = "Apply Leave";
    bool isAdmin = ViewBag.IsAdmin ?? true;
    bool noEmployeeProfile = ViewBag.NoEmployeeProfile ?? false;
    bool hasPendingLeave = ViewBag.HasPendingLeave ?? false;
    string employeeDisplayName = ViewBag.EmployeeDisplayName ?? "";
}

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">
            <i class="icon-calendar-plus position-left"></i>
            Apply Leave
        </h5>

        <div class="heading-elements">

            <a asp-action="Index"
               class="btn btn-default">
                <i class="icon-arrow-left13"></i>
                Back
            </a>

        </div>

    </div>

    <div class="panel-body">

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <div id="pendingLeaveAlert"
                 class="alert alert-warning alert-styled-left"
                 style="@(hasPendingLeave ? "" : "display:none;")">
                <span class="text-semibold">You already have a leave request awaiting approval.</span>
                Please wait until it is approved, rejected, or cancelled before applying for another leave.
            </div>

            <!-- Employee Information -->

            <div class="row">

                <div class="col-md-6">

                    <div class="form-group">

                        <label asp-for="EmployeeId">Employee</label>

                        @if (isAdmin)
                        {
                            <select asp-for="EmployeeId"
                                    asp-items="ViewBag.EmployeeList"
                                    class="form-control">
                                <option value="">Select Employee</option>
                            </select>

                            <span asp-validation-for="EmployeeId"
                                  class="text-danger"></span>
                        }
                        else
                        {
                            <!-- Self-service: always the logged-in employee, never a
                                 pickable dropdown - the server ignores any other
                                 value even if one were posted. -->
                            <input type="text"
                                   class="form-control bg-slate-100"
                                   value="@employeeDisplayName"
                                   readonly
                                   disabled />

                            <input asp-for="EmployeeId" type="hidden" />

                            @if (noEmployeeProfile)
                            {
                                <span class="text-danger text-size-small">
                                    Your login isn't linked to an employee profile - you can't apply leave.
                                </span>
                            }
                        }

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="form-group">

                        <label asp-for="LeaveTypeId"></label>

                        <select asp-for="LeaveTypeId"
                                asp-items="ViewBag.LeaveTypeList"
                                class="form-control">
                            <option value="">Select Leave Type</option>
                        </select>

                        <span asp-validation-for="LeaveTypeId"
                              class="text-danger"></span>

                    </div>

                </div>

            </div>

            @{
                var restrictedHolidayLeaveTypeId = ViewBag.RestrictedHolidayLeaveTypeId as string;
                var availableRestrictedHolidays =
                    (ViewBag.AvailableRestrictedHolidays as List<AvailableRestrictedHolidayDto>)
                    ?? new List<AvailableRestrictedHolidayDto>();
            }

            @if (!string.IsNullOrEmpty(restrictedHolidayLeaveTypeId) && availableRestrictedHolidays.Any())
            {
                <!-- Restricted Holiday helper panel - shown/hidden via JS
                     based on the selected Leave Type. Restricted Holiday can
                     only be claimed on one of these specific dates; clicking
                     a date auto-fills From/To (always single-day). This is a
                     UX nicety only - the API independently re-validates the
                     date regardless. -->
                <div id="restrictedHolidayPanel"
                     class="alert bg-warning-100 alert-styled-left"
                     style="display:none;">

                    <span class="text-semibold">Available Restricted Holidays</span>
                    <p class="text-muted text-size-small mb-10">
                        Restricted Holiday can only be claimed on one of the dates below. Click a date to fill it in.
                    </p>

                    <ul class="list-inline mb-0">

                        @foreach (var holiday in availableRestrictedHolidays)
                        {
                            if (holiday.AlreadyClaimed)
                            {
                                <li>
                                    <button type="button"
                                            class="btn btn-default btn-xs"
                                            disabled
                                            title="Already claimed">
                                        @holiday.HolidayDate.ToString("dd-MMM-yyyy") (@holiday.HolidayName)
                                    </button>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <button type="button"
                                            class="btn btn-primary btn-xs btnPickRestrictedHoliday"
                                            data-date="@holiday.HolidayDate.ToString("yyyy-MM-dd")">
                                        @holiday.HolidayDate.ToString("dd-MMM-yyyy") (@holiday.HolidayName)
                                    </button>
                                </li>
                            }
                        }

                    </ul>

                </div>
            }

            <!-- Leave Balance -->
            <div class="alert bg-info-300 alert-styled-left">
                <span id="leaveBalanceInfo">
                    Available Leave Balance : <strong>0 Days</strong>
                </span>
            </div>

            <input type="hidden" id="AvailableBalance" />

            <!-- Leave Dates -->

            <fieldset>

                <legend class="text-semibold">
                    <i class="icon-calendar3"></i>
                    Leave Duration
                </legend>

                <div class="row">

                    <div class="col-md-3">

                        <div class="form-group">

                            <label asp-for="FromDate"></label>

                            <input asp-for="FromDate"
                                   type="date"
                                   class="form-control" />

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="form-group">

                            <label asp-for="ToDate"></label>

                            <input asp-for="ToDate"
                                   type="date"
                                   class="form-control" />

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="form-group">

                            <label>Total Days</label>

                            <input asp-for="TotalDays"
                                   readonly
                                   class="form-control bg-slate-100" />

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="form-group">

                            <label>Half Day Leave</label>

                            <div class="checkbox checkbox-switchery">

                                <label>

                                    <input asp-for="IsHalfDay"
                                           id="chkHalfDay"
                                           type="checkbox"
                                           class="switchery" />

                                </label>

                            </div>

                        </div>

                    </div>

                </div>

            </fieldset>

            <!-- Half Day -->

            <div id="halfDaySection"
                 style="display:none;">

                <div class="row">

                    <div class="col-md-4">

                        <div class="form-group">

                            <label asp-for="HalfDayType"></label>

                            <select asp-for="HalfDayType"
                                    asp-items="Html.GetEnumSelectList<EnumExtensions.HalfDayType>()"
                                    class="form-control">
                                <option value="">
                                    Select Half Day Type
                                </option>
                            </select>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Reason -->

            <fieldset>

                <legend class="text-semibold">
                    <i class="icon-file-text2"></i>
                    Leave Reason
                </legend>

                <div class="form-group">

                    <label asp-for="Reason"></label>

                    <textarea asp-for="Reason"
                              rows="5"
                              maxlength="500"
                              class="form-control"
                              id="Reason"></textarea>

                    <small class="text-muted">
                        <span id="charCount">0</span>/500 Characters
                    </small>

                </div>

            </fieldset>

            <!-- Attachment -->

            <fieldset>

                <legend class="text-semibold">
                    <i class="icon-attachment"></i>
                    Supporting Document
                </legend>

                <div class="row">

                    <div class="col-md-6">

                        <input type="file"
                               name="UploadDocument"
                               class="file-input" />
                    </div>

                </div>

            </fieldset>

            <hr />

            <div class="text-right">

                <a asp-action="Index"
                   class="btn btn-default">

                    Cancel

                </a>

                <button type="submit"
                        id="btnSubmitLeave"
                        class="btn bg-primary"
                        @((noEmployeeProfile || hasPendingLeave) ? "disabled" : "")>

                    <i class="icon-checkmark4"></i>
                    Submit Leave

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        $(function () {

            $("#chkHalfDay").change(function () {

                if ($(this).is(":checked")) {

                    $("#halfDaySection").show();

                }
                else {

                    $("#halfDaySection").hide();

                }

                calculateDays();

            });

            $("#FromDate,#ToDate").change(function () {

                calculateDays();

            });

            // Total Days must match what the server will actually save -
            // week-offs (e.g. Sat/Sun) and configured holidays inside the
            // chosen range don't count as leave, so the count is asked from
            // the server (same logic used on submit) instead of a plain
            // calendar-day difference.
            function calculateDays() {

                var fromDate = $("#FromDate").val();
                var toDate = $("#ToDate").val();
                var isHalfDay = $("#chkHalfDay").is(":checked");

                if (!fromDate || !toDate) {
                    return;
                }

                if (new Date(toDate) < new Date(fromDate)) {
                    $("#TotalDays").val(0);
                    return;
                }

                $.ajax({

                    url: '@Url.Action("CalculateTotalDays", "LeaveApplication")',
                    type: 'GET',
                    dataType: 'json',

                    data: {
                        fromDate: fromDate,
                        toDate: toDate,
                        isHalfDay: isHalfDay
                    },

                    success: function (response) {

                        $("#TotalDays").val(response.totalDays);

                    }

                });

            }

        });

                    $(document).ready(function () {

            $("#EmployeeId, #LeaveTypeId").on("change", function () {

                loadLeaveBalance();

            });

            @if (isAdmin)
            {
                <text>
                $("#EmployeeId").on("change", function () {

                    checkPendingLeave();

                });
                </text>
            }

        });

        // Restricted Holiday helper panel - show it only while the
        // Restricted Holiday LeaveType is selected; clicking a listed date
        // fills From/To with that date (always single-day) and triggers the
        // existing #FromDate/#ToDate change handler to recalculate Total
        // Days server-side, same as picking the date manually.
        var restrictedHolidayLeaveTypeId = @Html.Raw(
            string.IsNullOrEmpty(ViewBag.RestrictedHolidayLeaveTypeId as string)
                ? "null"
                : Newtonsoft.Json.JsonConvert.SerializeObject((string)ViewBag.RestrictedHolidayLeaveTypeId));

        function toggleRestrictedHolidayPanel() {

            if (!restrictedHolidayLeaveTypeId) {
                return;
            }

            if ($("#LeaveTypeId").val() === restrictedHolidayLeaveTypeId) {
                $("#restrictedHolidayPanel").show();
            } else {
                $("#restrictedHolidayPanel").hide();
            }

        }

        $(function () {

            toggleRestrictedHolidayPanel();

            $("#LeaveTypeId").on("change", function () {

                toggleRestrictedHolidayPanel();

            });

            $(document).on("click", ".btnPickRestrictedHoliday", function () {

                var date = $(this).data("date");

                $("#FromDate").val(date).trigger("change");
                $("#ToDate").val(date).trigger("change");

            });

        });

        function checkPendingLeave() {

            var employeeId = $("#EmployeeId").val();

            if (!employeeId) {

                $("#pendingLeaveAlert").hide();
                $("#btnSubmitLeave").prop("disabled", false);

                return;
            }

            $.ajax({

                url: '@Url.Action("HasPendingLeave", "LeaveApplication")',
                type: 'GET',
                dataType: 'json',

                data: {
                    employeeId: employeeId
                },

                success: function (response) {

                    if (response.hasPending) {

                        $("#pendingLeaveAlert").show();
                        $("#btnSubmitLeave").prop("disabled", true);

                    } else {

                        $("#pendingLeaveAlert").hide();
                        $("#btnSubmitLeave").prop("disabled", false);

                    }

                }

            });

        }

        function loadLeaveBalance() {

            var employeeId = $("#EmployeeId").val();
            var leaveTypeId = $("#LeaveTypeId").val();

            if (!employeeId || !leaveTypeId) {

                $("#leaveBalanceInfo").html(
                    'Available Leave Balance : <strong>0 Days</strong>'
                );

                return;
            }

            $.ajax({

                url: '@Url.Action("EmployeeBalance", "LeaveBalance")',
                type: 'GET',
                dataType: 'json',

                data: {
                    employeeId: employeeId,
                    leaveTypeId: leaveTypeId
                },

                beforeSend: function () {

                    $("#leaveBalanceInfo").html(
                        '<i class="icon-spinner2 spinner"></i> Loading balance...'
                    );

                },

                success: function (response) {

                    console.log("Response:", response);

                    var balance = 0;

                    // Case 1
                    if (response.balance !== undefined) {
                        balance = response.balance;
                    }

                    // Case 2
                    else if (response.Balance !== undefined) {
                        balance = response.Balance;
                    }

                    // Case 3
                    else if (response.success && response.balance !== undefined) {
                        balance = response.balance;
                    }

                    $("#leaveBalanceInfo").html(
                        'Available Leave Balance : <strong class="text-white">' +
                        balance +
                        ' Days</strong>'
                    );

                    $("#AvailableBalance").val(balance);
                },

                error: function (xhr, status, error) {

                    console.log(xhr.responseText);

                    $("#leaveBalanceInfo").html(
                        '<span class="text-danger">Unable to load balance</span>'
                    );

                }

            });

        }
    </script>

}