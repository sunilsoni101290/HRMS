@model IEnumerable<LeaveApplicationDto>

@{
    bool isAdmin = ViewBag.IsAdmin ?? true;

    // Who is viewing this list right now - used to decide, per row, whether
    // the Approve/Reject/Send Back buttons should even be shown. The API
    // re-checks this for real when a button is clicked; this is only about
    // not showing actions the viewer can't actually use.
    string? currentEmployeeId = ViewBag.CurrentEmployeeId as string;
    bool viewerIsHR = ViewBag.IsHR ?? false;

    bool CanAct(LeaveApplicationDto item) =>
        item.Status == EnumExtensions.ApprovalStatus.Pending &&
        (
            (item.CurrentLevel == 3 && viewerIsHR) ||
            (item.CurrentLevel != 3 &&
                !string.IsNullOrEmpty(item.CurrentApproverEmployeeId) &&
                item.CurrentApproverEmployeeId == currentEmployeeId)
        );

    // Self-service: if the employee already has a leave request awaiting
    // approval, don't let them jump straight into another Apply Leave form
    // from here either - the server would reject it anyway.
    bool hasPendingLeave = !isAdmin && Model.Any(x => x.Status == EnumExtensions.ApprovalStatus.Pending);
}

@* Visual layer only, migrated onto the shared design system - the
   approve/reject/send-back/cancel modals, CanAct() permission logic, and
   all filter/search behavior below are unchanged. *@

<div class="ent-page-header">
    <div>
        <h4><i class="icon-calendar3 position-left"></i> @(ViewBag.ListTitle ?? "Leave Application Management")</h4>
        <p>Apply, review and track leave requests and approvals</p>
    </div>

    <div class="ent-page-header-actions">

        <a asp-action="Calendar" class="btn btn-default">
            <i class="icon-calendar3"></i>
            Leave Calendar
        </a>

        <a asp-action="MyApprovals" class="btn btn-default">
            <i class="icon-checkmark4"></i>
            Pending My Approval
        </a>

        @if (hasPendingLeave)
        {
            <button type="button"
                    class="btn bg-primary disabled"
                    disabled
                    data-popup="tooltip"
                    title="You already have a leave request awaiting approval.">
                <i class="icon-plus22"></i>
                Apply Leave
            </button>
        }
        else
        {
            <a asp-action="Create" class="btn bg-primary">
                <i class="icon-plus22"></i>
                Apply Leave
            </a>
        }
    </div>

</div>

<div class="ent-filter-card">
    @await Html.PartialAsync("_Filter", new LeaveApplicationFilterRequestDto())
</div>

<div class="ent-list-card">
<div class="table-responsive">
<table id="leaveApplicationTable" class="table ent-list-table table-hover datatable-basic">

        <thead>
            <tr>
                <th>Employee</th>
                <th>Leave Type</th>
                <th>From Date</th>
                <th>To Date</th>
                <th>Total Days</th>
                <th>Status</th>
                <th>Awaiting</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.EmployeeName</td>

                    <td>
                        <span class="ent-status-pill ent-badge-info">
                            @item.LeaveTypeName
                        </span>
                    </td>

                    <td>@item.FromDate.ToString("dd-MMM-yyyy")</td>

                    <td>@item.ToDate.ToString("dd-MMM-yyyy")</td>

                    <td>@item.TotalDays</td>

                    <td>

                        @if (item.Status == EnumExtensions.ApprovalStatus.Pending)
                        {
                            <span class="ent-status-pill ent-badge-warning">Pending</span>
                        }
                        else if (item.Status == EnumExtensions.ApprovalStatus.Approved)
                        {
                            <span class="ent-status-pill ent-badge-success">Approved</span>
                        }
                        else if (item.Status == EnumExtensions.ApprovalStatus.Rejected)
                        {
                            <span class="ent-status-pill ent-badge-danger">Rejected</span>
                        }
                        else if (item.Status == EnumExtensions.ApprovalStatus.ReturnedToEmployee)
                        {
                            <span class="ent-status-pill ent-badge-warning">Sent Back</span>
                        }
                        else if (item.Status == EnumExtensions.ApprovalStatus.Cancelled)
                        {
                            <span class="ent-status-pill ent-badge-neutral">Cancelled</span>
                        }
                        else
                        {
                            <span class="ent-status-pill ent-badge-neutral">@item.Status</span>
                        }

                    </td>

                    <td>

                        @if (item.Status == EnumExtensions.ApprovalStatus.Pending)
                        {
                            <span class="ent-status-pill ent-badge-neutral">@item.CurrentLevelName</span>
                        }
                        else if (item.Status == EnumExtensions.ApprovalStatus.ReturnedToEmployee)
                        {
                            <span class="text-muted text-size-small" data-popup="tooltip" title="@item.SendBackReason">
                                Employee
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">&mdash;</span>
                        }

                    </td>

                    <td style="padding: 10px 15px;">

                        <div class="btn-group">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-default btn-icon"
                               data-popup="tooltip"
                               title="View">

                                <i class="icon-eye"></i>

                            </a>

                            @if (item.Status == EnumExtensions.ApprovalStatus.ReturnedToEmployee &&
                                 (isAdmin || item.EmployeeId == currentEmployeeId))
                            {
                                <a asp-action="Resubmit"
                                   asp-route-id="@item.Id"
                                   class="btn bg-orange btn-icon"
                                   data-popup="tooltip"
                                   title="Edit &amp; Resubmit">

                                    <i class="icon-redo2"></i>

                                </a>
                            }

                            @if (CanAct(item))
                            {
                                <button type="button"
                                        class="btn btn-success btn-icon btnApprove"
                                        data-id="@item.Id"
                                        data-popup="tooltip"
                                        title="Approve (@item.CurrentLevelName)">

                                    <i class="icon-checkmark4"></i>

                                </button>

                                <button type="button"
                                        class="btn btn-danger btn-icon btnReject"
                                        data-id="@item.Id"
                                        data-popup="tooltip"
                                        title="Reject">

                                    <i class="icon-cross2"></i>

                                </button>

                                <button type="button"
                                        class="btn bg-warning btn-icon btnSendBack"
                                        data-id="@item.Id"
                                        data-popup="tooltip"
                                        title="Send Back to Employee">

                                    <i class="icon-undo2"></i>

                                </button>
                            }

                            @if (isAdmin && item.Status == EnumExtensions.ApprovalStatus.Pending)
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-primary btn-icon"
                                   data-popup="tooltip"
                                   title="Edit">

                                    <i class="icon-pencil7"></i>

                                </a>
                            }

                            @if (item.Status == EnumExtensions.ApprovalStatus.Pending &&
                                 (isAdmin || item.EmployeeId == currentEmployeeId))
                            {
                                <button type="button"
                                        class="btn bg-slate btn-icon btnCancel"
                                        data-id="@item.Id"
                                        data-popup="tooltip"
                                        title="Cancel">

                                    <i class="icon-blocked"></i>

                                </button>
                            }

                            @if (isAdmin)
                            {
                                <a asp-action="ApprovalHistory"
                                   asp-controller="LeaveApprovalHistory"
                                   asp-route-leaveApplicationId="@item.Id"
                                   class="btn btn-primary btn-icon"
                                   data-popup="tooltip"
                                   title="Approval History">

                                    <i class="icon-history"></i>

                                </a>
                            }
                        </div>

                    </td>

                </tr>
            }

        </tbody>

    </table>
</div>
</div>

<partial name="_ApproveModal"
         model="new ApproveLeaveRequestDto()" />
<partial name="_RejectModal"
         model="new RejectLeaveRequestDto()" />
<partial name="_SendBackModal"
         model="new SendBackLeaveRequestDto()" />
<partial name="_CancelModal"
         model="new CancelLeaveRequestDto()" />

<script src="~/global_assets/js/plugins/notifications/sweet_alert.min.js"></script>

@section Scripts {
    <script>

        @if (TempData["Success"] != null)
        {
                <text>
                    swal({
                        title: 'Success',
                        text: '@Html.Raw(TempData["Success"])',
                        type: 'success',
                        confirmButtonColor: '#66BB6A'
                    });
                </text>
        }

        @if (TempData["Error"] != null)
        {
                <text>
                    swal({
                        title: 'Error',
                        text: '@Html.Raw(TempData["Error"])',
                        type: 'error',
                        confirmButtonColor: '#EF5350'
                    });
                </text>
        }

    </script>
    <script>

        // Search Table (not rendered for self-service users)

        var searchInputEl = document.getElementById("searchInput");
        if (searchInputEl) {
            searchInputEl.addEventListener("keyup", function () {

                let value = this.value.toLowerCase();

                let rows = document.querySelectorAll("#leaveApplicationTable tr");

                rows.forEach(function (row) {

                    let text = row.innerText.toLowerCase();

                    row.style.display =
                        text.includes(value) ? "" : "none";

                });

            });
        }


        $(document).ready(function () {

            $('[data-popup="tooltip"]').tooltip();

           

            // Approve
            $(document).on('click', '.btnApprove', function () {
                var id = $(this).data('id');

                $('#ApproveLeaveId').val(id);

                $('#approveModal').modal('show');

            });

            // Reject
            $(document).on('click', '.btnReject', function () {
                var id = $(this).data('id');

                $('#RejectLeaveId').val(id);

                $('#rejectModal').modal('show');

            });

            // Send Back
            $(document).on('click', '.btnSendBack', function () {
                var id = $(this).data('id');

                $('#SendBackLeaveId').val(id);

                $('#sendBackModal').modal('show');

            });

            // Cancel
            $(document).on('click', '.btnCancel', function () {
                var id = $(this).data('id');

                $('#CancelLeaveId').val(id);

                $('#cancelModal').modal('show');

            });

        });

    </script>



    <script>
        // Auto-added: client-side pagination for this Index page's listing
        // table (DataTables). Safe to run even if this page already
        // initializes '.datatable-basic' itself above - 'retrieve: true'
        // makes DataTables return the existing instance instead of
        // re-initializing (and throwing) when that's the case.
        $(document).ready(function () {
            if ($.fn.DataTable) {
                var __indexDataTable = $('.datatable-basic').DataTable({
                    autoWidth: false,
                    paging: true,
                    ordering: true,
                    searching: true,
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                    language: { search: "_INPUT_", searchPlaceholder: "Search..." },
                    retrieve: true
                });
            }
        });
    </script>
}
