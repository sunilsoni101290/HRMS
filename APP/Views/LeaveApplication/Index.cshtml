@model IEnumerable<LeaveApplicationDto>

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">
            <i class="icon-calendar3 position-left"></i>
            Leave Application Management
        </h5>

        <div class="heading-elements">
            <a asp-action="Create" class="btn bg-primary">
                <i class="icon-plus22"></i>
                Apply Leave
            </a>
        </div>

    </div>

    <div class="panel-body">
        @await Html.PartialAsync("_Filter", new LeaveApplicationFilterRequestDto())
    </div>

    <table id="leaveApplicationTable" class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>Employee</th>
                <th>Leave Type</th>
                <th>From Date</th>
                <th>To Date</th>
                <th>Total Days</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.EmployeeName</td>

                    <td>
                        <span class="label bg-primary">
                            @item.LeaveTypeName
                        </span>
                    </td>

                    <td>@item.FromDate.ToString("dd-MMM-yyyy")</td>

                    <td>@item.ToDate.ToString("dd-MMM-yyyy")</td>

                    <td>@item.TotalDays</td>

                    <td>

                        @if (item.Status == EnumExtensions.ApprovalStatus.Pending)
                        {
                            <span class="label bg-warning">Pending</span>
                        }
                        else if (item.Status == EnumExtensions.ApprovalStatus.Approved)
                        {
                            <span class="label bg-success">Approved</span>
                        }
                        else if (item.Status == EnumExtensions.ApprovalStatus.Rejected)
                        {
                            <span class="label bg-danger">Rejected</span>
                        }
                        else
                        {
                            <span class="label bg-grey">Cancelled</span>
                        }

                    </td>

                    <td style="padding: 10px 15px;">

                        <div class="btn-group">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-default btn-icon"
                               data-popup="tooltip"
                               title="View">

                                <i class="icon-eye"></i>

                            </a>

                            @if (item.Status == EnumExtensions.ApprovalStatus.Pending)
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-primary btn-icon"
                                   data-popup="tooltip"
                                   title="Edit">

                                    <i class="icon-pencil7"></i>

                                </a>

                                <button type="button"
                                        class="btn btn-success btn-icon btnApprove"
                                        data-id="@item.Id"
                                        data-popup="tooltip"
                                        title="Approve">

                                    <i class="icon-checkmark4"></i>

                                </button>

                                <button type="button"
                                        class="btn btn-danger btn-icon btnReject"
                                        data-id="@item.Id"
                                        data-popup="tooltip"
                                        title="Reject">

                                    <i class="icon-cross2"></i>

                                </button>

                                <button type="button"
                                        class="btn bg-warning btn-icon btnCancel"
                                        data-id="@item.Id"
                                        data-popup="tooltip"
                                        title="Cancel">

                                    <i class="icon-blocked"></i>

                                </button>
                            }
                            <a asp-action="ApprovalHistory"
                               asp-controller="LeaveApprovalHistory"
                               asp-route-leaveApplicationId="@item.Id"
                               class="btn btn-primary btn-icon"
                               data-popup="tooltip"
                               title="Approval History">

                                <i class="icon-history"></i>

                            </a>
                        </div>

                    </td>

                </tr>
            }

        </tbody>

    </table>
    
</div>

<partial name="_ApproveModal"
         model="new ApproveLeaveRequestDto()" />
<partial name="_RejectModal"
         model="new RejectLeaveRequestDto()" />
<partial name="_CancelModal"
         model="new CancelLeaveRequestDto()" />

<script src="~/global_assets/js/plugins/notifications/sweet_alert.min.js"></script>

@section Scripts {
    <script>

        @if (TempData["Success"] != null)
        {
                <text>
                    swal({
                        title: 'Success',
                        text: '@Html.Raw(TempData["Success"])',
                        type: 'success',
                        confirmButtonColor: '#66BB6A'
                    });
                </text>
        }

        @if (TempData["Error"] != null)
        {
                <text>
                    swal({
                        title: 'Error',
                        text: '@Html.Raw(TempData["Error"])',
                        type: 'error',
                        confirmButtonColor: '#EF5350'
                    });
                </text>
        }

    </script>
    <script>

        // Search Table

        document.getElementById("searchInput")
            .addEventListener("keyup", function () {

                let value = this.value.toLowerCase();

                let rows = document.querySelectorAll("#leaveApplicationTable tr");

                rows.forEach(function (row) {

                    let text = row.innerText.toLowerCase();

                    row.style.display =
                        text.includes(value) ? "" : "none";

                });

            });


        $(document).ready(function () {

            $('[data-popup="tooltip"]').tooltip();

           

            // Approve
            $(document).on('click', '.btnApprove', function () {
                debugger;
                var id = $(this).data('id');

                $('#ApproveLeaveId').val(id);

                $('#approveModal').modal('show');

            });

            // Reject
            $(document).on('click', '.btnReject', function () {
                debugger;
                var id = $(this).data('id');

                $('#RejectLeaveId').val(id);

                $('#rejectModal').modal('show');

            });

            // Cancel
            $(document).on('click', '.btnCancel', function () {
                debugger;
                var id = $(this).data('id');

                $('#CancelLeaveId').val(id);

                $('#cancelModal').modal('show');

            });

        });

    </script>


}