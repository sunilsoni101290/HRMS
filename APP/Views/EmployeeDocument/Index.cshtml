@model IEnumerable<EmployeeDocumentDto>

@{
    ViewData["Title"] = ViewBag.ListTitle ?? "Employee Documents";
    var today = DateTime.Today;
    bool isAdmin = ViewBag.IsAdmin ?? true;
}

<div class="panel panel-flat">

    <div class="panel-heading">
        <h5 class="panel-title"><i class="icon-file-text2 position-left"></i> @ViewData["Title"]</h5>
        @if (isAdmin)
        {
            <div class="heading-elements">
                <a asp-action="Create" class="btn bg-primary"><i class="icon-plus22"></i> Upload Document</a>
                <a asp-action="Expiring" class="btn btn-warning"><i class="icon-alarm"></i> Expiring</a>
                <a asp-action="Expired" class="btn btn-danger"><i class="icon-warning22"></i> Expired</a>
            </div>
        }
    </div>

    <div class="panel-body">
        <div class="row">
            <div class="col-md-4">
                <input type="text" id="searchInput" class="form-control" placeholder="Search employee, type, number..." />
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-striped datatable-basic">
            <thead>
                <tr>
                    <th width="50">#</th>
                    <th>Employee</th>
                    <th>Type</th>
                    <th>Number</th>
                    <th>File</th>
                    <th>Expiry</th>
                    <th>Verified</th>
                    <th width="230">Action</th>
                </tr>
            </thead>
            <tbody id="dataTable">
                @{ int sr = 1; }
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        bool expired = item.ExpiryDate.HasValue && item.ExpiryDate.Value.Date < today;
                        bool expiringSoon = item.ExpiryDate.HasValue && item.ExpiryDate.Value.Date >= today && item.ExpiryDate.Value.Date <= today.AddDays(30);
                        <tr>
                            <td>@sr</td>
                            <td><strong>@item.EmployeeName</strong></td>
                            <td><span class="label bg-primary">@(item.DocumentTypeText ?? item.DocumentType.ToString())</span></td>
                            <td>@(item.DocumentNumber ?? "-")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.FilePath))
                                {
                                    <a href="@item.FilePath" target="_blank" class="text-primary" title="View"><i class="icon-eye"></i></a>
                                    <a asp-action="Download" asp-route-id="@item.Id" class="text-primary" title="Download" style="margin-left:6px;"><i class="icon-download"></i></a>
                                }
                                else { <span class="text-muted">-</span> }
                            </td>
                            <td>
                                @if (item.ExpiryDate.HasValue)
                                {
                                    <span class="label @(expired ? "bg-danger" : expiringSoon ? "bg-warning" : "bg-grey-300")">
                                        @item.ExpiryDate.Value.ToString("dd MMM yyyy")
                                    </span>
                                }
                                else { <span class="text-muted">-</span> }
                            </td>
                            <td>
                                @if (item.IsVerified)
                                {
                                    <span class="label bg-success"><i class="icon-checkmark3"></i> Verified</span>
                                }
                                else
                                {
                                    <span class="label bg-grey">Pending</span>
                                }
                            </td>
                            <td>
                                @if (isAdmin)
                                {
                                    @if (!item.IsVerified)
                                    {
                                        <form asp-action="Verify" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-success btn-icon" title="Verify"><i class="icon-checkmark3"></i></button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="UnVerify" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-warning btn-icon" title="Unverify"><i class="icon-cross2"></i></button>
                                        </form>
                                    }
                                }
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-default btn-icon" title="View"><i class="icon-eye"></i></a>
                                @if (isAdmin)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-icon" title="Edit"><i class="icon-pencil7"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                       onclick="return confirmSweetDelete(event, this, 'Delete this document?');"
                                       class="btn btn-danger btn-icon" title="Delete"><i class="icon-trash"></i></a>
                                }
                            </td>
                        </tr>
                        sr++;
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center text-muted" style="padding:30px;"><i class="icon-file-text2" style="font-size:32px;"></i><br />No documents found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    @if (TempData["Success"] != null)
    {
        <script>$(function(){ swal({ title:"Success", text:"@TempData["Success"]", type:"success" }); });</script>
    }
    <script>
        $(function () {
            $("#searchInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#dataTable tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
        });
    </script>
    <style>
        .table > thead > tr > th { font-weight: 600; }
        .table > tbody > tr > td { vertical-align: middle; }
        .label { font-size: 11px; }
        .btn-icon { width: 34px; }
    </style>

    <script>
        // Auto-added: client-side pagination for this Index page's listing
        // table (DataTables). Safe to run even if this page already
        // initializes '.datatable-basic' itself above - 'retrieve: true'
        // makes DataTables return the existing instance instead of
        // re-initializing (and throwing) when that's the case.
        $(document).ready(function () {
            if ($.fn.DataTable) {
                var __indexDataTable = $('.datatable-basic').DataTable({
                    autoWidth: false,
                    paging: true,
                    ordering: true,
                    searching: false,
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                    language: { search: "_INPUT_", searchPlaceholder: "Search..." },
                    retrieve: true
                });

            // Rewire the page's existing search box to drive DataTables'
            // own filtering pipeline (instead of any legacy row .toggle()
            // logic still bound above), so search results stay correct once
            // rows are split across pages.
            $('#searchInput').on('keyup', function () {
                __indexDataTable.search($(this).val() || '').draw();
            });
            }
        });
    </script>
}
