@model IEnumerable<RejoiningHistoryDto>

@{
    ViewData["Title"] = "Rejoining History";
}

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">
            <i class="icon-user-plus position-left"></i>
            Rejoining History
        </h5>

        <div class="heading-elements">

            <a asp-action="Eligible" class="btn bg-primary">
                <i class="icon-plus22"></i>
                Rejoin an Employee
            </a>

        </div>

    </div>

    <div class="panel-body">

        <form asp-action="Index" method="get" class="row">

            <div class="col-md-4">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by employee name/code..." />
            </div>

            <div class="col-md-3">
                <button type="submit" class="btn btn-default">
                    <i class="icon-search4"></i>
                    Search
                </button>
            </div>

        </form>

    </div>

    <div class="table-responsive">

        <table class="table table-bordered table-striped datatable-basic">

            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Previous Relieving Date</th>
                    <th>Previous Joining Date</th>
                    <th>New Joining Date</th>
                    <th>Reason</th>
                    <th>Processed By</th>
                    <th>Processed On</th>
                    <th width="60"></th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.EmployeeName
                                <br />
                                <span class="text-muted text-size-small">@item.EmployeeCode</span>
                            </td>

                            <td>@item.PreviousRelievingDate.ToString("dd-MMM-yyyy")</td>

                            <td>@item.PreviousJoiningDate.ToString("dd-MMM-yyyy")</td>

                            <td><span class="label bg-success">@item.NewJoiningDate.ToString("dd-MMM-yyyy")</span></td>

                            <td>
                                <span class="text-muted text-size-small">
                                    @(string.IsNullOrWhiteSpace(item.Reason) ? "-" : (item.Reason.Length > 40 ? item.Reason.Substring(0, 40) + "..." : item.Reason))
                                </span>
                            </td>

                            <td>@(item.ProcessedByName ?? "-")</td>

                            <td>@item.ProcessedOn.ToString("dd-MMM-yyyy HH:mm")</td>

                            <td style="padding: 10px 15px;">

                                <a asp-controller="Employee"
                                   asp-action="Details"
                                   asp-route-id="@item.EmployeeId"
                                   class="btn btn-default btn-icon"
                                   data-popup="tooltip"
                                   title="View Employee">
                                    <i class="icon-eye"></i>
                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted" style="padding:30px;">
                            <i class="icon-user-plus" style="font-size:32px;"></i><br />
                            No rejoining records found.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<script src="~/global_assets/js/plugins/notifications/sweet_alert.min.js"></script>

@section Scripts {

    <script>

        @if (TempData["Success"] != null)
        {
            <text>
                swal({
                    title: 'Success',
                    text: '@Html.Raw(TempData["Success"])',
                    type: 'success',
                    confirmButtonColor: '#66BB6A'
                });
            </text>
        }

        @if (TempData["GlobalError"] != null)
        {
            <text>
                swal({
                    title: 'Error',
                    text: '@Html.Raw(TempData["GlobalError"])',
                    type: 'error',
                    confirmButtonColor: '#EF5350'
                });
            </text>
        }

    </script>

    <script>
        $(document).ready(function () {
            $('[data-popup="tooltip"]').tooltip();
        });
    </script>


    <script>
        // Auto-added: client-side pagination for this Index page's listing
        // table (DataTables). Safe to run even if this page already
        // initializes '.datatable-basic' itself above - 'retrieve: true'
        // makes DataTables return the existing instance instead of
        // re-initializing (and throwing) when that's the case.
        $(document).ready(function () {
            if ($.fn.DataTable) {
                var __indexDataTable = $('.datatable-basic').DataTable({
                    autoWidth: false,
                    paging: true,
                    ordering: true,
                    searching: true,
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                    language: { search: "_INPUT_", searchPlaceholder: "Search..." },
                    retrieve: true
                });
            }
        });
    </script>
}
