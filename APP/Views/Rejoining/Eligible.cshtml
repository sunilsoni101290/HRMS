@model IEnumerable<RejoiningEligibleEmployeeDto>

@{
    ViewData["Title"] = "Eligible For Rejoin";
}

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">
            <i class="icon-user-plus position-left"></i>
            Eligible For Rejoin
        </h5>

        <div class="heading-elements">

            <a asp-action="Index" class="btn btn-default">
                <i class="icon-list"></i>
                Rejoining History
            </a>

        </div>

    </div>

    <div class="panel-body">

        <p class="text-muted">
            Former employees (Relieving Date already set) who can be rehired. Click "Rejoin" to process one.
        </p>

        <form asp-action="Eligible" method="get" class="row">

            <div class="col-md-4">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by employee name/code..." />
            </div>

            <div class="col-md-3">
                <button type="submit" class="btn btn-default">
                    <i class="icon-search4"></i>
                    Search
                </button>
            </div>

        </form>

    </div>

    <div class="table-responsive">

        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>Designation</th>
                    <th>Joining Date</th>
                    <th>Relieving Date</th>
                    <th width="120">Action</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.EmployeeName
                                <br />
                                <span class="text-muted text-size-small">@item.EmployeeCode</span>
                            </td>

                            <td>@(item.DepartmentName ?? "-")</td>

                            <td>@(item.DesignationName ?? "-")</td>

                            <td>@item.JoiningDate.ToString("dd-MMM-yyyy")</td>

                            <td><span class="label bg-danger">@item.RelievingDate.ToString("dd-MMM-yyyy")</span></td>

                            <td style="padding: 10px 15px;">

                                <a asp-action="Create"
                                   asp-route-employeeId="@item.EmployeeId"
                                   class="btn bg-primary btn-sm">
                                    <i class="icon-plus22"></i>
                                    Rejoin
                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted" style="padding:30px;">
                            <i class="icon-user-check" style="font-size:32px;"></i><br />
                            No former employees are currently eligible to rejoin.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<script src="~/global_assets/js/plugins/notifications/sweet_alert.min.js"></script>

@section Scripts {

    <script>

        @if (TempData["GlobalError"] != null)
        {
            <text>
                swal({
                    title: 'Error',
                    text: '@Html.Raw(TempData["GlobalError"])',
                    type: 'error',
                    confirmButtonColor: '#EF5350'
                });
            </text>
        }

    </script>

}
