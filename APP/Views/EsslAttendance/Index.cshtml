    .flow-list li:before { content:"• "; }
    .flow-arrow { display:flex; align-items:center; color:#b7c1d6; font-size:18px; flex:0 0 auto; }
    .ent-icon-badge { width:34px; height:34px; border-radius:8px; display:inline-flex; align-items:center; justify-content:center; font-size:16px; }
    .ent-counter { background:#fbfcfe; border:1px solid #eef1f7; border-radius:8px; padding:8px 4px; }
    .ent-counter-val { font-weight:700; font-size:17px; }
