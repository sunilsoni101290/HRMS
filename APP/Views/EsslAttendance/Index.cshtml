@section Scripts {
    <script>
        $(function () {

            // ==============================================================
            // Backend endpoints reused, unchanged, from both existing
            // features - this page adds NO new API routes for either sync
            // engine. Only CombinedLog below is new, and it lives on THIS
            // (APP) controller as a thin read-only composition.
            // ==============================================================
            var AUTO_SYNC_NOW_URL   = '@Url.Action("SyncNow")';
            var AUTO_GET_STATUS_URL = '@Url.Action("GetStatus")';
            var AUTO_RESET_STUCK_URL= '@Url.Action("ResetStuckSync")';

            var HIST_PREVIEW_URL = '@Url.Action("Preview", "HistoricalAttendanceSync")';
            var HIST_START_URL   = '@Url.Action("Start", "HistoricalAttendanceSync")';
            var HIST_STATUS_URL  = '@Url.Action("GetStatus", "HistoricalAttendanceSync")';
            var HIST_HISTORY_URL = '@Url.Action("History", "HistoricalAttendanceSync")';

            var COMBINED_LOG_URL = '@Url.Action("CombinedLog")';

            function fmtNum(n) { return (n === null || n === undefined) ? '0' : n.toLocaleString(); }

            function formatStatusDate(isoString) {
                if (!isoString) return "—";
                var dt = new Date(isoString);
                if (isNaN(dt.getTime())) return isoString;
                var pad = function (n) { return n < 10 ? "0" + n : "" + n; };
                var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                var hours = dt.getHours();
                var ampm = hours >= 12 ? "PM" : "AM";
                var h12 = hours % 12; if (h12 === 0) h12 = 12;
                return pad(dt.getDate()) + "-" + months[dt.getMonth()] + "-" + dt.getFullYear() + " " +
                    pad(h12) + ":" + pad(dt.getMinutes()) + ":" + pad(dt.getSeconds()) + " " + ampm;
            }

            function fmtElapsed(ms) {
                if (ms < 0) ms = 0;
                var totalSec = Math.floor(ms / 1000);
                var h = Math.floor(totalSec / 3600);
                var m = Math.floor((totalSec % 3600) / 60);
                var s = totalSec % 60;
                var pad = function (n) { return n < 10 ? "0" + n : "" + n; };
                return pad(h) + ":" + pad(m) + ":" + pad(s);
            }

            function showSuccessBanner(title) {
                $('#successBannerTitle').text(title || 'Attendance sync completed successfully!');
                $('#successBanner').slideDown(150);
            }

            // ==============================================================
            // SYNC NOW (Automatic) - drives BOTH the new top card AND the
            // legacy "Settings & Advanced Tools" status table, from the
            // SAME poll response, since both are on this one page at once.
            // Uses the exact same SyncNow/GetStatus/ResetStuckSync actions
            // as the original page - nothing about the sync itself changed.
            // ==============================================================
            var autoPollTimer = null;
            var autoElapsedTimer = null;
            var autoStartedAtMs = null;

            function setAutoBusy(isBusy) {
                if (isBusy) {
                    $('#autoSyncNowBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Syncing...');
                    $('#retryFailedBtn, #historicalSyncBtn').prop('disabled', true);
                    $('#autoSyncingLine').show();
                } else {
                    $('#autoSyncNowBtn').prop('disabled', false).html('<i class="bi bi-arrow-repeat"></i> Sync Now');
                    $('#retryFailedBtn, #historicalSyncBtn').prop('disabled', false);
                    $('#autoSyncingLine').hide();
                }
            }

            function stopAutoElapsedTimer() {
                if (autoElapsedTimer) { clearInterval(autoElapsedTimer); autoElapsedTimer = null; }
            }

            function startAutoElapsedTimer(startedAtIso) {
                stopAutoElapsedTimer();
                autoStartedAtMs = startedAtIso ? new Date(startedAtIso).getTime() : Date.now();
                $('#autoStartTime').text(formatStatusDate(startedAtIso));
                autoElapsedTimer = setInterval(function () {
                    $('#autoElapsedTime').text(fmtElapsed(Date.now() - autoStartedAtMs));
                }, 1000);
            }

            function renderAutoProgress(d) {
                $('#autoFetched').text(fmtNum(d.recordsRead));
                $('#autoImported').text(fmtNum(d.recordsImported));
                // "Processed" mirrors Imported - the eSSL sync engine does not
                // track a separate post-import "processed into Attendance"
                // counter distinct from Imported (see summary card note).
                $('#autoProcessed').text(fmtNum(d.recordsImported));
                $('#autoFailed').text(fmtNum(d.recordsFailed));
                // Unmapped has no LIVE counter on the engine's poll DTO
                // (only Fetched/Imported/Skipped/Failed) - shown as "—"
                // while running, filled in from the completion response.
                if (!d.isSyncRunning) { /* left as-is; set by caller */ } else {
                    $('#autoUnmapped').text('—');
                }

                if (d.canForceReset) { $('#autoResetStuckContainer').show(); } else { $('#autoResetStuckContainer').hide(); }
            }

            function applyAutoStatusToDom(d) {
                // legacy status table (Settings & Advanced Tools)
                var statusHtml;
                if (d.isSyncRunning) statusHtml = '<span class="label label-warning">Sync in progress...</span>';
                else if (d.lastSyncStatus === "Success") statusHtml = '<span class="label label-success">Last sync: Success</span>';
                else if (d.lastSyncStatus === "PartialFailure") statusHtml = '<span class="label label-warning">Last sync: Partial Failure</span>';
                else if (d.lastSyncStatus === "Failed") statusHtml = '<span class="label label-danger">Last sync: Failed</span>';
                else if (d.lastSyncStatus === "Cancelled") statusHtml = '<span class="label label-default">Last sync: Cancelled</span>';
                else statusHtml = '<span class="label label-default">Never synced</span>';

                $('#statSyncStatus').html(statusHtml);
                $('#statLastStarted').text(formatStatusDate(d.lastSyncStartedAt));
                $('#statLastCompleted').text(formatStatusDate(d.lastSyncCompletedAt));

                if (d.lastProcessedDeviceLogId) {
                    $('#statLastProcessed').text("DeviceLogId " + d.lastProcessedDeviceLogId + (d.lastProcessedLogDate ? (", " + formatStatusDate(d.lastProcessedLogDate)) : ""));
                } else {
                    $('#statLastProcessed').text("—");
                }

                if (d.lastError) { $('#statLastError').text(d.lastError); $('#statLastErrorRow').show(); }
                else { $('#statLastErrorRow').hide(); }

                // top-right service status badge
                $('#serviceLastSyncText').text(d.lastSyncCompletedAt ? formatStatusDate(d.lastSyncCompletedAt) : '—');
                if (d.isSyncRunning) {
                    $('#serviceStatusText').text('eSSL Sync Running Now');
                    $('#serviceStatusDot').css('background', '#f0ad4e');
                } else {
                    $('#serviceStatusText').text('eSSL Sync Service Running');
                    $('#serviceStatusDot').css('background', '#28a745');
                }
            }

            function stopAutoPoll() { if (autoPollTimer) { clearInterval(autoPollTimer); autoPollTimer = null; } }

            function pollAutoStatus(showCompletionAlert) {
                stopAutoPoll();
                autoPollTimer = setInterval(function () {
                    $.ajax({
                        url: AUTO_GET_STATUS_URL, type: 'GET',
                        success: function (resp) {
                            if (!resp || !resp.success || !resp.data) return;
                            var d = resp.data;
                            renderAutoProgress(d);

                            if (!d.isSyncRunning) {
                                stopAutoPoll();
                                stopAutoElapsedTimer();
                                setAutoBusy(false);
                                applyAutoStatusToDom(d);
                                $('#autoProgressBar').removeClass('progress-bar-striped progress-bar-animated').css('width', '100%');
                                $('#autoProgressPct').text('Idle');
                                $('#autoCurrentStepMini').text('Idle');

                                // Refresh the "Last Sync Summary (Auto)" card from this
                                // same completed-status payload (its Fetched/Imported/
                                // Failed/StartedAt/CompletedAt fields are exactly the
                                // just-finished run's final totals).
                                applyAutoSummaryFromStatus(d);

                                if (showCompletionAlert) {
                                    var swalType = d.lastSyncStatus === "Failed" ? "error" : d.lastSyncStatus === "PartialFailure" ? "warning" : "success";
                                    if (typeof swal === 'function') {
                                        swal({
                                            title: "Sync Complete",
                                            text: "Found " + (d.recordsRead || 0) + ", synced " + (d.recordsImported || 0) +
                                                ", skipped " + (d.recordsSkipped || 0) + ", failed " + (d.recordsFailed || 0) +
                                                (d.lastError ? (". " + d.lastError) : "."),
                                            type: swalType
                                        });
                                    }
                                    if (d.lastSyncStatus === 'Success' || d.lastSyncStatus === 'PartialFailure') {
                                        showSuccessBanner('Attendance sync completed successfully!');
                                    }
                                }
                                loadProcessingLog();
                            } else {
                                $('#autoProgressBar').addClass('progress-bar-striped progress-bar-animated').css('width', '100%');
                                $('#autoProgressPct').text('In Progress');
                                $('#autoCurrentStepMini').text('Fetching / processing attendance...');
                            }
                        }
                    });
                }, 2000);
            }

            function runAutoSync(payload, resultDataCallback) {
                setAutoBusy(true);
                renderAutoProgress({ recordsRead: 0, recordsImported: 0, recordsFailed: 0, isSyncRunning: true });
                $('#autoUnmapped').text('—');
                $('#autoProgressBar').addClass('progress-bar-striped progress-bar-animated').css('width', '100%');
                $('#autoProgressPct').text('In Progress');
                startAutoElapsedTimer(new Date().toISOString());

                $('#syncProgressBox').show(); // legacy container id kept for backward compatibility if referenced elsewhere

                $.ajax({
                    url: AUTO_SYNC_NOW_URL, type: 'POST', contentType: 'application/json', data: JSON.stringify(payload || {}),
                    success: function (resp) {
                        if (!resp.success) {
                            setAutoBusy(false);
                            stopAutoElapsedTimer();
                            if (typeof swal === 'function') swal("Sync Not Started", resp.message || "Unable to start sync.", "warning");
                            else alert(resp.message || "Unable to start sync.");
                            return;
                        }
                        if (resp.data && typeof resultDataCallback === 'function') resultDataCallback(resp.data);
                        pollAutoStatus(true);
                    },
                    error: function () {
                        setAutoBusy(false);
                        stopAutoElapsedTimer();
                        if (typeof swal === 'function') swal("Error", "Unable to reach the ERP API.", "error");
                        else alert("Unable to reach the ERP API.");
                    }
                });
            }

            $('#autoSyncNowBtn').on('click', function () {
                runAutoSync({}, function (result) {
                    // SyncNow's own result DOES carry unknownEmployeeCount for
                    // THIS run - surfaced here since the live poll DTO doesn't
                    // carry it (see renderAutoProgress's remarks).
                    if (result && typeof result.unknownEmployeeCount !== 'undefined') {
                        $('#autoUnmapped').text(fmtNum(result.unknownEmployeeCount));
                        $('#sumUnmapped').text(fmtNum(result.unknownEmployeeCount));
                    }
                });
            });

            $('#retryFailedBtn').on('click', function () {
                var from = $('#historyFromDate').val();
                var to = $('#historyToDate').val();
                if (!from || !to) {
                    var toDate = new Date(); var fromDate = new Date(); fromDate.setDate(fromDate.getDate() - 90);
                    to = toDate.toISOString().slice(0, 10); from = fromDate.toISOString().slice(0, 10);
                }
                runAutoSync({ FromDate: from, ToDate: to });
            });

            $('#historicalSyncBtn').on('click', function () {
                var from = $('#historyFromDate').val();
                var to = $('#historyToDate').val();
                if (!from || !to) {
                    if (typeof swal === 'function') swal("Missing Dates", "Please select both From Date and To Date.", "warning");
                    else alert("Please select both From Date and To Date.");
                    return;
                }
                runAutoSync({ FromDate: from, ToDate: to });
            });

            $('#autoResetStuckBtn').on('click', function () {
                var $btn = $(this).prop('disabled', true);
                $.ajax({
                    url: AUTO_RESET_STUCK_URL, type: 'POST',
                    success: function (resp) {
                        $btn.prop('disabled', false);
                        if (!resp || !resp.success) {
                            if (typeof swal === 'function') swal("Not Reset", (resp && resp.message) || "Unable to reset the stuck sync.", "warning");
                            return;
                        }
                        if (typeof swal === 'function') swal("Reset", resp.message || "The stuck sync has been reset.", "success");
                        stopAutoPoll(); stopAutoElapsedTimer();
                        $('#autoResetStuckContainer').hide();
                        setAutoBusy(false);
                        $.ajax({ url: AUTO_GET_STATUS_URL, type: 'GET', success: function (r) { if (r && r.success && r.data) applyAutoStatusToDom(r.data); } });
                    },
                    error: function () { $btn.prop('disabled', false); if (typeof swal === 'function') swal("Error", "Unable to reach the ERP API.", "error"); }
                });
            });

            // Resume on load if a sync is already running (any trigger point).
            var initialSyncRunning = @Json.Serialize(status.IsSyncRunning);
            if (initialSyncRunning) {
                setAutoBusy(true);
                startAutoElapsedTimer('@(status.LastSyncStartedAt?.ToString("o"))');
                renderAutoProgress({
                    recordsRead: @status.RecordsRead, recordsImported: @status.RecordsImported,
                    recordsFailed: @status.RecordsFailed, isSyncRunning: true,
                    canForceReset: @Json.Serialize(status.CanForceReset)
                });
                $('#autoProgressBar').addClass('progress-bar-striped progress-bar-animated').css('width', '100%');
                $('#autoProgressPct').text('In Progress');
                pollAutoStatus(false);
            }

            function applyAutoSummaryFromStatus(d) {
                $('#sumSyncTime').text(formatStatusDate(d.lastSyncStartedAt));
                $('#sumFetched').text(fmtNum(d.recordsRead));
                $('#sumImported').text(fmtNum(d.recordsImported));
                $('#sumProcessed').text(fmtNum(d.recordsImported));
                $('#sumFailed').text(fmtNum(d.recordsFailed));

                if (d.lastSyncStartedAt && d.lastSyncCompletedAt) {
                    var ms = new Date(d.lastSyncCompletedAt).getTime() - new Date(d.lastSyncStartedAt).getTime();
                    $('#sumDuration').text(fmtElapsed(ms));
                }

                var statusHtml = '<span class="text-muted">—</span>';
                if (d.lastSyncStatus === 'Success') statusHtml = '<span class="badge bg-success">Completed</span>';
                else if (d.lastSyncStatus === 'PartialFailure') statusHtml = '<span class="badge bg-warning text-dark">Partial</span>';
                else if (d.lastSyncStatus === 'Failed') statusHtml = '<span class="badge bg-danger">Failed</span>';
                $('#sumStatus').html(statusHtml);
            }

            // ==============================================================
            // HISTORICAL SYNC (Manual) - reuses the standalone Historical
            // Attendance Sync page's own Preview/Start/GetStatus/History
            // actions verbatim; only the ids/markup are new (card layout).
            // ==============================================================
            var histPollTimer = null;

            function histRequest() {
                return {
                    fromDate: $('#histFromDate').val(),
                    toDate: $('#histToDate').val(),
                    employeeId: $('#histEmployeeId').val() || null,
                    batchSize: 1000
                };
            }

            function histValidate(req) {
                if (!req.fromDate || !req.toDate) { alert('Please select both From Date and To Date.'); return false; }
                if (new Date(req.fromDate) > new Date(req.toDate)) { alert('From Date cannot be after To Date.'); return false; }
                return true;
            }

            function histExtractError(xhr) {
                try { var json = JSON.parse(xhr.responseText); return json.message || 'Request failed.'; } catch (e) { return 'Request failed.'; }
            }

            function histStatBox(label, value) {
                return '<div class="col-4 col-md-2 mb-2"><div style="font-weight:700;font-size:1.05rem;">' + fmtNum(value) +
                    '</div><div class="text-muted" style="font-size:10.5px;">' + label + '</div></div>';
            }

            $('#histPreviewBtn').on('click', function () {
                var req = histRequest();
                if (!histValidate(req)) return;
                var btn = $(this).prop('disabled', true);
                $.ajax({
                    url: HIST_PREVIEW_URL, type: 'POST', contentType: 'application/json', data: JSON.stringify(req),
                    success: function (resp) {
                        btn.prop('disabled', false);
                        if (!resp || !resp.success) { alert((resp && resp.message) || 'Preview failed.'); return; }
                        renderHistPreview(resp.data);
                        $('#histStartBtn').prop('disabled', resp.data.hasOverlappingActiveJob);
                    },
                    error: function (xhr) { btn.prop('disabled', false); alert(histExtractError(xhr)); }
                });
            });

            function renderHistPreview(d) {
                $('#histPreviewBox').show();
                var scopeCount = $('#histModeSafe').is(':checked') ? d.totalBiometricLogsInRange : d.unprocessedLogsInRange;
                var html = '';
                html += histStatBox('Total in Range', d.totalBiometricLogsInRange);
                html += histStatBox('Will Process', scopeCount);
                html += histStatBox('Already Linked', d.alreadyLinkedCount);
                html += histStatBox('Duplicates', d.flaggedDuplicateCount);
                html += histStatBox('Unmapped', d.unmappedEmployeeCodeCount);
                $('#histPreviewSummary').html(html);

                if (d.hasOverlappingActiveJob) {
                    $('#histPreviewWarning').text('A Historical Sync job is already Queued/Running for an overlapping range (Job Id: ' + d.overlappingJobId + '). Start is disabled until it finishes.').show();
                } else {
                    $('#histPreviewWarning').hide();
                }
            }

            $('#histStartBtn').on('click', function () {
                var req = histRequest();
                if (!histValidate(req)) return;
                if (!confirm('Start Historical Sync for ' + req.fromDate + ' to ' + req.toDate + '?')) return;

                var btn = $(this).prop('disabled', true);
                $.ajax({
                    url: HIST_START_URL, type: 'POST', contentType: 'application/json', data: JSON.stringify(req),
                    success: function (resp) {
                        if (!resp || !resp.success) { btn.prop('disabled', false); alert((resp && resp.message) || 'Could not start Historical Sync.'); return; }
                        var jobId = resp.data && resp.data.jobId;
                        if (jobId) { $('#histStatusBox').show(); startHistPolling(jobId); }
                    },
                    error: function (xhr) { btn.prop('disabled', false); alert(histExtractError(xhr)); }
                });
            });

            $('#histResetBtn').on('click', function () {
                $('#histFromDate, #histToDate').val('');
                $('#histEmployeeId').val('');
                $('#histModeUnprocessed').prop('checked', true);
                $('#histPreviewBox, #histStatusBox').hide();
                // Start no longer requires a Preview click first (see
                // histStartBtn's remarks above) - Reset just clears the
                // form back to a blank state, it should not leave Start
                // permanently disabled the way it used to.
                $('#histStartBtn').prop('disabled', false);
            });

            var histStartedAtMs = null;
            var histElapsedTimer = null;

            function startHistPolling(jobId) {
                if (histPollTimer) clearInterval(histPollTimer);
                histStartedAtMs = Date.now();
                if (histElapsedTimer) clearInterval(histElapsedTimer);
                histElapsedTimer = setInterval(function () { $('#histElapsedTime').text('Elapsed ' + fmtElapsed(Date.now() - histStartedAtMs)); }, 1000);
                histPollJobStatus(jobId);
                histPollTimer = setInterval(function () { histPollJobStatus(jobId); }, 3000);
            }

            function histPollJobStatus(jobId) {
                $.ajax({
                    url: HIST_STATUS_URL, type: 'GET', data: { jobId: jobId },
                    success: function (resp) {
                        if (!resp || !resp.success || !resp.data) return;
                        renderHistStatus(resp.data);
                        if (resp.data.status === 'Completed' || resp.data.status === 'Failed' || resp.data.status === 'PartiallyCompleted') {
                            if (histPollTimer) { clearInterval(histPollTimer); histPollTimer = null; }
                            if (histElapsedTimer) { clearInterval(histElapsedTimer); histElapsedTimer = null; }
                            $('#histStartBtn').prop('disabled', false);
                            refreshHistSummary(resp.data);
                            if (resp.data.status === 'Completed') {
                                showSuccessBanner('Historical attendance sync completed successfully!');
                            }
                            loadProcessingLog();
                        }
                    }
                });
            }

            function renderHistStatus(d) {
                var badgeClass = 'bg-secondary';
                if (d.status === 'Running' || d.status === 'Queued') badgeClass = 'bg-info text-dark';
                else if (d.status === 'Completed') badgeClass = 'bg-success';
                else if (d.status === 'PartiallyCompleted') badgeClass = 'bg-warning text-dark';
                else if (d.status === 'Failed') badgeClass = 'bg-danger';
                $('#histStatusBadge').attr('class', 'badge ' + badgeClass).text(d.status);

                var pct = 0;
                if (d.totalRecords > 0) pct = Math.min(100, Math.round(((d.processedCount + d.failedCount + d.unmappedCount + d.duplicateCount) / d.totalRecords) * 100));
                else if (d.status === 'Completed') pct = 100;
                $('#histProgressBar').css('width', pct + '%');

                if (d.errorSummary) { $('#histStatusError').text(d.errorSummary).show(); } else { $('#histStatusError').hide(); }
            }

            function refreshHistSummary(d) {
                $('#hSumRange').text(formatDateOnly(d.fromDate) + ' to ' + formatDateOnly(d.toDate));
                $('#hSumTotal').text(fmtNum(d.totalRecords));
                $('#hSumProcessed').text(fmtNum(d.processedCount));
                $('#hSumLogsInserted').text(fmtNum(d.attendanceLogsCreated));
                $('#hSumAttCreated').text(fmtNum(d.attendancesCreated));
                $('#hSumAttUpdated').text(fmtNum(d.attendancesUpdated));
                $('#hSumUnmapped').text(fmtNum(d.unmappedCount));
                $('#hSumFailed').text(fmtNum(d.failedCount));
                $('#hSumDuration').text(d.durationSeconds != null ? fmtElapsed(d.durationSeconds * 1000) : '—');

                var statusBadge = '<span class="text-muted">—</span>';
                if (d.status === 'Completed') statusBadge = '<span class="badge bg-success">Completed</span>';
                else if (d.status === 'PartiallyCompleted') statusBadge = '<span class="badge bg-warning text-dark">Partial</span>';
                else if (d.status === 'Failed') statusBadge = '<span class="badge bg-danger">Failed</span>';
                else statusBadge = '<span class="badge bg-info text-dark">' + d.status + '</span>';
                $('#hSumStatus').html(statusBadge);
            }

            function formatDateOnly(s) { var d = new Date(s); if (isNaN(d.getTime())) return s; return d.toLocaleDateString(); }

            $('#historyModal').on('show.bs.modal shown.bs.tab', function () {
                $('#historyModalBody').load(HIST_HISTORY_URL);
            });
            // Bootstrap 3-style data-toggle also used elsewhere in this app -
            // handle both trigger conventions for the modal.
            $('#histViewDetailsLink').on('click', function (e) {
                e.preventDefault();
                $('#historyModalBody').load(HIST_HISTORY_URL);
                if ($.fn.modal) { $('#historyModal').modal('show'); }
            });

            // ==============================================================
            // PROCESSING LOG (combined, additive - see CombinedLog() action)
            // ==============================================================
            function loadProcessingLog() {
                $.ajax({
                    url: COMBINED_LOG_URL, type: 'GET',
                    success: function (resp) {
                        if (!resp || !resp.success) { return; }
                        var rows = resp.data || [];
                        if (rows.length === 0) {
                            $('#processingLogBody').html('<tr><td colspan="3" class="text-center text-muted">No activity yet.</td></tr>');
                            return;
                        }
                        var html = '';
                        rows.forEach(function (r) {
                            html += '<tr><td>' + r.line + '</td><td>' + r.time + '</td><td>' + $('<div>').text(r.message).html() + '</td></tr>';
                        });
                        $('#processingLogBody').html(html);
                    },
                    error: function () {
                        $('#processingLogBody').html('<tr><td colspan="3" class="text-center text-danger">Unable to load the processing log.</td></tr>');
                    }
                });
            }

            $('#refreshLogBtn').on('click', loadProcessingLog);
            loadProcessingLog();

            // ==============================================================
            // LEGACY TABS + CONFIG FORM (unchanged behavior, moved under the
            // collapsible "Settings & Advanced Tools" panel)
            // ==============================================================
            var originalValues = captureFormValues();

            function captureFormValues() {
                return {
                    IntegrationEnabled: $("#IntegrationEnabled").is(":checked"),
                    DatabaseServer: $("#DatabaseServer").val(),
                    DatabaseName: $("#DatabaseName").val(),
                    AuthenticationType: $("#AuthenticationType").val(),
                    Username: $("#Username").val(),
                    ConnectionTimeout: $("#ConnectionTimeout").val(),
                    SyncIntervalMinutes: $("#SyncIntervalMinutes").val(),
                    BatchSize: $("#BatchSize").val()
                };
            }

            function applyFormValues(v) {
                $("#IntegrationEnabled").prop("checked", !!v.IntegrationEnabled);
                $("#DatabaseServer").val(v.DatabaseServer || "");
                $("#DatabaseName").val(v.DatabaseName || "");
                $("#AuthenticationType").val(v.AuthenticationType || "Sql");
                $("#Username").val(v.Username || "");
                $("#Password").val("");
                $("#ConnectionTimeout").val(v.ConnectionTimeout || 15);
                $("#SyncIntervalMinutes").val(v.SyncIntervalMinutes || 5);
                $("#BatchSize").val(v.BatchSize || 500);
                toggleAuthFields();
                clearValidation();
            }

            function toggleAuthFields() {
                var isSql = $("#AuthenticationType").val() === "Sql";
                $("#credentialsRow").toggle(isSql);
                $("#Username").prop("disabled", !isSql);
                $("#Password").prop("disabled", !isSql);
            }
            $("#AuthenticationType").on("change", toggleAuthFields);
            toggleAuthFields();

            $("#togglePasswordBtn").on("click", function () {
                var input = $("#Password");
                var showing = input.attr("type") === "text";
                input.attr("type", showing ? "password" : "text");
                $(this).attr("aria-pressed", (!showing).toString());
                $(this).attr("aria-label", showing ? "Show password" : "Hide password");
                $("#togglePasswordIcon").attr("class", showing ? "icon-eye8" : "icon-eye-blocked2");
            });

            function clearValidation() {
                $("#configValidationSummary").hide();
                $(".field-error").text("");
                $(".form-group").removeClass("has-error");
            }

            function showFieldError(field, message) {
                $(".field-error[data-field='" + field + "']").text(message);
                $("#" + field).closest(".form-group").addClass("has-error");
            }

            function validateForm() {
                clearValidation();
                var valid = true;
                if (!$("#DatabaseServer").val().trim()) { showFieldError("DatabaseServer", "Database server is required."); valid = false; }
                if (!$("#DatabaseName").val().trim()) { showFieldError("DatabaseName", "Database name is required."); valid = false; }
                if ($("#AuthenticationType").val() === "Sql" && !$("#Username").val().trim()) { showFieldError("Username", "Username is required for SQL Server Authentication."); valid = false; }
                var timeout = parseInt($("#ConnectionTimeout").val(), 10);
                if (!timeout || timeout < 1 || timeout > 300) { showFieldError("ConnectionTimeout", "Connection timeout must be between 1 and 300 seconds."); valid = false; }
                var interval = parseInt($("#SyncIntervalMinutes").val(), 10);
                if (!interval || interval < 1 || interval > 1440) { showFieldError("SyncIntervalMinutes", "Sync interval must be greater than zero."); valid = false; }
                var batch = parseInt($("#BatchSize").val(), 10);
                if (!batch || batch < 1 || batch > 5000) { showFieldError("BatchSize", "Batch size must be greater than zero."); valid = false; }
                if (!valid) { $("#configValidationMessage").text("Please correct the highlighted fields."); $("#configValidationSummary").show(); }
                return valid;
            }

            function buildConfigPayload() {
                return {
                    IntegrationEnabled: $("#IntegrationEnabled").is(":checked"),
                    DatabaseServer: $("#DatabaseServer").val().trim(),
                    DatabaseName: $("#DatabaseName").val().trim(),
                    AuthenticationType: $("#AuthenticationType").val(),
                    Username: $("#AuthenticationType").val() === "Sql" ? $("#Username").val().trim() : null,
                    Password: $("#AuthenticationType").val() === "Sql" ? ($("#Password").val() || null) : null,
                    ConnectionTimeout: parseInt($("#ConnectionTimeout").val(), 10) || 15,
                    SyncIntervalMinutes: parseInt($("#SyncIntervalMinutes").val(), 10) || 5,
                    BatchSize: parseInt($("#BatchSize").val(), 10) || 500
                };
            }

            $("#testConnectionBtn").on("click", function () {
                if (!validateForm()) return;
                var btn = $(this); var original = btn.html();
                btn.prop("disabled", true).html('<i class="icon-spinner2 spinner position-left"></i> Testing...');
                $.ajax({
                    url: "@Url.Action("TestConnection")", type: "POST", contentType: "application/json", data: JSON.stringify(buildConfigPayload()),
                    success: function (resp) {
                        btn.prop("disabled", false).html(original);
                        if (resp.success) swal("Connection Successful", resp.message, "success");
                        else swal("Connection Failed", resp.message, "error");
                    },
                    error: function () { btn.prop("disabled", false).html(original); swal("Error", "Unable to reach the ERP API.", "error"); }
                });
            });

            $("#saveConfigBtn").on("click", function () {
                if (!validateForm()) return;
                var btn = $(this); var original = btn.html();
                btn.prop("disabled", true).html('<i class="icon-spinner2 spinner position-left"></i> Saving...');
                $.ajax({
                    url: "@Url.Action("SaveConfiguration")", type: "POST", contentType: "application/json", data: JSON.stringify(buildConfigPayload()),
                    success: function (resp) {
                        btn.prop("disabled", false).html(original);
                        if (resp.success) {
                            swal({ title: "Success", text: resp.message || "Settings saved successfully.", type: "success" }, function () { location.reload(); });
                        } else {
                            $("#configValidationMessage").text(resp.message || "Unable to save settings.");
                            $("#configValidationSummary").show();
                        }
                    },
                    error: function () { btn.prop("disabled", false).html(original); swal("Error", "Unable to reach the ERP API.", "error"); }
                });
            });

            $("#cancelConfigBtn").on("click", function () { applyFormValues(originalValues); });

            var syncLogsLoaded = false;
            $("#tab-synclogs-link").on("shown.bs.tab", function () {
                if (syncLogsLoaded) return; syncLogsLoaded = true;
                $("#syncLogsContainer").load("@Url.Action("SyncLogs")");
            });

            var unmappedLoaded = false;
            $("#tab-unmapped-link").on("shown.bs.tab", function () {
                if (unmappedLoaded) return; unmappedLoaded = true;
                $("#unmappedContainer").load("@Url.Action("UnmappedEmployees")");
            });

            // Default Historical Sync (Manual) card's dates to the current month.
            (function initDefaults() {
                var today = new Date();
                var first = new Date(today.getFullYear(), today.getMonth(), 1);
                $('#histFromDate').val(first.toISOString().slice(0, 10));
                $('#histToDate').val(today.toISOString().slice(0, 10));
            })();
        });
    </script>
}
