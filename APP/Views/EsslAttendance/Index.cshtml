@model EsslSettingsPageViewModel
@{
    ViewData["Title"] = "Attendance Synchronization";
    var status = Model.Status;
    var config = Model.Config;
    var lastSync = Model.LastSyncHistory;
    var lastJob = Model.LastHistoricalJob;
}

@*
    ==========================================================================
    ATTENDANCE SYNCHRONIZATION - combined redesign of the eSSL Sync page.
    ==========================================================================
    This is a RESTYLE/RECOMPOSITION of this same Views/EsslAttendance/Index.cshtml
    page only - the eSSL sync engine (Application/Services/Attendances/
    EsslAttendanceSyncService.cs), its job queue and its background service are
    UNCHANGED, and so is the standalone Historical Attendance Sync engine/SP.
    This page simply presents both existing features - and everything the old
    page already did - in one enterprise dashboard layout, wired to the SAME
    API actions/DTOs both features already had:

      - "Sync Now (Automatic)" card  -> EsslAttendanceController's existing
        SyncNow / GetStatus / ResetStuckSync actions (unchanged).
      - "Historical Sync (Manual)" card -> HistoricalAttendanceSyncController's
        existing Preview / Start / GetStatus / History actions (unchanged).
      - "Processing Log" -> new CombinedLog() action on THIS (APP) controller
        only, which merely reads the two features' existing history/job
        endpoints and merges them into readable lines - no new persistence,
        no engine change (see EsslAttendanceController.cs's remarks).

    LEGACY FUNCTIONALITY (nothing was deleted): the previous page's Database
    Configuration form (Test Connection / Save / Cancel), Integration Status
    table, Reset Stuck Sync, Sync Logs tab, Unmapped Employees tab, and the
    OLD "Historical Import" panel (which re-fetches from the eSSL device for
    a date range - a DIFFERENT, older feature than the new "Historical Sync"
    card, which only re-processes rows already imported) all still exist,
    unchanged in behavior, inside the collapsible "Settings & Advanced Tools"
    section at the bottom of this page. Only the page's OWN duplicate
    "Sync Now" trigger button was removed from that legacy panel, because the
    new top card's "Sync Now" button now drives the exact same SyncNow
    action/lock - keeping two separate "Sync Now" buttons on one page would
    just be a confusing duplicate control, not a feature.
*@

<div class="ent-page">

    <!-- ================= HEADER ================= -->
    <div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
        <div>
            <h3 class="mb-0" style="font-weight:700;color:#1b2a4a;">Attendance Synchronization</h3>
            <p class="text-muted mb-0">Sync eSSL biometric data with HRMS ERP</p>
        </div>
        <div id="serviceStatusBadge" class="d-flex align-items-center gap-2 px-3 py-2" style="background:#eaf7ef;border:1px solid #bfe6cc;border-radius:8px;">
            <span id="serviceStatusDot" style="width:9px;height:9px;border-radius:50%;background:#28a745;display:inline-block;"></span>
            <div style="line-height:1.25;">
                <div style="font-weight:600;font-size:13px;color:#1c6b34;" id="serviceStatusText">eSSL Sync Service Running</div>
                <div style="font-size:11.5px;color:#5c8a6c;">Last Sync: <span id="serviceLastSyncText">@(status.LastSyncCompletedAt?.ToString("dd-MM-yyyy HH:mm") ?? "—")</span></div>
            </div>
        </div>
    </div>

    <!-- ================= FLOW DIAGRAM ================= -->
    <div class="ent-panel mb-3" style="overflow-x:auto;">
        <div style="display:flex;align-items:stretch;flex-wrap:nowrap;gap:6px;min-width:900px;">

            <div class="flow-box" style="border-top:4px solid #6c757d;">
                <div class="flow-icon" style="color:#6c757d;"><i class="bi bi-fingerprint"></i></div>
                <div class="flow-title">eSSL Device</div>
                <ul class="flow-list">
                    <li>Capture IN/OUT</li>
                    <li>Store in Device</li>
                </ul>
            </div>
            <div class="flow-arrow"><i class="bi bi-arrow-right-circle-fill"></i></div>

            <div class="flow-box" style="border-top:4px solid #2b6fd9;">
                <div class="flow-icon" style="color:#2b6fd9;"><i class="bi bi-server"></i></div>
                <div class="flow-title">eTimeTrackLite DB</div>
                <ul class="flow-list">
                    <li>DeviceLogs_*_2026</li>
                    <li>Multiple Device Logs</li>
                    <li>Raw Punch Data</li>
                </ul>
            </div>
            <div class="flow-arrow"><i class="bi bi-arrow-right-circle-fill"></i></div>

            <div class="flow-box" style="border-top:4px solid #28a745;">
                <div class="flow-icon" style="color:#28a745;"><i class="bi bi-gear-fill"></i></div>
                <div class="flow-title">Sync Now (Automatic)</div>
                <ul class="flow-list">
                    <li>Fetch new records</li>
                    <li>Insert to BiometricAttendanceLogs</li>
                    <li>Process to AttendanceLogs</li>
                    <li>Update Attendances</li>
                </ul>
            </div>
            <div class="flow-arrow"><i class="bi bi-arrow-right-circle-fill"></i></div>

            <div class="flow-box" style="border-top:4px solid #d9534f;">
                <div class="flow-icon" style="color:#d9534f;"><i class="bi bi-calendar-range-fill"></i></div>
                <div class="flow-title">Historical Sync (Manual from UI)</div>
                <ul class="flow-list">
                    <li>Select date range</li>
                    <li>Process existing records</li>
                    <li>Use same business rules</li>
                    <li>No impact on current sync</li>
                </ul>
            </div>
            <div class="flow-arrow"><i class="bi bi-arrow-right-circle-fill"></i></div>

            <div class="flow-box" style="border-top:4px solid #6f42c1;">
                <div class="flow-icon" style="color:#6f42c1;"><i class="bi bi-building-fill-gear"></i></div>
                <div class="flow-title">HRMS ERP</div>
                <ul class="flow-list">
                    <li>BiometricAttendanceLogs</li>
                    <li>AttendanceLogs</li>
                    <li>Attendances</li>
                    <li>Employee, Shift, Leave etc.</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- ================= SYNC NOW + HISTORICAL SYNC CARDS ================= -->
    <div class="row">
        <!-- ---- Sync Now (Automatic) ---- -->
        <div class="col-lg-6 mb-3">
            <div class="ent-panel h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="ent-icon-badge" style="background:#eaf7ef;color:#28a745;"><i class="bi bi-arrow-repeat"></i></span>
                        <div>
                            <div style="font-weight:700;">Sync Now (Automatic)</div>
                            <div class="text-muted" style="font-size:12.5px;">Fetch new eSSL device logs and sync to HRMS ERP</div>
                        </div>
                    </div>
                    <span class="badge" id="autoRunModeBadge" style="background:#eaf7ef;color:#1c6b34;font-weight:600;">
                        <i class="bi bi-check-circle-fill"></i> Running as Scheduled
                    </span>
                </div>

                <div id="autoSyncingLine" class="mb-2" style="display:none;">
                    <span class="text-primary" style="font-weight:600;">Syncing...</span>
                    <span class="text-muted" id="autoCurrentStep">Fetching device logs and processing attendance...</span>
                </div>

                <div class="progress mb-2" style="height:8px;">
                    <div id="autoProgressBar" class="progress-bar bg-success" role="progressbar" style="width:0%;"></div>
                </div>
                <div class="text-end text-muted mb-3" style="font-size:11.5px;" id="autoProgressPct">Idle</div>

                <div class="row text-center g-2 mb-3">
                    <div class="col">
                        <div class="ent-counter"><i class="bi bi-download text-primary"></i><div class="ent-counter-val" id="autoFetched">0</div><div class="ent-counter-lbl">Fetched</div></div>
                    </div>
                    <div class="col">
                        <div class="ent-counter"><i class="bi bi-database-check text-info"></i><div class="ent-counter-val" id="autoImported">0</div><div class="ent-counter-lbl">Imported</div></div>
                    </div>
                    <div class="col">
                        <div class="ent-counter"><i class="bi bi-check-circle text-success"></i><div class="ent-counter-val" id="autoProcessed">0</div><div class="ent-counter-lbl">Processed</div></div>
                    </div>
                    <div class="col">
                        <div class="ent-counter"><i class="bi bi-exclamation-triangle text-warning"></i><div class="ent-counter-val" id="autoUnmapped">0</div><div class="ent-counter-lbl">Unmapped</div></div>
                    </div>
                    <div class="col">
                        <div class="ent-counter"><i class="bi bi-x-circle text-danger"></i><div class="ent-counter-val" id="autoFailed">0</div><div class="ent-counter-lbl">Failed</div></div>
                    </div>
                </div>

                <div class="row small text-muted mb-3">
                    <div class="col-4"><strong>Start Time</strong><div id="autoStartTime">—</div></div>
                    <div class="col-4"><strong>Elapsed Time</strong><div id="autoElapsedTime">—</div></div>
                    <div class="col-4"><strong>Current Step</strong><div id="autoCurrentStepMini">Idle</div></div>
                </div>

                <div id="autoResetStuckContainer" style="display:none;" class="mb-2">
                    <p class="text-warning small mb-1"><i class="bi bi-exclamation-triangle-fill"></i> This sync has been running unusually long and may be stuck.</p>
                    <button type="button" class="btn btn-sm btn-outline-danger" id="autoResetStuckBtn"><i class="bi bi-x-circle"></i> Force Reset Stuck Sync</button>
                </div>

                <button type="button" class="btn btn-success" id="autoSyncNowBtn" style="min-width:140px;">
                    <i class="bi bi-arrow-repeat"></i> Sync Now
                </button>
            </div>
        </div>

        <!-- ---- Historical Sync (Manual) ---- -->
        <div class="col-lg-6 mb-3">
            <div class="ent-panel h-100">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="ent-icon-badge" style="background:#eaf2fd;color:#2b6fd9;"><i class="bi bi-calendar3"></i></span>
                    <div>
                        <div style="font-weight:700;">Historical Sync (Manual)</div>
                        <div class="text-muted" style="font-size:12.5px;">Process existing biometric records from selected date range</div>
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-md-4">
                        <label class="form-label small mb-1">From Date <span class="text-danger">*</span></label>
                        <input type="date" id="histFromDate" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small mb-1">To Date <span class="text-danger">*</span></label>
                        <input type="date" id="histToDate" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small mb-1">Employee (Optional)</label>
                        <select id="histEmployeeId" class="form-control form-control-sm" asp-items="ViewBag.EmployeeList">
                            <option value="">All Employees</option>
                        </select>
                    </div>
                </div>

                <div class="mb-2">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="histMode" id="histModeUnprocessed" value="unprocessed" checked>
                        <label class="form-check-label small" for="histModeUnprocessed">
                            Reprocess Unprocessed Only
                            <i class="bi bi-question-circle text-muted" title="Only biometric logs in range that have not yet produced an AttendanceLog are processed."></i>
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="histMode" id="histModeSafe" value="safe">
                        <label class="form-check-label small" for="histModeSafe">
                            Include Already Processed (Safe Mode)
                            <i class="bi bi-question-circle text-muted" title="Re-scans already-processed logs too. Existing links are never duplicated - safe to re-run."></i>
                        </label>
                    </div>
                    <div class="text-muted" style="font-size:10.5px;">
                        Note: the Historical Sync engine (unchanged) always skips already-linked/duplicate records on every run regardless of
                        this choice - both options are therefore equally safe to re-run; this selector only changes which counts the Preview
                        highlights above ("Will Process"). A distinct server-side "safe mode" would require changing the Historical Sync
                        engine itself, which is out of scope for this UI-only change.
                    </div>
                </div>

                <div id="histPreviewBox" class="mb-2" style="display:none;background:#f7f9fc;border-radius:6px;padding:10px;">
                    <div class="row text-center g-2" id="histPreviewSummary"></div>
                    <div id="histPreviewWarning" class="alert alert-warning py-1 px-2 mt-2 mb-0 small" style="display:none;"></div>
                </div>

                <div id="histStatusBox" class="mb-2" style="display:none;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="badge" id="histStatusBadge">Queued</span>
                        <span class="small text-muted" id="histElapsedTime"></span>
                    </div>
                    <div class="progress mb-2" style="height:8px;">
                        <div id="histProgressBar" class="progress-bar bg-primary" role="progressbar" style="width:0%;"></div>
                    </div>
                    <div id="histStatusError" class="alert alert-danger py-1 px-2 small" style="display:none;white-space:pre-wrap;"></div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-2">
                    <button type="button" class="btn btn-success" id="histStartBtn"><i class="bi bi-play-fill"></i> Start Historical Sync</button>
                    <button type="button" class="btn btn-outline-secondary" id="histPreviewBtn"><i class="bi bi-search"></i> Preview Records</button>
                    <button type="button" class="btn btn-outline-secondary" id="histResetBtn"><i class="bi bi-arrow-counterclockwise"></i> Reset</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= SUMMARY + LOG ROW ================= -->
    <div class="row">
        <div class="col-lg-4 mb-3">
            <div class="ent-panel h-100">
                <div style="font-weight:700;" class="mb-2">Last Sync Summary (Auto)</div>
                <table class="table table-sm mb-0" id="autoSummaryTable">
                    <tbody>
                        <tr><th class="text-muted" style="font-weight:500;">Sync Time</th><td class="text-end" id="sumSyncTime">@(lastSync?.StartTime.ToString("dd-MM-yyyy HH:mm") ?? "—")</td></tr>
                        <tr><th class="text-muted" style="font-weight:500;">Fetched</th><td class="text-end" id="sumFetched">@(lastSync?.RecordsFetched.ToString() ?? "—")</td></tr>
                        <tr><th class="text-muted" style="font-weight:500;">Imported</th><td class="text-end" id="sumImported">@(lastSync?.RecordsInserted.ToString() ?? "—")</td></tr>
                        <tr><th class="text-muted" style="font-weight:500;">Processed</th><td class="text-end" id="sumProcessed">@(lastSync?.RecordsInserted.ToString() ?? "—")</td></tr>
                        <tr><th class="text-muted" style="font-weight:500;">Unmapped</th><td class="text-end" id="sumUnmapped">—</td></tr>
                        <tr><th class="text-muted" style="font-weight:500;">Failed</th><td class="text-end" id="sumFailed">@(lastSync?.RecordsFailed.ToString() ?? "—")</td></tr>
                        <tr><th class="text-muted" style="font-weight:500;">Duration</th><td class="text-end" id="sumDuration">@(lastSync != null && lastSync.EndTime.HasValue ? (lastSync.EndTime.Value - lastSync.StartTime).ToString(@"hh\:mm\:ss") : "—")</td></tr>
                        <tr>
                            <th class="text-muted" style="font-weight:500;">Status</th>
                            <td class="text-end" id="sumStatus">
                                @if (lastSync == null)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else if (lastSync.Status == "Success")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (lastSync.Status == "PartialFailure")
                                {
                                    <span class="badge bg-warning text-dark">Partial</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Failed</span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="text-muted small mt-2" style="font-size:10.5px;">
                    "Unmapped" reflects the most recent Sync Now run triggered from this page (the eSSL sync engine tracks Fetched/Imported/Skipped/Failed per run; Unmapped is only reported transiently in that run's own result).
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-3">
            <div class="ent-panel h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div style="font-weight:700;">Historical Sync Summary (Manual)</div>
                    <a href="#" id="histViewDetailsLink" data-toggle="modal" data-target="#historyModal" data-bs-toggle="modal" data-bs-target="#historyModal" class="small">View Details</a>
                </div>
                <table class="table table-sm mb-0" id="histSummaryTable">
                    <tbody>
                        <tr><th class="text-muted" style="font-weight:500;">Date Range</th><td class="text-end" id="hSumRange">@(lastJob != null ? $"{lastJob.FromDate:dd-MM-yyyy} to {lastJob.ToDate:dd-MM-yyyy}" : "—")</td></tr>
                        <tr><th class="text-muted" style="font-weight:500;">Total Records Found</th><td class="text-end" id="hSumTotal">@(lastJob?.TotalRecords.ToString() ?? "—")</td></tr>
                        <tr><th class="text-muted" style="font-weight:500;">Processed</th><td class="text-end" id="hSumProcessed">@(lastJob?.ProcessedCount.ToString() ?? "—")</td></tr>
                        <tr><th class="text-muted" style="font-weight:500;">AttendanceLogs Inserted</th><td class="text-end" id="hSumLogsInserted">@(lastJob?.AttendanceLogsCreated.ToString() ?? "—")</td></tr>
                        <tr><th class="text-muted" style="font-weight:500;">Attendances Created</th><td class="text-end" id="hSumAttCreated">@(lastJob?.AttendancesCreated.ToString() ?? "—")</td></tr>
                        <tr><th class="text-muted" style="font-weight:500;">Attendances Updated</th><td class="text-end" id="hSumAttUpdated">@(lastJob?.AttendancesUpdated.ToString() ?? "—")</td></tr>
                        <tr><th class="text-muted" style="font-weight:500;">Unmapped</th><td class="text-end" id="hSumUnmapped">@(lastJob?.UnmappedCount.ToString() ?? "—")</td></tr>
                        <tr><th class="text-muted" style="font-weight:500;">Failed</th><td class="text-end" id="hSumFailed">@(lastJob?.FailedCount.ToString() ?? "—")</td></tr>
                        <tr><th class="text-muted" style="font-weight:500;">Duration</th><td class="text-end" id="hSumDuration">@(lastJob?.DurationSeconds != null ? TimeSpan.FromSeconds(lastJob.DurationSeconds.Value).ToString(@"hh\:mm\:ss") : "—")</td></tr>
                        <tr>
                            <th class="text-muted" style="font-weight:500;">Status</th>
                            <td class="text-end" id="hSumStatus">
                                @if (lastJob == null)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else if (lastJob.Status == "Completed")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (lastJob.Status == "PartiallyCompleted")
                                {
                                    <span class="badge bg-warning text-dark">Partial</span>
                                }
                                else if (lastJob.Status == "Failed")
                                {
                                    <span class="badge bg-danger">Failed</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark">@lastJob.Status</span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-lg-4 mb-3">
            <div class="ent-panel h-100 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div style="font-weight:700;">Processing Log (Last 50 Lines)</div>
                    <button type="button" class="btn btn-light btn-sm" id="refreshLogBtn"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
                </div>
                <div style="max-height:340px;overflow-y:auto;flex:1;">
                    <table class="table table-sm table-striped mb-0" style="font-size:11.5px;">
                        <thead style="position:sticky;top:0;background:#fff;">
                            <tr><th style="width:24px;">#</th><th style="width:70px;">Time</th><th>Message</th></tr>
                        </thead>
                        <tbody id="processingLogBody">
                            <tr><td colspan="3" class="text-center text-muted">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= SUCCESS BANNER ================= -->
    <div id="successBanner" class="ent-panel d-flex flex-wrap justify-content-between align-items-center mb-3" style="background:#eaf7ef;border:1px solid #bfe6cc;display:none;">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill text-success" style="font-size:20px;"></i>
            <div>
                <div style="font-weight:700;color:#1c6b34;" id="successBannerTitle">Attendance sync completed successfully!</div>
                <div class="text-muted small">eSSL biometric data is now available in HRMS ERP.</div>
            </div>
        </div>
        <a asp-controller="Attendance" asp-action="Index" class="btn btn-success">View Attendance <i class="bi bi-chevron-right"></i></a>
    </div>

    <!-- ================= SETTINGS & ADVANCED / LEGACY TOOLS ================= -->
    @*
        Everything the previous eSSL Sync page could do and is NOT shown above
        (Database Configuration edit form, Integration Status detail table,
        Test Connection, Save Settings, the OLD date-range "Historical Import"
        that re-fetches from the eSSL device itself, Retry Failed Sync, Reset
        Stuck Sync, Sync Logs, Unmapped Employees) lives here, collapsed by
        default so the new dashboard above stays the primary view - nothing
        was removed, only relocated and re-labelled to avoid confusion with
        the new "Historical Sync (Manual)" card above (which reprocesses
        records already imported, and never talks to the eSSL device).
    *@
    <div class="ent-panel mb-3">
        <a href="#legacyToolsBody" data-toggle="collapse" data-bs-toggle="collapse" class="d-flex justify-content-between align-items-center text-decoration-none" style="color:#1b2a4a;">
            <span style="font-weight:700;"><i class="bi bi-tools"></i> Settings &amp; Advanced Tools</span>
            <span class="text-muted small">Database configuration, legacy device re-fetch, sync logs, unmapped employees <i class="bi bi-chevron-down"></i></span>
        </a>

        <div class="collapse" id="legacyToolsBody">
            <hr />

            <ul class="nav nav-tabs" style="margin-top:6px;">
                <li class="active"><a href="#tab-settings" data-toggle="tab">Settings</a></li>
                <li><a href="#tab-synclogs" data-toggle="tab" id="tab-synclogs-link">Sync Logs</a></li>
                <li><a href="#tab-unmapped" data-toggle="tab" id="tab-unmapped-link">Unmapped Employees</a></li>
            </ul>

            <div class="tab-content">

                <!-- SETTINGS TAB -->
                <div class="tab-pane active" id="tab-settings">

                    <!-- CARD 1: INTEGRATION STATUS (read-only) -->
                    <div class="panel panel-bordered" style="margin-top:15px;">
                        <div class="panel-heading">
                            <h6 class="panel-title"><i class="icon-pulse position-left"></i> Integration Status</h6>
                        </div>
                        <div class="panel-body">
                            <div class="table-responsive">
                                <table class="table table-bordered" id="statusTable">
                                    <tbody>
                                        <tr>
                                            <th width="220">Integration Enabled</th>
                                            <td id="statIntegrationEnabled">
                                                @if (status.Enabled)
                                                {
                                                    <span class="label label-success">Enabled</span>
                                                }
                                                else
                                                {
                                                    <span class="label label-default">Disabled</span>
                                                }
                                            </td>
                                            <th width="220">Sync Status</th>
                                            <td id="statSyncStatus">
                                                @if (status.IsSyncRunning)
                                                {
                                                    <span class="label label-warning">Sync in progress...</span>
                                                }
                                                else if (status.LastSyncStatus == "Success")
                                                {
                                                    <span class="label label-success">Last sync: Success</span>
                                                }
                                                else if (status.LastSyncStatus == "PartialFailure")
                                                {
                                                    <span class="label label-warning">Last sync: Partial Failure</span>
                                                }
                                                else if (status.LastSyncStatus == "Failed")
                                                {
                                                    <span class="label label-danger">Last sync: Failed</span>
                                                }
                                                else
                                                {
                                                    <span class="label label-default">Never synced</span>
                                                }
                                            </td>
                                        </tr>
                                        <tr>
                                            <th>Last Sync Started</th>
                                            <td id="statLastStarted">@(status.LastSyncStartedAt?.ToString("dd-MMM-yyyy hh:mm:ss tt") ?? "—")</td>
                                            <th>Last Sync Completed</th>
                                            <td id="statLastCompleted">@(status.LastSyncCompletedAt?.ToString("dd-MMM-yyyy hh:mm:ss tt") ?? "—")</td>
                                        </tr>
                                        <tr>
                                            <th>Last Processed Punch</th>
                                            <td colspan="3" id="statLastProcessed">
                                                @if (status.LastProcessedDeviceLogId.HasValue)
                                                {
                                                    @:DeviceLogId @status.LastProcessedDeviceLogId, @status.LastProcessedLogDate?.ToString("dd-MMM-yyyy hh:mm:ss tt")
                                                }
                                                else
                                                {
                                                    @:—
                                                }
                                            </td>
                                        </tr>
                                        <tr id="statLastErrorRow" style="@(string.IsNullOrEmpty(status.LastError) ? "display:none;" : "")">
                                            <th>Last Error</th>
                                            <td colspan="3" class="text-danger" id="statLastError">@status.LastError</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- CARD 2: DATABASE CONFIGURATION (editable) -->
                    <div class="panel panel-bordered">
                        <div class="panel-heading">
                            <h6 class="panel-title"><i class="icon-database position-left"></i> Database Configuration</h6>
                        </div>
                        <div class="panel-body">

                            <div id="configValidationSummary" class="alert alert-danger alert-dismissible" style="display:none;">
                                <button type="button" class="close" data-dismiss="alert">&times;</button>
                                <span id="configValidationMessage"></span>
                            </div>

                            <form id="esslConfigForm" novalidate>

                                <div class="row">
                                    <div class="col-sm-6">
                                        <div class="checkbox">
                                            <label for="IntegrationEnabled">
                                                <input type="checkbox" id="IntegrationEnabled" name="IntegrationEnabled"
                                                       @(config.IntegrationEnabled ? "checked" : "") />
                                                Integration Enabled
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            <label for="DatabaseServer">Database Server <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="DatabaseServer" name="DatabaseServer"
                                                   placeholder="e.g. DESKTOP-AAQM99\SQLEXPRESS01"
                                                   value="@config.DatabaseServer" required aria-required="true" />
                                            <span class="help-block field-error" data-field="DatabaseServer"></span>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            <label for="DatabaseName">Database Name <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="DatabaseName" name="DatabaseName"
                                                   placeholder="etimetracklite1"
                                                   value="@config.DatabaseName" required aria-required="true" />
                                            <span class="help-block field-error" data-field="DatabaseName"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            <label for="AuthenticationType">Authentication Type <span class="text-danger">*</span></label>
                                            <select class="form-control" id="AuthenticationType" name="AuthenticationType">
                                                <option value="Sql" selected="@(config.AuthenticationType == "Sql")">SQL Server Authentication</option>
                                                <option value="Windows" selected="@(config.AuthenticationType == "Windows")">Windows Authentication</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            <label for="ConnectionTimeout">Connection Timeout (seconds)</label>
                                            <input type="number" class="form-control" id="ConnectionTimeout" name="ConnectionTimeout"
                                                   min="1" max="300" value="@config.ConnectionTimeout" />
                                            <span class="help-block field-error" data-field="ConnectionTimeout"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row" id="credentialsRow">
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            <label for="Username">Username <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="Username" name="Username"
                                                   autocomplete="off"
                                                   value="@config.Username" />
                                            <span class="help-block field-error" data-field="Username"></span>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            <label for="Password">
                                                Password
                                                @if (config.HasPasswordConfigured)
                                                {
                                                    <span class="text-muted">(a password is already saved - leave blank to keep it)</span>
                                                }
                                            </label>
                                            <div class="input-group">
                                                <input type="password" class="form-control" id="Password" name="Password"
                                                       autocomplete="new-password"
                                                       placeholder="@(config.HasPasswordConfigured ? "•••••••• (leave blank to keep)" : "Enter password if changing")" />
                                                <span class="input-group-btn">
                                                    <button class="btn btn-default" type="button" id="togglePasswordBtn"
                                                            aria-pressed="false" aria-label="Show password" title="Show password">
                                                        <i class="icon-eye8" id="togglePasswordIcon"></i>
                                                    </button>
                                                </span>
                                            </div>
                                            <span class="help-block field-error" data-field="Password"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            <label for="SyncIntervalMinutes">Sync Interval (minutes)</label>
                                            <input type="number" class="form-control" id="SyncIntervalMinutes" name="SyncIntervalMinutes"
                                                   min="1" max="1440" value="@config.SyncIntervalMinutes" />
                                            <span class="help-block field-error" data-field="SyncIntervalMinutes"></span>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            <label for="BatchSize">Batch Size (records)</label>
                                            <input type="number" class="form-control" id="BatchSize" name="BatchSize"
                                                   min="1" max="5000" value="@config.BatchSize" />
                                            <span class="help-block field-error" data-field="BatchSize"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-sm-6">
                                        <button type="button" class="btn btn-default" id="testConnectionBtn">
                                            <i class="icon-plug2 position-left"></i> Test Connection
                                        </button>
                                    </div>
                                    <div class="col-sm-6 text-right">
                                        <button type="button" class="btn btn-link" id="cancelConfigBtn">
                                            Cancel
                                        </button>
                                        <button type="button" class="btn bg-primary" id="saveConfigBtn">
                                            <i class="icon-checkmark3 position-left"></i> Save Settings
                                        </button>
                                    </div>
                                </div>

                            </form>
                        </div>
                    </div>

                    <div class="mb-3">
                        <button type="button" class="btn btn-default" id="retryFailedBtn" title="Re-runs the sync over the date range below (or the last 90 days if none is set). Safe to re-run - already-imported punches are skipped automatically, only what's still missing gets retried.">
                            <i class="icon-repeat position-left"></i> Retry Failed Sync
                        </button>
                    </div>

                    <div class="panel panel-bordered">
                        <div class="panel-heading"><h6 class="panel-title">Historical Import <span class="text-muted" style="font-weight:normal;">(legacy - re-fetches from the eSSL device, different from the "Historical Sync (Manual)" card above)</span></h6></div>
                        <div class="panel-body">
                            <p class="text-muted">Import punches for a specific date range (e.g. backfill before this integration was enabled). Uses the same sync engine and duplicate prevention as the automatic sync - safe to re-run.</p>
                            <div class="row">
                                <div class="col-md-3">
                                    <label for="historyFromDate">From Date</label>
                                    <input type="date" id="historyFromDate" class="form-control" />
                                </div>
                                <div class="col-md-3">
                                    <label for="historyToDate">To Date</label>
                                    <input type="date" id="historyToDate" class="form-control" />
                                </div>
                                <div class="col-md-3" style="margin-top:25px;">
                                    <button type="button" class="btn btn-primary" id="historicalSyncBtn">
                                        <i class="icon-history position-left"></i> Import Historical Data
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="syncResultBox" style="display:none;" class="panel panel-bordered">
                        <div class="panel-heading"><h6 class="panel-title">Last Sync Result</h6></div>
                        <div class="panel-body" id="syncResultBody"></div>
                    </div>
                </div>

                <!-- SYNC LOGS TAB -->
                <div class="tab-pane" id="tab-synclogs">
                    <div id="syncLogsContainer" style="margin-top:15px;">
                        <div class="text-center text-muted">Loading...</div>
                    </div>
                </div>

                <!-- UNMAPPED EMPLOYEES TAB -->
                <div class="tab-pane" id="tab-unmapped">
                    <div id="unmappedContainer" style="margin-top:15px;">
                        <div class="text-center text-muted">Loading...</div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Historical Sync job history modal (backs "View Details" link above) -->
    <div class="modal fade" id="historyModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Historical Sync - Job History</h5>
                    <button type="button" class="close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body" id="historyModalBody">
                    <div class="text-center text-muted">Loading...</div>
                </div>
            </div>
        </div>
    </div>

</div>

<style>
    /* ===================================================================
       Bootstrap 4/5 utility-class shim.

       This project actually ships Bootstrap 3.3.7 (see
       APP/wwwroot/global_assets/js/core/libraries/bootstrap.min.js's
       header comment - "Bootstrap v3.3.7"), which has NO flexbox utility
       classes (d-flex, justify-content-*, align-items-*, gap-*) and NO
       spacing utility classes (mb-*, mt-*, px-*, py-*, etc. - those were
       all introduced in Bootstrap 4). This page's markup uses those
       Bootstrap 4/5 class names throughout (copied from modern Bootstrap
       5 conventions during the redesign), so without this shim every one
       of those classes is silently a no-op under the real BS3 stylesheet
       - elements that were supposed to sit in a flex row instead just
       stack as plain block divs (this is exactly what caused the flow
       diagram's 5 boxes, and several other rows on this page, to render
       stacked vertically instead of side by side), and every margin/
       padding utility is simply ignored.

       Rather than rewrite every element's markup back to Bootstrap-3-only
       classes/inline styles, this shim defines the small subset of
       Bootstrap 4/5 utility classes actually used on this page as plain
       CSS, scoped to plain class selectors so they behave identically to
       upstream Bootstrap 4/5. Safe to keep even if this project is ever
       upgraded to a newer Bootstrap - these rules would simply become
       redundant duplicates of the framework's own, not a conflict.
       =================================================================== */
    .d-flex { display: flex !important; }
    .d-inline-flex { display: inline-flex !important; }
    .d-block { display: block !important; }
    .d-inline-block { display: inline-block !important; }
    .d-none { display: none !important; }
    .flex-row { flex-direction: row !important; }
    .flex-column { flex-direction: column !important; }
    .flex-wrap { flex-wrap: wrap !important; }
    .flex-nowrap { flex-wrap: nowrap !important; }
    .justify-content-start { justify-content: flex-start !important; }
    .justify-content-end { justify-content: flex-end !important; }
    .justify-content-center { justify-content: center !important; }
    .justify-content-between { justify-content: space-between !important; }
    .justify-content-around { justify-content: space-around !important; }
    .align-items-start { align-items: flex-start !important; }
    .align-items-end { align-items: flex-end !important; }
    .align-items-center { align-items: center !important; }
    .align-items-stretch { align-items: stretch !important; }
    .gap-1 { gap: .25rem !important; }
    .gap-2 { gap: .5rem !important; }
    .gap-3 { gap: 1rem !important; }
    .gap-4 { gap: 1.5rem !important; }
    .h-100 { height: 100% !important; }
    .w-100 { width: 100% !important; }
    .text-end { text-align: right !important; }
    .text-start { text-align: left !important; }
    .text-decoration-none { text-decoration: none !important; }
    .rounded { border-radius: .25rem !important; }
    /* Bootstrap 4/5 spacing scale (0=0, 1=.25rem, 2=.5rem, 3=1rem, 4=1.5rem, 5=3rem) */
    .m-0 { margin: 0 !important; } .m-1 { margin: .25rem !important; } .m-2 { margin: .5rem !important; } .m-3 { margin: 1rem !important; } .m-4 { margin: 1.5rem !important; } .m-5 { margin: 3rem !important; }
    .mt-0 { margin-top: 0 !important; } .mt-1 { margin-top: .25rem !important; } .mt-2 { margin-top: .5rem !important; } .mt-3 { margin-top: 1rem !important; } .mt-4 { margin-top: 1.5rem !important; } .mt-5 { margin-top: 3rem !important; }
    .mb-0 { margin-bottom: 0 !important; } .mb-1 { margin-bottom: .25rem !important; } .mb-2 { margin-bottom: .5rem !important; } .mb-3 { margin-bottom: 1rem !important; } .mb-4 { margin-bottom: 1.5rem !important; } .mb-5 { margin-bottom: 3rem !important; }
    .ms-0 { margin-left: 0 !important; } .ms-1 { margin-left: .25rem !important; } .ms-2 { margin-left: .5rem !important; } .ms-3 { margin-left: 1rem !important; }
    .me-0 { margin-right: 0 !important; } .me-1 { margin-right: .25rem !important; } .me-2 { margin-right: .5rem !important; } .me-3 { margin-right: 1rem !important; }
    .mx-auto { margin-left: auto !important; margin-right: auto !important; }
    .my-2 { margin-top: .5rem !important; margin-bottom: .5rem !important; }
    .my-3 { margin-top: 1rem !important; margin-bottom: 1rem !important; }
    .p-0 { padding: 0 !important; } .p-1 { padding: .25rem !important; } .p-2 { padding: .5rem !important; } .p-3 { padding: 1rem !important; } .p-4 { padding: 1.5rem !important; }
    .pt-2 { padding-top: .5rem !important; } .pt-3 { padding-top: 1rem !important; }
    .pb-2 { padding-bottom: .5rem !important; } .pb-3 { padding-bottom: 1rem !important; }
    .px-1 { padding-left: .25rem !important; padding-right: .25rem !important; }
    .px-2 { padding-left: .5rem !important; padding-right: .5rem !important; }
    .px-3 { padding-left: 1rem !important; padding-right: 1rem !important; }
    .py-1 { padding-top: .25rem !important; padding-bottom: .25rem !important; }
    .py-2 { padding-top: .5rem !important; padding-bottom: .5rem !important; }
    .py-3 { padding-top: 1rem !important; padding-bottom: 1rem !important; }
    /* Bootstrap 5 badge/background color utilities (this page's badges use
       "badge bg-success" etc.; BS3's own .badge has no color variants -
       its colored equivalent is .label.label-success, used only in the
       untouched legacy panel below). Colors match Bootstrap's standard
       success/warning/danger/info palette so they match the legacy
       .label-* colors already on this page. */
    .badge { display: inline-block; padding: .35em .65em; font-size: .75em; font-weight: 700; line-height: 1; color: #fff; text-align: center; white-space: nowrap; vertical-align: baseline; border-radius: .375rem; }
    .badge.bg-success { background-color: #28a745 !important; }
    .badge.bg-warning { background-color: #ffc107 !important; }
    .badge.bg-danger { background-color: #d9534f !important; }
    .badge.bg-info { background-color: #17a2b8 !important; }
    .badge.text-dark { color: #212529 !important; }
    /* Bootstrap 5 progress-bar color utilities (BS3 uses
       .progress-bar-success/.progress-bar-danger instead of bg-*). */
    .progress-bar.bg-success { background-color: #28a745; }
    .progress-bar.bg-primary { background-color: #2b6fd9; }
    .progress-bar.bg-danger { background-color: #d9534f; }
    .progress-bar.bg-warning { background-color: #ffc107; }
    /* Bootstrap 4/5 outline button variants (no equivalent in BS3). */
    .btn-outline-secondary { color: #6c757d; background-color: transparent; border: 1px solid #6c757d; }
    .btn-outline-secondary:hover { color: #fff; background-color: #6c757d; }
    .btn-outline-danger { color: #d9534f; background-color: transparent; border: 1px solid #d9534f; }
    .btn-outline-danger:hover { color: #fff; background-color: #d9534f; }
    /* ================================================================ */

    .ent-panel { background:#fff; border:1px solid #e7ebf3; border-radius:10px; padding:16px 18px; }
    .flow-box { flex:1 1 0; min-width:150px; background:#fbfcfe; border:1px solid #e7ebf3; border-radius:8px; padding:12px; }
