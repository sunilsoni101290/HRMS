@model APP.Models.DTOs.PagedResult<EsslSyncHistoryDto>
@{
    var filter = ViewBag.Filter as EsslSyncHistoryFilterDto ?? new EsslSyncHistoryFilterDto();
}

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Start Time</th>
                <th>End Time</th>
                <th>Window (From / To)</th>
                <th class="text-center">Fetched</th>
                <th class="text-center">Imported</th>
                <th class="text-center">Skipped</th>
                <th class="text-center">Failed</th>
                <th>Status</th>
                <th>Triggered By</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Data != null && Model.Data.Any())
            {
                @foreach (var item in Model.Data)
                {
                    <tr>
                        <td>@item.StartTime.ToString("dd-MMM-yyyy hh:mm:ss tt")</td>
                        <td>@(item.EndTime?.ToString("dd-MMM-yyyy hh:mm:ss tt") ?? "—")</td>
                        <td>
                            @(item.FromDate?.ToString("dd-MMM-yyyy") ?? "—") to
                            @(item.ToDate?.ToString("dd-MMM-yyyy") ?? "—")
                        </td>
                        <td class="text-center">@item.RecordsFetched</td>
                        <td class="text-center">@item.RecordsInserted</td>
                        <td class="text-center">@item.RecordsSkipped</td>
                        <td class="text-center">@item.RecordsFailed</td>
                        <td>
                            @if (item.Status == "Success")
                            {
                                <span class="label label-success">Success</span>
                            }
                            else if (item.Status == "PartialFailure")
                            {
                                <span class="label label-warning">Partial Failure</span>
                            }
                            else
                            {
                                <span class="label label-danger">Failed</span>
                            }
                            @if (!string.IsNullOrEmpty(item.ErrorMessage))
                            {
                                <div class="text-muted font-size-sm" title="@item.ErrorMessage">
                                    @(item.ErrorMessage.Length > 60 ? item.ErrorMessage.Substring(0, 60) + "…" : item.ErrorMessage)
                                </div>
                            }
                        </td>
                        <td>@(item.TriggeredBy ?? "—")</td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="9" class="text-center text-muted">No sync history yet.</td></tr>
            }
        </tbody>
    </table>
</div>

<style>.font-size-sm { font-size: 12px; }</style>
