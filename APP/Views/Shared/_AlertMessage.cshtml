@* This project ships Bootstrap 3.3.7, not Bootstrap 5 - the dismiss buttons
   below previously used BS5's "btn-close" + "data-bs-dismiss", which BS3's
   jQuery plugin doesn't recognize at all, so every alert on every page was
   silently stuck on screen with a non-functional (x). Converted to BS3's
   ".close" + "data-dismiss" convention, which the loaded bootstrap.min.js
   actually understands. *@

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade in shadow-sm" role="alert">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Success"]
    </div>
}

