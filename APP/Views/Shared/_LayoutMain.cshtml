								@fullName
								<small>@designation</small>
							</span>
							<i class="caret"></i>
						</a>

						<ul class="dropdown-menu dropdown-menu-right">
							<li>
								<a asp-action="Details" asp-controller="Auth"
								   asp-route-id="@userId"><i class="icon-user-plus"></i> My profile</a>
							</li>
							<li>
								<a asp-controller="Auth"
								   asp-action="ChangePassword"><i class="icon-lock"></i> Change Password</a>
							</li>
							<li class="divider"></li>
							<li>
								<a asp-controller="Auth"
								   asp-action="Logout"><i class="icon-switch2"></i> Logout</a>
							</li>
						</ul>
					</li>
				</ul>
			</div>
		</div>
	</div>
	<!-- /main navbar -->
	<!-- Page container -->
	<div class="page-container">

		<!-- Page content -->
		<div class="page-content">

			<!-- Off-canvas mobile drawer backdrop - see .sidebar-mobile-overlay
			     CSS above. Tapping it, or picking any real menu link,
			     closes the drawer (see the Scripts block near the end of
			     body). -->
			<div class="sidebar-mobile-overlay" id="sidebarMobileOverlay"></div>

			<!-- Main sidebar -->
			<div class="sidebar sidebar-main">
				<div class="sidebar-content">
					<!-- /user menu -->
					<!-- Main navigation -->
					<div class="sidebar-category sidebar-category-visible">
						<div class="category-content no-padding">
							<ul class="navigation navigation-main">

								@if (favorites != null && favorites.Any())
								{
									<!-- Menu Bar redesign - Quick Access. Flat list (no
									     nesting) of the user's own pinned items, in the
									     order they pinned them. Only rendered when the
									     user actually has at least one favorite - an
									     empty "Quick Access" header for every brand new
									     user would just be clutter. -->
									<li class="navigation-header">
										<span>Quick Access</span>
										<i class="bi bi-star-fill" title="Your pinned modules"></i>
									</li>

									foreach (var fav in favorites)
									{
										bool isFavActive = !string.IsNullOrEmpty(fav.Url) && currentPath.StartsWith(Url.Content(fav.Url).ToLower());

										<li class="quick-access-section @(isFavActive ? "active" : "")">
											<a href="@Url.Content(fav.Url ?? "#")" data-feature-id="@fav.Id" title="@fav.Name" data-popup="tooltip">
												<i class="@(string.IsNullOrEmpty(fav.Icon) ? "bi bi-star" : fav.Icon)"></i>
												@fav.Name
												<i class="bi bi-star-fill favorite-star is-favorite" data-feature-id="@fav.Id" title="Remove from Quick Access" data-popup="tooltip"></i>
											</a>
										</li>
									}
								}

								<!-- Main -->
								<li class="navigation-header">
									<span>Main</span>
									<i class="icon-menu" title="Main pages"></i>
								</li>

								@foreach (var parent in parentMenus.OrderBy(x => x.DisplayOrder))
								{
									var childs = menus
										.Where(x => x.ParentFeatureId == parent.Id)
										.OrderBy(x => x.DisplayOrder)
										.ToList();

									bool hasChild = childs.Any();

									bool isParentActive = childs.Any(x =>
										!string.IsNullOrEmpty(x.Url) &&
										currentPath.StartsWith(Url.Content(x.Url).ToLower()));

									bool isMenuActive =
										!hasChild &&
										!string.IsNullOrEmpty(parent.Url) &&
										currentPath.StartsWith(Url.Content(parent.Url).ToLower());

									if (hasChild)
									{
										<li class="has-children @(isParentActive ? "active" : "")">
											<a href="#">
												<i class="@(string.IsNullOrEmpty(parent.Icon) ? "bi bi-grid" : parent.Icon)"></i>
												<span>@parent.Name</span>
											</a>

											<ul style="@(isParentActive ? "display:block;" : "")">

												@foreach (var child in childs)
												{
													bool isChildActive =
														!string.IsNullOrEmpty(child.Url) &&
														currentPath.StartsWith(Url.Content(child.Url).ToLower());

													bool isChildFavorite = favoriteIds.Contains(child.Id);

													<li class="@(isChildActive ? "active" : "")">

														<a href="@Url.Content(child.Url ?? "#")" data-feature-id="@child.Id" title="@child.Name" data-popup="tooltip">

															<i class="@(string.IsNullOrEmpty(child.Icon)
																								   ? "bi bi-dot"
																								   : child.Icon)"></i>

															@child.Name

															@if (!string.IsNullOrEmpty(child.Url))
															{
																<i class="bi @(isChildFavorite ? "bi-star-fill" : "bi-star") favorite-star @(isChildFavorite ? "is-favorite" : "")"
																   data-feature-id="@child.Id"
																   title="@(isChildFavorite ? "Remove from Quick Access" : "Pin to Quick Access")"></i>
															}

														</a>

													</li>
												}

												</ul>

											</li>
										}
										else
										{
											bool isLeafFavorite = favoriteIds.Contains(parent.Id);

											<li class="@(isMenuActive ? "active" : "")">

												<a href="@Url.Content(parent.Url ?? "#")" data-feature-id="@parent.Id" title="@parent.Name" data-popup="tooltip">

													<i class="@(string.IsNullOrEmpty(parent.Icon) ? "bi bi-circle" : parent.Icon)"></i>

													<span>@parent.Name</span>

													@if (!string.IsNullOrEmpty(parent.Url))
													{
														<i class="bi @(isLeafFavorite ? "bi-star-fill" : "bi-star") favorite-star @(isLeafFavorite ? "is-favorite" : "")"
														   data-feature-id="@parent.Id"
														   title="@(isLeafFavorite ? "Remove from Quick Access" : "Pin to Quick Access")"></i>
													}

												</a>

											</li>
										}
									}

								</ul>
							</div>
						</div>
						<!-- /main navigation -->

					</div>
				</div>
			<!-- /main sidebar -->

			<!-- Main content -->
			<div class="content-wrapper">

				<div class="content">

				<!-- Page header -->
				<div class="page-header page-header-default">
					<div class="page-header-content">
						<div class="page-title">
							<h4><i class="icon-arrow-left52 position-left"></i> <span class="text-semibold">@pageTitle</span></h4>
						</div>
						<div class="heading-elements">
							<div class="heading-btn-group">
								@await Html.PartialAsync("_AlertMessage")
							</div>
						</div>
					</div>

					<!-- Menu Bar redesign - dynamic breadcrumbs. Was a static
					     "Home" link on every single page regardless of where
					     you actually were; now resolved from the current
					     page's own AppFeature (currentFeature/
					     currentFeatureParent, computed above from the same
					     menu data the sidebar renders from). Falls back to
					     just "Home" when the current page has no matching
					     AppFeature (e.g. Login, Error pages). -->
					<div class="breadcrumb-line">
						<ul class="breadcrumb">
							<li><a asp-controller="Dashboard" asp-action="Index"><i class="icon-home2 position-left"></i> Home</a></li>
							@if (currentFeatureParent != null)
							{
								<li><span>@currentFeatureParent.Name</span></li>
							}
							@if (currentFeature != null)
							{
								<li class="active"><span>@currentFeature.Name</span></li>
							}
						</ul>
					</div>
				</div>
				<!-- /page header -->

					@RenderBody()

				<!-- Footer -->
				<div class="footer text-muted">
					&copy; 2015. <a href="https://prosaectotal.com/">Prosaec Total PVT. LTD. </a>
				</div>
				<!-- /footer -->
				</div>
			</div>
			<!-- /main content -->

		</div>
		<!-- /page content -->

	</div>
	<!-- /page container -->

	<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
	<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

	<!-- Menu Bar redesign - global search + Favorites toggle + sidebar
	     collapse persistence + "/" keyboard shortcut. Vanilla JS + jQuery
	     (both already loaded above) - no new library. -->
	<script>
		var hrmsMenuSearchIndex = @Html.Raw(searchIndexJson);

		$(function () {
			// ---- Sidebar collapse persistence ----
			// app.js already toggles body.sidebar-xs on
			// .sidebar-main-toggle click (see assets/js/app.js) - this just
			// mirrors that same class into localStorage so the next page
			// load's inline <script> (top of body) can restore it before
			// paint. Does not replace app.js's own handler, both fire.
			$(document).on('click', '.sidebar-main-toggle', function () {
				try {
					setTimeout(function () {
						var collapsed = document.body.classList.contains('sidebar-xs');
						localStorage.setItem('hrmsSidebarXs', collapsed ? '1' : '0');
					}, 0);
				} catch (e) { /* localStorage unavailable - collapse still works, just doesn't persist */ }
			});

			// ---- Mobile drawer: tap-outside-to-close + auto-close after
			// picking a real menu link. Group headers use href="#" (they
			// only expand/collapse a submenu) so they never close the
			// drawer; only a link with a real Url does. The favorite-star
			// icon already calls stopPropagation() on its own click
			// handler below, so starring an item never triggers this.
			$('#sidebarMobileOverlay').on('click', function () {
				$('body').removeClass('sidebar-mobile-main');
			});

			$(document).on('click', '.navigation-main a[href]', function () {
				var href = $(this).attr('href');
				if (href && href !== '#' && window.innerWidth <= 768) {
					$('body').removeClass('sidebar-mobile-main');
				}
			});

			// ---- Global menu search ----
			var $input = $('#menuSearchInput');
			var $results = $('#menuSearchResults');
			var activeIndex = -1;

			function renderResults(matches, query) {
				$results.empty();
				activeIndex = -1;

				if (!query) {
					$results.removeClass('show');
					return;
				}

				if (matches.length === 0) {
					$results.append('<div class="search-empty">No matching module for "' + $('<div>').text(query).html() + '"</div>');
					$results.addClass('show');
					return;
				}

				var lastGroup = null;
				matches.slice(0, 20).forEach(function (m) {
					if (m.group && m.group !== lastGroup) {
						$results.append('<div class="search-result-group">' + $('<div>').text(m.group).html() + '</div>');
						lastGroup = m.group;
					}
					var $item = $('<a class="search-result-item"></a>')
						.attr('href', m.url)
						.attr('data-url', m.url)
						.append('<i class="' + m.icon + '"></i><span></span>');
					$item.find('span').text(m.name);
					$results.append($item);
				});

				$results.addClass('show');
			}

			function doSearch() {
				var query = $input.val().trim().toLowerCase();

				if (!query) {
					renderResults([], '');
					return;
				}

				var matches = hrmsMenuSearchIndex.filter(function (m) {
					return m.name.toLowerCase().indexOf(query) !== -1 ||
						(m.group && m.group.toLowerCase().indexOf(query) !== -1);
				});

				renderResults(matches, query);
			}

			$input.on('input', doSearch);
			$input.on('focus', function () { if ($input.val().trim()) doSearch(); });

			$input.on('keydown', function (e) {
				var $items = $results.find('.search-result-item');

				if (e.key === 'Escape') {
					$results.removeClass('show');
					$input.blur();
					return;
				}

				if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
					e.preventDefault();
					if ($items.length === 0) return;

					$items.removeClass('active-result');
					if (e.key === 'ArrowDown') activeIndex = (activeIndex + 1) % $items.length;
					else activeIndex = (activeIndex - 1 + $items.length) % $items.length;

					var $active = $items.eq(activeIndex).addClass('active-result');
					$active[0].scrollIntoView({ block: 'nearest' });
					return;
				}

				if (e.key === 'Enter') {
					if (activeIndex >= 0 && $items.eq(activeIndex).length) {
						window.location.href = $items.eq(activeIndex).attr('data-url');
					} else if ($items.length > 0) {
						window.location.href = $items.eq(0).attr('data-url');
					}
				}
			});

			// "/" anywhere on the page (unless already typing in a field) jumps to search.
			$(document).on('keydown', function (e) {
				if (e.key === '/' && !$(e.target).is('input, textarea, select') && !e.target.isContentEditable) {
					e.preventDefault();
					$input.focus();
				}
			});

			$(document).on('click', function (e) {
				if (!$(e.target).closest('.navbar-menu-search').length) {
					$results.removeClass('show');
				}
			});

			// ---- Favorites / Quick Access star toggle ----
			$(document).on('click', '.favorite-star', function (e) {
				e.preventDefault();
				e.stopPropagation();

				var $star = $(this);
				var featureId = $star.data('feature-id');
				var isPinned = $star.hasClass('is-favorite');

				if (!featureId) return;

				$.post('@Url.Action("ToggleFavorite", "AppFeatures")', {
					appFeatureId: featureId,
					pin: !isPinned
				})
					.done(function (resp) {
						if (resp && resp.success) {
							// Simplest correct refresh: the Quick Access
							// section and every star's state are all
							// server-rendered from `favorites`/`favoriteIds`
							// above - reloading guarantees they stay
							// consistent with the DB rather than
							// hand-patching the DOM in two places.
							window.location.reload();
						} else {
							alert((resp && resp.message) || 'Could not update Quick Access. Please try again.');
						}
					})
					.fail(function () {
						alert('Could not update Quick Access. Please try again.');
					});
			});
		});
	</script>

	@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
