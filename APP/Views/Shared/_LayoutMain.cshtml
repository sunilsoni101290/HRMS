	<style>
		/* Fix: native dropdowns were rendering with
		   invisible text (blank rows, the highlighted row a solid color
		   with no visible label) whenever the OS/browser is in dark mode.
		   The page itself is always light-themed, but without an explicit
		   color-scheme the browser paints a plain <select>'s native
		   popup list using dark-mode system colors while this page's own
		   CSS keeps the closed control light - the mismatch is what hides
		   the option text. Forcing color-scheme: light (plus an explicit
		   background/text color as a fallback for browsers that don't
		   support color-scheme) makes every dropdown across the app -
		   including plain selects with no JS plugin at all -
		   always render with dark text on a light background,
		   regardless of the user's OS theme. */
		select.form-control,
		select {
			color-scheme: light;
			background-color: #fff;
			color: #333333;
		}

		/* Active/hover coloring for the sidebar now lives in one place -
		   the "Sidebar redesign" style block near the top of this file
		   (.navigation-main greater-than li.active greater-than a, etc.)
		   - this used to also be redefined here with a flat #2196F3,
		   which (same CSS specificity, but declared later) silently
		   overrode that design and made hover/active look inconsistent.
		   Only the submenu collapse mechanics stay here. */
		.navigation-main li ul {
		display: none;
		}

		.navigation-main li.active > ul {
		display: block;
		}
	</style>
</head>

<body>
	<!-- Menu Bar redesign - restore the sidebar's collapsed/compact state
	     (localStorage: "hrmsSidebarXs") before first paint, so a user who
	     collapsed the sidebar does not see it flash open on every page
	     navigation. `document.body` already exists the instant the parser
	     reaches this point (right after the <body> start tag), so this
	     applies the theme's own real "sidebar-xs" class (the same one
	     assets/js/app.js's .sidebar-main-toggle handler toggles) directly -
	     no separate approximate style to keep in sync with the theme. -->
	<script>
		(function () {
			try {
				var pref = localStorage.getItem('hrmsSidebarXs');
				if (pref === '1') {
					document.body.classList.add('sidebar-xs');
				} else if (pref === null) {
					// First-ever visit, no saved preference yet. On tablet-
					// width screens default to compact/icon-only mode so
					// the content area gets more room - this is a one-time
					// default, never forced again: the user's very first
					// manual toggle (either direction) writes '0' or '1'
					// above and is honoured on every later visit/device.
					var w = window.innerWidth || document.documentElement.clientWidth;
					if (w >= 769 && w <= 991) {
						document.body.classList.add('sidebar-xs');
					}
				}
			} catch (e) { /* localStorage unavailable (privacy mode etc.) - fall back to default expanded sidebar */ }
		})();
	</script>

