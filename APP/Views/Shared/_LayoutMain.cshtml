			background: linear-gradient(90deg, #16233f, #1b2a4a 55%, #203258);
			border: none;
			box-shadow: 0 2px 10px rgba(0,0,0,.18);
			min-height: 58px;
		}
		.navbar-enterprise .navbar-header { display: flex; align-items: center; }
		.navbar-enterprise .navbar-brand {
			display: flex; align-items: center; height: 58px; padding: 0 20px 0 18px;
		}
		.navbar-enterprise .brand-logo-panel {
			background: #fff; border-radius: 7px; padding: 6px 14px;
			display: inline-flex; align-items: center; box-shadow: 0 1px 4px rgba(0,0,0,.15);
		}
		.navbar-enterprise .brand-logo-panel img { height: 26px; display: block; }
		.navbar-enterprise .brand-divider {
			width: 1px; height: 26px; background: rgba(255,255,255,.18); margin: 0 4px 0 18px;
		}
		.navbar-enterprise .brand-title {
			color: #eef2fa; font-size: 15px; font-weight: 600; letter-spacing: .2px; margin-left: 14px;
			display: flex; flex-direction: column; line-height: 1.15;
		}
		.navbar-enterprise .brand-title small {
			color: #93a3c4; font-size: 10.5px; font-weight: 400; letter-spacing: .8px; text-transform: uppercase;
		}
		.navbar-enterprise .sidebar-control { color: #cfd8e6 !important; }
		.navbar-enterprise .sidebar-control:hover { color: #fff !important; }
		.navbar-enterprise .dropdown-user > .dropdown-toggle {
			display: flex; align-items: center; padding: 10px 18px !important; color: #eef2fa !important;
		}
		.navbar-enterprise .dropdown-user .user-avatar-circle {
			width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg,#4e9cff,#2b6fd9);
			color: #fff; display: inline-flex; align-items: center; justify-content: center;
			font-size: 13px; font-weight: 700; margin-right: 10px; flex-shrink: 0;
		}
		.navbar-enterprise .dropdown-user .user-meta { display: flex; flex-direction: column; line-height: 1.2; text-align: left; }
		.navbar-enterprise .dropdown-user .user-meta small { color: #93a3c4; font-size: 11px; font-weight: 400; }
		.navbar-enterprise .dropdown-user.open .dropdown-toggle,
		.navbar-enterprise .dropdown-user > .dropdown-toggle:hover { background: rgba(255,255,255,.06); }
		.navbar-enterprise .dropdown-menu { border: none; box-shadow: 0 6px 24px rgba(0,0,0,.18); border-radius: 6px; overflow: hidden; }
		.navbar-enterprise .dropdown-menu > li > a { padding: 9px 16px; font-size: 13px; }
		.navbar-enterprise .dropdown-menu > li > a > i { margin-right: 8px; opacity: .75; }
	</style>
	<!-- /global stylesheets -->
	<!-- Core JS files -->
	<script src="~/global_assets/js/plugins/loaders/pace.min.js"></script>
	<script src="~/global_assets/js/core/libraries/jquery.min.js"></script>
	<script src="~/global_assets/js/core/libraries/bootstrap.min.js"></script>
	<script src="~/global_assets/js/plugins/loaders/blockui.min.js"></script>
	<!-- sweet_alert.min.js ships in wwwroot but was never actually included
	     here - every swal(...) call across the app (46 views, including the
	     Reset Password result and most create/edit success messages) was
	     throwing "swal is not defined" in the console and silently doing
	     nothing. -->
	<script src="~/global_assets/js/plugins/notifications/sweet_alert.min.js"></script>
	<!-- /core JS files -->
	<!-- Theme JS files -->
	<script src="~/global_assets/js/plugins/visualization/d3/d3.min.js"></script>
	<script src="~/global_assets/js/plugins/visualization/d3/d3_tooltip.js"></script>

	<script src="~/assets/js/app.js"></script>
	<script src="~/global_assets/js/demo_pages/general_widgets_stats.js"></script>
	<!-- /theme JS files -->

	@* <script src="~/global_assets/js/plugins/tables/datatables/datatables.min.js"></script> *@
	<script src="~/global_assets/js/plugins/notifications/sweet_alert.min.js"></script>

	<style>
		/* Fix: native dropdowns were rendering with
		   invisible text (blank rows, the highlighted row a solid color
		   with no visible label) whenever the OS/browser is in dark mode.
		   The page itself is always light-themed, but without an explicit
		   color-scheme the browser paints a plain <select>'s native
		   popup list using dark-mode system colors while this page's own
		   CSS keeps the closed control light - the mismatch is what hides
		   the option text. Forcing color-scheme: light (plus an explicit
		   background/text color as a fallback for browsers that don't
		   support color-scheme) makes every dropdown across the app -
		   including plain selects with no JS plugin at all, like
		   EmployeeWorkAssignment/Assign.cshtml's Employee/Job Type
		   dropdowns - always render with dark text on a light background,
		   regardless of the user's OS theme. */
		select.form-control,
		select {
			color-scheme: light;
			background-color: #fff;
			color: #333333;
		}

		.navigation-main li.active > a {
		background-color: #2196F3;
		color: #fff;
		}

		.navigation-main li.active > a i {
		color: #fff;
		}

		.navigation-main li ul {
		display: none;
		}

		.navigation-main li.active > ul {
		display: block;
		}
	</style>
</head>

<body>

	<!-- Main navbar -->
	<div class="navbar navbar-inverse navbar-enterprise">
		<div class="navbar-header" style="margin-top:5px;">
			<a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">
				<span class="brand-logo-panel">
					<img src="~/images/PT-03.png" style="height:39px;" alt="PROSAEC Total" />
				</span>
				<span class="brand-divider"></span>
				<span class="brand-title">
					HRMS Suite
					<small>PROSAEC Total</small>
				</span>
			</a>

			<ul class="nav navbar-nav visible-xs-block">
				<li><a data-toggle="collapse" data-target="#navbar-mobile"><i class="icon-tree5"></i></a></li>
				<li><a class="sidebar-mobile-main-toggle"><i class="icon-paragraph-justify3"></i></a></li>
			</ul>
		</div>

		<div class="navbar-collapse collapse" id="navbar-mobile">
			<ul class="nav navbar-nav">
				<li><a class="sidebar-control sidebar-main-toggle hidden-xs"><i class="icon-paragraph-justify3"></i></a></li>
			</ul>
			<div class="navbar-right">
				<ul class="nav navbar-nav">

					@await Html.PartialAsync("_NotificationBell")

					<li class="dropdown dropdown-user">
						<a class="dropdown-toggle" data-toggle="dropdown">
							<span class="user-avatar-circle">@(string.IsNullOrWhiteSpace(fullName) ? "?" : fullName.Trim().Substring(0, 1).ToUpper())</span>
							<span class="user-meta">
								@fullName
								<small>@designation</small>
							</span>
							<i class="caret"></i>
						</a>

						<ul class="dropdown-menu dropdown-menu-right">
							<li>
								<a asp-action="Details" asp-controller="Auth"
								   asp-route-id="@userId"><i class="icon-user-plus"></i> My profile</a>
							</li>
							<li>
								<a asp-controller="Auth"
								   asp-action="ChangePassword"><i class="icon-lock"></i> Change Password</a>
							</li>
							<li class="divider"></li>
							<li>
								<a asp-controller="Auth"
								   asp-action="Logout"><i class="icon-switch2"></i> Logout</a>
							</li>
						</ul>
					</li>
				</ul>
			</div>
		</div>
	</div>
	<!-- /main navbar -->
	<!-- Page container -->
	<div class="page-container">

		<!-- Page content -->
		<div class="page-content">

			<!-- Main sidebar -->
			<div class="sidebar sidebar-main">
				<div class="sidebar-content">
					<!-- /user menu -->
					<!-- Main navigation -->
					<div class="sidebar-category sidebar-category-visible">
						<div class="category-content no-padding">
							<ul class="navigation navigation-main">

								<!-- Main -->
								<li class="navigation-header">
									<span>Main</span>
									<i class="icon-menu" title="Main pages"></i>
								</li>

								@foreach (var parent in parentMenus.OrderBy(x => x.DisplayOrder))
								{
									var childs = menus
										.Where(x => x.ParentFeatureId == parent.Id)
										.OrderBy(x => x.DisplayOrder)
										.ToList();

									bool hasChild = childs.Any();

									bool isParentActive = childs.Any(x =>
										!string.IsNullOrEmpty(x.Url) &&
										currentPath.StartsWith(Url.Content(x.Url).ToLower()));

									bool isMenuActive =
										!hasChild &&
										!string.IsNullOrEmpty(parent.Url) &&
										currentPath.StartsWith(Url.Content(parent.Url).ToLower());

									if (hasChild)
									{
										<li class="has-children @(isParentActive ? "active" : "")">
											<a href="#">
												<i class="@(string.IsNullOrEmpty(parent.Icon) ? "bi bi-grid" : parent.Icon)"></i>
												<span>@parent.Name</span>
											</a>

											<ul style="@(isParentActive ? "display:block;" : "")">

												@foreach (var child in childs)
												{
													bool isChildActive =
														!string.IsNullOrEmpty(child.Url) &&
														currentPath.StartsWith(Url.Content(child.Url).ToLower());

													<li class="@(isChildActive ? "active" : "")">

														<a href="@Url.Content(child.Url ?? "#")">

															<i class="@(string.IsNullOrEmpty(child.Icon)
																								   ? "bi bi-dot"
																								   : child.Icon)"></i>

															@child.Name

														</a>

													</li>
												}

												</ul>

											</li>
										}
										else
										{
											<li class="@(isMenuActive ? "active" : "")">

												<a href="@Url.Content(parent.Url ?? "#")">

													<i class="@(string.IsNullOrEmpty(parent.Icon) ? "bi bi-circle" : parent.Icon)"></i>

													<span>@parent.Name</span>

												</a>

											</li>
										}
									}

								</ul>
							</div>
						</div>
						<!-- /main navigation -->

					</div>
				</div>
			<!-- /main sidebar -->

			<!-- Main content -->
			<div class="content-wrapper">

				<div class="content">

				<!-- Page header -->
				<div class="page-header page-header-default">
					<div class="page-header-content">
						<div class="page-title">
							<h4><i class="icon-arrow-left52 position-left"></i> <span class="text-semibold">@pageTitle</span></h4>
						</div>
						<div class="heading-elements">
							<div class="heading-btn-group">
								@await Html.PartialAsync("_AlertMessage")
							</div>
						</div>
					</div>

					<div class="breadcrumb-line">
						<ul class="breadcrumb">
							<li><a asp-controller="Dashboard" asp-action="Index"><i class="icon-home2 position-left"></i> Home</a></li>
						</ul>
					</div>
				</div>
				<!-- /page header -->

					@RenderBody()

				<!-- Footer -->
				<div class="footer text-muted">
					&copy; 2015. <a href="https://prosaectotal.com/">Prosaec Total PVT. LTD. </a>
				</div>
				<!-- /footer -->
				</div>
			</div>
			<!-- /main content -->

		</div>
		<!-- /page content -->

	</div>
	<!-- /page container -->

	<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
	<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

	@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
