@{
    Layout = null;
    var pageTitle = ViewBag.Title ?? "HRMS Dashboard";
}

@using Microsoft.AspNetCore.Http
@using APP.Services.Interfaces
@using APP.Models.DTOs
@using Microsoft.Extensions.Configuration
@using System.Text.Json

@inject IConfiguration Configuration
@inject IApiService apiService
@inject IHttpContextAccessor HttpContextAccessor


@{
    var fullName = HttpContextAccessor.HttpContext.Session.GetString("FullName");
    var designation = HttpContextAccessor.HttpContext.Session.GetString("Designation");
    var rolename = HttpContextAccessor.HttpContext.Session.GetString("RoleName");
    var userId = HttpContextAccessor.HttpContext.Session.GetString("UserId");

    //var profileImage = HttpContextAccessor.HttpContext.Session.GetString("ProfileImage");

    List<AppFeatureDto> menus = new();

    try
    {
        var apiBaseUrl = @Configuration["ApiSettings:BaseUrl"];

        // Role-based menu for the signed-in user; falls back to the full menu.
        var menuUrl = string.IsNullOrEmpty(userId)
            ? $"{apiBaseUrl}AppFeatures/menu"
            : $"{apiBaseUrl}AppFeatures/menu/user/{userId}";

        menus = await apiService
            .GetAsync<List<AppFeatureDto>>(menuUrl);
    }
    catch
    {
        menus = new List<AppFeatureDto>();
    }

    var parentMenus = menus
        .Where(x => x.ParentFeatureId == null)
        .OrderBy(x => x.DisplayOrder)
        .ToList();

	string currentPath = Context.Request.Path.Value?.ToLower() ?? "";

    // ==================================================================
    // MENU BAR REDESIGN - Favorites / Quick Access
    // ==================================================================
    // Fetched alongside the menu itself (same request-per-page-load
    // pattern as `menus` above) so the Quick Access section renders on
    // first paint with no extra client round-trip. Failure here (API down,
    // brand new user with no favorites yet) degrades to "no Quick Access
    // section" - it never blocks the rest of the sidebar from rendering.
    List<AppFeatureDto> favorites = new();

    if (!string.IsNullOrEmpty(userId))
    {
        try
        {
            var apiBaseUrl = @Configuration["ApiSettings:BaseUrl"];
            favorites = await apiService
                .GetAsync<List<AppFeatureDto>>($"{apiBaseUrl}AppFeatures/favorites/user/{userId}");
        }
        catch
        {
            favorites = new List<AppFeatureDto>();
        }
    }

    var favoriteIds = (favorites ?? new List<AppFeatureDto>())
        .Where(f => !string.IsNullOrEmpty(f.Id))
        .Select(f => f.Id)
        .ToHashSet();

    // ==================================================================
    // MENU BAR REDESIGN - dynamic breadcrumbs
    // ==================================================================
    // Every previous page showed a hardcoded "Home" breadcrumb regardless
    // of where you were. Resolve the current page's own AppFeature (by URL
    // prefix match, same rule already used for sidebar active-highlighting
    // above) and, if it has a parent group, that parent too - built from
    // data already loaded for the sidebar, no extra query.
    AppFeatureDto currentFeature = menus
        .Where(x => !string.IsNullOrEmpty(x.Url) && currentPath.StartsWith(Url.Content(x.Url).ToLower()))
        .OrderByDescending(x => Url.Content(x.Url).Length) // longest/most specific URL match wins
        .FirstOrDefault();

    AppFeatureDto currentFeatureParent = currentFeature?.ParentFeatureId != null
        ? menus.FirstOrDefault(x => x.Id == currentFeature.ParentFeatureId)
        : null;

    // ==================================================================
    // MENU BAR REDESIGN - client-side global menu search index
    // ==================================================================
    // Leaf items only (a bare group header has no Url to navigate to and
    // would just be dead weight in search results). Built from the same
    // already role/permission-filtered `menus` list - search can never
    // surface something the user is not otherwise allowed to see.
    var searchIndex = menus
        .Where(x => !string.IsNullOrEmpty(x.Url) && !string.IsNullOrEmpty(x.ControllerName))
        .Select(x => new
        {
            id = x.Id,
            name = x.Name,
            url = Url.Content(x.Url),
            icon = string.IsNullOrEmpty(x.Icon) ? "bi bi-dot" : x.Icon,
            group = menus.FirstOrDefault(p => p.Id == x.ParentFeatureId)?.Name ?? ""
        })
        .ToList();

    var searchIndexJson = JsonSerializer.Serialize(searchIndex);
}

