@{
    Layout = null;
    var pageTitle = ViewBag.Title ?? "HRMS Dashboard";
}

@using Microsoft.AspNetCore.Http
@using APP.Services.Interfaces
@using APP.Models.DTOs
@using Microsoft.Extensions.Configuration

@inject IConfiguration Configuration
@inject IApiService apiService
@inject IHttpContextAccessor HttpContextAccessor


@{
    var fullName = HttpContextAccessor.HttpContext.Session.GetString("FullName");
    var designation = HttpContextAccessor.HttpContext.Session.GetString("Designation");
    var rolename = HttpContextAccessor.HttpContext.Session.GetString("RoleName");
    var userId = HttpContextAccessor.HttpContext.Session.GetString("UserId");

    //var profileImage = HttpContextAccessor.HttpContext.Session.GetString("ProfileImage");

    List<AppFeatureDto> menus = new();

    try
    {
        var apiBaseUrl = @Configuration["ApiSettings:BaseUrl"];

        // Role-based menu for the signed-in user; falls back to the full menu.
        var menuUrl = string.IsNullOrEmpty(userId)
            ? $"{apiBaseUrl}AppFeatures/menu"
            : $"{apiBaseUrl}AppFeatures/menu/user/{userId}";

        menus = await apiService
            .GetAsync<List<AppFeatureDto>>(menuUrl);
    }
    catch
    {
        menus = new List<AppFeatureDto>();
    }

    var parentMenus = menus
        .Where(x => x.ParentFeatureId == null)
        .OrderBy(x => x.DisplayOrder)
        .ToList();

	string currentPath = Context.Request.Path.Value?.ToLower() ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	
	<link rel="apple-touch-icon" sizes="180x180" href="~/images/favicon_io/apple-touch-icon.png">
	<link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon_io/favicon-32x32.png">
	<link rel="icon" type="image/png" sizes="16x16" href="~/images/favicon_io/favicon-16x16.png">
	<link rel="manifest" href="~/images/favicon_io/site.webmanifest">
	<title>PROSAEC TOTAL | HRMS </title>

	<!-- Global stylesheets -->
	<link href="https://fonts.googleapis.com/css?family=Roboto:400,300,100,500,700,900" rel="stylesheet" type="text/css">
	<link href="~/global_assets/css/icons/icomoon/styles.css" rel="stylesheet" type="text/css">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" type="text/css">
	<link href="~/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css">
	<link href="~/assets/css/core.min.css" rel="stylesheet" type="text/css">
	<link href="~/assets/css/components.min.css" rel="stylesheet" type="text/css">
	<link href="~/assets/css/colors.min.css" rel="stylesheet" type="text/css">

	<!-- Sidebar redesign -->
	<style>
		.sidebar-main .sidebar-content { background: #1b2a4a; }
		.navigation-main > li > a {
			color: #cfd8e6; padding: 11px 20px; font-size: 13px;
			border-left: 3px solid transparent; transition: all .15s ease;
		}
		.navigation-main > li > a > i,
		.navigation-main > li > a > [class^="bi-"],
		.navigation-main > li > a > [class^="icon-"] {
			margin-right: 12px; font-size: 16px; min-width: 18px; text-align: center;
			display: inline-block; vertical-align: middle; opacity: .9;
		}
		.navigation-main > li > a:hover {
			background: rgba(255,255,255,.06); color: #fff; border-left-color: #4e9cff;
		}
		.navigation-main > li.active > a,
		.navigation-main > li.active > a:hover {
			background: linear-gradient(90deg, rgba(78,156,255,.22), rgba(78,156,255,0));
			color: #fff; border-left-color: #4e9cff;
		}
		.navigation-main .navigation-header {
			color: #6b7a99; font-size: 11px; letter-spacing: .6px; text-transform: uppercase;
			padding: 14px 20px 6px; font-weight: 600;
		}
		.navigation-main li ul { background: rgba(0,0,0,.18); }
		.navigation-main li ul > li > a {
			color: #b4c0d4; padding: 9px 20px 9px 50px; font-size: 12.5px;
			border-left: 3px solid transparent;
		}
		.navigation-main li ul > li > a:hover { color: #fff; background: rgba(255,255,255,.05); }
		.navigation-main li ul > li.active > a { color: #fff; border-left-color: #4e9cff; font-weight: 500; }
		.navigation-main li ul > li > a > i,
		.navigation-main li ul > li > a > [class^="bi-"],
		.navigation-main li ul > li > a > [class^="icon-"] { margin-right: 9px; font-size: 13px; opacity: .8; }
		.navigation-main > li.has-children > a:after {
			content: "\f282"; font-family: "bootstrap-icons"; font-size: 11px;
			float: right; margin-top: 3px; opacity: .6; transition: transform .2s ease;
		}
		.navigation-main > li.has-children.active > a:after { transform: rotate(90deg); }
	</style>
	<!-- /global stylesheets -->
	<!-- Core JS files -->
	<script src="~/global_assets/js/plugins/loaders/pace.min.js"></script>
	<script src="~/global_assets/js/core/libraries/jquery.min.js"></script>
	<script src="~/global_assets/js/core/libraries/bootstrap.min.js"></script>
	<script src="~/global_assets/js/plugins/loaders/blockui.min.js"></script>
	<!-- /core JS files -->
	<!-- Theme JS files -->
	<script src="~/global_assets/js/plugins/visualization/d3/d3.min.js"></script>
	<script src="~/global_assets/js/plugins/visualization/d3/d3_tooltip.js"></script>

	<script src="~/assets/js/app.js"></script>
	<script src="~/global_assets/js/demo_pages/general_widgets_stats.js"></script>
	<!-- /theme JS files -->

	@* <script src="~/global_assets/js/plugins/tables/datatables/datatables.min.js"></script> *@
	<script src="~/global_assets/js/plugins/notifications/sweet_alert.min.js"></script>

	<style>
		.navigation-main li.active > a {
		background-color: #2196F3;
		color: #fff;
		}

		.navigation-main li.active > a i {
		color: #fff;
		}

		.navigation-main li ul {
		display: none;
		}

		.navigation-main li.active > ul {
		display: block;
		}
	</style>
</head>

<body>

	<!-- Main navbar -->
	<div class="navbar navbar-inverse">
		<div class="navbar-header">
			<a class="navbar-brand" href="index.html"><img src="~/images/PT-06.png" style="height: 35px;margin-top:0px;" alt=""></a>

			<ul class="nav navbar-nav visible-xs-block">
				<li><a data-toggle="collapse" data-target="#navbar-mobile"><i class="icon-tree5"></i></a></li>
				<li><a class="sidebar-mobile-main-toggle"><i class="icon-paragraph-justify3"></i></a></li>
			</ul>
		</div>

		<div class="navbar-collapse collapse" id="navbar-mobile">
			<ul class="nav navbar-nav">
				<li><a class="sidebar-control sidebar-main-toggle hidden-xs"><i class="icon-paragraph-justify3"></i></a></li>
			</ul>
			<div class="navbar-right">
				<ul class="nav navbar-nav">
					
					<li class="dropdown dropdown-user">
						<a class="dropdown-toggle" data-toggle="dropdown">
							@* <img src="../../../../global_assets/images/placeholders/placeholder.jpg" alt=""> *@
							<span>@fullName , @designation</span>
							<i class="caret"></i>
						</a>

						<ul class="dropdown-menu dropdown-menu-right">
							<li>
								<a asp-action="Details" asp-controller="Auth"
								   asp-route-id="@userId"><i class="icon-user-plus"></i> My profile</a>
							</li>
							<li>
								<a asp-controller="Auth"
								   asp-action="ChangePassword"><i class="icon-lock"></i> Change Password</a>
							</li>
							<li>
								<a asp-controller="Auth"
								   asp-action="Logout"><i class="icon-switch2"></i> Logout</a>
							</li>
						</ul>
					</li>
				</ul>
			</div>
		</div>
	</div>
	<!-- /main navbar -->
	<!-- Page container -->
	<div class="page-container">

		<!-- Page content -->
		<div class="page-content">

			<!-- Main sidebar -->
			<div class="sidebar sidebar-main">
				<div class="sidebar-content">
					<!-- /user menu -->
					<!-- Main navigation -->
					<div class="sidebar-category sidebar-category-visible">
						<div class="category-content no-padding">
							<ul class="navigation navigation-main">

								<!-- Main -->
								<li class="navigation-header">
									<span>Main</span>
									<i class="icon-menu" title="Main pages"></i>
								</li>

								@foreach (var parent in parentMenus.OrderBy(x => x.DisplayOrder))
								{
									var childs = menus
										.Where(x => x.ParentFeatureId == parent.Id)
										.OrderBy(x => x.DisplayOrder)
										.ToList();

									bool hasChild = childs.Any();

									bool isParentActive = childs.Any(x =>
										!string.IsNullOrEmpty(x.Url) &&
										currentPath.StartsWith(Url.Content(x.Url).ToLower()));

									bool isMenuActive =
										!hasChild &&
										!string.IsNullOrEmpty(parent.Url) &&
										currentPath.StartsWith(Url.Content(parent.Url).ToLower());

									if (hasChild)
									{
										<li class="has-children @(isParentActive ? "active" : "")">
											<a href="#">
												<i class="@(string.IsNullOrEmpty(parent.Icon) ? "bi bi-grid" : parent.Icon)"></i>
												<span>@parent.Name</span>
											</a>

											<ul style="@(isParentActive ? "display:block;" : "")">

												@foreach (var child in childs)
												{
													bool isChildActive =
														!string.IsNullOrEmpty(child.Url) &&
														currentPath.StartsWith(Url.Content(child.Url).ToLower());

													<li class="@(isChildActive ? "active" : "")">

														<a href="@Url.Content(child.Url ?? "#")">

															<i class="@(string.IsNullOrEmpty(child.Icon)
																								   ? "bi bi-dot"
																								   : child.Icon)"></i>

															@child.Name

														</a>

													</li>
												}

												</ul>

											</li>
										}
										else
										{
											<li class="@(isMenuActive ? "active" : "")">

												<a href="@Url.Content(parent.Url ?? "#")">

													<i class="@(string.IsNullOrEmpty(parent.Icon) ? "bi bi-circle" : parent.Icon)"></i>

													<span>@parent.Name</span>

												</a>

											</li>
										}
									}

								</ul>
							</div>
						</div>
						<!-- /main navigation -->

					</div>
				</div>
			<!-- /main sidebar -->

			<!-- Main content -->
			<div class="content-wrapper">

				<div class="content">

				<!-- Page header -->
				<div class="page-header page-header-default">
					<div class="page-header-content">
						<div class="page-title">
							<h4><i class="icon-arrow-left52 position-left"></i> <span class="text-semibold">@pageTitle</span></h4>
						</div>
						<div class="heading-elements">
							<div class="heading-btn-group">
								@await Html.PartialAsync("_AlertMessage")
							</div>
						</div>
					</div>

					<div class="breadcrumb-line">
						<ul class="breadcrumb">
							<li><a asp-controller="Dashboard" asp-action="Index"><i class="icon-home2 position-left"></i> Home</a></li>
						</ul>
					</div>
				</div>
				<!-- /page header -->

					@RenderBody()

				<!-- Footer -->
				<div class="footer text-muted">
					&copy; 2015. <a href="https://prosaectotal.com/">Prosaec Total PVT. LTD. </a>
				</div>
				<!-- /footer -->
				</div>
			</div>
			<!-- /main content -->

		</div>
		<!-- /page content -->

	</div>
	<!-- /page container -->

	<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
	<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

	@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
