@{
    Layout = null;
    var pageTitle = ViewBag.Title ?? "HRMS Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@pageTitle</title>

    <!-- ================= BOOTSTRAP ================= -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- ================= BOOTSTRAP ICON ================= -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- ================= GOOGLE FONT ================= -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- ================= CUSTOM CSS ================= -->
    <link href="~/css/layout-main.css" rel="stylesheet" />
  
</head>

<body>
    @await Html.PartialAsync("_AlertMessage")
    <!-- ================= SIDEBAR ================= -->

    <aside class="sidebar" id="sidebar">

        <!-- LOGO -->
        <div class="sidebar-logo">
            HR<span>MS</span> Pro
        </div>

        <!-- MENU -->
        <div class="sidebar-menu">

            <div class="sidebar-title">
                Main Navigation
            </div>

            <a href="/Dashboard/Index" class="active">
                <i class="bi bi-grid-fill"></i>
                <span>Dashboard</span>
            </a>

            <a href="/Employee/Index">
                <i class="bi bi-people-fill"></i>
                <span>Employees</span>
            </a>

            <a href="/Department/Index">
                <i class="bi bi-diagram-3-fill"></i>
                <span>Departments</span>
            </a>
            <a href="/Designation/Index">
                <i class="bi bi-diagram-3-fill"></i>
                <span>Designation</span>
            </a>

            <a href="/Attendance/Index">
                <i class="bi bi-calendar-check-fill"></i>
                <span>Attendance</span>
            </a>

            <a href="/Leave/Index">
                <i class="bi bi-calendar2-week-fill"></i>
                <span>Leave Management</span>
            </a>

            <a href="/Payroll/Index">
                <i class="bi bi-cash-stack"></i>
                <span>Payroll</span>
            </a>

            <a href="/Recruitment/Index">
                <i class="bi bi-person-workspace"></i>
                <span>Recruitment</span>
            </a>

            <a href="/Performance/Index">
                <i class="bi bi-bar-chart-fill"></i>
                <span>Performance</span>
            </a>

            <a href="/Reports/Index">
                <i class="bi bi-file-earmark-bar-graph-fill"></i>
                <span>Reports</span>
            </a>

            <a href="/Settings/Index">
                <i class="bi bi-gear-fill"></i>
                <span>Settings</span>
            </a>

        </div>

    </aside>

    <!-- ================= MAIN CONTENT ================= -->

    <main class="main-content">

        <!-- ================= TOPBAR ================= -->

        <header class="topbar">

            <div class="topbar-left">

                <!-- MOBILE MENU -->
                <button class="menu-toggle" id="menuToggle">
                    <i class="bi bi-list"></i>
                </button>

                <!-- PAGE TITLE -->
                <h4 class="page-title">
                    @pageTitle
                </h4>

            </div>

            <div class="topbar-right">

                <!-- SEARCH -->
                <div class="search-box">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           class="form-control"
                           placeholder="Search employee, payroll, department..." />

                </div>

                <!-- NOTIFICATION -->
                <div class="notification-box">
                    <i class="bi bi-bell-fill"></i>
                    <span class="notification-count">5</span>
                </div>

                <!-- PROFILE -->
                <div class="dropdown profile-box">

                    <a href="#"
                           class="d-flex align-items-center text-decoration-none"
                           data-bs-toggle="dropdown">

                        <img src="https://i.pravatar.cc/150?img=12" />

                        <div class="ms-2 d-none d-md-block">
                            <h6>Admin User</h6>
                            <small>HR Manager</small>
                        </div>

                    </a>

                    <ul class="dropdown-menu dropdown-menu-end shadow border-0">

                        <li>
                            <a class="dropdown-item" href="#">
                                <i class="bi bi-person me-2"></i>
                                My Profile
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item" href="#">
                                <i class="bi bi-gear me-2"></i>
                                Settings
                            </a>
                        </li>

                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item text-danger" href="#">
                                <i class="bi bi-box-arrow-right me-2"></i>
                                Logout
                            </a>
                        </li>

                    </ul>

                </div>

            </div>

        </header>

        <!-- ================= PAGE CONTENT ================= -->

        <section class="page-content">

            @RenderBody()
            @await RenderSectionAsync("Scripts",required: false)
        </section>

    </main>

    <!-- ================= SCRIPTS ================= -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        // ================= MOBILE SIDEBAR =================

        const menuToggle = document.getElementById('menuToggle');
        const sidebar = document.getElementById('sidebar');

        menuToggle.addEventListener('click', function () {

        sidebar.classList.toggle('active');

        });

    </script>
    <!-- ================= SCRIPTS ================= -->

    <script>
        setTimeout(function () {

        let alerts = document.querySelectorAll('.alert');

        alerts.forEach(function (alert) {

        let bsAlert = new bootstrap.Alert(alert);

        bsAlert.close();

        });

        }, 3000);
    </script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const ctx = document.getElementById('performanceChart');

        new Chart(ctx, {
        type: 'bar',
        data: {
        labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
        datasets: [{
        label: 'Performance',
        data: [65, 78, 80, 72, 90, 95],
        borderWidth: 1,
        borderRadius: 8
        }]
        },
        options: {
        responsive: true,
        plugins: {
        legend: {
        display: false
        }
        }
        }
        });

    </script>
</body>
</html>
