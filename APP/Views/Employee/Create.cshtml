            </a>
        }
        else
        {
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light border rounded-3 px-4">
                <i class="bi bi-arrow-left"></i>
                Cancel
            </a>
        }

        <button type="submit" class="btn btn-primary rounded-3 px-4" id="btnSaveEmployee">
            <i class="bi bi-check-circle"></i>
            <span id="btnSaveEmployeeText">@(isEdit ? "Update" : "Save Employee")</span>
        </button>

    </div>
</form>

@section Scripts {
    <script>

        @if (TempData["Success"] != null)
        {
            <text>
                swal({
                    title: '@(isEdit ? "Employee Updated Successfully" : "Employee Created Successfully")',
                    text: '@Html.Raw(TempData["Success"])',
                    type: 'success',
                    confirmButtonColor: '#66BB6A'
                });
            </text>
        }

        @if (TempData["Error"] != null)
        {
            <text>
                swal({
                    title: 'Something went wrong',
                    text: '@Html.Raw(TempData["Error"])',
                    type: 'error',
                    confirmButtonColor: '#EF5350'
                });
            </text>
        }

        // =====================================================================
        // Employee Code duplicate validation (blur-triggered, debounced)
        // =====================================================================
        // Reuses the existing jQuery Unobtrusive Validation setup already on
        // this form (see the submit handler's `$(this).valid()` check below)
        // rather than adding a second validation system: a custom rule is
        // registered on the EmployeeCode field so the normal submit-time
        // `.valid()` call also blocks submission on a still-duplicate code,
        // and errors render into the SAME <span asp-validation-for="EmployeeCode">
        // this form already has - no new validation-message markup/CSS.
        var employeeCodeExists = false;
        var employeeCodeCheckXhr = null;
        var employeeCodeDebounceTimer = null;
        var lastCheckedEmployeeCode = null;
        var lastAlertedEmployeeCode = null;
        var currentEmployeeId = @Html.Raw(string.IsNullOrEmpty(Model?.Id) ? "null" : $"'{Model.Id}'");

        function setEmployeeCodeUiState(state, message) {
            var $input = $('#EmployeeCode');
            var $status = $('#employeeCodeStatus');
            var $errorSpan = $("span[data-valmsg-for='EmployeeCode']");

            $input.removeClass('is-invalid is-valid input-validation-error');
            $status.hide().text('');

            if (state === 'invalid') {
                $input.addClass('is-invalid input-validation-error');
                $errorSpan.addClass('field-validation-error').text(message || 'Employee Code already exists.');
            } else if (state === 'valid') {
                $input.addClass('is-valid');
                $errorSpan.removeClass('field-validation-error').text('');
                $status.text('✓ Employee Code is available.').show();
            } else {
                // 'checking' / 'idle' - just clear the previous state above.
                $errorSpan.removeClass('field-validation-error').text('');
            }
        }

        function checkEmployeeCode(employeeCode) {
            employeeCode = (employeeCode || '').trim();

            // Requirement 3: empty value is the required-field validator's
            // job, never the duplicate-check API's.
            if (!employeeCode) {
                employeeCodeExists = false;
                lastCheckedEmployeeCode = null;
                setEmployeeCodeUiState('idle');
                return;
            }

            // Don't re-check (or re-alert) a value that hasn't changed since
            // the last check - requirement 17.
            if (employeeCode === lastCheckedEmployeeCode) {
                return;
            }

            // Cancel any still-in-flight request for a previous value so a
            // slow stale response can never overwrite the result of a newer
            // one (requirement 11).
            if (employeeCodeCheckXhr && employeeCodeCheckXhr.readyState !== 4) {
                employeeCodeCheckXhr.abort();
            }

            $('#employeeCodeSpinner').show();
            setEmployeeCodeUiState('checking');

            employeeCodeCheckXhr = $.ajax({
                url: '@Url.Action("CheckEmployeeCode")',
                type: 'GET',
                data: {
                    employeeCode: employeeCode,
                    employeeId: currentEmployeeId
                },
                success: function (res) {
                    $('#employeeCodeSpinner').hide();

                    if (res && res.error) {
                        employeeCodeExists = false;
                        lastCheckedEmployeeCode = null;
                        setEmployeeCodeUiState('idle');
                        swal({
                            title: 'Unable to Validate Employee Code',
                            text: res.message || 'Unable to check Employee Code right now. Please try again.',
                            type: 'warning'
                        });
                        return;
                    }

                    lastCheckedEmployeeCode = employeeCode;

                    if (res && res.exists) {
                        employeeCodeExists = true;
                        setEmployeeCodeUiState('invalid', "Employee Code '" + employeeCode + "' already exists.");

                        if (lastAlertedEmployeeCode !== employeeCode) {
                            lastAlertedEmployeeCode = employeeCode;
                            swal({
                                title: 'Employee Code Already Exists',
                                text: "Employee Code '" + employeeCode + "' is already registered. Please enter a different Employee Code.",
                                type: 'warning'
                            });
                        }

                        $('html, body').animate({ scrollTop: $('#EmployeeCode').offset().top - 120 }, 200);
                        $('#EmployeeCode').trigger('focus');
                    } else {
                        employeeCodeExists = false;
                        setEmployeeCodeUiState('valid');
                    }
                },
                error: function (jqXhr) {
                    $('#employeeCodeSpinner').hide();

                    if (jqXhr.statusText === 'abort') return;

                    employeeCodeExists = false;
                    lastCheckedEmployeeCode = null;
                    setEmployeeCodeUiState('idle');
                    swal({
                        title: 'Unable to Validate Employee Code',
                        text: 'Unable to check Employee Code right now. Please try again.',
                        type: 'warning'
                    });
                }
            });
        }

        $(document).ready(function () {

            // jQuery Validate custom rule: makes the form's existing
            // `.valid()` call (already run on submit below) fail whenever
            // employeeCodeExists is true, so submission is blocked even if
            // blur somehow hasn't fired yet - requirement 12's "don't rely
            // only on the flag" is satisfied by the server re-checking in
            // EmployeeService.CreateAsync/UpdateAsync regardless.
            if ($.validator && !$.validator.methods.employeeCodeUnique) {
                $.validator.addMethod('employeeCodeUnique', function (value, element) {
                    return !employeeCodeExists;
                }, 'Employee Code already exists.');
            }

            if ($.validator) {
                $('#EmployeeCode').rules('add', {
                    employeeCodeUnique: true,
                    messages: { employeeCodeUnique: 'Employee Code already exists.' }
                });
            }

            $('#EmployeeCode').on('blur', function () {
                var value = $(this).val().trim();
                checkEmployeeCode(value);
            });

            // Debounced live check while typing (300-500ms) in addition to
            // the mandatory blur check - requirement 11.
            $('#EmployeeCode').on('input', function () {
                var $el = $(this);
                clearTimeout(employeeCodeDebounceTimer);
                employeeCodeDebounceTimer = setTimeout(function () {
                    checkEmployeeCode($el.val());
                }, 400);
            });

            // ===== Profile Photo widget: choose / preview / remove =====
            $('#btnChoosePhoto').on('click', function () {
                $('#profileImageInput').trigger('click');
            });

            $('#profileImageInput').on('change', function () {
                var file = this.files[0];
                if (!file) return;

                var allowed = ['image/jpeg', 'image/jpg', 'image/png'];
                if (allowed.indexOf(file.type) === -1) {
                    swal({ title: 'Invalid file', text: 'Only JPG and PNG images are allowed.', type: 'warning' });
                    $(this).val('');
                    return;
                }

                if (file.size > 2 * 1024 * 1024) {
                    swal({ title: 'File too large', text: 'Maximum image size is 2 MB.', type: 'warning' });
                    $(this).val('');
                    return;
                }

                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#profilePreview').attr('src', e.target.result);
                    $('#btnRemovePhoto').show();
                };
                reader.readAsDataURL(file);
            });

            $('#btnRemovePhoto').on('click', function () {
                $('#profileImageInput').val('');
                $('#profilePreview').attr('src', '@Url.Content("~/images/no-image.png")');
                $(this).hide();
            });

            if ($('#profilePreview').attr('src') && $('#profilePreview').attr('src').indexOf('no-image') === -1) {
                $('#btnRemovePhoto').show();
            }

            // ===== Collapsible sections (KYC / Passport) =====
            $('.empform-collapsible .empform-section-header').on('click', function () {
                var target = $(this).data('toggle-target');
                $(target).slideToggle(150);
                $(this).find('.toggle-icon').toggleClass('bi-chevron-down bi-chevron-up');
            });

            // ===== Prevent duplicate submission + button loading state =====
            $('#employeeForm').on('submit', function (e) {

                if ($(this).data('submitting')) {
                    e.preventDefault();
                    return false;
                }

                // Explicit client-side guard (requirement 12) - checked
                // ahead of $(this).valid() so a duplicate code always shows
                // its own SweetAlert on submit, even though the
                // employeeCodeUnique rule registered above would also block
                // .valid() from passing. This is a convenience only; the
                // real authority is EmployeeService.CreateAsync/UpdateAsync
                // re-checking on the server (requirement 13).
                if (employeeCodeExists) {
                    e.preventDefault();
                    swal({
                        title: 'Employee Code Already Exists',
                        text: 'Please enter a different Employee Code before saving.',
                        type: 'warning'
                    });
                    $('html, body').animate({ scrollTop: $('#EmployeeCode').offset().top - 120 }, 200);
                    $('#EmployeeCode').trigger('focus');
                    return false;
                }

                if ($.validator && !$(this).valid()) {
                    // Let jQuery Validate show inline messages and focus
                    // the first invalid field - do not disable the button.
                    var $firstError = $('.input-validation-error, .is-invalid').first();
                    if ($firstError.length) {
                        $('html, body').animate({ scrollTop: $firstError.offset().top - 120 }, 300);
                        $firstError.focus();
                    }
                    return true;
                }

                $(this).data('submitting', true);
                $('#btnSaveEmployee').prop('disabled', true);
                $('#btnSaveEmployeeText').text('@(isEdit ? "Updating Employee..." : "Saving Employee...")');
            });

            // ===== Company -> Branch, Department -> Designation cascades =====
            $(document).on('change', '#CompanyId', function () {
                var companyId = $(this).val();

                if (!companyId) {
                    $('#BranchId').html('<option value="">-- Select Branch --</option>');
                    return;
                }

                $.ajax({
                    url: '@Url.Action("GetBranchByCompanyId")',
                    type: 'GET',
                    data: { companyId: companyId },
                    success: function (response) {
                        var html = '<option value="">-- Select Branch --</option>';
                        $.each(response, function (i, item) {
                            html += '<option value="' + item.value + '">' + item.text + '</option>';
                        });
                        $('#BranchId').html(html);
                    },
                    error: function () {
                        swal({ title: 'Something went wrong', text: 'Unable to load branches. Please try again.', type: 'error' });
                    }
                });
            });

            $(document).on('change', '#DepartmentId', function () {
                var departmentId = $(this).val();

                if (!departmentId) {
                    $('#DesignationId').html('<option value="">-- Select Designation --</option>');
                    return;
                }

                $.ajax({
                    url: '@Url.Action("GetDesignationByDepartmentId")',
                    type: 'GET',
                    data: { departmentId: departmentId },
                    success: function (response) {
                        var html = '<option value="">-- Select Designation --</option>';
                        $.each(response, function (i, item) {
                            html += '<option value="' + item.value + '">' + item.text + '</option>';
                        });
                        $('#DesignationId').html(html);
                    },
                    error: function () {
                        swal({ title: 'Something went wrong', text: 'Unable to load designations. Please try again.', type: 'error' });
                    }
                });
            });

        });

    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
