
@model EmployeeDto

@{
    ViewData["Title"] = "Employee";

    // This form is shared by admin Add/Edit and by a self-service
    // employee's "Edit My Profile" (reached only via Employee/Edit, never
    // Create, for a non-admin). ViewBag.IsAdmin is set by the controller;
    // default true so nothing changes for the existing admin flows if a
    // caller ever forgets to set it.
    bool isAdmin = ViewBag.IsAdmin ?? true;

    // Server-side enforcement lives in EmployeeController.Edit(POST) - this
    // is only about not showing/letting a self-service user touch fields
    // that will be ignored (or rejected) anyway.
    string lockedAttr = isAdmin ? "" : "disabled";
}

<div class="panel panel-flat">
    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-user position-left"></i>

            @(string.IsNullOrEmpty(Model?.Id)
                    ? "Create Employee"
                    : (isAdmin ? "Edit Employee" : "Edit My Profile"))

        </h5>

        <div class="heading-elements">

            @if (isAdmin)
            {
                <a asp-action="Index"
                   class="btn btn-default">

                    <i class="icon-arrow-left13"></i>
                    Back

                </a>
            }
            else
            {
                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-default">

                    <i class="icon-arrow-left13"></i>
                    Back to My Profile

                </a>
            }
        </div>

    </div>
    <div class="panel-body">

        @if (!isAdmin)
        {
            <div class="alert alert-info alert-styled-left mb-15">
                <span class="text-semibold">Only your contact details can be updated here.</span>
                Everything else on this page is shown for reference - contact HR/Admin if it needs to change.
            </div>
        }

        <form asp-action="@(Model.Id == null ? "Create" : "Edit")"
              asp-controller="Employee"
              method="post" enctype="multipart/form-data">
            <div class="row">

                <div class="col-md-4">

                    <div class="form-group">

                        <label class="text-semibold">

                            Profile Image

                        </label>

                        <input type="file"
                               name="UploadImage"
                               class="form-control"
                               accept="image/*" />

                    </div>

                </div>

                <div class="col-md-4">

                    @if (!string.IsNullOrEmpty(Model?.FilePath))
                    {
                        <img src="@Model.FilePath"
                             id="profilePreview"
                             class="img-responsive"
                             style="width:150px;height:150px;object-fit:cover;margin:auto;" />

                        <input asp-for="FilePath"
                               type="hidden" />
                    }
                    else
                    {
                        <img id="profilePreview"
                             src="~/images/no-image.png"
                             class="img-responsive"
                             style="width:150px;height:150px;margin:auto;" />
                    }

                </div>

            </div>

            <div class="panel panel-flat">

                <div class="panel-heading">
                    <h6 class="panel-title">
                        <i class="icon-user position-left"></i>
                        Personal Information
                    </h6>
                </div>

                <div class="panel-body">

                    <div class="row">

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="EmployeeCode"
                                       class="text-semibold">
                                </label>

                                <input asp-for="EmployeeCode"
                                       class="form-control"
                                       placeholder="Enter Employee Code"
                                       disabled="@(isAdmin ? null : "disabled")" />

                                <span asp-validation-for="EmployeeCode"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="FirstName"
                                       class="text-semibold">
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control"
                                       placeholder="Enter First Name"
                                       disabled="@(isAdmin ? null : "disabled")" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="LastName"
                                       class="text-semibold">
                                </label>

                                <input asp-for="LastName"
                                       class="form-control"
                                       placeholder="Enter Last Name"
                                       disabled="@(isAdmin ? null : "disabled")" />

                                <span asp-validation-for="LastName"
                                      class="text-danger"></span>

                            </div>

                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="DateOfBirth"
                                       class="text-semibold">
                                </label>

                                <input asp-for="DateOfBirth"
                                       type="date"
                                       class="form-control"
                                       disabled="@(isAdmin ? null : "disabled")" />

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="Gender"
                                       class="text-semibold">
                                </label>

                                <select asp-for="Gender"
                                        asp-items="Html.GetEnumSelectList<EnumExtensions.Gender>()"
                                        class="form-control"
                                        disabled="@(isAdmin ? null : "disabled")">

                                    <option value="">
                                        Select Gender
                                    </option>

                                </select>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="MaritalStatus"
                                       class="text-semibold">
                                </label>

                                <select asp-for="MaritalStatus"
                                        asp-items="Html.GetEnumSelectList<EnumExtensions.MaritalStatus>()"
                                        class="form-control"
                                        disabled="@(isAdmin ? null : "disabled")">

                                    <option value="">
                                        Select Marital Status
                                    </option>

                                </select>

                            </div>

                        </div>

                    </div>

                </div>

            </div>
            <div class="panel panel-flat">
                <div class="panel-heading">

                    <h6 class="panel-title">
                        <i class="icon-phone position-left"></i>
                        Contact Details
                    </h6>

                </div>

                <div class="panel-body">

                    <!-- Contact Information -->

                    <div class="row">

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="Email"
                                       class="text-semibold">
                                </label>

                                <input asp-for="Email"
                                       class="form-control"
                                       placeholder="Enter Email Address"
                                       disabled="@(isAdmin ? null : "disabled")" />

                                <span asp-validation-for="Email"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="Phone"
                                       class="text-semibold">
                                </label>

                                <input asp-for="Phone"
                                       class="form-control"
                                       placeholder="Enter Mobile Number" />

                                <span asp-validation-for="Phone"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="EmergencyContact"
                                       class="text-semibold">
                                </label>

                                <input asp-for="EmergencyContact"
                                       class="form-control"
                                       placeholder="Enter Emergency Contact" />

                                <span asp-validation-for="EmergencyContact"
                                      class="text-danger"></span>

                            </div>

                        </div>

                    </div>

                    <!-- Verification -->

                    <div class="row">

                        <div class="col-md-3">

                            <div class="checkbox">

                                <label>

                                    <input asp-for="EmailConfirmed"
                                           type="checkbox"
                                           disabled="@(isAdmin ? null : "disabled")" />

                                    Email Verified

                                </label>

                            </div>

                        </div>

                        <div class="col-md-3">

                            <div class="checkbox">

                                <label>

                                    <input asp-for="PhoneConfirmed"
                                           type="checkbox"
                                           disabled="@(isAdmin ? null : "disabled")" />

                                    Mobile Verified

                                </label>

                            </div>

                        </div>

                    </div>

                    <hr />

                    <!-- Address -->

                    <div class="row">

                        <div class="col-md-8">

                            <div class="form-group">

                                <label asp-for="Address"
                                       class="text-semibold">
                                </label>

                                <textarea asp-for="Address"
                                          rows="4"
                                          class="form-control"
                                          placeholder="Enter Complete Address">
                                        </textarea>

                                <span asp-validation-for="Address"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="Pincode"
                                       class="text-semibold">
                                </label>

                                <input asp-for="Pincode"
                                       class="form-control"
                                       placeholder="Enter Pincode" />

                                <span asp-validation-for="Pincode"
                                      class="text-danger"></span>

                            </div>

                        </div>

                    </div>

                </div>
            </div>
            <div class="panel panel-flat">
                <div class="panel-heading">

                    <h6 class="panel-title">
                        <i class="icon-office position-left"></i>
                        Organization Details
                    </h6>

                </div>

                <div class="panel-body">

                    <!-- Row 1 -->

                    <div class="row">

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="RoleId"
                                       class="text-semibold">
                                </label>

                                <select asp-for="RoleId"
                                        asp-items="ViewBag.RoleList"
                                        class="form-control"
                                        disabled="@(isAdmin ? null : "disabled")">

                                    <option value="">
                                        Select Role
                                    </option>

                                </select>

                                <span asp-validation-for="RoleId"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="CompanyId"
                                       class="text-semibold">
                                </label>

                                <select asp-for="CompanyId"
                                        asp-items="ViewBag.CompanyList"
                                        class="form-control"
                                        id="CompanyId"
                                        disabled="@(isAdmin ? null : "disabled")">

                                    <option value="">
                                        Select Company
                                    </option>

                                </select>

                                <span asp-validation-for="CompanyId"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="BranchId"
                                       class="text-semibold">
                                </label>

                                <select asp-for="BranchId"
                                        asp-items="ViewBag.BranchList"
                                        class="form-control"
                                        id="BranchId"
                                        disabled="@(isAdmin ? null : "disabled")">

                                    <option value="">
                                        Select Branch
                                    </option>

                                </select>

                                <span asp-validation-for="BranchId"
                                      class="text-danger"></span>

                            </div>

                        </div>

                    </div>

                    <!-- Row 2 -->

                    <div class="row">

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="DepartmentId"
                                       class="text-semibold">
                                </label>

                                <select asp-for="DepartmentId"
                                        asp-items="ViewBag.DepartmentList"
                                        class="form-control"
                                        id="DepartmentId"
                                        disabled="@(isAdmin ? null : "disabled")">

                                    <option value="">
                                        Select Department
                                    </option>

                                </select>

                                <span asp-validation-for="DepartmentId"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="DesignationId"
                                       class="text-semibold">
                                </label>

                                <select asp-for="DesignationId"
                                        asp-items="ViewBag.DesignationList"
                                        class="form-control"
                                        id="DesignationId"
                                        disabled="@(isAdmin ? null : "disabled")">

                                    <option value="">
                                        Select Designation
                                    </option>

                                </select>

                                <span asp-validation-for="DesignationId"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="ReportingManagerId"
                                       class="text-semibold">
                                </label>

                                <select asp-for="ReportingManagerId"
                                        asp-items="ViewBag.ReportingManagerList"
                                        class="form-control"
                                        disabled="@(isAdmin ? null : "disabled")">

                                    <option value="">
                                        Select Reporting Manager
                                    </option>

                                </select>

                                <span asp-validation-for="ReportingManagerId"
                                      class="text-danger"></span>

                            </div>

                        </div>

                    </div>

                    <!-- Row 3 -->

                    <div class="row">

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="ShiftId"
                                       class="text-semibold">
                                </label>

                                <select asp-for="ShiftId"
                                        asp-items="ViewBag.ShiftList"
                                        class="form-control"
                                        disabled="@(isAdmin ? null : "disabled")">

                                    <option value="">
                                        Select Shift
                                    </option>

                                </select>

                                <span asp-validation-for="ShiftId"
                                      class="text-danger"></span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>
            <div class="panel panel-flat">
                <div class="panel-heading">

                    <h6 class="panel-title">
                        <i class="icon-vcard position-left"></i>
                        KYC & Identity Verification
                    </h6>

                </div>

                <div class="panel-body">

                    <div class="row">

                        <!-- PAN Number -->

                        <div class="col-md-6">

                            <div class="form-group">

                                <label asp-for="PANNumber"
                                       class="text-semibold">
                                </label>

                                <input asp-for="PANNumber"
                                       class="form-control text-uppercase"
                                       placeholder="ABCDE1234F"
                                       maxlength="10"
                                       disabled="@(isAdmin ? null : "disabled")" />

                                <span asp-validation-for="PANNumber"
                                      class="text-danger"></span>

                                <small class="text-muted">
                                    Example: ABCDE1234F
                                </small>

                            </div>

                        </div>

                        <!-- Aadhar Number -->

                        <div class="col-md-6">

                            <div class="form-group">

                                <label asp-for="AadharNumber"
                                       class="text-semibold">
                                </label>

                                <input asp-for="AadharNumber"
                                       class="form-control"
                                       maxlength="12"
                                       placeholder="123412341234"
                                       disabled="@(isAdmin ? null : "disabled")" />

                                <span asp-validation-for="AadharNumber"
                                      class="text-danger"></span>

                                <small class="text-muted">
                                    Enter 12 digit Aadhaar Number
                                </small>

                            </div>

                        </div>

                    </div>
                </div>
            </div>
            <!-- Passport Information -->

            <div class="panel panel-flat">

                <div class="panel-heading">

                    <h6 class="panel-title">

                        <i class="icon-airplane3 position-left"></i>
                        Passport Information

                    </h6>

                </div>

                <div class="panel-body">

                    <fieldset disabled="@(isAdmin ? null : "disabled")">

                    <!-- Row 1 -->

                    <div class="row">

                        <!-- Passport Number -->

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="PassportNumber"
                                       class="text-semibold"></label>

                                <input asp-for="PassportNumber"
                                       class="form-control text-uppercase"
                                       placeholder="Enter Passport Number" />

                                <span asp-validation-for="PassportNumber"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <!-- Nationality -->

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="Nationality"
                                       class="text-semibold"></label>

                                <select asp-for="Nationality"
                                        asp-items="Html.GetEnumSelectList<EnumExtensions.Nationality>()"
                                        class="form-control">
                                </select>

                                <span asp-validation-for="Nationality"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <!-- Passport Status -->

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="PassportStatus"
                                       class="text-semibold"></label>

                                <select asp-for="PassportStatus"
                                        asp-items="Html.GetEnumSelectList<EnumExtensions.PassportStatus>()"
                                        class="form-control">
                                </select>

                                <span asp-validation-for="PassportStatus"
                                      class="text-danger"></span>

                            </div>

                        </div>

                    </div>

                    <!-- Row 2 -->

                    <div class="row">

                        <!-- Issue Date -->

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="IssueDate"
                                       class="text-semibold"></label>

                                <input asp-for="IssueDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="IssueDate"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <!-- Expiry Date -->

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="ExpiryDate"
                                       class="text-semibold"></label>

                                <input asp-for="ExpiryDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="ExpiryDate"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <!-- Place Of Issue -->

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="PlaceOfIssue"
                                       class="text-semibold"></label>

                                <input asp-for="PlaceOfIssue"
                                       class="form-control"
                                       placeholder="Enter Place Of Issue" />

                                <span asp-validation-for="PlaceOfIssue"
                                      class="text-danger"></span>

                            </div>

                        </div>

                    </div>

                    <!-- Row 3 -->

                    <div class="row">

                        <!-- Passport Issuing Country -->

                        <div class="col-md-6">

                            <div class="form-group">

                                <label asp-for="CountryId"
                                       class="text-semibold"></label>

                                <select asp-for="CountryId"
                                        asp-items="ViewBag.CountryList"
                                        class="form-control">

                                    <option value="">
                                        Select Country
                                    </option>

                                </select>

                                <span asp-validation-for="CountryId"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <!-- Upload Passport -->

                        <div class="col-md-6">

                            <div class="form-group">

                                <label asp-for="UploadPassport"
                                       class="text-semibold"></label>

                                <input asp-for="UploadPassport"
                                       type="file"
                                       class="form-control"
                                       accept=".pdf,.jpg,.jpeg,.png" />

                                <span asp-validation-for="UploadPassport"
                                      class="text-danger"></span>

                            </div>

                        </div>

                    </div>

                    <!-- Existing Passport Document -->
                    @if (!string.IsNullOrWhiteSpace(Model.PassportFilePath))
                    {
                        <hr />

                        <div class="row">

                            <div class="col-md-12">

                                <label class="text-semibold">
                                    Existing Passport Document
                                </label>

                                <br />

                                <a href="@Model.PassportFilePath"
                                   target="_blank"
                                   class="btn btn-primary">

                                    <i class="icon-file-eye"></i>

                                    View Passport

                                </a>

                                <input asp-for="PassportFilePath"
                                       type="hidden" />

                            </div>

                        </div>
                    }

                    </fieldset>

                </div>

            </div>
            <div class="panel panel-flat">
                <div class="panel-heading">

                    <h6 class="panel-title">
                        <i class="icon-briefcase position-left"></i>
                        Employment Details
                    </h6>

                </div>

                <div class="panel-body">

                    <fieldset disabled="@(isAdmin ? null : "disabled")">

                    <!-- Employment Dates -->

                    <div class="row">

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="JoiningDate"
                                       class="text-semibold">
                                </label>

                                <input asp-for="JoiningDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="JoiningDate"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="ConfirmationDate"
                                       class="text-semibold">
                                </label>

                                <input asp-for="ConfirmationDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="ConfirmationDate"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="RelievingDate"
                                       class="text-semibold">
                                </label>

                                <input asp-for="RelievingDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="RelievingDate"
                                      class="text-danger"></span>

                            </div>

                        </div>

                      

                    </div>

                    <hr />

                    <!-- Additional Employment Information -->

                    <div class="row">
                        <div class="col-md-4">

                            <div class="form-group">

                                <label asp-for="EmploymentType"
                                       class="text-semibold">
                                </label>

                                <select asp-for="EmploymentType"
                                        asp-items="Html.GetEnumSelectList<EnumExtensions.EmploymentType>()"
                                        class="form-control">

                                    <option value="">
                                        Select Employment Type
                                    </option>

                                </select>

                                <span asp-validation-for="EmploymentType"
                                      class="text-danger"></span>

                            </div>

                        </div>
                        <div class="col-md-4">

                            <div class="form-group">

                                <label class="text-semibold">
                                    Employee Status
                                </label>

                                <select name="EmployeeStatus"
                                        class="form-control">

                                    <option value="Active">Active</option>
                                    <option value="Inactive">Inactive</option>
                                    <option value="Resigned">Resigned</option>
                                    <option value="Terminated">Terminated</option>

                                </select>

                            </div>

                        </div>
                    </div>

                    </fieldset>

                </div>

            </div><!-- Buttons -->
            <div class="text-end fa-align-right">

                @if (isAdmin)
                {
                    <a asp-action="Index"
                       class="btn btn-light border rounded-3 px-4">

                        <i class="bi bi-arrow-left"></i>
                        Back

                    </a>
                }
                else
                {
                    <a asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="btn btn-light border rounded-3 px-4">

                        <i class="bi bi-arrow-left"></i>
                        Cancel

                    </a>
                }

                <button type="submit"
                        class="btn btn-primary rounded-3 px-4">

                    <i class="bi bi-check-circle"></i>

                    @(string.IsNullOrEmpty(Model?.Id)
                        ? "Save"
                        : "Update")

                </button>

            </div>
        </form>
    </div>
</div>
@section Scripts {
    <script>

        @if (TempData["Success"] != null)
        {
                    <text>
                            swal({
                                title: 'Success',
                                text: '@Html.Raw(TempData["Success"])',
                                type: 'success',
                                confirmButtonColor: '#66BB6A'
                            });
                    </text>
        }

        @if (TempData["Error"] != null)
        {
                    <text>
                            swal({
                                title: 'Error',
                                text: '@Html.Raw(TempData["Error"])',
                                type: 'error',
                                confirmButtonColor: '#EF5350'
                            });
                    </text>
        }

    </script>
    <script>

        $(document).ready(function () {

            $("input[name='UploadImage']").change(function () {

                var file = this.files[0];

                if (file) {

                    var reader = new FileReader();

                    reader.onload = function (e) {

                        $("#profilePreview")
                            .attr("src", e.target.result);

                    };

                    reader.readAsDataURL(file);
                }

            });

        });

    </script>
        <script>

        $(document).ready(function () {

        // =========================================
        // COMPANY CHANGE -> LOAD BRANCH
        // =========================================

        $(document).on("change", "#CompanyId", function () {

        debugger;

        let companyId = $(this).val();

        console.log(companyId);

        // Reset Branch Dropdown
        if (companyId == null || companyId === "") {

        $("#BranchId").html(
        '<option value="">-- Select Branch --</option>'
        );

        return;
        }

        $.ajax({

        url: '@Url.Action("GetBranchByCompanyId")',

        type: 'GET',

        data: { companyId: companyId },

        success: function (response) {

        let html =
        '<option value="">-- Select Branch --</option>';

        $.each(response, function (i, item) {

        html += `
        <option value="${item.value}">
        ${item.text}
        </option>`;
        });

        $("#BranchId").html(html);
        },

        error: function (xhr) {

        console.log(xhr);

        alert("Error loading branches");
        }
        });

        });


        // =========================================
        // DEPARTMENT CHANGE -> LOAD DESIGNATION
        // =========================================

        $(document).on("change", "#DepartmentId", function () {

        debugger;

        let departmentId = $(this).val();

        console.log(departmentId);

        // Reset Designation Dropdown
        if (departmentId == null || departmentId === "") {

        $("#DesignationId").html(
        '<option value="">-- Select Designation --</option>'
        );

        return;
        }

        $.ajax({

        url: '@Url.Action("GetDesignationByDepartmentId")',

        type: 'GET',

        data: { departmentId: departmentId },

        success: function (response) {

        let html =
        '<option value="">-- Select Designation --</option>';

        $.each(response, function (i, item) {

        html += `
        <option value="${item.value}">
        ${item.text}
        </option>`;
        });

        $("#DesignationId").html(html);
        },

        error: function (xhr) {

        console.log(xhr);

        alert("Error loading designations");
        }
        });

        });

        });

    </script>

