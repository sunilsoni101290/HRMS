 
@model EmployeeDto

@{
    ViewData["Title"] = "Employee";
}

<div class="container-fluid py-4">

    <div class="card shadow border-0 rounded-4">

        <!-- Header -->
        <div class="card-header bg-primary text-white py-3 rounded-top-4">

            <div class="d-flex align-items-center">

                <i class="bi bi-people-fill fs-3 me-2"></i>

                <h4 class="mb-0">
                    @(string.IsNullOrEmpty(Model?.Id)
                        ? "Create Employee"
                        : "Edit Employee")
                </h4>

            </div>

        </div>

        <!-- Body -->
        <div class="card-body p-4">

            <form asp-action="@(Model.Id == null ? "Create" : "Edit")"
                  asp-controller="Employee"
                  method="post">

                <input asp-for="Id" type="hidden" />
                <input asp-for="TenantId" type="hidden" />

                <!-- Personal Information -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">

                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            Personal Information
                        </h5>
                    </div>

                    <div class="card-body">

                        <div class="row g-4">

                            <div class="col-md-4">

                                <label asp-for="FirstName" class="form-label"></label>

                                <input asp-for="FirstName"
                                       class="form-control"
                                       placeholder="Enter First Name" />

                                <span asp-validation-for="FirstName" class="text-danger"></span>

                            </div>

                            <div class="col-md-4">

                                <label asp-for="LastName" class="form-label"></label>

                                <input asp-for="LastName"
                                       class="form-control"
                                       placeholder="Enter Last Name" />

                            </div>

                            <div class="col-md-4">

                                <label asp-for="DateOfBirth" class="form-label"></label>

                                <input asp-for="DateOfBirth"
                                       type="date"
                                       class="form-control" />

                            </div>

                            <div class="col-md-4">

                                <label asp-for="Gender" class="form-label"></label>

                                <select asp-for="Gender"
                                        asp-items="Html.GetEnumSelectList<EnumExtensions.Gender>()"
                                        class="form-select">

                                    <option value="">
                                        -- Select Gender --
                                    </option>

                                </select>

                            </div>

                            <div class="col-md-4">

                                <label asp-for="MaritalStatus" class="form-label"></label>

                                <select asp-for="MaritalStatus"
                                        asp-items="Html.GetEnumSelectList<EnumExtensions.MaritalStatus>()"
                                        class="form-select">

                                    <option value="">
                                        -- Select Marital Status --
                                    </option>

                                </select>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Organization Details -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">

                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            Organization Details
                        </h5>
                    </div>

                    <div class="card-body">

                        <div class="row g-4">

                            <div class="col-md-4">

                                <label asp-for="CompanyId" class="form-label"></label>

                                <select asp-for="CompanyId"
                                        asp-items="ViewBag.CompanyList"
                                        class="form-select">

                                    <option value="">
                                        -- Select Company --
                                    </option>

                                </select>

                            </div>

                            <div class="col-md-4">

                                <label asp-for="BranchId" class="form-label"></label>

                                <select asp-for="BranchId"
                                        asp-items="ViewBag.BranchList"
                                        class="form-select">

                                    <option value="">
                                        -- Select Branch --
                                    </option>

                                </select>

                            </div>

                            <div class="col-md-4">

                                <label asp-for="DepartmentId" class="form-label"></label>

                                <select asp-for="DepartmentId"
                                        asp-items="ViewBag.DepartmentList"
                                        class="form-select">

                                    <option value="">
                                        -- Select Department --
                                    </option>

                                </select>

                            </div>

                            <div class="col-md-4">

                                <label asp-for="DesignationId" class="form-label"></label>

                                <select asp-for="DesignationId"
                                        asp-items="ViewBag.DesignationList"
                                        class="form-select">

                                    <option value="">
                                        -- Select Designation --
                                    </option>

                                </select>

                            </div>

                            <div class="col-md-4">

                                <label asp-for="ReportingManagerId" class="form-label"></label>

                                <select asp-for="ReportingManagerId"
                                        asp-items="ViewBag.ReportingManagerList"
                                        class="form-select">

                                    <option value="">
                                        -- Select Reporting Manager --
                                    </option>

                                </select>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Contact Details -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">

                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            Contact Details
                        </h5>
                    </div>

                    <div class="card-body">

                        <div class="row g-4">

                            <div class="col-md-4">

                                <label asp-for="Email" class="form-label"></label>

                                <input asp-for="Email"
                                       class="form-control"
                                       placeholder="Enter Email" />

                            </div>

                            <div class="col-md-4">

                                <label asp-for="Phone" class="form-label"></label>

                                <input asp-for="Phone"
                                       class="form-control"
                                       placeholder="Enter Phone Number" />

                            </div>

                            <div class="col-md-4">

                                <label asp-for="EmergencyContact" class="form-label"></label>

                                <input asp-for="EmergencyContact"
                                       class="form-control"
                                       placeholder="Enter Emergency Contact" />

                            </div>

                            <div class="col-md-8">

                                <label asp-for="Address" class="form-label"></label>

                                <textarea asp-for="Address"
                                          class="form-control"
                                          rows="3"></textarea>

                            </div>

                            <div class="col-md-4">

                                <label asp-for="Pincode" class="form-label"></label>

                                <input asp-for="Pincode"
                                       class="form-control"
                                       placeholder="Enter Pin Code" />

                            </div>

                        </div>

                    </div>

                </div>

                <!-- KYC Details -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">

                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            KYC Details
                        </h5>
                    </div>

                    <div class="card-body">

                        <div class="row g-4">

                            <div class="col-md-6">

                                <label asp-for="PANNumber" class="form-label"></label>

                                <input asp-for="PANNumber"
                                       class="form-control"
                                       placeholder="Enter PAN Number" />

                            </div>

                            <div class="col-md-6">

                                <label asp-for="AadharNumber" class="form-label"></label>

                                <input asp-for="AadharNumber"
                                       class="form-control"
                                       placeholder="Enter Aadhar Number" />

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Employment Details -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">

                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            Employment Details
                        </h5>
                    </div>

                    <div class="card-body">

                        <div class="row g-4">

                            <div class="col-md-3">

                                <label asp-for="JoiningDate" class="form-label"></label>

                                <input asp-for="JoiningDate"
                                       type="date"
                                       class="form-control" />

                            </div>

                            <div class="col-md-3">

                                <label asp-for="ConfirmationDate" class="form-label"></label>

                                <input asp-for="ConfirmationDate"
                                       type="date"
                                       class="form-control" />

                            </div>

                            <div class="col-md-3">

                                <label asp-for="RelievingDate" class="form-label"></label>

                                <input asp-for="RelievingDate"
                                       type="date"
                                       class="form-control" />

                            </div>

                            <div class="col-md-3">

                                <label asp-for="EmploymentType" class="form-label"></label>

                                <select asp-for="EmploymentType"
                                        asp-items="Html.GetEnumSelectList<EnumExtensions.EmploymentType>()"
                                        class="form-select">

                                    <option value="">
                                        -- Select Employment Type --
                                    </option>

                                </select>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Buttons -->
                <div class="text-end">

                    <a asp-action="Index"
                       class="btn btn-light border rounded-3 px-4">

                        <i class="bi bi-arrow-left"></i>
                        Back

                    </a>

                    <button type="submit"
                            class="btn btn-primary rounded-3 px-4">

                        <i class="bi bi-check-circle"></i>

                        @(string.IsNullOrEmpty(Model?.Id)
                            ? "Save"
                            : "Update")

                    </button>

                </div>
                <div class="col-md-6">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show"
                             role="alert">

                            <i class="bi bi-check-circle-fill"></i>

                            @TempData["Success"]

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert">
                            </button>
                        </div>
                    }
                </div>
            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}