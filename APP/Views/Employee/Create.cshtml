 
@model EmployeeDto

@{
    ViewData["Title"] = "Employee";
}

<div class="container-fluid mt-4">

    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="mb-0">
                @(Model.Id == null
                    ? "Add New Employee"
                    : "Update Employee")
            </h4>
        </div>

        <div class="card-body">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="TenantId" />

            <form asp-action="@(Model.Id == null ? "Create" : "Edit")"
                  asp-controller="Employee"
                  method="post">

                <div class="row">

                    <!-- First Name -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <!-- Last Name -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>

                    <!-- Gender -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="Gender" class="form-label"></label>
                        <select asp-for="Gender"
                                asp-items="Html.GetEnumSelectList<EnumExtensions.Gender>()"
                                class="form-select">
                            <option value="">Select Gender</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>

                    <!-- Marital Status -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="MaritalStatus" class="form-label"></label>
                        <select asp-for="MaritalStatus"
                                asp-items="Html.GetEnumSelectList<EnumExtensions.MaritalStatus>()"
                                class="form-select">
                            <option value="">Select Marital Status</option>
                        </select>
                        <span asp-validation-for="MaritalStatus" class="text-danger"></span>
                    </div>

                    <!-- DOB -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="DateOfBirth" class="form-label"></label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>

                    <!-- Joining Date -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="JoiningDate" class="form-label"></label>
                        <input asp-for="JoiningDate" type="date" class="form-control" />
                        <span asp-validation-for="JoiningDate" class="text-danger"></span>
                    </div>

                    <!-- Company -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="CompanyId" class="form-label"></label>
                        <select asp-for="CompanyId"
                                asp-items="ViewBag.CompanyList"
                                class="form-select">
                            <option value="">Select Company</option>
                        </select>
                        <span asp-validation-for="CompanyId" class="text-danger"></span>
                    </div>

                    <!-- Department -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="DepartmentId" class="form-label"></label>
                        <select asp-for="DepartmentId"
                                asp-items="ViewBag.DepartmentList"
                                class="form-select">
                            <option value="">Select Department</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger"></span>
                    </div>

                    <!-- Designation -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="DesignationId" class="form-label"></label>
                        <select asp-for="DesignationId"
                                asp-items="ViewBag.DesignationList"
                                class="form-select">
                            <option value="">Select Designation</option>
                        </select>
                        <span asp-validation-for="DesignationId" class="text-danger"></span>
                    </div>

                    <!-- Reporting Manager -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="ReportingManagerId" class="form-label"></label>
                        <select asp-for="ReportingManagerId"
                                asp-items="ViewBag.ReportingManagerList"
                                class="form-select">
                            <option value="">Select Reporting Manager</option>
                        </select>
                    </div>

                    <!-- Employment Type -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="EmploymentType" class="form-label"></label>
                        <select asp-for="EmploymentType"
                                asp-items="Html.GetEnumSelectList<EnumExtensions.EmploymentType>()"
                                class="form-select">
                            <option value="">Select Employment Type</option>
                        </select>
                        <span asp-validation-for="EmploymentType" class="text-danger"></span>
                    </div>

                    <!-- Email -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- Phone -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <!-- Emergency Contact -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="EmergencyContact" class="form-label"></label>
                        <input asp-for="EmergencyContact" class="form-control" />
                    </div>

                    <!-- PAN -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="PANNumber" class="form-label"></label>
                        <input asp-for="PANNumber" class="form-control" />
                        <span asp-validation-for="PANNumber" class="text-danger"></span>
                    </div>

                    <!-- Aadhar -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="AadharNumber" class="form-label"></label>
                        <input asp-for="AadharNumber" class="form-control" />
                        <span asp-validation-for="AadharNumber" class="text-danger"></span>
                    </div>

                    <!-- Pincode -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="Pincode" class="form-label"></label>
                        <input asp-for="Pincode" class="form-control" />
                        <span asp-validation-for="Pincode" class="text-danger"></span>
                    </div>

                    <!-- Address -->
                    <div class="col-md-12 mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <textarea asp-for="Address"
                                  class="form-control"
                                  rows="3"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <!-- Confirmation Date -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="ConfirmationDate" class="form-label"></label>
                        <input asp-for="ConfirmationDate"
                               type="date"
                               class="form-control" />
                    </div>

                    <!-- Relieving Date -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="RelievingDate" class="form-label"></label>
                        <input asp-for="RelievingDate"
                               type="date"
                               class="form-control" />
                    </div>

                </div>

                <div class="mt-3">
                    <button type="submit"
                            class="btn btn-primary">

                        @(Model.Id == null
                            ? "Save"
                            : "Update")

                    </button>

                    <a asp-action="Index"
                           class="btn btn-secondary">
                        Back
                    </a>
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show"
                             role="alert">

                            <i class="bi bi-check-circle-fill"></i>

                            @TempData["Success"]

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert">
                            </button>
                        </div>
                    }

                    
                    @* @if (TempData["Warning"] != null)
                    {
                        <div class="alert alert-warning alert-dismissible fade show"
                             role="alert">

                            <i class="bi bi-exclamation-triangle-fill"></i>

                            @TempData["Warning"]

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert">
                            </button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show"
                             role="alert">

                            <i class="bi bi-x-circle-fill"></i>

                            @TempData["Error"]

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert">
                            </button>
                        </div>
                    }

                    @if (TempData["Info"] != null)
                    {
                        <div class="alert alert-info alert-dismissible fade show"
                             role="alert">

                            <i class="bi bi-info-circle-fill"></i>

                            @TempData["Info"]

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert">
                            </button>
                        </div>
                    } *@
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}