
@model EmployeeDto

@{
    ViewData["Title"] = "Employee";

    // This form is shared by admin Add/Edit and by a self-service
    // employee's "Edit My Profile" (reached only via Employee/Edit, never
    // Create, for a non-admin). ViewBag.IsAdmin is set by the controller;
    // default true so nothing changes for the existing admin flows if a
    // caller ever forgets to set it.
    bool isAdmin = ViewBag.IsAdmin ?? true;

    // Server-side enforcement lives in EmployeeController.Edit(POST) - this
    // is only about not showing/letting a self-service user touch fields
    // that will be ignored (or rejected) anyway.
    string lockedAttr = isAdmin ? "" : "disabled";

    bool isEdit = !string.IsNullOrEmpty(Model?.Id);
}

@* Page-local styling removed - "empform-*" classes now live in the shared
   wwwroot/css/design-system.css (loaded once in _LayoutMain.cshtml), moved
   verbatim (identical selectors/rules) so this is pure deduplication - no
   markup, field names, binding, or validation changed below. *@

<div class="empform-header">
    <div>
        <h4>@(isEdit ? (isAdmin ? "Edit Employee" : "Edit My Profile") : "Create Employee")</h4>
        <p>Manage employee personal, contact and employment information</p>
    </div>

    <div>
        @if (isAdmin)
        {
            <a asp-action="Index" class="btn btn-default">
                <i class="icon-arrow-left13 position-left"></i>
                Back to List
            </a>
        }
        else
        {
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-default">
                <i class="icon-arrow-left13 position-left"></i>
                Back to My Profile
            </a>
        }
    </div>
</div>

@if (!isAdmin)
{
    <div class="alert alert-info alert-styled-left mb-15">
        <span class="text-semibold">Only your contact details can be updated here.</span>
        Everything else on this page is shown for reference - contact HR/Admin if it needs to change.
    </div>
}

@if (ViewBag.FromCandidate ?? false)
{
    <div class="alert alert-info alert-styled-left mb-15">
        <span class="text-semibold">Creating employee record from selected candidate.</span>
        Onboarding will start automatically once this employee is saved.
    </div>
}

<form id="employeeForm"
      asp-action="@(Model.Id == null ? "Create" : "Edit")"
      asp-controller="Employee"
      method="post" enctype="multipart/form-data" novalidate>

    <input type="hidden" asp-for="CandidateId" />
    <input type="hidden" asp-for="Id" />

    <div class="row">

        <div class="col-md-3">

            <div class="empform-photo-card">

                <div class="empform-photo-frame">
                    @if (!string.IsNullOrEmpty(Model?.FilePath))
                    {
                        <img src="@Model.FilePath" id="profilePreview" alt="Profile Photo" />
                        <input asp-for="FilePath" type="hidden" />
                    }
                    else
                    {
                        <img src="~/images/no-image.png" id="profilePreview" alt="Profile Photo" />
                    }
                </div>

                <input type="file" name="UploadImage" id="profileImageInput"
                       accept="image/jpeg,image/jpg,image/png" style="display:none;" />

                <div class="empform-photo-actions">
                    <button type="button" class="btn btn-default" id="btnChoosePhoto">
                        <i class="icon-upload3 position-left"></i>
                        Upload Photo
                    </button>
                    <button type="button" class="btn btn-link text-danger" id="btnRemovePhoto" style="display:none;">
                        Remove
                    </button>
                </div>

                <div class="empform-photo-hint">JPG or PNG • Max 2 MB</div>

            </div>

        </div>

        <div class="col-md-9">

            <!-- ========================================================
                 SECTION 1: Basic Information
                 ======================================================== -->
            <div class="empform-section">
                <div class="empform-section-header">
                    <i class="icon-user"></i>
                    <h6>Basic Information</h6>
                </div>

                <div class="empform-section-body">
                    <div class="row">

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="EmployeeCode" class="text-semibold empform-required"></label>
                                <div style="position:relative;">
                                    <input asp-for="EmployeeCode" class="form-control" placeholder="Enter Employee Code"
                                           autocomplete="off"
                                           disabled="@(isAdmin ? null : "disabled")" />
                                    <i id="employeeCodeSpinner" class="icon-spinner2 spinner"
                                       style="display:none; position:absolute; right:10px; top:9px; color:#9aa0ac;"></i>
                                </div>
                                <span asp-validation-for="EmployeeCode" class="text-danger"></span>
                                <small id="employeeCodeStatus" class="text-success" style="display:none;"></small>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="FirstName" class="text-semibold empform-required"></label>
                                <input asp-for="FirstName" class="form-control" placeholder="Enter First Name"
                                       disabled="@(isAdmin ? null : "disabled")" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="LastName" class="text-semibold"></label>
                                <input asp-for="LastName" class="form-control" placeholder="Enter Last Name"
                                       disabled="@(isAdmin ? null : "disabled")" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="DateOfBirth" class="text-semibold"></label>
                                <input asp-for="DateOfBirth" type="date" class="form-control"
                                       disabled="@(isAdmin ? null : "disabled")" />
                                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Gender" class="text-semibold empform-required"></label>
                                <select asp-for="Gender" asp-items="Html.GetEnumSelectList<EnumExtensions.Gender>()"
