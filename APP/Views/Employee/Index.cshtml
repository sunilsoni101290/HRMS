@model IEnumerable<EmployeeListDto>

@{
    ViewData["Title"] = "Employees";
}

@* Page-local styling removed - now uses the shared design system
   (wwwroot/css/design-system.css, loaded once in _LayoutMain.cshtml).
   .emplist-* classes below map 1:1 to .ent-* equivalents, so this is a
   pure rename with identical visual result - no markup, JS, or behavior
   changed. *@

<div class="ent-page-header">
    <div>
        <h4>Employees <span class="ent-count-badge" id="employeeCount">@(Model?.Count() ?? 0)</span></h4>
        <p>Manage employee records, personal information and employment details</p>
    </div>

    <div class="ent-page-header-actions">
        <a asp-controller="SalaryTemplate" asp-action="Assign" class="btn btn-default" title="Apply a reusable salary structure to one or more employees">
            <i class="icon-cash position-left"></i>
            Assign Salary Structure
        </a>

        <a asp-action="Import" class="btn btn-default">
            <i class="icon-file-excel position-left"></i>
            Import
        </a>

        <a id="btnExport" href="#" class="btn btn-default" title="Export the employees currently shown below (respects Search/Department/Designation/Status filters)">
            <i class="icon-file-download position-left"></i>
            Export
        </a>

        <a asp-action="Create" class="btn bg-primary">
            <i class="icon-plus22 position-left"></i>
            Add Employee
        </a>
    </div>
</div>

<div class="ent-filter-card">
    <div class="row">
        <div class="col-md-3">
            <div class="form-group">
                <label>Search</label>
                <input type="text" id="filterSearch" class="form-control"
                       placeholder="Name, code, mobile or email..." />
            </div>
        </div>

        <div class="col-md-2">
            <div class="form-group">
                <label>Department</label>
                <select id="filterDepartment" class="form-control">
                    <option value="">All Departments</option>
                </select>
            </div>
        </div>

        <div class="col-md-2">
            <div class="form-group">
                <label>Designation</label>
                <select id="filterDesignation" class="form-control">
                    <option value="">All Designations</option>
                </select>
            </div>
        </div>

        <div class="col-md-2">
            <div class="form-group">
                <label>Status</label>
                <select id="filterStatus" class="form-control">
                    <option value="">All</option>
                    <option value="active">Active</option>
                    <option value="relieved">Relieved</option>
                </select>
            </div>
        </div>

        <div class="col-md-3">
            <label>&nbsp;</label>
            <div class="form-group" style="display:flex; gap:8px;">
                <button type="button" id="btnClearFilters" class="btn btn-default btn-block">
                    <i class="icon-cross2 position-left"></i>
                    Clear Filters
                </button>
            </div>
        </div>
    </div>
</div>

<div class="ent-list-card">

    <div class="table-responsive">
        <table class="table ent-list-table datatable-basic" id="employeeDataTable">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>Designation</th>
                    <th>Mobile</th>
                    <th>Email</th>
                    <th>Joining Date</th>
                    <th>Status</th>
                    <th width="140">Action</th>
                </tr>
            </thead>

            <tbody id="employeeTableBody">

                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        bool isActive = !item.RelievingDate.HasValue;
                        var fullName = $"{item.FirstName} {item.LastName}".Trim();
                        var initials = string.Concat(
                        (item.FirstName?.Length > 0 ? item.FirstName[0].ToString() : ""),
                        (item.LastName?.Length > 0 ? item.LastName[0].ToString() : "")).ToUpper();

                        <tr class="employee-row"
                            data-search="@($"{fullName} {item.EmployeeCode} {item.Phone} {item.Email}".ToLower())"
                            data-department="@item.DepartmentName"
                            data-designation="@item.DesignationName"
                            data-status="@(isActive ? "active" : "relieved")">

                            <td>
                                <div class="ent-name-cell">

                                    @if (!string.IsNullOrEmpty(item.FilePath))
                                    {
                                        <img src="@item.FilePath" class="ent-avatar" alt="@fullName" />
                                    }
                                    else
                                    {
                                        <span class="ent-avatar-initials">@(string.IsNullOrWhiteSpace(initials) ? "?" : initials)</span>
                                    }

                                    <div>
                                        <div class="ent-name-primary">@fullName</div>
                                        <div class="ent-name-secondary">@item.EmployeeCode</div>
                                    </div>

                                </div>
                            </td>

                            <td>@(item.DepartmentName ?? "-")</td>
                            <td>@(item.DesignationName ?? "-")</td>
                            <td>@(item.Phone ?? "-")</td>
                            <td>@(item.Email ?? "-")</td>
                            <td>@(item.JoiningDate?.ToString("dd-MMM-yyyy") ?? "-")</td>

                            <td>
                                @if (isActive)
                                {
                                    <span class="ent-status-pill ent-badge-success"><i class="icon-checkmark3"></i> Active</span>
                                }
                                else
                                {
                                    <span class="ent-status-pill ent-badge-danger"><i class="icon-cross2"></i> Relieved</span>
                                }
                            </td>

                            <td class="ent-row-actions">
                                <div class="btn-group">

                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-default btn-icon" data-popup="tooltip" title="View Details">
                                        <i class="icon-eye"></i>
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-primary btn-icon" data-popup="tooltip" title="Edit">
                                        <i class="icon-pencil7"></i>
                                    </a>

                                    <button type="button"
                                            class="btn btn-danger btn-icon btn-delete-employee"
                                            data-id="@item.Id"
                                            data-name="@fullName"
                                            data-popup="tooltip" title="Delete">
                                        <i class="icon-trash"></i>
                                    </button>

                                </div>
                            </td>

                        </tr>
                    }
                }

            </tbody>
        </table>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="ent-empty-state">
            <i class="icon-users"></i>
            <h6>No Employees Found</h6>
            <p>Get started by adding your first employee record.</p>
            <a asp-action="Create" class="btn bg-primary" style="margin-top:8px;">
                <i class="icon-plus22 position-left"></i>
                Add Employee
            </a>
        </div>
    }

    <div id="noResultsRow" class="ent-empty-state" style="display:none;">
        <i class="icon-search4"></i>
        <h6>No Matching Employees</h6>
        <p>Try adjusting your search or filters.</p>
    </div>

</div>

@section Scripts {

    <script>
        $(function () {

            // Populate Department/Designation filters from the rendered rows
            // themselves - no extra API call needed, this data is already
            // on the page.
            var deptSet = {}, desigSet = {};

            $('#employeeTableBody .employee-row').each(function () {
                var dept = $(this).data('department');
                var desig = $(this).data('designation');
                if (dept) deptSet[dept] = true;
                if (desig) desigSet[desig] = true;
            });

            Object.keys(deptSet).sort().forEach(function (d) {
                $('#filterDepartment').append('<option value="' + d + '">' + d + '</option>');
            });

            Object.keys(desigSet).sort().forEach(function (d) {
                $('#filterDesignation').append('<option value="' + d + '">' + d + '</option>');
            });

            function applyFilters() {
                var search = $('#filterSearch').val().toLowerCase().trim();
                var dept = $('#filterDepartment').val();
                var desig = $('#filterDesignation').val();
                var status = $('#filterStatus').val();

                var visibleCount = 0;

                $('#employeeTableBody .employee-row').each(function () {
                    var $row = $(this);

                    var matchesSearch = !search || ($row.data('search') + '').indexOf(search) !== -1;
                    var matchesDept = !dept || $row.data('department') === dept;
                    var matchesDesig = !desig || $row.data('designation') === desig;
                    var matchesStatus = !status || $row.data('status') === status;

                    var visible = matchesSearch && matchesDept && matchesDesig && matchesStatus;

                    $row.toggle(visible);

                    if (visible) visibleCount++;
                });

                $('#employeeCount').text(visibleCount);
                $('#noResultsRow').toggle(visibleCount === 0 && $('#employeeTableBody .employee-row').length > 0);
            }

            // Export always reflects whatever the admin currently sees -
            // the link's querystring is rebuilt from the same four filter
            // inputs applyFilters() reads, and EmployeeController.Export
            // applies the identical matching rules server-side so the
            // downloaded file and the on-screen list can never disagree.
            function updateExportLink() {
                var params = new URLSearchParams();

                var search = $('#filterSearch').val().trim();
                var dept = $('#filterDepartment').val();
                var desig = $('#filterDesignation').val();
                var status = $('#filterStatus').val();

                if (search) params.set('search', search);
                if (dept) params.set('department', dept);
                if (desig) params.set('designation', desig);
                if (status) params.set('status', status);

                var qs = params.toString();
                $('#btnExport').attr('href', '@Url.Action("Export")' + (qs ? '?' + qs : ''));
            }

            $('#filterSearch').on('keyup', function () { applyFilters(); updateExportLink(); });
            $('#filterDepartment, #filterDesignation, #filterStatus').on('change', function () { applyFilters(); updateExportLink(); });

            $('#btnClearFilters').on('click', function () {
                $('#filterSearch').val('');
                $('#filterDepartment').val('');
                $('#filterDesignation').val('');
                $('#filterStatus').val('');
                applyFilters();
                updateExportLink();
            });

            updateExportLink();

            // Delete - confirmation before any destructive action, no
            // immediate navigation on click.
            $(document).on('click', '.btn-delete-employee', function () {
                var id = $(this).data('id');
                var name = $(this).data('name');
                var deleteUrl = '@Url.Action("Delete", "Employee")/' + id;

                swal({
                    title: 'Are you sure?',
                    text: 'You are about to delete "' + name + '". This action cannot be undone.',
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#EF5350',
                    confirmButtonText: 'Delete Employee',
                    cancelButtonText: 'Cancel',
                    closeOnConfirm: false
                }, function (isConfirm) {
                    if (!isConfirm) return;

                    window.location.href = deleteUrl;
                });
            });

            @if (TempData["Success"] != null)
            {
                <text>
                    swal({
                        title: 'Success',
                        text: '@Html.Raw(TempData["Success"])',
                        type: 'success',
                        confirmButtonColor: '#66BB6A'
                    });
                </text>
            }

            @if (TempData["Error"] != null)
            {
                <text>
                    swal({
                        title: 'Something went wrong',
                        text: '@Html.Raw(TempData["Error"])',
                        type: 'error',
                        confirmButtonColor: '#EF5350'
                    });
                </text>
            }
        });
    </script>


    <script>
        // Auto-added: client-side pagination for this Index page's listing
        // table (DataTables). Safe to run even if this page already
        // initializes '.datatable-basic' itself above - 'retrieve: true'
        // makes DataTables return the existing instance instead of
        // re-initializing (and throwing) when that's the case.
        $(document).ready(function () {
            if ($.fn.DataTable) {
                var __indexDataTable = $('.datatable-basic').DataTable({
                    autoWidth: false,
                    paging: true,
                    ordering: true,
                    searching: true,
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                    language: { search: "_INPUT_", searchPlaceholder: "Search..." },
                    retrieve: true
                });
            }
        });
    </script>
}
