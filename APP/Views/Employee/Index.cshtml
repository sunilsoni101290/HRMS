@model IEnumerable<EmployeeListDto>

<div class="panel panel-flat">
    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-users position-left"></i>

            Employee Management

        </h5>

        <div class="heading-elements">

            <a asp-action="Create"
               class="btn bg-primary">

                <i class="icon-plus22"></i>
                Add Employee

            </a>

        </div>

    </div>

    <div class="panel-body">

        <div class="row">

            <div class="col-md-4">

                <input type="text"
                       id="searchInput"
                       class="form-control"
                       placeholder="Search Employee..." />

            </div>

        </div>

    </div>

    <table
           class="table table-bordered table-striped table-hover datatable-basic">

        <thead>

            <tr>

                <th width="50">#</th>
                <th>Photo</th>
                <th>Employee Code</th>
                <th>Employee Name</th>
                <th>Company</th>
                <th>Department</th>
                <th>Designation</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Joining Date</th>
                <th width="180">Action</th>

            </tr>

        </thead>

        <tbody id="employeeTable">

            @{
                int sr = 1;
            }

            @foreach (var item in Model)
            {
                <tr>

                    <td>@sr</td>

                    <td>

                        @if (!string.IsNullOrEmpty(item.FilePath))
                        {
                            <img src="@item.FilePath"
                                 class="img-circle"
                                 style="width:40px;height:40px;object-fit:cover;" />
                        }
                        else
                        {
                            <img src="~/images/no-image.png"
                                 class="img-circle"
                                 style="width:40px;height:40px;" />
                        }

                    </td>

                    <td>

                        <span class="label bg-primary">
                            @item.EmployeeCode
                        </span>

                    </td>

                    <td>

                        <strong>
                            @item.FirstName @item.LastName
                        </strong>

                    </td>

                    <td>@item.CompanyName</td>

                    <td>@item.DepartmentName</td>

                    <td>@item.DesignationName</td>

                    <td>@item.Phone</td>

                    <td>@item.Email</td>

                    <td>
                        @(item.JoiningDate?.ToString("dd-MMM-yyyy"))
                    </td>

                    <td>

                        <div class="btn-group">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-default btn-icon"
                               data-popup="tooltip"
                               title="Details">

                                <i class="icon-eye"></i>

                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-primary btn-icon"
                               data-popup="tooltip"
                               title="Edit">

                                <i class="icon-pencil7"></i>

                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-danger btn-icon btnDelete"
                               data-popup="tooltip"
                               title="Delete">

                                <i class="icon-trash"></i>

                            </a>

                        </div>

                    </td>

                </tr>

                sr++;
            }

        </tbody>

    </table>
</div>

@section Scripts {

    <script>

        document.getElementById("searchInput")
            .addEventListener("keyup", function () {

                let value = this.value.toLowerCase();

                let rows = document.querySelectorAll("#employeeTable tr");

                rows.forEach(function (row) {

                    let text = row.innerText.toLowerCase();

                    row.style.display =
                        text.includes(value) ? "" : "none";

                });

            });

    </script>

}