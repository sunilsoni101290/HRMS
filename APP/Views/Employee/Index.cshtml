@model IEnumerable<APP.Models.DTOs.EmployeeListDto>
@using APP.Helpers

@{
    ViewData["Title"] = "Employee";
}
<link href="~/css/form-style.css" rel="stylesheet" />

<!-- ================= EMPLOYEE PAGE ================= -->

<div class="employee-page">

    <!-- ================= PAGE HEADER ================= -->

    <div class="employee-header">

        <div>

            <h2>@ViewData["Title"]</h2>

            <p>
                Manage your workforce and employee records
            </p>

        </div>

        <a asp-action="Create" asp-controller="Employee"  class="btn btn-add-employee">

            <i class="bi bi-person-plus"></i>

            Add Employee

        </a>

    </div>

    <!-- ================= FILTER SECTION ================= -->

    <div class="employee-toolbar">

        <!-- SEARCH -->
        <div class="search-box-custom">

            <i class="bi bi-search"></i>

            <input type="text"
                   placeholder="Search employees..." />

        </div>

        <!-- FILTER -->
        <button class="btn toolbar-btn">

            <i class="bi bi-funnel"></i>

            Filter

        </button>

        <!-- EXPORT -->
        <button class="btn toolbar-btn">

            <i class="bi bi-download"></i>

            Export

        </button>

    </div>

    <!-- ================= TABLE CARD ================= -->

    <div class="employee-table-card">

        <div class="table-responsive">

            <table class="table employee-table align-middle">

                <!-- TABLE HEAD -->
                <thead>

                    <tr>

                        <th>EMPLOYEE</th>
                        <th>DEPARTMENT</th>
                        <th>DESIGNATION</th>
                        <th>STATUS</th>
                        <th>REPORTING MANAGER</th>
                        <th>JOINED</th>
                        <th class="text-center">ACTIONS</th>
                    </tr>

                </thead>

                <!-- TABLE BODY -->
                <tbody>

                    <!-- ROW -->
                    @{
                        if(Model!=null && Model.Count() > 0)
                        {
                            foreach (var emp in Model)
                            {
                                <tr>

                                    <td>

                                        <div class="employee-info">

                                            <div class="employee-avatar blue-avatar">
                                                @NameHelper.GetNamePrefix(emp.FirstName,emp.LastName)
                                            </div>

                                            <div>

                                                <h6>@emp.FirstName @Html.Raw(" ") @emp.LastName</h6>

                                                <span>@emp.EmployeeCode</span>

                                            </div>

                                        </div>

                                    </td>

                                    <td>@emp.DepartmentName</td>

                                    <td>@emp.DesignationName</td>

                                    <td>
                                        <span class="status-badge active-status">
                                            Active
                                        </span>
                                    </td>

                                    <td>@emp.ReportingManagerName+</td>

                                    <td>@emp.JoiningDate?.ToString("MMM dd,yyyy")</td>

                                    <td>

                                        <div class="action-buttons">
                                            <a asp-action="Detail"
                                                   asp-controller="Employee"
                                                   asp-route-id="@emp.Id"
                                                   title="View">

                                                <i class="bi bi-eye"></i>

                                            </a>
                                            <a asp-action="Edit"
                                                   asp-controller="Employee"
                                                   asp-route-id="@emp.Id"
                                                   title="Edit">

                                                <i class="bi bi-pencil-square"></i>

                                            </a>

                                            <a href="#">
                                                <i class="bi bi-trash"></i>
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
