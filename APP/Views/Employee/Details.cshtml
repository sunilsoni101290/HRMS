    @* =====================================================
       UPLOAD PROFILE IMAGE MODAL
       ===================================================== *@

    <div class="modal fade" id="uploadPhotoModal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">

                <form asp-action="UploadProfilePhoto"
                      asp-controller="Employee"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bi bi-camera position-left"></i>
                            Upload Profile Image
                        </h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>

                    <div class="modal-body text-center">

                        <img id="uploadPhotoPreview"
                             src="@(string.IsNullOrEmpty(Model.FilePath) ? Url.Content("~/images/no-image.png") : Model.FilePath)" />

                        <div class="form-group text-left">
                            <label class="text-semibold">Choose an image (JPG, JPEG, PNG - max 2 MB)</label>
                            <input type="file"
                                   name="profilePhoto"
                                   id="profilePhotoInput"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png"
                                   required />
                        </div>

                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn bg-primary">
                            <i class="bi bi-upload"></i>
                            Upload
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>

    @section Scripts {
        @* Success/error messages are already shown by _AlertMessage in
           _EmployeeLayout.cshtml (reads the same TempData keys this
           controller sets) - no separate alert here needed. *@
        <script>
            $(function () {
                $('#profilePhotoInput').on('change', function (e) {
                    var file = e.target.files && e.target.files[0];
                    if (!file) return;

                    var reader = new FileReader();
                    reader.onload = function (ev) {
                        $('#uploadPhotoPreview').attr('src', ev.target.result);
                    };
                    reader.readAsDataURL(file);
                });
            });
        </script>
    }
}
