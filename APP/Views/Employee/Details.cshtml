@model EmployeeListDto

@{
    // This same view doubles as the org-wide "Employee Details" screen for
    // admin/HR (unchanged tabbed layout, Edit button) and as the
    // read-only "My Profile" screen for a self-service employee (modern
    // card layout below, no editing anywhere except the photo). The Back
    // button must not send a self-service user to the admin employee list
    // (Employee/Index) - they have no access to it.
    bool isAdmin = ViewBag.IsAdmin ?? true;
}

@if (isAdmin)
{
    <style>
        .empdetail-hero {
            background: linear-gradient(120deg, #1b2a4a, #22365f 60%, #2b4270);
            border-radius: 12px;
            padding: 28px 28px 24px;
            color: #fff;
            box-shadow: 0 8px 24px rgba(20,30,60,.16);
            margin-bottom: 20px;
        }

        .empdetail-toolbar {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-bottom: 14px;
        }

        .empdetail-photo {
            width: 96px;
            height: 96px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid rgba(255,255,255,.85);
            box-shadow: 0 4px 14px rgba(0,0,0,.25);
            background: #fff;
        }

        .empdetail-name {
            font-size: 20px;
            font-weight: 700;
            margin: 0 0 2px;
        }

        .empdetail-role {
            color: #c7d3ea;
            font-size: 13px;
            margin-bottom: 10px;
        }

        .empdetail-code {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(255,255,255,.12);
            border: 1px solid rgba(255,255,255,.25);
            padding: 3px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .empdetail-quickinfo {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 16px;
        }

        .empdetail-quickinfo .qi-pill {
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.18);
            border-radius: 8px;
            padding: 7px 14px;
            font-size: 12px;
            display: flex;
            align-items: center;
            gap: 7px;
            color: #e8edf7;
        }

        .empdetail-quickinfo .qi-pill i {
            font-size: 14px;
            opacity: .85;
        }

        .empdetail-tabs {
            border: none;
            gap: 6px;
            margin-bottom: 0;
        }

        .empdetail-tabs > li {
            margin-bottom: 0;
        }

        .empdetail-tabs > li > a {
            border: 1px solid #e5e9f2 !important;
            border-radius: 8px !important;
            margin-right: 6px;
            color: #5b6680;
            font-size: 13px;
            font-weight: 500;
            padding: 9px 16px;
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .empdetail-tabs > li.active > a,
        .empdetail-tabs > li.active > a:hover,
        .empdetail-tabs > li.active > a:focus {
            background: #4e9cff !important;
            border-color: #4e9cff !important;
            color: #fff !important;
        }

        .empdetail-section-body {
            background: #fff;
            border: 1px solid #eef0f4;
            border-top: none;
            border-radius: 0 0 10px 10px;
            padding: 20px 22px 6px;
        }

        .empdetail-field {
            display: flex;
            gap: 12px;
            margin-bottom: 18px;
        }

        .empdetail-field-icon {
            flex-shrink: 0;
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: #eaf2ff;
            color: #4e9cff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }

        .empdetail-field-label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .4px;
            color: #9aa5b8;
            font-weight: 600;
            margin-bottom: 2px;
        }

        .empdetail-field-value {
            font-size: 13.5px;
            color: #2c3548;
            font-weight: 500;
            word-break: break-word;
        }
    </style>

    <div class="empdetail-toolbar">

        <a asp-action="Index" class="btn btn-default">
            <i class="icon-arrow-left13"></i>
            Back
        </a>

        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn bg-primary">
            <i class="icon-pencil7"></i>
            Edit
        </a>

    </div>

    <div class="empdetail-hero">

        <div class="row">

            <div class="col-md-3 text-center">

                @if (!string.IsNullOrEmpty(Model.FilePath))
                {
                    <img src="@Model.FilePath" class="empdetail-photo" alt="@Model.FirstName @Model.LastName" />
                }
                else
                {
                    <img src="~/images/no-image.png" class="empdetail-photo" alt="@Model.FirstName @Model.LastName" />
                }

            </div>

            <div class="col-md-9">

                <div class="empdetail-name">@Model.FirstName @Model.LastName</div>

                <div class="empdetail-role">
                    @(string.IsNullOrWhiteSpace(Model.DesignationName) ? "Employee" : Model.DesignationName)
                    @(string.IsNullOrWhiteSpace(Model.DepartmentName) ? "" : " · " + Model.DepartmentName)
                </div>

                <span class="empdetail-code">
                    <i class="bi bi-person-badge"></i>
                    @Model.EmployeeCode
                </span>

                <div class="empdetail-quickinfo">

                    <div class="qi-pill">
                        <i class="bi bi-building"></i>
                        @(string.IsNullOrWhiteSpace(Model.CompanyName) ? "-" : Model.CompanyName)
                    </div>

                    <div class="qi-pill">
                        <i class="bi bi-signpost-split"></i>
                        @(string.IsNullOrWhiteSpace(Model.BrnachName) ? "-" : Model.BrnachName)
                    </div>

                    <div class="qi-pill">
                        <i class="bi bi-envelope"></i>
                        @(string.IsNullOrWhiteSpace(Model.Email) ? "-" : Model.Email)
                    </div>

                    <div class="qi-pill">
                        <i class="bi bi-telephone"></i>
                        @(string.IsNullOrWhiteSpace(Model.Phone) ? "-" : Model.Phone)
                    </div>

                </div>

            </div>

        </div>

    </div>

    <ul class="nav nav-tabs empdetail-tabs">
        <li class="active">
            <a href="#personal" data-toggle="tab">
                <i class="bi bi-person-vcard"></i>
                Personal
            </a>
        </li>

        <li>
            <a href="#organization" data-toggle="tab">
                <i class="bi bi-diagram-3"></i>
                Organization
            </a>
        </li>

        <li>
            <a href="#contact" data-toggle="tab">
                <i class="bi bi-telephone-outbound"></i>
                Contact
            </a>
        </li>

        <li>
            <a href="#kyc" data-toggle="tab">
                <i class="bi bi-shield-check"></i>
                KYC
            </a>
        </li>
        <li>
            <a href="#Passport" data-toggle="tab">
                <i class="bi bi-passport"></i>
                Passport
            </a>
        </li>

        <li>
            <a href="#employment" data-toggle="tab">
                <i class="bi bi-briefcase"></i>
                Employment
            </a>
        </li>
    </ul>

    <div class="tab-content">

        <div class="tab-pane active empdetail-section-body" id="personal">

            <div class="row">

                <div class="col-md-3">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-person"></i></div>
                        <div>
                            <div class="empdetail-field-label">First Name</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.FirstName) ? "-" : Model.FirstName)</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-person"></i></div>
                        <div>
                            <div class="empdetail-field-label">Last Name</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.LastName) ? "-" : Model.LastName)</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-gender-ambiguous"></i></div>
                        <div>
                            <div class="empdetail-field-label">Gender</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.Gender) ? "-" : Model.Gender)</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-cake2"></i></div>
                        <div>
                            <div class="empdetail-field-label">Date Of Birth</div>
                            <div class="empdetail-field-value">@(Model.DateOfBirth?.ToString("dd-MMM-yyyy") ?? "-")</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-heart"></i></div>
                        <div>
                            <div class="empdetail-field-label">Marital Status</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.MaritalStatus) ? "-" : Model.MaritalStatus)</div>
                        </div>
                    </div>
                </div>

            </div>

        </div>

        <div class="tab-pane empdetail-section-body" id="organization">

            <div class="row">

                <div class="col-md-3">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-building"></i></div>
                        <div>
                            <div class="empdetail-field-label">Company</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.CompanyName) ? "-" : Model.CompanyName)</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-signpost-split"></i></div>
                        <div>
                            <div class="empdetail-field-label">Branch</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.BrnachName) ? "-" : Model.BrnachName)</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-diagram-2"></i></div>
                        <div>
                            <div class="empdetail-field-label">Department</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.DepartmentName) ? "-" : Model.DepartmentName)</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-award"></i></div>
                        <div>
                            <div class="empdetail-field-label">Designation</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.DesignationName) ? "-" : Model.DesignationName)</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-person-workspace"></i></div>
                        <div>
                            <div class="empdetail-field-label">Reporting Manager</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.ReportingManagerName) ? "-" : Model.ReportingManagerName)</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-clock-history"></i></div>
                        <div>
                            <div class="empdetail-field-label">Shift</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.ShiftName) ? "-" : Model.ShiftName)</div>
                        </div>
                    </div>
                </div>

            </div>

        </div>

        <div class="tab-pane empdetail-section-body" id="contact">

            <div class="row">

                <div class="col-md-4">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-telephone"></i></div>
                        <div>
                            <div class="empdetail-field-label">Phone</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.Phone) ? "-" : Model.Phone)</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-envelope"></i></div>
                        <div>
                            <div class="empdetail-field-label">Email</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.Email) ? "-" : Model.Email)</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-person-lines-fill"></i></div>
                        <div>
                            <div class="empdetail-field-label">Emergency Contact</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.EmergencyContact) ? "-" : Model.EmergencyContact)</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-8">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-geo-alt"></i></div>
                        <div>
                            <div class="empdetail-field-label">Address</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.Address) ? "-" : Model.Address)</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-mailbox"></i></div>
                        <div>
                            <div class="empdetail-field-label">Pincode</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.Pincode) ? "-" : Model.Pincode)</div>
                        </div>
                    </div>
                </div>

            </div>

        </div>

        <div class="tab-pane empdetail-section-body" id="kyc">

            <div class="row">

                <div class="col-md-4">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-credit-card-2-front"></i></div>
                        <div>
                            <div class="empdetail-field-label">PAN Number</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.PANNumber) ? "-" : Model.PANNumber)</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-card-text"></i></div>
                        <div>
                            <div class="empdetail-field-label">Aadhar Number</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.AadharNumber) ? "-" : Model.AadharNumber)</div>
                        </div>
                    </div>
                </div>

            </div>

        </div>

        <div class="tab-pane empdetail-section-body" id="Passport">

            <div class="row">

                <div class="col-md-4">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-upc-scan"></i></div>
                        <div>
                            <div class="empdetail-field-label">Passport Number</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.PassportNumber) ? "-" : Model.PassportNumber)</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-flag"></i></div>
                        <div>
                            <div class="empdetail-field-label">Nationality</div>
                            <div class="empdetail-field-value">@Model.Nationality</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-info-circle"></i></div>
                        <div>
                            <div class="empdetail-field-label">Passport Status</div>
                            <div class="empdetail-field-value">

                                @if (Model.PassportStatus == EnumExtensions.PassportStatus.Active)
                                {
                                    <span class="label bg-success">@Model.PassportStatus</span>
                                }
                                else if (Model.PassportStatus == EnumExtensions.PassportStatus.Applied)
                                {
                                    <span class="label bg-warning">@Model.PassportStatus</span>
                                }
                                else if (Model.PassportStatus == EnumExtensions.PassportStatus.Expired ||
                                    Model.PassportStatus == EnumExtensions.PassportStatus.Cancelled)
                                {
                                    <span class="label bg-danger">@Model.PassportStatus</span>
                                }
                                else
                                {
                                    <span class="label bg-grey">@Model.PassportStatus</span>
                                }

                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-globe2"></i></div>
                        <div>
                            <div class="empdetail-field-label">Issuing Country</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.CountryName) ? "-" : Model.CountryName)</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-calendar-check"></i></div>
                        <div>
                            <div class="empdetail-field-label">Issue Date</div>
                            <div class="empdetail-field-value">@(Model.IssueDate?.ToString("dd-MMM-yyyy") ?? "-")</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-calendar-x"></i></div>
                        <div>
                            <div class="empdetail-field-label">Expiry Date</div>
                            <div class="empdetail-field-value">@(Model.ExpiryDate?.ToString("dd-MMM-yyyy") ?? "-")</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-geo"></i></div>
                        <div>
                            <div class="empdetail-field-label">Place Of Issue</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.PlaceOfIssue) ? "-" : Model.PlaceOfIssue)</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-file-earmark-pdf"></i></div>
                        <div>
                            <div class="empdetail-field-label">Passport Document</div>
                            <div class="empdetail-field-value">

                                @if (!string.IsNullOrWhiteSpace(Model.PassportFilePath))
                                {
                                    <a asp-action="ViewPassport"
                                       asp-route-employeeId="@Model.Id"
                                       target="_blank"
                                       class="btn bg-primary btn-sm">
                                        <i class="icon-file-eye"></i>
                                        View
                                    </a>

                                    <a asp-action="DownloadPassport"
                                       asp-route-employeeId="@Model.Id"
                                       download
                                       class="btn bg-success btn-sm">
                                        <i class="icon-download"></i>
                                        Download
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        <i class="icon-file-empty"></i>
                                        Not Uploaded
                                    </span>
                                }

                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>

        <div class="tab-pane empdetail-section-body" id="employment">

            <div class="row">

                <div class="col-md-3">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-box-arrow-in-right"></i></div>
                        <div>
                            <div class="empdetail-field-label">Joining Date</div>
                            <div class="empdetail-field-value">@(Model.JoiningDate?.ToString("dd-MMM-yyyy") ?? "-")</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-patch-check"></i></div>
                        <div>
                            <div class="empdetail-field-label">Confirmation Date</div>
                            <div class="empdetail-field-value">@(Model.ConfirmationDate?.ToString("dd-MMM-yyyy") ?? "-")</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-box-arrow-right"></i></div>
                        <div>
                            <div class="empdetail-field-label">Relieving Date</div>
                            <div class="empdetail-field-value">@(Model.RelievingDate?.ToString("dd-MMM-yyyy") ?? "-")</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-file-earmark-person"></i></div>
                        <div>
                            <div class="empdetail-field-label">Employment Type</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.EmploymentType) ? "-" : Model.EmploymentType)</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-envelope"></i></div>
                        <div>
                            <div class="empdetail-field-label">Email</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.Email) ? "-" : Model.Email)</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="empdetail-field">
                        <div class="empdetail-field-icon"><i class="bi bi-telephone"></i></div>
                        <div>
                            <div class="empdetail-field-label">Phone</div>
                            <div class="empdetail-field-value">@(string.IsNullOrWhiteSpace(Model.Phone) ? "-" : Model.Phone)</div>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>
}
else
{
    @* =====================================================
       MY PROFILE - self-service, fully read-only.
       Modern card-based layout. The ONLY interactive element on this
       whole page is the "Upload Profile Image" button, which opens a
       modal to replace the photo - every other field below is plain
       text, never an input.
       ===================================================== *@

    <style>
        .myprofile-hero {
            background: linear-gradient(135deg, #1b2a4a 0%, #203258 55%, #2a3f6b 100%);
            border-radius: 12px;
            padding: 36px 28px 28px;
            color: #fff;
            box-shadow: 0 8px 28px rgba(27,42,74,.18);
            margin-bottom: 22px;
        }

        .myprofile-photo-wrap {
            position: relative;
            width: 132px;
            height: 132px;
            margin: 0 auto 16px;
        }

        .myprofile-photo-wrap img {
            width: 132px;
            height: 132px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid rgba(255,255,255,.85);
            box-shadow: 0 4px 16px rgba(0,0,0,.25);
            background: #fff;
        }

        .myprofile-name {
            font-size: 21px;
            font-weight: 600;
            margin: 4px 0 2px;
            text-align: center;
        }

        .myprofile-role {
            text-align: center;
            color: #c7d3ea;
            font-size: 13.5px;
            margin-bottom: 14px;
        }

        .myprofile-code {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(255,255,255,.12);
            border: 1px solid rgba(255,255,255,.25);
            color: #fff;
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 12.5px;
