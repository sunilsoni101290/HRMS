@model EmployeeListDto

<div class="panel panel-flat">
    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-user position-left"></i>

            Employee Details

        </h5>

        <div class="heading-elements">

            <a asp-action="Index"
               class="btn btn-default">

                <i class="icon-arrow-left13"></i>
                Back

            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn bg-primary">

                <i class="icon-pencil7"></i>
                Edit

            </a>

        </div>

    </div>

    <div class="panel-body">
        <div class="row">

            <div class="col-md-3 text-center">

                @if (!string.IsNullOrEmpty(Model.FilePath))
                {
                    <img src="@Model.FilePath"
                         class="img-circle img-responsive"
                         style="width:150px;height:150px;object-fit:cover;margin:auto;" />
                }
                else
                {
                    <img src="~/images/no-image.png"
                         class="img-circle img-responsive"
                         style="width:150px;height:150px;margin:auto;" />
                }

                <h4 class="mt-15">

                    @Model.FirstName @Model.LastName

                </h4>

                <span class="label bg-primary">

                    @Model.EmployeeCode

                </span>

            </div>

            <div class="col-md-9">

                <div class="row">

                    <div class="col-md-4">

                        <div class="panel bg-primary-400">

                            <div class="panel-body">

                                <h3 class="no-margin">
                                    @Model.CompanyName
                                </h3>

                                Company

                            </div>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="panel bg-success-400">

                            <div class="panel-body">

                                <h3 class="no-margin">
                                    @Model.DepartmentName
                                </h3>

                                Department

                            </div>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="panel bg-warning-400">

                            <div class="panel-body">

                                <h3 class="no-margin">
                                    @Model.DesignationName
                                </h3>

                                Designation

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <hr />
        <ul class="nav nav-tabs nav-tabs-highlight">
            <li class="active">
                <a href="#personal" data-toggle="tab">
                    Personal Information
                </a>
            </li>

            <li>
                <a href="#organization" data-toggle="tab">
                    Organization Information
                </a>
            </li>

            <li>
                <a href="#contact" data-toggle="tab">
                    Contact Information
                </a>
            </li>

            <li>
                <a href="#kyc" data-toggle="tab">
                    KYC Information
                </a>
            </li>
            <li>
                <a href="#Passport" data-toggle="tab">
                    Passport Information
                </a>
            </li>

            <li>
                <a href="#employment" data-toggle="tab">
                    Employment Information
                </a>
            </li>
        </ul>

        <div class="tab-content">

            <div class="tab-pane active" id="personal">

                <div class="row">

                    <div class="col-md-3">
                        <label class="text-semibold">First Name</label>
                        <p>@Model.FirstName</p>
                    </div>

                    <div class="col-md-3">
                        <label class="text-semibold">Last Name</label>
                        <p>@Model.LastName</p>
                    </div>

                    <div class="col-md-3">
                        <label class="text-semibold">Gender</label>
                        <p>@Model.Gender</p>
                    </div>

                    <div class="col-md-3">
                        <label class="text-semibold">Date Of Birth</label>
                        <p>@Model.DateOfBirth?.ToString("dd-MMM-yyyy")</p>
                    </div>

                    <div class="col-md-3">
                        <label class="text-semibold">Marital Status</label>
                        <p>@Model.MaritalStatus</p>
                    </div>

                </div>

            </div>

            <div class="tab-pane" id="organization">

                <div class="row">

                    <div class="col-md-3">
                        <label class="text-semibold">Company</label>
                        <p>@Model.CompanyName</p>
                    </div>

                    <div class="col-md-3">
                        <label class="text-semibold">Branch</label>
                        <p>@Model.BrnachName</p>
                    </div>

                    <div class="col-md-3">
                        <label class="text-semibold">Department</label>
                        <p>@Model.DepartmentName</p>
                    </div>

                    <div class="col-md-3">
                        <label class="text-semibold">Designation</label>
                        <p>@Model.DesignationName</p>
                    </div>

                    <div class="col-md-3">
                        <label class="text-semibold">Reporting Manager</label>
                        <p>@Model.ReportingManagerName</p>
                    </div>

                    <div class="col-md-3">
                        <label class="text-semibold">Shift</label>
                        <p>@Model.ShiftName</p>
                    </div>

                </div>

            </div>
            <div class="tab-pane" id="contact">

                <div class="row">

                    <div class="col-md-4">
                        <label class="text-semibold">Phone</label>
                        <p>@Model.Phone</p>
                    </div>

                    <div class="col-md-4">
                        <label class="text-semibold">Email</label>
                        <p>@Model.Email</p>
                    </div>

                    <div class="col-md-4">
                        <label class="text-semibold">Emergency Contact</label>
                        <p>@Model.EmergencyContact</p>
                    </div>

                    <div class="col-md-12">
                        <label class="text-semibold">Address</label>
                        <p>@Model.Address</p>
                    </div>

                    <div class="col-md-3">
                        <label class="text-semibold">Pincode</label>
                        <p>@Model.Pincode</p>
                    </div>

                </div>

            </div>
            <div class="tab-pane" id="kyc">

                <div class="row">

                    <div class="col-md-4">
                        <label class="text-semibold">PAN Number</label>
                        <p>@Model.PANNumber</p>
                    </div>

                    <div class="col-md-4">
                        <label class="text-semibold">Aadhar Number</label>
                        <p>@Model.AadharNumber</p>
                    </div>

                </div>

            </div>
            <div class="tab-pane" id="Passport">
                <!-- Passport Information -->

                <div class="panel panel-flat">

                    <div class="panel-heading">

                        <h6 class="panel-title">

                            <i class="icon-airplane3 position-left"></i>

                            Passport Information

                        </h6>

                    </div>

                    <div class="panel-body">

                        <table class="table table-bordered table-striped">

                            <tbody>

                                <tr>

                                    <th width="250">
                                        Passport Number
                                    </th>

                                    <td>

                                        @(string.IsNullOrWhiteSpace(Model.PassportNumber)
                                            ? "-"
                                            : Model.PassportNumber)

                                    </td>

                                </tr>

                                <tr>

                                    <th>
                                        Nationality
                                    </th>

                                    <td>

                                        @Model.Nationality

                                    </td>

                                </tr>

                                <tr>

                                    <th>
                                        Passport Status
                                    </th>

                                    <td>

                                        @if (Model.PassportStatus == EnumExtensions.PassportStatus.Active)
                                        {
                                            <span class="label bg-success">
                                                @Model.PassportStatus
                                            </span>
                                        }
                                        else if (Model.PassportStatus == EnumExtensions.PassportStatus.Applied)
                                        {
                                            <span class="label bg-warning">
                                                @Model.PassportStatus
                                            </span>
                                        }
                                        else if (Model.PassportStatus == EnumExtensions.PassportStatus.Expired)
                                        {
                                            <span class="label bg-danger">
                                                @Model.PassportStatus
                                            </span>
                                        }
                                        else if (Model.PassportStatus == EnumExtensions.PassportStatus.Cancelled)
                                        {
                                            <span class="label bg-danger">
                                                @Model.PassportStatus
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="label bg-grey">
                                                @Model.PassportStatus
                                            </span>
                                        }

                                    </td>

                                </tr>

                                <tr>

                                    <th>
                                        Passport Issuing Country
                                    </th>

                                    <td>

                                        @(string.IsNullOrWhiteSpace(Model.CountryName)
                                            ? "-"
                                            : Model.CountryName)

                                    </td>

                                </tr>

                                <tr>

                                    <th>
                                        Issue Date
                                    </th>

                                    <td>

                                        @(Model.IssueDate == DateTime.MinValue
                                            ? "-"
                                            : Model.IssueDate.ToString("dd-MMM-yyyy"))

                                    </td>

                                </tr>

                                <tr>

                                    <th>
                                        Expiry Date
                                    </th>

                                    <td>

                                        @(Model.ExpiryDate == DateTime.MinValue
                                            ? "-"
                                            : Model.ExpiryDate.ToString("dd-MMM-yyyy"))

                                    </td>

                                </tr>

                                <tr>

                                    <th>
                                        Place Of Issue
                                    </th>

                                    <td>

                                        @(string.IsNullOrWhiteSpace(Model.PlaceOfIssue)
                                            ? "-"
                                            : Model.PlaceOfIssue)

                                    </td>

                                </tr>

                                <tr>

                                    <th>
                                        Passport Document
                                    </th>

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(Model.PassportFilePath))
                                        {
                                            <a asp-action="ViewPassport"
                                               asp-route-employeeId="@Model.Id"
                                               target="_blank"
                                               class="btn bg-primary btn-sm">

                                                <i class="icon-file-eye"></i>

                                                View Passport

                                            </a>

                                            <a asp-action="DownloadPassport"
                                               asp-route-employeeId="@Model.Id"
                                               download
                                               class="btn bg-success btn-sm">

                                                <i class="icon-download"></i>

                                                Download

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">

                                                <i class="icon-file-empty"></i>

                                                Not Uploaded

                                            </span>
                                        }

                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>
            </div>
            <div class="tab-pane" id="employment">

                <div class="row">

                    <div class="col-md-3">
                        <label class="text-semibold">Joining Date</label>
                        <p>@Model.JoiningDate?.ToString("dd-MMM-yyyy")</p>
                    </div>

                    <div class="col-md-3">
                        <label class="text-semibold">Confirmation Date</label>
                        <p>@Model.ConfirmationDate?.ToString("dd-MMM-yyyy")</p>
                    </div>

                    <div class="col-md-3">
                        <label class="text-semibold">Relieving Date</label>
                        <p>@Model.RelievingDate?.ToString("dd-MMM-yyyy")</p>
                    </div>

                    <div class="col-md-3">
                        <label class="text-semibold">Employment Type</label>
                        <p>@Model.EmploymentType</p>
                    </div>

                    <div class="col-md-3">
                        <label class="text-semibold">Email</label>
                        <p>
                            @Model.Email
                        </p>
                    </div>

                    <div class="col-md-3">
                        <label class="text-semibold">Phone</label>
                        <p>
                            @Model.Phone
                        </p>
                    </div>

                </div>

            </div>

        </div>
