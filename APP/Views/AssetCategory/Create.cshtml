@model AssetCategoryDto

@{
    ViewData["Title"] = "Asset Category";
}

<form asp-action="@(string.IsNullOrEmpty(Model?.Id) ? "Create" : "Edit")"
      asp-controller="AssetCategory" asp-route-id="@Model?.Id" method="post">

    <input asp-for="Id" type="hidden" />
    <input asp-for="TenantId" type="hidden" />
    <input asp-for="CreatedBy" type="hidden" />

    <div class="panel panel-flat">

        <div class="panel-heading">
            <h5 class="panel-title">
                <i class="icon-grid3 position-left"></i>
                @(string.IsNullOrEmpty(Model?.Id) ? "Create Category" : "Edit Category")
            </h5>
            <div class="heading-elements">
                <a asp-action="Index" class="btn btn-default">
                    <i class="icon-arrow-left13"></i> Back
                </a>
            </div>
        </div>

        <div class="panel-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Name"></label> <span class="text-danger">*</span>
                        <input asp-for="Name" class="form-control"
                               placeholder="e.g. Laptop, Vehicle, Furniture" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel-footer text-right">
            <button type="reset" class="btn btn-default"><i class="icon-reset"></i> Reset</button>
            <button type="submit" class="btn bg-primary">
                <i class="icon-floppy-disk"></i>
                @(string.IsNullOrEmpty(Model?.Id) ? "Save" : "Update")
            </button>
        </div>
    </div>
</form>

@section Scripts {
    @if (TempData["Success"] != null)
    {
        <script>
            $(function () {
                swal({ title: "Success", text: "@TempData["Success"]", type: "success" });
            });
        </script>
    }
    <partial name="_ValidationScriptsPartial" />
}
