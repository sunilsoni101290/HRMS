@model TaxDeclarationDto

@{
    ViewData["Title"] = "Tax Declaration Details";
    bool canAct = Model.Status == (int)EnumExtensions.TaxDeclarationStatus.Submitted;
}

<div class="panel panel-flat">

    <div class="panel-heading">
        <h5 class="panel-title">
            <i class="icon-file-text2 position-left"></i>
            Tax Declaration Details
        </h5>
        <div class="heading-elements">
            <a asp-action="Index" class="btn btn-default">
                <i class="icon-arrow-left13"></i>
                Back
            </a>
        </div>
    </div>

    <div class="panel-body">

        <dl class="dl-horizontal">
            <dt>Employee</dt>
            <dd>@Model.EmployeeName (@Model.EmployeeCode)</dd>

            <dt>Department</dt>
            <dd>@(Model.DepartmentName ?? "-")</dd>

            <dt>Financial Year</dt>
            <dd>@Model.FinancialYearName</dd>

            <dt>Regime</dt>
            <dd>@Model.RegimeName</dd>

            <dt>Status</dt>
            <dd>@Model.StatusName</dd>

            <dt>Section 80C</dt>
            <dd>@Model.Section80C.ToString("N2")</dd>

            <dt>Section 80CCD(1B)</dt>
            <dd>@Model.Section80CCD1B.ToString("N2")</dd>

            <dt>Section 80D</dt>
            <dd>@Model.Section80D.ToString("N2")</dd>

            <dt>Section 24(b)</dt>
            <dd>@Model.Section24B.ToString("N2")</dd>

            <dt>Other Deductions</dt>
            <dd>@Model.OtherDeductions.ToString("N2")</dd>

            <dt>Annual Rent Paid</dt>
            <dd>@Model.AnnualRentPaid.ToString("N2") (@(Model.IsMetroCity ? "Metro" : "Non-Metro"))</dd>

            <dt>Submitted On</dt>
            <dd>@(Model.SubmittedOn?.ToString("dd-MMM-yyyy") ?? "-")</dd>

            <dt>Verified/Rejected By</dt>
            <dd>@(Model.VerifiedByName ?? "-")</dd>

            @if (!string.IsNullOrEmpty(Model.VerifierRemarks))
            {
                <dt>Remarks</dt>
                <dd>@Model.VerifierRemarks</dd>
            }
        </dl>

        @if (canAct)
        {
            <div class="row">
                <div class="col-md-6">
                    <form asp-action="Verify" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="form-group">
                            <label>Verifier Remarks (optional)</label>
                            <textarea name="remarks" class="form-control" rows="2"></textarea>
                        </div>
                        <button type="submit" class="btn bg-success">
                            <i class="icon-checkmark3"></i>
                            Verify
                        </button>
                    </form>
                </div>

                <div class="col-md-6">
                    <form asp-action="Reject" method="post" onsubmit="return validateReject(this);">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="form-group">
                            <label>Rejection Remarks (required)</label>
                            <textarea name="remarks" class="form-control" rows="2" required></textarea>
                        </div>
                        <button type="submit" class="btn bg-danger">
                            <i class="icon-cross2"></i>
                            Reject
                        </button>
                    </form>
                </div>
            </div>
        }

    </div>

</div>

<script src="~/global_assets/js/plugins/notifications/sweet_alert.min.js"></script>

@section Scripts {

    <script>

        function validateReject(form) {
            var remarks = form.querySelector('textarea[name="remarks"]').value.trim();
            if (!remarks) {
                swal({ title: 'Error', text: 'Rejection remarks are required.', type: 'error' });
                return false;
            }
            return true;
        }

        @if (TempData["Success"] != null)
        {
            <text>
                swal({
                    title: 'Success',
                    text: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(TempData["Success"]?.ToString() ?? string.Empty)),
                    type: 'success',
                    confirmButtonColor: '#66BB6A'
                });
            </text>
        }

        @if (TempData["GlobalError"] != null)
        {
            <text>
                swal({
                    title: 'Error',
                    text: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(TempData["GlobalError"]?.ToString() ?? string.Empty)),
                    type: 'error',
                    confirmButtonColor: '#EF5350'
                });
            </text>
        }

    </script>

}
