@model IEnumerable<TaxDeclarationDto>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Tax Declarations";

    string StatusBadgeClass(int status) => status switch
    {
        (int)EnumExtensions.TaxDeclarationStatus.Draft => "bg-grey",
        (int)EnumExtensions.TaxDeclarationStatus.Submitted => "bg-warning",
        (int)EnumExtensions.TaxDeclarationStatus.Verified => "bg-success",
        (int)EnumExtensions.TaxDeclarationStatus.Rejected => "bg-danger",
        _ => "bg-grey"
    };
}

<div class="panel panel-flat">

    <div class="panel-heading">
        <h5 class="panel-title">
            <i class="icon-file-text2 position-left"></i>
            Tax Declarations
        </h5>
        <div class="heading-elements">
            <a asp-action="MyDeclaration" class="btn bg-primary">
                <i class="icon-user"></i>
                My Declaration
            </a>
        </div>
    </div>

    <div class="panel-body">

        <form asp-action="Index" method="get" class="row">

            <div class="col-md-3">
                <select name="financialYearId" class="form-control">
                    <option value="">-- All Financial Years --</option>
                    @if (ViewBag.FinancialYearList is SelectList fyList)
                    {
                        foreach (SelectListItem item in fyList)
                        {
                            <option value="@item.Value" selected="@(item.Value == (string)ViewBag.FinancialYearId)">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3">
                <select name="status" class="form-control">
                    <option value="">-- All Statuses --</option>
                    @if (ViewBag.StatusList is List<SelectListItem> statusList)
                    {
                        foreach (var item in statusList)
                        {
                            <option value="@item.Value" selected="@(item.Value == (string)ViewBag.Status)">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3">
                <select name="departmentId" class="form-control">
                    <option value="">-- All Departments --</option>
                    @if (ViewBag.DepartmentList is SelectList deptList)
                    {
                        foreach (SelectListItem item in deptList)
                        {
                            <option value="@item.Value" selected="@(item.Value == (string)ViewBag.DepartmentId)">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3">
                <button type="submit" class="btn btn-default">
                    <i class="icon-search4"></i>
                    Filter
                </button>
            </div>

        </form>

    </div>

    <div class="table-responsive">

        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>Financial Year</th>
                    <th>Regime</th>
                    <th>Status</th>
                    <th width="100">Action</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @item.EmployeeName
                                <br />
                                <span class="text-muted text-size-small">@item.EmployeeCode</span>
                            </td>
                            <td>@(item.DepartmentName ?? "-")</td>
                            <td>@item.FinancialYearName</td>
                            <td>@item.RegimeName</td>
                            <td><span class="label @StatusBadgeClass(item.Status)">@item.StatusName</span></td>
                            <td style="padding: 10px 15px;">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-default btn-icon" title="View">
                                    <i class="icon-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted" style="padding:30px;">
                            <i class="icon-file-text2" style="font-size:32px;"></i><br />
                            No Tax Declarations found.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
