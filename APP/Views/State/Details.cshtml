@model StateDto

@{
    ViewData["Title"] = "State Details";
}

<div class="panel panel-flat">

    <!-- Header -->

    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-location4 position-left"></i>

            State Details

        </h5>

        <div class="heading-elements">

            <a asp-action="Index"
               class="btn btn-default">

                <i class="icon-arrow-left13 position-left"></i>

                Back

            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn bg-primary">

                <i class="icon-pencil7 position-left"></i>

                Edit

            </a>

        </div>

    </div>

    <div class="panel-body">

        <!-- Header Card -->

        <div class="row">

            <div class="col-md-2 text-center">

                <div class="content-group">

                    <div class="icon-object border-primary text-primary"
                         style="width:100px;
                        height:100px;
                        line-height:100px;
                        font-size:42px;
                        margin:auto;">

                        <i class="icon-location4"></i>

                    </div>

                </div>

            </div>

            <div class="col-md-6">

                <h2 class="text-semibold no-margin">

                    @Model.Name

                </h2>

                <br />

                <span class="label bg-primary">

                    @Model.Code

                </span>

                <span class="label bg-success">

                    Active

                </span>

            </div>

            <div class="col-md-4">

                <div class="panel bg-primary-400">

                    <div class="panel-body">

                        <h3 class="no-margin">

                            @Model.CountryName

                        </h3>

                        Country

                    </div>

                </div>

            </div>

        </div>

        <hr />

        <div class="row">

            <!-- Basic Information -->

            <div class="col-md-6">

                <div class="panel panel-bordered">

                    <div class="panel-heading">

                        <h6 class="panel-title">

                            <i class="icon-info22 position-left"></i>

                            Basic Information

                        </h6>

                    </div>

                    <table class="table table-bordered">

                        <tr>

                            <th width="220">

                                State Name

                            </th>

                            <td>

                                @Model.Name

                            </td>

                        </tr>

                        <tr>

                            <th>

                                State Code

                            </th>

                            <td>

                                @Model.Code

                            </td>

                        </tr>

                        <tr>

                            <th>

                                GST State Code

                            </th>

                            <td>

                                @if (!string.IsNullOrWhiteSpace(Model.GSTStateCode))
                                {
                                    <span class="label bg-success">

                                        @Model.GSTStateCode

                                    </span>
                                }
                                else
                                {
                                    <span class="label bg-warning">

                                        N/A

                                    </span>
                                }

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

            <!-- Country -->

            <div class="col-md-6">

                <div class="panel panel-bordered">

                    <div class="panel-heading">

                        <h6 class="panel-title">

                            <i class="icon-earth position-left"></i>

                            Country Information

                        </h6>

                    </div>

                    <table class="table table-bordered">

                        <tr>

                            <th width="220">

                                Country

                            </th>

                            <td>

                                @Model.CountryName

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Country Id

                            </th>

                            <td>

                                @Model.CountryId

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

        </div>

        <!-- Audit Information -->

        <div class="panel panel-bordered">

            <div class="panel-heading">

                <h6 class="panel-title">

                    <i class="icon-history position-left"></i>

                    Audit Information

                </h6>

            </div>

            <table class="table table-bordered">

                <tr>

                    <th>

                        Created By

                    </th>

                    <td>

                        @(string.IsNullOrEmpty(Model.CreatedBy)
                            ? "-"
                            : Model.CreatedBy)

                    </td>

                </tr>

                <tr>

                    <th>

                        Modified On

                    </th>

                    <td>

                        @(Model.ModifiedOn?.ToString("dd-MMM-yyyy HH:mm") ?? "-")

                    </td>

                </tr>

                <tr>

                    <th>

                        Modified By

                    </th>

                    <td>

                        @(string.IsNullOrEmpty(Model.ModifiedBy)
                            ? "-"
                            : Model.ModifiedBy)

                    </td>

                </tr>

            </table>

        </div>

    </div>

</div>

<style>

    .panel-bordered {
        border: 1px solid #ddd;
        margin-bottom: 20px;
    }

        .panel-bordered .panel-heading {
            background: #fafafa;
            border-bottom: 1px solid #ddd;
        }

    .table > tbody > tr > th {
        width: 220px;
        background: #fafafa;
        font-weight: 600;
    }

    .icon-object {
        border: 3px solid #2196F3;
        border-radius: 50%;
    }

    .label {
        font-size: 11px;
        margin-right: 5px;
    }

    .text-semibold {
        font-weight: 600;
    }

</style>