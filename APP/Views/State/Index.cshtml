    <style>

        .panel-heading {
            padding: 18px 20px;
        }

        .panel-title {
            font-weight: 600;
        }

        .panel-body {
            padding: 20px;
        }

        .table > thead > tr > th {
            background: #fafafa;
            font-size: 13px;
            font-weight: 600;
            vertical-align: middle;
        }

        .table > tbody > tr > td {
            font-size: 13px;
            vertical-align: middle;
        }

        .table-hover tbody tr:hover {
            background: #f8f9fa;
        }

        .text-semibold {
            font-weight: 600;
        }

        .btn-group .btn {
            margin-right: 2px;
        }

        .btn-icon {
            width: 34px;
            height: 34px;
            padding: 7px;
        }

        .label {
            font-size: 11px;
            padding: 5px 10px;
        }

        .panel.bg-primary-400,
        .panel.bg-success-400,
        .panel.bg-info-400,
        .panel.bg-warning-400 {
            margin-bottom: 20px;
            border-radius: 4px;
        }

        .media {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .media-left i {
            opacity: .85;
        }

        .datatable-basic tbody tr:hover {
            background: #f5f5f5;
        }

        .chosen-container {
            width: 100% !important;
        }

        .chosen-single {
            height: 36px !important;
            line-height: 34px !important;
        }

        .panel {
            box-shadow: 0 1px 3px rgba(0,0,0,.08);
        }

    </style>

}
