@model IEnumerable<StateDto>

@{
    ViewData["Title"] = "State Management";
}

<div class="panel panel-flat">

    <!-- Page Header -->

    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-location4 position-left"></i>

            State Management

        </h5>

        <div class="heading-elements">

            <a asp-action="Create"
               class="btn bg-primary">

                <i class="icon-plus22 position-left"></i>

                Add State

            </a>

        </div>

    </div>

    <!-- KPI Cards -->

    <div class="panel-body">

        <div class="row">

            <!-- Total States -->

            <div class="col-md-4">

                <div class="panel bg-primary-400">

                    <div class="panel-body">

                        <div class="media">

                            <div class="media-left">

                                <i class="icon-location4 icon-3x"></i>

                            </div>

                            <div class="media-body text-right">

                                <h3 class="no-margin">

                                    @Model.Count()

                                </h3>

                                <span>

                                    Total States

                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            
            <!-- GST Configured -->

            <div class="col-md-4">

                <div class="panel bg-info-400">

                    <div class="panel-body">

                        <div class="media">

                            <div class="media-left">

                                <i class="icon-price-tag3 icon-3x"></i>

                            </div>

                            <div class="media-body text-right">

                                <h3 class="no-margin">

                                    @Model.Count(x=>!string.IsNullOrEmpty(x.GSTStateCode))

                                </h3>

                                <span>

                                    GST Configured

                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Modified -->

            <div class="col-md-4">

                <div class="panel bg-warning-400">

                    <div class="panel-body">

                        <div class="media">

                            <div class="media-left">

                                <i class="icon-history icon-3x"></i>

                            </div>

                            <div class="media-body text-right">

                                <h3 class="no-margin">

                                    @Model.Count(x=>x.ModifiedOn!=null)

                                </h3>

                                <span>

                                    Updated

                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <hr />

        <!-- Search Area -->

        <div class="row">

            <!-- Search -->

            <div class="col-md-4">

                <div class="form-group">

                    <input type="text"
                           id="searchInput"
                           class="form-control"
                           placeholder="Search State..." />

                </div>

            </div>

            <!-- Country -->

            <div class="col-md-3">

                <div class="form-group">

                    <select id="CountryFilter"
                            class="form-control select-search">

                        <option value="">

                            All Countries

                        </option>

                    </select>

                </div>

            </div>

            <!-- GST -->

            <div class="col-md-3">

                <div class="form-group">

                    <select id="GSTFilter"
                            class="form-control select-search">

                        <option value="">

                            GST Status

                        </option>

                        <option value="Configured">

                            Configured

                        </option>

                        <option value="Not Configured">

                            Not Configured

                        </option>

                    </select>

                </div>

            </div>

            <!-- Button -->

            <div class="col-md-2">

                <button type="button"
                        class="btn bg-primary btn-block">

                    <i class="icon-search4 position-left"></i>

                    Filter

                </button>

            </div>

        </div>

    </div>

    <!-- Grid -->

    <table class="table table-hover table-striped datatable-basic">

        <thead>

            <tr>

                <th width="60">

                    #

                </th>

                <th>

                    State

                </th>

                <th>

                    Code

                </th>

                <th>

                    Country

                </th>

                <th>

                    GST Code

                </th>

                <th>

                    Modified On

                </th>

                <th>

                    Status

                </th>

                <th width="170"
                    class="text-center">

                    Action

                </th>

            </tr>

        </thead>

        <tbody id="stateTable">

            @{
                int sr = 1;
            }

            @foreach (var item in Model)
            {
                <tr>

                    <!-- Sr No -->

                    <td>

                        @sr

                    </td>

                    <!-- State -->

                    <td>

                        <div class="text-semibold">

                            <i class="icon-location4 text-primary position-left"></i>

                            @item.Name

                        </div>

                    </td>

                    <!-- Code -->

                    <td>

                        <span class="label bg-primary">

                            @item.Code

                        </span>

                    </td>

                    <!-- Country -->

                    <td>

                        <span class="label bg-info">

                            <i class="icon-earth position-left"></i>

                            @item.CountryName

                        </span>

                    </td>

                    <!-- GST -->

                    <td>

                        @if (!string.IsNullOrWhiteSpace(item.GSTStateCode))
                        {
                            <span class="label bg-success">

                                @item.GSTStateCode

                            </span>
                        }
                        else
                        {
                            <span class="label bg-warning">

                                N/A

                            </span>
                        }

                    </td>

                    <!-- Modified -->

                    <td>

                        @if (item.ModifiedOn.HasValue)
                        {
                            @item.ModifiedOn.Value.ToString("dd-MMM-yyyy")
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </td>

                    <!-- Status -->

                    <td>

                        <span class="label bg-success">

                            Active

                        </span>

                    </td>

                    <!-- Action -->

                    <td class="text-center">

                        <div class="btn-group">

                            <!-- Details -->

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-default btn-icon"
                               data-popup="tooltip"
                               title="Details">

                                <i class="icon-eye"></i>

                            </a>

                            <!-- Edit -->

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn bg-primary btn-icon"
                               data-popup="tooltip"
                               title="Edit">

                                <i class="icon-pencil7"></i>

                            </a>

                            <!-- Delete -->

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               onclick="return confirm('Are you sure you want to delete this state?');"
                               class="btn btn-danger btn-icon"
                               data-popup="tooltip"
                               title="Delete">

                                <i class="icon-trash"></i>

                            </a>

                        </div>

                    </td>

                </tr>

                sr++;
            }

        </tbody>

    </table>

</div>

@section Scripts {
    <script>

        // Search Table

        document.getElementById("searchInput")
            .addEventListener("keyup", function () {

                let value = this.value.toLowerCase();

                let rows = document.querySelectorAll("#stateTable tr");

                rows.forEach(function (row) {

                    let text = row.innerText.toLowerCase();

                    row.style.display =
                        text.includes(value) ? "" : "none";

                });

            });

    </script>

    <script>

        // Search Table

        document.getElementById("searchInput")
            .addEventListener("keyup", function () {

                let value = this.value.toLowerCase();

                let rows = document.querySelectorAll("#stateTable tr");

                rows.forEach(function (row) {

                    let text = row.innerText.toLowerCase();

                    row.style.display =
                        text.includes(value) ? "" : "none";

                });

            });

    </script>

