@model StateDto

@{
    ViewData["Title"] = "State Management";
}

<form asp-action="@(string.IsNullOrEmpty(Model?.Id) ? "Create" : "Edit")"
      method="post">
    <!-- Hidden Fields -->

    <input asp-for="Id" type="hidden" />
    <input asp-for="TenantId" type="hidden" />
    <input asp-for="CreatedBy" type="hidden" />
    <input asp-for="ModifiedBy" type="hidden" />
    <input asp-for="ModifiedOn" type="hidden" />

    <div class="panel panel-flat">

        <!-- Header -->

        <div class="panel-heading">

            <h5 class="panel-title">

                <i class="icon-location4 position-left"></i>

                @(string.IsNullOrEmpty(Model?.Id)
                    ? "Create State"
                    : "Edit State")

            </h5>

            <div class="heading-elements">

                <a asp-action="Index"
                   class="btn btn-default">

                    <i class="icon-arrow-left13 position-left"></i>

                    Back

                </a>

            </div>

        </div>

        <!-- Body -->

        <div class="panel-body">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <!-- ========================================= -->
            <!-- Basic Information -->
            <!-- ========================================= -->

            <fieldset>

                <legend class="text-semibold">

                    <i class="icon-info22 position-left"></i>

                    Basic Information

                </legend>

                <div class="row">

                    <!-- State Name -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="Name"></label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter State Name" />

                            <span asp-validation-for="Name"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <!-- State Code -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="Code"></label>

                            <input asp-for="Code"
                                   class="form-control"
                                   placeholder="MH / DL / GJ" />

                            <span asp-validation-for="Code"
                                  class="text-danger"></span>

                        </div>

                    </div>

                </div>

            </fieldset>

            <!-- ========================================= -->
            <!-- Country & GST Information -->
            <!-- ========================================= -->

            <fieldset>
                <legend class="text-semibold">

                    <i class="icon-earth position-left"></i>

                    Country & GST Information

                </legend>

                <div class="row">

                    <!-- Country -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="CountryId"></label>

                            <select asp-for="CountryId"
                                    asp-items="ViewBag.CountryList"
                                    id="CountryId"
                                    class="form-control select-search">

                                <option value="">

                                    -- Select Country --

                                </option>

                            </select>

                            <span asp-validation-for="CountryId"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <!-- GST State Code -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="GSTStateCode"></label>

                            <input asp-for="GSTStateCode"
                                   class="form-control"
                                   placeholder="GST State Code" />

                            <span asp-validation-for="GSTStateCode"
                                  class="text-danger"></span>

                        </div>

                    </div>

                </div>
            </fieldset>

            </div>

        <!-- ========================================= -->
        <!-- Summary -->
        <!-- ========================================= -->

        <fieldset>

            <legend class="text-semibold">

                <i class="icon-file-text2 position-left"></i>

                Summary

            </legend>

            <div class="row">

                <div class="col-md-4">

                    <div class="panel bg-primary-400">

                        <div class="panel-body">

                            <h5 class="no-margin">

                                <span id="StateNamePreview">

                                    @(string.IsNullOrWhiteSpace(Model?.Name)
                                        ? "-"
                                        : Model.Name)

                                </span>

                            </h5>

                            <div class="text-size-small">

                                State Name

                            </div>

                        </div>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="panel bg-success-400">

                        <div class="panel-body">

                            <h5 class="no-margin">

                                <span id="CountryPreview">

                                    @(string.IsNullOrWhiteSpace(Model?.CountryName)
                                        ? "-"
                                        : Model.CountryName)

                                </span>

                            </h5>

                            <div class="text-size-small">

                                Country

                            </div>

                        </div>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="panel bg-warning-400">

                        <div class="panel-body">

                            <h5 class="no-margin">

                                <span id="GSTPreview">

                                    @(string.IsNullOrWhiteSpace(Model?.GSTStateCode)
                                        ? "-"
                                        : Model.GSTStateCode)

                                </span>

                            </h5>

                            <div class="text-size-small">

                                GST State Code

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </fieldset>

    </div>

    <!-- ========================================= -->
    <!-- Footer -->
    <!-- ========================================= -->

    <div class="panel-footer text-right">

        <a asp-action="Index"
           class="btn btn-default">

            <i class="icon-arrow-left13 position-left"></i>

            Back

        </a>

        <button type="reset"
                class="btn btn-warning">

            <i class="icon-reset position-left"></i>

            Reset

        </button>

        <button type="submit"
                class="btn bg-primary">

            <i class="icon-floppy-disk position-left"></i>

            @(string.IsNullOrWhiteSpace(Model?.Id)
                ? "Save"
                : "Update")

        </button>

    </div>

</form>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        $(document).ready(function () {

            //=========================================
            // Chosen Dropdown
            //=========================================

            if ($(".select-search").length) {

                $(".select-search").chosen({

                    width: "100%",
                    search_contains: true,
                    allow_single_deselect: true

                });

            }

            //=========================================
            // State Name Preview
            //=========================================

            $("#Name").keyup(function () {

                var state = $(this).val();

                if (state == "")
                    state = "-";

                $("#StateNamePreview").text(state);

            });

            //=========================================
            // Country Preview
            //=========================================

            $("#CountryId").change(function () {

                var country = $("#CountryId option:selected").text();

                if ($("#CountryId").val() == "")
                    country = "-";

                $("#CountryPreview").text(country);

            });

            //=========================================
            // GST Preview
            //=========================================

            $("#GSTStateCode").keyup(function () {

                var gst = $(this).val();

                if (gst == "")
                    gst = "-";

                $("#GSTPreview").text(gst);

            });

            //=========================================
            // Form Validation
            //=========================================

            $("form").submit(function () {

                if ($("#Name").val().trim() == "") {

                    alert("Please enter State Name.");

                    $("#Name").focus();

                    return false;

                }

                if ($("#Code").val().trim() == "") {

                    alert("Please enter State Code.");

                    $("#Code").focus();

                    return false;

                }

                if ($("#CountryId").val() == "") {

                    alert("Please select Country.");

                    $("#CountryId").focus();

                    return false;

                }

                return true;

            });

        });

    </script>

    <style>

        .panel-heading {
            padding: 18px 20px;
        }

        .panel-title {
            font-weight: 600;
        }

        .panel-body {
            padding: 20px;
        }

        fieldset {
            border: 1px solid #e5e5e5;
            padding: 20px;
            margin-bottom: 20px;
        }

        legend {
            width: auto;
            border: none;
            padding: 0 10px;
            font-size: 15px;
            font-weight: 600;
        }

        .panel-footer {
            background: #fafafa;
            padding: 15px 20px;
        }

        .panel.bg-primary-400,
        .panel.bg-success-400,
        .panel.bg-warning-400 {
            margin-bottom: 0;
            color: #fff;
        }

            .panel.bg-primary-400 h5,
            .panel.bg-success-400 h5,
            .panel.bg-warning-400 h5 {
                color: #fff;
                font-weight: 600;
            }

        .chosen-container {
            width: 100% !important;
        }

        .chosen-single {
            height: 36px !important;
            line-height: 34px !important;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .text-danger {
            font-size: 12px;
        }

        .btn {
            min-width: 110px;
        }

        .alert {
            margin-bottom: 20px;
        }

    </style>

}