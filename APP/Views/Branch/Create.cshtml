@model BranchDto

@{
    ViewData["Title"] = "Branch";
}

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-office position-left"></i>

            @(string.IsNullOrEmpty(Model?.Id)
                ? "Create Branch"
                : "Edit Branch")

        </h5>

        <div class="heading-elements">

            <span class="text-muted">
                Manage branch information and locations
            </span>

        </div>

    </div>

    <div class="panel-body">

        <form asp-action="@(Model.Id == null ? "Create" : "Edit")"
              method="post"
              enctype="multipart/form-data">

            <input asp-for="Id" type="hidden" />
            <input asp-for="TenantId" type="hidden" />
            <input asp-for="CreatedBy" type="hidden" />
            <input asp-for="ModifiedBy" type="hidden" />
            <input asp-for="ModifiedOn" type="hidden" />

            <!-- Basic Information -->

            <fieldset>

                <legend class="text-semibold">
                    <i class="icon-info22 position-left"></i>
                    Basic Information
                </legend>

                <div class="row">

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="Name"></label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter Branch Name" />

                            <span asp-validation-for="Name"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="Code"></label>

                            <input asp-for="Code"
                                   class="form-control"
                                   placeholder="Enter Branch Code" />

                            <span asp-validation-for="Code"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="CompanyId"></label>

                            <select asp-for="CompanyId"
                                    asp-items="ViewBag.CompanyList"
                                    class="form-control">

                                <option value="">
                                    -- Select Company --
                                </option>

                            </select>

                            <span asp-validation-for="CompanyId"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="form-group">

                            <label>Branch Type</label>

                            <div class="checkbox checkbox-switchery">

                                <label>

                                    <input asp-for="IsHeadOffice"
                                           type="checkbox"
                                           class="switchery" />

                                    Head Office

                                </label>

                            </div>

                        </div>

                    </div>

                </div>

            </fieldset>

            <!-- Contact Information -->

            <fieldset>

                <legend class="text-semibold">
                    <i class="icon-phone position-left"></i>
                    Contact Information
                </legend>

                <div class="row">

                    <div class="col-md-4">

                        <div class="form-group">

                            <label asp-for="Email"></label>

                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="Email Address" />

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="form-group">

                            <label asp-for="Phone"></label>

                            <input asp-for="Phone"
                                   class="form-control"
                                   placeholder="Phone Number" />

                            <span asp-validation-for="Phone"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="form-group">

                            <label asp-for="AlternatePhone"></label>

                            <input asp-for="AlternatePhone"
                                   class="form-control"
                                   placeholder="Alternate Phone" />

                        </div>

                    </div>

                </div>

            </fieldset>

            <!-- Address Information -->

            <fieldset>

                <legend class="text-semibold">
                    <i class="icon-location4 position-left"></i>
                    Address Information
                </legend>

                <div class="row">

                    <div class="col-md-12">

                        <div class="form-group">

                            <label asp-for="Address"></label>

                            <textarea asp-for="Address"
                                      rows="3"
                                      class="form-control"></textarea>

                            <span asp-validation-for="Address"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="form-group">

                            <label asp-for="CountryId"></label>

                            <select asp-for="CountryId"
                                    asp-items="ViewBag.CountryList"
                                    id="CountryId"
                                    class="form-control">

                                <option value="">
                                    -- Select Country --
                                </option>

                            </select>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="form-group">

                            <label asp-for="StateId"></label>

                            <select asp-for="StateId"
                                    asp-items="ViewBag.StateList"
                                    id="StateId"
                                    class="form-control">

                                <option value="">
                                    -- Select State --
                                </option>

                            </select>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="form-group">

                            <label asp-for="CityId"></label>

                            <select asp-for="CityId"
                                    asp-items="ViewBag.CityList"
                                    id="CityId"
                                    class="form-control">

                                <option value="">
                                    -- Select City --
                                </option>

                            </select>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="form-group">

                            <label asp-for="Pincode"></label>

                            <input asp-for="Pincode"
                                   class="form-control"
                                   placeholder="Pincode" />

                        </div>

                    </div>

                </div>

            </fieldset>

            <!-- GST & Legal Information -->

            <fieldset>

                <legend class="text-semibold">
                    <i class="icon-file-text2 position-left"></i>
                    GST & Legal Information
                </legend>

                <div class="row">

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="GSTNumber"></label>

                            <input asp-for="GSTNumber"
                                   class="form-control"
                                   placeholder="GST Number" />

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="CINNo"></label>

                            <input asp-for="CINNo"
                                   class="form-control"
                                   placeholder="CIN Number" />

                        </div>

                    </div>

                </div>

            </fieldset>

            <!-- Buttons -->

            <div class="text-right">

                <a asp-action="Index"
                   class="btn btn-default">

                    <i class="icon-arrow-left13"></i>
                    Back

                </a>

                <button type="submit"
                        class="btn bg-success">

                    <i class="icon-checkmark3"></i>

                    @(string.IsNullOrEmpty(Model?.Id)
                        ? "Save"
                        : "Update")

                </button>

            </div>

        </form>

    </div>

</div>
@section Scripts {

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>
        $(document).ready(function () {

        $(document).on("change", "#CountryId", function () {
        debugger;
        let countryId = $(this).val();

        console.log(countryId);

        if (countryId == null || countryId === "") {

        $("#StateId").html(
        '<option value="">-- Select State --</option>'
        );

        return;
        }

        $.ajax({

        url: '@Url.Action("GetStatesByCountry")',

        type: 'GET',

        data: { countryId: countryId },

        success: function (response) {

        let html = '<option value="">-- Select State --</option>';

        $.each(response, function (i, item) {

        html += `<option value="${item.value}">
        ${item.text}
        </option>`;
        });

        $("#StateId").html(html);
        },

        error: function (xhr) {

        console.log(xhr);

        alert("Error loading states");

        }

        });

        });
        $(document).on("change", "#StateId", function () {
        debugger;
        let stateId = $(this).val();

        console.log(stateId);

        if (stateId == null || stateId === "") {

        $("#CityId").html(
        '<option value="">-- Select City --</option>'
        );

        return;
        }

        $.ajax({

        url: '@Url.Action("GetCityByState")',

        type: 'GET',

        data: { stateId: stateId },

        success: function (response) {

        let html = '<option value="">-- Select City --</option>';

        $.each(response, function (i, item) {

        html += `<option value="${item.value}">
        ${item.text}
        </option>`;
        });

        $("#CityId").html(html);
        },

        error: function (xhr) {

        console.log(xhr);

        alert("Error loading states");

        }

        });

        });
        });

    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}