@model BranchDto

@{
    ViewData["Title"] = "Branch Details";
}

<div class="panel panel-flat">

    <div class="panel-heading bg-success">

        <div class="media">

            <div class="media-left">

                <div class="bg-white text-success text-center"
                     style="width:80px;height:80px;line-height:80px;border-radius:50%;">

                    <i class="icon-office icon-3x"></i>

                </div>

            </div>

            <div class="media-body">

                <h4 class="text-white no-margin">
                    @Model.Name
                </h4>

                <span class="text-white">
                    Branch Code : @Model.Code
                </span>

            </div>

            <div class="media-right">

                @if (Model.IsHeadOffice)
                {
                    <span class="label bg-warning">
                        Head Office
                    </span>
                }

            </div>

        </div>

    </div>

    <div class="panel-body">

        <!-- Summary Cards -->

        <div class="row">

            <div class="col-md-3">

                <div class="panel bg-primary-400">
                    <div class="panel-body text-center">
                        <h4>@Model.CompanyName</h4>
                        <span>Company</span>
                    </div>
                </div>

            </div>

            <div class="col-md-3">

                <div class="panel bg-success-400">
                    <div class="panel-body text-center">
                        <h4>@Model.CityName</h4>
                        <span>City</span>
                    </div>
                </div>

            </div>

            <div class="col-md-3">

                <div class="panel bg-info-400">
                    <div class="panel-body text-center">
                        <h4>@Model.StateName</h4>
                        <span>State</span>
                    </div>
                </div>

            </div>

            <div class="col-md-3">

                <div class="panel bg-warning-400">
                    <div class="panel-body text-center">
                        <h4>@Model.Locations.Count</h4>
                        <span>Locations</span>
                    </div>
                </div>

            </div>

        </div>

        <div class="row">

            <!-- Basic Information -->

            <div class="col-md-6">

                <div class="panel panel-bordered">

                    <div class="panel-heading">
                        <h6 class="panel-title">
                            <i class="icon-info22 position-left"></i>
                            Basic Information
                        </h6>
                    </div>

                    <table class="table table-striped">

                        <tbody>

                            <tr>
                                <th width="180">Branch Name</th>
                                <td>@Model.Name</td>
                            </tr>

                            <tr>
                                <th>Branch Code</th>
                                <td>@Model.Code</td>
                            </tr>

                            <tr>
                                <th>Company</th>
                                <td>@Model.CompanyName</td>
                            </tr>

                            <tr>
                                <th>Tenant</th>
                                <td>@Model.TenantName</td>
                            </tr>

                            <tr>
                                <th>Head Office</th>
                                <td>
                                    @if (Model.IsHeadOffice)
                                    {
                                        <span class="label label-success">
                                            Yes
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="label label-default">
                                            No
                                        </span>
                                    }
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

            <!-- Contact Information -->

            <div class="col-md-6">

                <div class="panel panel-bordered">

                    <div class="panel-heading">
                        <h6 class="panel-title">
                            <i class="icon-phone position-left"></i>
                            Contact Information
                        </h6>
                    </div>

                    <table class="table table-striped">

                        <tbody>

                            <tr>
                                <th width="180">Email</th>
                                <td>@Model.Email</td>
                            </tr>

                            <tr>
                                <th>Phone</th>
                                <td>@Model.Phone</td>
                            </tr>

                            <tr>
                                <th>Alternate Phone</th>
                                <td>@Model.AlternatePhone</td>
                            </tr>

                            <tr>
                                <th>GST Number</th>
                                <td>@Model.GSTNumber</td>
                            </tr>

                            <tr>
                                <th>CIN No</th>
                                <td>@Model.CINNo</td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <!-- Address -->

        <div class="panel panel-flat">

            <div class="panel-heading">

                <h6 class="panel-title">
                    <i class="icon-location4 position-left"></i>
                    Address Information
                </h6>

            </div>

            <table class="table table-bordered">

                <tbody>

                    <tr>
                        <th width="180">Country</th>
                        <td>@Model.CountryName</td>
                    </tr>

                    <tr>
                        <th>State</th>
                        <td>@Model.StateName</td>
                    </tr>

                    <tr>
                        <th>City</th>
                        <td>@Model.CityName</td>
                    </tr>

                    <tr>
                        <th>Pincode</th>
                        <td>@Model.Pincode</td>
                    </tr>

                    <tr>
                        <th>Address</th>
                        <td>@Model.Address</td>
                    </tr>

                </tbody>

            </table>

        </div>

        <!-- Branch Locations -->

        <div class="panel panel-flat">

            <div class="panel-heading">

                <h6 class="panel-title">
                    <i class="icon-location3 position-left"></i>
                    Branch Locations
                </h6>

                <div class="heading-elements">

                    <span class="label bg-warning">
                        @Model.Locations.Count Locations
                    </span>

                </div>

            </div>

            <table class="table datatable-scroll-y">

                <thead>

                    <tr>
                        <th>#</th>
                        <th>Location Name</th>
                        <th>Code</th>
                        <th>Default</th>
                    </tr>

                </thead>

                <tbody>

                    @{
                        int srLoc = 1;
                    }

                    @foreach (var location in Model.Locations)
                    {
                        <tr>

                            <td>@srLoc</td>

                            <td>
                                @location.LocationName
                            </td>

                            <td>
                                <span class="label bg-primary">
                                    @location.LocationCode
                                </span>
                            </td>

                            <td>

                                @if (location.IsDefault)
                                {
                                    <span class="label label-success">
                                        Default
                                    </span>
                                }
                                else
                                {
                                    <span class="label label-default">
                                        No
                                    </span>
                                }

                            </td>

                        </tr>

                        srLoc++;
                    }

                </tbody>

            </table>

        </div>

        <!-- Actions -->

        <div class="text-right">

            <a asp-action="Index"
               class="btn btn-default">

                <i class="icon-arrow-left13"></i>
                Back

            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn bg-success">

                <i class="icon-pencil7"></i>
                Edit Branch

            </a>

        </div>

    </div>

</div>