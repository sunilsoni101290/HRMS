@model IEnumerable<ProbationDueForReviewDto>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Probation - Due For Review";
}

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">
            <i class="icon-alarm position-left"></i>
            Probation - Due For Review
        </h5>

        <div class="heading-elements">

            <a asp-action="Index" class="btn btn-default">
                <i class="icon-list"></i>
                All Confirmations
            </a>

        </div>

    </div>

    <div class="panel-body">

        <form asp-action="DueForReview" method="get" class="row">

            <div class="col-md-4">
                <select name="departmentId" class="form-control">
                    <option value="">-- All Departments --</option>
                    @if (ViewBag.DepartmentList is SelectList deptList)
                    {
                        foreach (SelectListItem item in deptList)
                        {
                            <option value="@item.Value" selected="@(item.Value == (string)ViewBag.DepartmentId)">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-4">
                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search by employee name/code..." />
            </div>

            <div class="col-md-3">
                <button type="submit" class="btn btn-default">
                    <i class="icon-search4"></i>
                    Filter
                </button>
            </div>

        </form>

    </div>

    <div class="table-responsive">

        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>Designation</th>
                    <th>Joining Date</th>
                    <th>Probation End Date</th>
                    <th>Days Remaining</th>
                    <th width="180">Action</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.EmployeeName
                                <br />
                                <span class="text-muted text-size-small">@item.EmployeeCode</span>
                            </td>

                            <td>@(item.DepartmentName ?? "-")</td>

                            <td>@(item.DesignationName ?? "-")</td>

                            <td>@item.JoiningDate.ToString("dd-MMM-yyyy")</td>

                            <td>@(item.ProbationEndDate?.ToString("dd-MMM-yyyy") ?? "-")</td>

                            <td>
                                @if (item.IsOverdue)
                                {
                                    <span class="label bg-danger">Overdue by @Math.Abs(item.DaysRemaining ?? 0) day(s)</span>
                                }
                                else if (item.DaysRemaining.HasValue)
                                {
                                    <span class="label bg-warning">@item.DaysRemaining day(s) left</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>

                            <td style="padding: 10px 15px;">

                                <a asp-action="Create"
                                   asp-route-employeeId="@item.EmployeeId"
                                   class="btn bg-primary btn-xs">
                                    <i class="icon-plus22"></i>
                                    Propose Recommendation
                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted" style="padding:30px;">
                            <i class="icon-checkmark-circle" style="font-size:32px;"></i><br />
                            No employees currently due for probation review.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<script src="~/global_assets/js/plugins/notifications/sweet_alert.min.js"></script>

@section Scripts {

    <script>

        @if (TempData["Success"] != null)
        {
            <text>
                swal({
                    title: 'Success',
                    text: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(TempData["Success"]?.ToString() ?? string.Empty)),
                    type: 'success',
                    confirmButtonColor: '#66BB6A'
                });
            </text>
        }

        @if (TempData["GlobalError"] != null)
        {
            <text>
                swal({
                    title: 'Error',
                    text: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(TempData["GlobalError"]?.ToString() ?? string.Empty)),
                    type: 'error',
                    confirmButtonColor: '#EF5350'
                });
            </text>
        }

    </script>

}
