@model IEnumerable<FinancialYearDto>

@{
    ViewData["Title"] = "Financial Year List";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h3 class="fw-bold mb-1">

                <i class="bi bi-calendar-range-fill text-success"></i>
                Financial Year Management

            </h3>

            <p class="text-muted mb-0">
                Manage company financial years
            </p>

        </div>

        <div>

            <a asp-action="Create"
               class="btn btn-success rounded-3 px-4">

                <i class="bi bi-plus-circle"></i>
                Add Financial Year

            </a>

        </div>

    </div>

    <!-- Search -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <input type="text"
                           id="searchInput"
                           class="form-control"
                           placeholder="Search Financial Year..." />

                </div>

                <div class="col-md-3">

                    <select class="form-select">

                        <option value="">
                            All Companies
                        </option>

                    </select>

                </div>

                <div class="col-md-3">

                    <select class="form-select">

                        <option value="">
                            All Status
                        </option>

                    </select>

                </div>

                <div class="col-md-2">

                    <button class="btn btn-outline-success w-100">

                        <i class="bi bi-search"></i>
                        Search

                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- Table -->
    <div class="card border-0 shadow rounded-4">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>#</th>
                            <th>Financial Year</th>
                            <th>Code</th>
                            <th>Company</th>
                            <th>Period</th>
                            <th>Status</th>
                            <th>Current</th>
                            <th width="160">Action</th>

                        </tr>

                    </thead>

                    <tbody id="financialYearTable">

                        @{
                            int sr = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- Sr -->
                                <td>
                                    @sr
                                </td>

                                <!-- FY -->
                                <td>

                                    <div class="fw-semibold">

                                        <i class="bi bi-calendar-event text-success"></i>
                                        @item.Name

                                    </div>

                                </td>

                                <!-- Code -->
                                <td>

                                    <span class="badge bg-dark">
                                        @item.Code
                                    </span>

                                </td>

                                <!-- Company -->
                                <td>

                                    <span class="badge bg-primary">
                                        @item.CompanyName
                                    </span>

                                </td>

                                <!-- Period -->
                                <td>

                                    <small>

                                        @item.StartDate.ToString("dd MMM yyyy")
                                        -
                                        @item.EndDate.ToString("dd MMM yyyy")

                                    </small>

                                </td>

                                <!-- Status -->
                                <td>

                                    @if (item.Status == EnumExtensions.FinancialYearStatus.Open)
                                    {
                                        <span class="badge bg-success">
                                            @item.Status
                                        </span>
                                    }
                                    else if (item.Status == EnumExtensions.FinancialYearStatus.Upcoming)
                                    {
                                        <span class="badge bg-warning">
                                            @item.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            @item.Status
                                        </span>
                                    }

                                </td>

                                <!-- Current -->
                                <td>

                                    @if (item.IsCurrent)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Current
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            No
                                        </span>
                                    }

                                </td>

                                <!-- Action -->
                                <td>

                                    <div class="d-flex gap-2">

                                        <!-- Details -->
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info rounded-3">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <!-- Edit -->
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-success rounded-3">

                                            <i class="bi bi-pencil-square"></i>

                                        </a>

                                        <!-- Delete -->
                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           onclick="return confirm('Delete this financial year?')"
                                           class="btn btn-sm btn-outline-danger rounded-3">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>

                            sr++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        // Search Table

        document.getElementById("searchInput")
            .addEventListener("keyup", function () {

                let value = this.value.toLowerCase();

                let rows = document.querySelectorAll("#financialYearTable tr");

                rows.forEach(function (row) {

                    let text = row.innerText.toLowerCase();

                    row.style.display =
                        text.includes(value) ? "" : "none";

                });

            });

    </script>

}