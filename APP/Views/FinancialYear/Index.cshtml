@model IEnumerable<FinancialYearDto>

@{
    ViewData["Title"] = "Financial Year Management";
}

<div class="panel panel-flat">

    <!-- Header -->

    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-calendar3 position-left"></i>

            Financial Year Management

        </h5>

        <div class="heading-elements">

            <a asp-action="Create"
               class="btn bg-primary">

                <i class="icon-plus22 position-left"></i>

                Add Financial Year

            </a>

        </div>

    </div>

    <!-- KPI Cards -->

    <div class="panel-body">

        <div class="row">

            <!-- Total -->

            <div class="col-md-3">

                <div class="panel bg-primary-400">

                    <div class="panel-body">

                        <div class="media">

                            <div class="media-left">

                                <i class="icon-calendar3 icon-3x"></i>

                            </div>

                            <div class="media-body text-right">

                                <h3 class="no-margin">

                                    @Model.Count()

                                </h3>

                                <span>

                                    Total Financial Years

                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Open -->

            <div class="col-md-3">

                <div class="panel bg-success-400">

                    <div class="panel-body">

                        <div class="media">

                            <div class="media-left">

                                <i class="icon-checkmark-circle icon-3x"></i>

                            </div>

                            <div class="media-body text-right">

                                <h3 class="no-margin">

                                    @Model.Count(x => x.Status == EnumExtensions.FinancialYearStatus.Open)

                                </h3>

                                <span>

                                    Open

                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Upcoming -->

            <div class="col-md-3">

                <div class="panel bg-warning-400">

                    <div class="panel-body">

                        <div class="media">

                            <div class="media-left">

                                <i class="icon-hour-glass2 icon-3x"></i>

                            </div>

                            <div class="media-body text-right">

                                <h3 class="no-margin">

                                    @Model.Count(x => x.Status == EnumExtensions.FinancialYearStatus.Upcoming)

                                </h3>

                                <span>

                                    Upcoming

                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Current -->

            <div class="col-md-3">

                <div class="panel bg-info-400">

                    <div class="panel-body">

                        <div class="media">

                            <div class="media-left">

                                <i class="icon-star-full2 icon-3x"></i>

                            </div>

                            <div class="media-body text-right">

                                <h3 class="no-margin">

                                    @Model.Count(x => x.IsCurrent)

                                </h3>

                                <span>

                                    Current FY

                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <hr />

        <!-- Search & Filter -->

        <div class="row">

            <!-- Search -->

            <div class="col-md-4">

                <div class="form-group">

                    <input type="text"
                           id="searchInput"
                           class="form-control"
                           placeholder="Search Financial Year..." />

                </div>

            </div>

            <!-- Company -->

            <div class="col-md-3">

                <div class="form-group">

                    <select id="CompanyFilter"
                            class="form-control select-search">

                        <option value="">

                            All Companies

                        </option>

                    </select>

                </div>

            </div>

            <!-- Status -->

            <div class="col-md-3">

                <div class="form-group">

                    <select id="StatusFilter"
                            class="form-control select-search">

                        <option value="">

                            All Status

                        </option>

                        <option>

                            Open

                        </option>

                        <option>

                            Upcoming

                        </option>

                        <option>

                            Closed

                        </option>

                    </select>

                </div>

            </div>

            <!-- Filter -->

            <div class="col-md-2">

                <button type="button"
                        class="btn bg-primary btn-block">

                    <i class="icon-search4 position-left"></i>

                    Filter

                </button>

            </div>

        </div>

    </div>

    <!-- Grid -->

    <table class="table table-hover table-striped datatable-basic">

        <thead>

            <tr>

                <th width="60">

                    #

                </th>

                <th>

                    Financial Year

                </th>

                <th>

                    Code

                </th>

                <th>

                    Company

                </th>

                <th>

                    Period

                </th>

                <th>

                    Status

                </th>

                <th>

                    Current

                </th>

                <th width="180"
                    class="text-center">

                    Action

                </th>

            </tr>

        </thead>

        <tbody id="financialYearTable">
            @{
                int sr = 1;
            }

            @foreach (var item in Model)
            {
                <tr>

                    <!-- Sr No -->

                    <td>

                        @sr

                    </td>

                    <!-- Financial Year -->

                    <td>

                        <div class="text-semibold">

                            <i class="icon-calendar3 text-primary position-left"></i>

                            @item.Name

                        </div>

                    </td>

                    <!-- Code -->

                    <td>

                        <span class="label bg-primary">

                            @item.Code

                        </span>

                    </td>

                    <!-- Company -->

                    <td>

                        <span class="label bg-info">

                            @item.CompanyName

                        </span>

                    </td>

                    <!-- Period -->

                    <td>

                        <small>

                            @item.StartDate.ToString("dd-MMM-yyyy")

                            <br />

                            <i class="icon-arrow-right5 text-muted"></i>

                            @item.EndDate.ToString("dd-MMM-yyyy")

                        </small>

                    </td>

                    <!-- Status -->

                    <td>

                        @if (item.Status == EnumExtensions.FinancialYearStatus.Open)
                        {
                            <span class="label bg-success">

                                Open

                            </span>
                        }
                        else if (item.Status == EnumExtensions.FinancialYearStatus.Upcoming)
                        {
                            <span class="label bg-warning">

                                Upcoming

                            </span>
                        }
                        else
                        {
                            <span class="label bg-danger">

                                Closed

                            </span>
                        }

                    </td>

                    <!-- Current FY -->

                    <td>

                        @if (item.IsCurrent)
                        {
                            <span class="label bg-primary">

                                <i class="icon-star-full2"></i>

                                Current

                            </span>
                        }
                        else
                        {
                            <span class="label bg-grey">

                                No

                            </span>
                        }

                    </td>

                    <!-- Actions -->

                    <td class="text-center">

                        <div class="btn-group">

                            <!-- Details -->

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-default btn-icon"
                               data-popup="tooltip"
                               title="Details">

                                <i class="icon-eye"></i>

                            </a>

                            <!-- Edit -->

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn bg-primary btn-icon"
                               data-popup="tooltip"
                               title="Edit">

                                <i class="icon-pencil7"></i>

                            </a>

                            <!-- Delete -->

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               onclick="return confirmSweetDelete(event, this, 'Are you sure you want to delete this Financial Year?');"
                               class="btn btn-danger btn-icon"
                               data-popup="tooltip"
                               title="Delete">

                                <i class="icon-trash"></i>

                            </a>

                        </div>

                    </td>

                </tr>

                sr++;
            }

        </tbody>

    </table>

</div>

@section Scripts {
    <script>

        // Search Table

        document.getElementById("searchInput")
            .addEventListener("keyup", function () {

                let value = this.value.toLowerCase();

                let rows = document.querySelectorAll("#financialYearTable tr");

                rows.forEach(function (row) {

                    let text = row.innerText.toLowerCase();

                    row.style.display =
                        text.includes(value) ? "" : "none";

                });

            });

    </script>
