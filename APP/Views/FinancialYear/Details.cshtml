@model FinancialYearDto

@{
    ViewData["Title"] = "Financial Year Details";
}

<div class="container-fluid py-4">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="card shadow border-0 rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="card-header bg-success text-white py-4">

                    <div class="d-flex align-items-center">

                        <div class="me-3">

                            <div class="bg-white text-success rounded-circle d-flex align-items-center justify-content-center"
                                 style="width:70px;height:70px;">

                                <i class="bi bi-calendar-range-fill fs-2"></i>

                            </div>

                        </div>

                        <div>

                            <h3 class="mb-1">
                                @Model.Name
                            </h3>

                            <p class="mb-0 opacity-75">

                                Financial Year Code :
                                @Model.Code

                            </p>

                        </div>

                    </div>

                </div>

                <!-- Body -->
                <div class="card-body p-4">

                    <div class="row g-4">

                        <!-- Financial Year Information -->
                        <div class="col-md-6">

                            <div class="card border-0 shadow-sm rounded-4 h-100">

                                <div class="card-header bg-light">

                                    <h5 class="mb-0">

                                        <i class="bi bi-info-circle text-success"></i>
                                        Financial Year Information

                                    </h5>

                                </div>

                                <div class="card-body">

                                    <table class="table table-borderless mb-0">

                                        <tr>

                                            <th width="200">
                                                Financial Year
                                            </th>

                                            <td>
                                                @Model.Name
                                            </td>

                                        </tr>

                                        <tr>

                                            <th>
                                                Financial Year Code
                                            </th>

                                            <td>

                                                <span class="badge bg-dark">
                                                    @Model.Code
                                                </span>

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>
                                                Company
                                            </th>

                                            <td>

                                                <span class="badge bg-primary">
                                                    @Model.CompanyName
                                                </span>

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>
                                                Status
                                            </th>

                                            <td>

                                                <span class="badge bg-success">
                                                    @Model.Status
                                                </span>

                                            </td>

                                        </tr>

                                    </table>

                                </div>

                            </div>

                        </div>

                        <!-- Date Information -->
                        <div class="col-md-6">

                            <div class="card border-0 shadow-sm rounded-4 h-100">

                                <div class="card-header bg-light">

                                    <h5 class="mb-0">

                                        <i class="bi bi-calendar-event text-success"></i>
                                        Date Information

                                    </h5>

                                </div>

                                <div class="card-body">

                                    <table class="table table-borderless mb-0">

                                        <tr>

                                            <th width="200">
                                                Start Date
                                            </th>

                                            <td>

                                                @Model.StartDate.ToString("dd MMM yyyy")

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>
                                                End Date
                                            </th>

                                            <td>

                                                @Model.EndDate.ToString("dd MMM yyyy")

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>
                                                Current FY
                                            </th>

                                            <td>

                                                @if (Model.IsCurrent)
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        Current
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">
                                                        No
                                                    </span>
                                                }

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>
                                                Modified On
                                            </th>

                                            <td>

                                                @(Model.ModifiedOn.HasValue
                                                    ? Model.ModifiedOn.Value.ToString("dd MMM yyyy")
                                                    : "-")

                                            </td>

                                        </tr>

                                    </table>

                                </div>

                            </div>

                        </div>

                        <!-- Status -->
                        <div class="col-md-12">

                            <div class="card border-0 shadow-sm rounded-4">

                                <div class="card-header bg-light">

                                    <h5 class="mb-0">

                                        <i class="bi bi-check-circle text-success"></i>
                                        Financial Year Status

                                    </h5>

                                </div>

                                <div class="card-body">

                                    <div class="row text-center">

                                        <!-- Status -->
                                        <div class="col-md-4">

                                            <div class="border rounded-4 p-4">

                                                <i class="bi bi-check-circle-fill text-success fs-1"></i>

                                                <h6 class="mt-3">
                                                    Status
                                                </h6>

                                                <span class="badge bg-success">
                                                    @Model.Status
                                                </span>

                                            </div>

                                        </div>

                                        <!-- Current -->
                                        <div class="col-md-4">

                                            <div class="border rounded-4 p-4">

                                                <i class="bi bi-calendar-check-fill text-warning fs-1"></i>

                                                <h6 class="mt-3">
                                                    Current FY
                                                </h6>

                                                @if (Model.IsCurrent)
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        Active FY
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">
                                                        No
                                                    </span>
                                                }

                                            </div>

                                        </div>

                                        <!-- Company -->
                                        <div class="col-md-4">

                                            <div class="border rounded-4 p-4">

                                                <i class="bi bi-building-fill text-primary fs-1"></i>

                                                <h6 class="mt-3">
                                                    Company
                                                </h6>

                                                <span class="badge bg-primary">
                                                    @Model.CompanyName
                                                </span>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Footer -->
                    <div class="mt-4 text-end">

                        <a asp-action="Index"
                           class="btn btn-light border rounded-3 px-4">

                            <i class="bi bi-arrow-left"></i>
                            Back

                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-success rounded-3 px-4">

                            <i class="bi bi-pencil-square"></i>
                            Edit Financial Year

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>