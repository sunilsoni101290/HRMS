@model FinancialYearDto

@{
    ViewData["Title"] = "Financial Year Details";
}

<div class="panel panel-flat">

    <!-- Header -->

    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-calendar3 position-left"></i>

            Financial Year Details

        </h5>

        <div class="heading-elements">

            <a asp-action="Index"
               class="btn btn-default">

                <i class="icon-arrow-left13 position-left"></i>

                Back

            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn bg-primary">

                <i class="icon-pencil7 position-left"></i>

                Edit

            </a>

        </div>

    </div>

    <div class="panel-body">

        <!-- Summary -->

        <div class="row">

            <div class="col-md-3">

                <div class="panel bg-primary-400">

                    <div class="panel-body">

                        <h3 class="no-margin">

                            @Model.Name

                        </h3>

                        Financial Year

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="panel bg-success-400">

                    <div class="panel-body">

                        <h3 class="no-margin">

                            @Model.CompanyName

                        </h3>

                        Company

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="panel bg-warning-400">

                    <div class="panel-body">

                        <h3 class="no-margin">

                            @Model.Status

                        </h3>

                        Status

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="panel bg-info-400">

                    <div class="panel-body">

                        <h3 class="no-margin">

                            @(Model.IsCurrent ? "YES" : "NO")

                        </h3>

                        Current FY

                    </div>

                </div>

            </div>

        </div>

        <hr />

        <div class="row">

            <!-- Basic Information -->

            <div class="col-md-6">

                <div class="panel panel-bordered">

                    <div class="panel-heading">

                        <h6 class="panel-title">

                            <i class="icon-info22 position-left"></i>

                            Basic Information

                        </h6>

                    </div>

                    <table class="table table-bordered">

                        <tr>

                            <th width="220">

                                Financial Year

                            </th>

                            <td>

                                @Model.Name

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Code

                            </th>

                            <td>

                                <span class="label bg-primary">

                                    @Model.Code

                                </span>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Company

                            </th>

                            <td>

                                @Model.CompanyName

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Status

                            </th>

                            <td>

                                @if (Model.Status == EnumExtensions.FinancialYearStatus.Open)
                                {
                                    <span class="label bg-success">

                                        Open

                                    </span>
                                }
                                else if (Model.Status == EnumExtensions.FinancialYearStatus.Upcoming)
                                {
                                    <span class="label bg-warning">

                                        Upcoming

                                    </span>
                                }
                                else
                                {
                                    <span class="label bg-danger">

                                        Closed

                                    </span>
                                }

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Current Financial Year

                            </th>

                            <td>

                                @if (Model.IsCurrent)
                                {
                                    <span class="label bg-primary">

                                        Current

                                    </span>
                                }
                                else
                                {
                                    <span class="label bg-grey">

                                        No

                                    </span>
                                }

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

            <!-- Date Information -->

            <div class="col-md-6">

                <div class="panel panel-bordered">

                    <div class="panel-heading">

                        <h6 class="panel-title">

                            <i class="icon-calendar52 position-left"></i>

                            Financial Period

                        </h6>

                    </div>

                    <table class="table table-bordered">

                        <tr>

                            <th width="220">

                                Start Date

                            </th>

                            <td>

                                @Model.StartDate.ToString("dd-MMM-yyyy")

                            </td>

                        </tr>

                        <tr>

                            <th>

                                End Date

                            </th>

                            <td>

                                @Model.EndDate.ToString("dd-MMM-yyyy")

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Total Days

                            </th>

                            <td>

                                @((Model.EndDate - Model.StartDate).Days + 1)
                                Days

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

        </div>

        <!-- Audit -->

        <div class="panel panel-bordered">

            <div class="panel-heading">

                <h6 class="panel-title">

                    <i class="icon-history position-left"></i>

                    Audit Information

                </h6>

            </div>

            <table class="table table-bordered">

                <tr>

                    <th>

                        Created By

                    </th>

                    <td>

                        @(string.IsNullOrEmpty(Model.CreatedBy)
                            ? "-"
                            : Model.CreatedBy)

                    </td>

                </tr>

                <tr>

                    <th>

                        Modified On

                    </th>

                    <td>

                        @(Model.ModifiedOn?.ToString("dd-MMM-yyyy HH:mm") ?? "-")

                    </td>

                </tr>

                <tr>

                    <th>

                        Modified By

                    </th>

                    <td>

                        @(string.IsNullOrEmpty(Model.ModifiedBy)
                            ? "-"
                            : Model.ModifiedBy)

                    </td>

                </tr>

            </table>

        </div>

    </div>

</div>

<style>

    .panel-bordered {
        border: 1px solid #ddd;
        margin-bottom: 20px;
    }

        .panel-bordered .panel-heading {
            background: #fafafa;
            border-bottom: 1px solid #ddd;
        }

    .table > tbody > tr > th {
        width: 220px;
        background: #fafafa;
        font-weight: 600;
    }

    .label {
        font-size: 11px;
        padding: 5px 10px;
    }

    .text-semibold {
        font-weight: 600;
    }

    .panel.bg-primary-400,
    .panel.bg-success-400,
    .panel.bg-warning-400,
    .panel.bg-info-400 {
        margin-bottom: 20px;
    }

        .panel.bg-primary-400 h3,
        .panel.bg-success-400 h3,
        .panel.bg-warning-400 h3,
        .panel.bg-info-400 h3 {
            color: #fff;
        }

</style>