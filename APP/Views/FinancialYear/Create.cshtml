@model FinancialYearDto

@{
    ViewData["Title"] = "Financial Year";
}

<form asp-action="@(string.IsNullOrEmpty(Model?.Id) ? "Create" : "Edit")"
      method="post">

    <!-- Hidden Fields -->

    <input asp-for="Id" type="hidden" />
    <input asp-for="TenantId" type="hidden" />
    <input asp-for="CreatedBy" type="hidden" />
    <input asp-for="ModifiedBy" type="hidden" />
    <input asp-for="ModifiedOn" type="hidden" />

    <div class="panel panel-flat">

        <!-- Header -->

        <div class="panel-heading">

            <h5 class="panel-title">

                <i class="icon-calendar3 position-left"></i>

                @(string.IsNullOrEmpty(Model?.Id)
                    ? "Create Financial Year"
                    : "Edit Financial Year")

            </h5>

            <div class="heading-elements">

                <a asp-action="Index"
                   class="btn btn-default">

                    <i class="icon-arrow-left13 position-left"></i>

                    Back

                </a>

            </div>

        </div>

        <!-- Body -->

        <div class="panel-body">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <!-- ======================================== -->
            <!-- Basic Information -->
            <!-- ======================================== -->

            <fieldset>

                <legend class="text-semibold">

                    <i class="icon-info22 position-left"></i>

                    Basic Information

                </legend>

                <div class="row">

                    <!-- Name -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="Name"></label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="2025-2026" />

                            <span asp-validation-for="Name"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <!-- Code -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="Code"></label>

                            <input asp-for="Code"
                                   class="form-control"
                                   placeholder="FY25-26" />

                            <span asp-validation-for="Code"
                                  class="text-danger"></span>

                        </div>

                    </div>

                </div>

            </fieldset>

            <!-- ======================================== -->
            <!-- Financial Year Configuration -->
            <!-- ======================================== -->

            <fieldset>

                <legend class="text-semibold">

                    <i class="icon-calendar52 position-left"></i>

                    Financial Year Configuration

                </legend>

                <div class="row">

                    <!-- Start Date -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="StartDate"></label>

                            <input asp-for="StartDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="StartDate"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <!-- End Date -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="EndDate"></label>

                            <input asp-for="EndDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="EndDate"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <!-- Status -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="Status"></label>

                            <select asp-for="Status"
                                    asp-items="EnumHelper.GetEnumList<EnumExtensions.FinancialYearStatus>()"
                                    class="form-control select-search">

                                <option value="">

                                    -- Select Status --

                                </option>

                            </select>

                            <span asp-validation-for="Status"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <!-- Company -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="CompanyId"></label>

                            <select asp-for="CompanyId"
                                    asp-items="ViewBag.CompanyList"
                                    id="CompanyId"
                                    class="form-control select-search">

                                <option value="">

                                    -- Select Company --

                                </option>

                            </select>

                            <span asp-validation-for="CompanyId"
                                  class="text-danger"></span>

                        </div>

                    </div>

                </div>

            </fieldset>
            <!-- ======================================== -->
            <!-- Current Financial Year -->
            <!-- ======================================== -->

            <fieldset>

                <legend class="text-semibold">

                    <i class="icon-checkmark-circle position-left"></i>

                    Current Financial Year

                </legend>

                <div class="row">

                    <div class="col-md-12">

                        <div class="checkbox checkbox-switchery switchery-sm">

                            <label>

                                <input asp-for="IsCurrent"
                                       type="checkbox"
                                       class="switchery" />

                                Set as Current Financial Year

                            </label>

                        </div>

                    </div>

                </div>

            </fieldset>

            <!-- ======================================== -->
            <!-- Summary -->
            <!-- ======================================== -->

            <fieldset>

                <legend class="text-semibold">

                    <i class="icon-stats-bars position-left"></i>

                    Financial Year Summary

                </legend>

                <div class="row">

                    <!-- FY Name -->

                    <div class="col-md-3">

                        <div class="panel bg-primary-400">

                            <div class="panel-body">

                                <h4 class="no-margin">

                                    <span id="FyNamePreview">

                                        @(string.IsNullOrWhiteSpace(Model?.Name)
                                            ? "-"
                                            : Model.Name)

                                    </span>

                                </h4>

                                Financial Year

                            </div>

                        </div>

                    </div>

                    <!-- Company -->

                    <div class="col-md-3">

                        <div class="panel bg-success-400">

                            <div class="panel-body">

                                <h4 class="no-margin">

                                    <span id="CompanyPreview">

                                        @(string.IsNullOrWhiteSpace(Model?.CompanyName)
                                            ? "-"
                                            : Model.CompanyName)

                                    </span>

                                </h4>

                                Company

                            </div>

                        </div>

                    </div>

                    <!-- Duration -->

                    <div class="col-md-3">

                        <div class="panel bg-warning-400">

                            <div class="panel-body">

                                <h4 class="no-margin">

                                    <span id="DurationPreview">

                                        -

                                    </span>

                                </h4>

                                Duration

                            </div>

                        </div>

                    </div>

                    <!-- Status -->

                    <div class="col-md-3">

                        <div class="panel bg-info-400">

                            <div class="panel-body">

                                <h4 class="no-margin">

                                    <span id="StatusPreview">

                                        @(Model?.Status.ToString() ?? "-")

                                    </span>

                                </h4>

                                Status

                            </div>

                        </div>

                    </div>

                </div>

            </fieldset>

        </div>

        <!-- ======================================== -->
        <!-- Footer -->
        <!-- ======================================== -->

        <div class="panel-footer text-right">

            <a asp-action="Index"
               class="btn btn-default">

                <i class="icon-arrow-left13 position-left"></i>

                Back

            </a>

            <button type="reset"
                    class="btn btn-warning">

                <i class="icon-reset position-left"></i>

                Reset

            </button>

            <button type="submit"
                    class="btn bg-primary">

                <i class="icon-floppy-disk position-left"></i>

                @(string.IsNullOrEmpty(Model?.Id)
                    ? "Save Financial Year"
                    : "Update Financial Year")

            </button>

        </div>

    </div>

</form>
@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        $(document).ready(function () {

            //=========================================
            // Chosen Dropdown
            //=========================================

            if ($(".select-search").length) {

                $(".select-search").chosen({

                    width: "100%",
                    search_contains: true,
                    allow_single_deselect: true

                });

            }

            //=========================================
            // Switchery
            //=========================================

            if ($(".switchery").length) {

                $(".switchery").each(function () {

                    new Switchery(this, {

                        color: '#2196F3'

                    });

                });

            }

            //=========================================
            // Name Preview
            //=========================================

            $("#Name").keyup(function () {

                var value = $(this).val();

                if (value == "")
                    value = "-";

                $("#FyNamePreview").text(value);

            });

            //=========================================
            // Company Preview
            //=========================================

            $("#CompanyId").change(function () {

                var company =
                    $("#CompanyId option:selected").text();

                if ($("#CompanyId").val() == "")
                    company = "-";

                $("#CompanyPreview").text(company);

            });

            //=========================================
            // Status Preview
            //=========================================

            $("#Status").change(function () {

                var status =
                    $("#Status option:selected").text();

                if ($("#Status").val() == "")
                    status = "-";

                $("#StatusPreview").text(status);

            });

            //=========================================
            // Duration
            //=========================================

            $("#StartDate,#EndDate").change(function () {

                calculateDuration();

            });

            function calculateDuration() {

                var start = $("#StartDate").val();

                var end = $("#EndDate").val();

                if (start == "" || end == "") {

                    $("#DurationPreview").text("-");

                    return;

                }

                var startDate = new Date(start);

                var endDate = new Date(end);

                var diff =
                    endDate.getTime() -
                    startDate.getTime();

                var days =
                    Math.floor(diff / (1000 * 60 * 60 * 24));

                if (days < 0)
                    days = 0;

                $("#DurationPreview").text(days + " Days");

            }

            calculateDuration();

            //=========================================
            // Validation
            //=========================================

            $("form").submit(function () {

                if ($("#Name").val().trim() == "") {

                    alert("Please enter Financial Year Name.");

                    $("#Name").focus();

                    return false;

                }

                if ($("#Code").val().trim() == "") {

                    alert("Please enter Financial Year Code.");

                    $("#Code").focus();

                    return false;

                }

                if ($("#CompanyId").val() == "") {

                    alert("Please select Company.");

                    $("#CompanyId").focus();

                    return false;

                }

                if ($("#StartDate").val() == "") {

                    alert("Please select Start Date.");

                    $("#StartDate").focus();

                    return false;

                }

                if ($("#EndDate").val() == "") {

                    alert("Please select End Date.");

                    $("#EndDate").focus();

                    return false;

                }

                if ($("#Status").val() == "") {

                    alert("Please select Status.");

                    $("#Status").focus();

                    return false;

                }

                return true;

            });

        });

    </script>

    <style>

        .panel-heading {
            padding: 18px 20px;
        }

        .panel-title {
            font-weight: 600;
        }

        .panel-body {
            padding: 20px;
        }

        fieldset {
            border: 1px solid #e5e5e5;
            padding: 20px;
            margin-bottom: 20px;
        }

        legend {
            width: auto;
            padding: 0 10px;
            border: none;
            font-size: 15px;
            font-weight: 600;
        }

        .panel-footer {
            background: #fafafa;
            padding: 15px 20px;
        }

        .panel.bg-primary-400,
        .panel.bg-success-400,
        .panel.bg-warning-400,
        .panel.bg-info-400 {
            margin-bottom: 15px;
            border-radius: 3px;
        }

            .panel.bg-primary-400 h4,
            .panel.bg-success-400 h4,
            .panel.bg-warning-400 h4,
            .panel.bg-info-400 h4 {
                color: #fff;
                font-weight: 600;
            }

        .chosen-container {
            width: 100% !important;
        }

        .chosen-single {
            height: 36px !important;
            line-height: 34px !important;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .text-danger {
            font-size: 12px;
        }

        .btn {
            min-width: 110px;
        }

        .alert {
            margin-bottom: 20px;
        }

        .checkbox-switchery {
            margin-top: 10px;
        }

    </style>

}