@model IEnumerable<DesignationListDto>

@{
    ViewData["Title"] = "Designation Management";
}

<div class="panel panel-flat">

    <!-- Header -->

    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-user-tie position-left"></i>

            Designation Management

        </h5>

        <div class="heading-elements">

            <a asp-action="Export"
               class="btn btn-default">

                <i class="icon-file-download"></i>

                Export

            </a>

            <a asp-action="DownloadImportTemplate"
               class="btn bg-success">

                <i class="icon-file-spreadsheet"></i>

                Download Template

            </a>

            <a asp-action="Import"
               class="btn bg-info">

                <i class="icon-upload3"></i>

                Import

            </a>

            <a asp-action="Create"
               class="btn bg-primary">

                <i class="icon-plus22"></i>

                Add Designation

            </a>

        </div>

    </div>

    <!-- Search Panel -->

    <div class="panel-body">

        <div class="row">

            <div class="col-md-4">

                <input type="text"
                       id="searchInput"
                       class="form-control"
                       placeholder="Search Designation..." />

            </div>

            <div class="col-md-3">

                <select class="form-control">

                    <option value="">
                        All Companies
                    </option>

                </select>

            </div>

            <div class="col-md-3">

                <select class="form-control">

                    <option value="">
                        All Departments
                    </option>

                </select>

            </div>

            <div class="col-md-2">

                <button class="btn bg-primary btn-block">

                    <i class="icon-search4"></i>

                    Search

                </button>

            </div>

        </div>

    </div>

    <!-- Table -->

    <table class="table table-hover table-striped datatable-basic">

        <thead>

            <tr>

                <th width="60">#</th>

                <th>Designation</th>

                <th>Code</th>

                <th>Department</th>

                <th>Level</th>

                <th class="text-right">Min Salary</th>

                <th class="text-right">Max Salary</th>

                <th>Status</th>

                <th width="170">Action</th>

            </tr>

        </thead>

        <tbody id="designationTable">

            @{
                int sr = 1;
            }

            @foreach (var item in Model)
            {

                <tr>

                    <td>@sr</td>

                    <td>

                        <strong>

                            @item.Name

                        </strong>

                    </td>

                    <td>

                        <span class="label bg-primary">

                            @item.Code

                        </span>

                    </td>

                    <td>

                        @(ViewBag.DepartmentNames != null &&
                          ViewBag.DepartmentNames.ContainsKey(item.DepartmentId)
                            ? ViewBag.DepartmentNames[item.DepartmentId]
                            : "-")

                    </td>

                    <td>

                        <span class="label bg-info">

                            Level @item.Level

                        </span>

                    </td>

                    <td class="text-right">

                        ₹ @item.MinSalary.ToString("N2")

                    </td>

                    <td class="text-right">

                        ₹ @item.MaxSalary.ToString("N2")

                    </td>

                    <td>

                        <span class="label bg-success">

                            Active

                        </span>

                    </td>

                    <td>

                        <div class="btn-group">

                            <!-- Details -->

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-default btn-icon"
                               title="View">

                                <i class="icon-eye"></i>

                            </a>

                            <!-- Edit -->

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-primary btn-icon"
                               title="Edit">

                                <i class="icon-pencil7"></i>

                            </a>

                            <!-- Delete -->

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               onclick="return confirm('Are you sure you want to delete this designation?');"
                               class="btn btn-danger btn-icon"
                               title="Delete">

                                <i class="icon-trash"></i>

                            </a>

                        </div>

                    </td>

                </tr>

                sr++;

            }

        </tbody>

    </table>

</div>

@section Scripts {

    <script>

        $(function () {

            $("#searchInput").on("keyup", function () {

                var value = $(this).val().toLowerCase();

                $("#designationTable tr").filter(function () {

                    $(this).toggle(

                        $(this).text().toLowerCase().indexOf(value) > -1

                    );

                });

            });

        });

    </script>

    <style>

        .table > thead > tr > th {
            font-weight: 600;
        }

        .table > tbody > tr > td {
            vertical-align: middle;
        }

        .label {
            font-size: 11px;
        }

        .btn-icon {
            width: 34px;
        }

    </style>

}
