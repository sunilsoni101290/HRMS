@model IEnumerable<DesignationListDto>

@{
    ViewData["Title"] = "Designation List";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-person-workspace text-success"></i>
                Designation Management
            </h3>

            <p class="text-muted mb-0">
                Manage all company designations
            </p>
        </div>

        <div>
            <a asp-action="Create"
               class="btn btn-success rounded-3 px-4 shadow-sm">

                <i class="bi bi-plus-circle"></i>
                Add Designation
            </a>
        </div>

    </div>

    <!-- Search & Filter -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">
                    <input type="text"
                           id="searchInput"
                           class="form-control"
                           placeholder="Search designation..." />
                </div>

                <div class="col-md-3">
                    <select class="form-select">
                        <option value="">All Companies</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <select class="form-select">
                        <option value="">All Departments</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <button class="btn btn-outline-success w-100">
                        <i class="bi bi-funnel"></i>
                        Filter
                    </button>
                </div>

            </div>

        </div>

    </div>

    <!-- Grid -->
    <div class="card border-0 shadow rounded-4">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>#</th>
                            <th>Designation</th>
                            <th>Code</th>
                            <th>Department</th>
                            <th>Level</th>
                            <th>Min Salary</th>
                            <th>Max Salary</th>
                            <th>Status</th>
                            <th width="140">Action</th>
                        </tr>

                    </thead>

                    <tbody id="designationTable">

                        @{
                            int sr = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @sr
                                </td>

                                <td>
                                    <div class="fw-semibold">
                                        @item.Name
                                    </div>
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @item.Code
                                    </span>
                                </td>

                                <td>
                                    @(ViewBag.DepartmentNames != null &&
                                        ViewBag.DepartmentNames.ContainsKey(item.DepartmentId)
                                            ? ViewBag.DepartmentNames[item.DepartmentId]
                                            : "-")
                                </td>

                                <td>
                                    <span class="badge bg-info">
                                        Level @item.Level
                                    </span>
                                </td>

                                <td>
                                    ₹ @item.MinSalary
                                </td>

                                <td>
                                    ₹ @item.MaxSalary
                                </td>

                                <td>
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                </td>

                                <td>

                                    <div class="d-flex gap-2">

                                        <!-- Edit -->
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary rounded-3">

                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <!-- Details -->
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info rounded-3">

                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <!-- Delete -->
                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           onclick="return confirm('Are you sure to delete this designation?')"
                                           class="btn btn-sm btn-outline-danger rounded-3">

                                            <i class="bi bi-trash"></i>
                                        </a>

                                    </div>

                                </td>

                            </tr>

                            sr++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        // Designation Search

        document.getElementById("searchInput")
            .addEventListener("keyup", function () {

                let designation_value =
                    this.value.toLowerCase();

                let designation_rows =
                    document.querySelectorAll("#designationTable tr");

                designation_rows.forEach(function (designation_row) {

                    let designation_text =
                        designation_row.innerText.toLowerCase();

                    designation_row.style.display =
                        designation_text.includes(designation_value)
                            ? ""
                            : "none";

                });

            });

    </script>
    <style>
        table th {
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            font-weight: 600;
        }

        table td {
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: normal;
        }
    </style>

}