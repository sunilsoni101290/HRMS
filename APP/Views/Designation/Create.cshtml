@model DesignationDto

@{
    ViewData["Title"] = "Designation";
}

<form asp-action="@(string.IsNullOrEmpty(Model?.Id) ? "Create" : "Edit")"
      asp-controller="Designation"
      method="post">

    <input asp-for="Id" type="hidden" />
    <input asp-for="TenantId" type="hidden" />
    <input asp-for="CreatedBy" type="hidden" />
    <input asp-for="ModifiedBy" type="hidden" />
    <input asp-for="ModifiedOn" type="hidden" />

    <div class="panel panel-flat">

        <div class="panel-heading">

            <h5 class="panel-title">

                <i class="icon-user-tie position-left"></i>

                @(string.IsNullOrEmpty(Model?.Id)
                    ? "Create Designation"
                    : "Edit Designation")

            </h5>

            <div class="heading-elements">

                <a asp-action="Index"
                   class="btn btn-default">

                    <i class="icon-arrow-left13"></i>

                    Back

                </a>

            </div>

        </div>

        <div class="panel-body">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <!-- Basic Information -->

            <fieldset>

                <legend class="text-semibold">

                    <i class="icon-info22 position-left"></i>

                    Basic Information

                </legend>

                <div class="row">

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="Name"></label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter Designation Name" />

                            <span asp-validation-for="Name"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="Code"></label>

                            <input asp-for="Code"
                                   class="form-control"
                                   placeholder="Enter Designation Code" />

                            <span asp-validation-for="Code"
                                  class="text-danger"></span>

                        </div>

                    </div>

                </div>

            </fieldset>

            <!-- Organization -->

            <fieldset>

                <legend class="text-semibold">

                    <i class="icon-office position-left"></i>

                    Organization Information

                </legend>

                <div class="row">

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="CompanyId"></label>

                            <select asp-for="CompanyId"
                                    asp-items="ViewBag.CompanyList"
                                    class="form-control"
                                    id="CompanyId">

                                <option value="">Select Company</option>

                            </select>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="BranchId"></label>

                            <select asp-for="BranchId"
                                    asp-items="ViewBag.BranchList"
                                    class="form-control" id="BranchId">

                                <option value="">Select Branch</option>

                            </select>

                        </div>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="DepartmentId"></label>

                            <select asp-for="DepartmentId"
                                    asp-items="ViewBag.DepartmentList"
                                    class="form-control">

                                <option value="">Select Department</option>

                            </select>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="ParentDesignationId"></label>

                            <select asp-for="ParentDesignationId"
                                    asp-items="ViewBag.ParentDesignationList"
                                    class="form-control">

                                <option value="">Select Parent Designation</option>

                            </select>

                        </div>

                    </div>

                </div>

            </fieldset>

            <!-- Salary Information -->

            <fieldset>

                <legend class="text-semibold">

                    <i class="icon-coins position-left"></i>

                    Salary & Level

                </legend>

                <div class="row">

                    <div class="col-md-4">

                        <div class="form-group">

                            <label asp-for="Level"></label>

                            <input asp-for="Level"
                                   type="number"
                                   class="form-control"
                                   placeholder="Level" />

                            <span asp-validation-for="Level"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="form-group">

                            <label asp-for="MinSalary"></label>

                            <div class="input-group">

                                <span class="input-group-addon">
                                    ₹
                                </span>

                                <input asp-for="MinSalary"
                                       type="number"
                                       step="0.01"
                                       class="form-control"
                                       placeholder="Minimum Salary" />

                            </div>

                            <span asp-validation-for="MinSalary"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="form-group">

                            <label asp-for="MaxSalary"></label>

                            <div class="input-group">

                                <span class="input-group-addon">
                                    ₹
                                </span>

                                <input asp-for="MaxSalary"
                                       type="number"
                                       step="0.01"
                                       class="form-control"
                                       placeholder="Maximum Salary" />

                            </div>

                            <span asp-validation-for="MaxSalary"
                                  class="text-danger"></span>

                        </div>

                    </div>

                </div>

            </fieldset>

        </div>

        <div class="panel-footer text-right">

            <button type="reset"
                    class="btn btn-default">

                <i class="icon-reset"></i>

                Reset

            </button>

            <button type="submit"
                    class="btn bg-primary">

                <i class="icon-floppy-disk"></i>

                @(string.IsNullOrEmpty(Model?.Id)
                    ? "Save"
                    : "Update")

            </button>

        </div>

    </div>

</form>


@section Scripts {

    @if (TempData["Success"] != null)
    {
        <script>

            $(function () {

                swal({
                    title: "Success",
                    text: "@TempData["Success"]",
                    type: "success"
                });

            });

        </script>
    }

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>

        $(document).ready(function () {

        $(document).on("change", "#CompanyId", function () {

        debugger;

        let companyId = $(this).val();

        console.log(companyId);

        if (companyId == null || companyId === "") {

        $("#BranchId").html(
        '<option value="">-- Select Branch --</option>'
        );

        return;
        }

        $.ajax({

        url: '@Url.Action("GetBranchByCompanyId")',

        type: 'GET',

        data: { companyId: companyId },

        success: function (response) {

        let html = '<option value="">-- Select Branch --</option>';

        $.each(response, function (i, item) {

        html += `<option value="${item.value}">
        ${item.text}
        </option>`;
        });

        $("#BranchId").html(html);
        },

        error: function (xhr) {

        console.log(xhr);

        alert("Error loading branches");
        }
        });

        });

        });

    </script>
    <partial name="_ValidationScriptsPartial" />
   
}
