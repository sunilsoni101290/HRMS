@model DesignationDto

@{
    ViewData["Title"] = "Designation";
}

<div class="container-fluid py-4">

    <div class="row justify-content-center">

        <div class="col-lg-10">

            <div class="card shadow border-0 rounded-4">

                <!-- Header -->
                <div class="card-header bg-success text-white py-3 rounded-top-4">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-workspace fs-4 me-2"></i>

                        <h4 class="mb-0">
                            @(string.IsNullOrEmpty(Model?.Id)
                                ? "Create Designation"
                                : "Edit Designation")
                        </h4>
                    </div>
                </div>

                <!-- Body -->
                <div class="card-body p-4">

                    <form asp-action="@(Model.Id == null ? "Create" : "Edit")"
                          asp-controller="Designation" method="post">

                        <!-- Hidden Fields -->
                        <input asp-for="Id" type="hidden" />
                        <input asp-for="TenantId" type="hidden" />
                        <input asp-for="CreatedBy" type="hidden" />
                        <input asp-for="ModifiedBy" type="hidden" />
                        <input asp-for="ModifiedOn" type="hidden" />

                        <div class="row g-4">

                            <!-- Name -->
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-semibold">
                                    Designation Name
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-person-badge"></i>
                                    </span>

                                    <input asp-for="Name"
                                           class="form-control"
                                           placeholder="Enter Designation Name" />
                                </div>

                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <!-- Code -->
                            <div class="col-md-6">
                                <label asp-for="Code" class="form-label fw-semibold">
                                    Designation Code
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-upc-scan"></i>
                                    </span>

                                    <input asp-for="Code"
                                           class="form-control"
                                           placeholder="Enter Designation Code" />
                                </div>

                                <span asp-validation-for="Code" class="text-danger"></span>
                            </div>

                            <!-- Company -->
                            <div class="col-md-6">
                                <label asp-for="CompanyId" class="form-label fw-semibold">
                                    Company
                                </label>

                                <select asp-for="CompanyId"
                                        class="form-select"
                                        asp-items="ViewBag.CompanyList">
                                    <option value="">-- Select Company --</option>
                                </select>

                                <span asp-validation-for="CompanyId" class="text-danger"></span>
                            </div>

                            <!-- Branch -->
                            <div class="col-md-6">
                                <label asp-for="BranchId" class="form-label fw-semibold">
                                    Branch
                                </label>

                                <select asp-for="BranchId"
                                        class="form-select"
                                        asp-items="ViewBag.BranchList">
                                    <option value="">-- Select Branch --</option>
                                </select>

                                <span asp-validation-for="BranchId" class="text-danger"></span>
                            </div>

                            <!-- Department -->
                            <div class="col-md-6">
                                <label asp-for="DepartmentId" class="form-label fw-semibold">
                                    Department
                                </label>

                                <select asp-for="DepartmentId"
                                        class="form-select"
                                        asp-items="ViewBag.DepartmentList">
                                    <option value="">-- Select Department --</option>
                                </select>

                                <span asp-validation-for="DepartmentId" class="text-danger"></span>
                            </div>

                            <!-- Parent Designation -->
                            <div class="col-md-6">
                                <label asp-for="ParentDesignationId" class="form-label fw-semibold">
                                    Parent Designation
                                </label>

                                <select asp-for="ParentDesignationId"
                                        class="form-select"
                                        asp-items="ViewBag.ParentDesignationList">
                                    <option value="">-- Select Parent Designation --</option>
                                </select>

                                <span asp-validation-for="ParentDesignationId" class="text-danger"></span>
                            </div>

                            <!-- Level -->
                            <div class="col-md-4">
                                <label asp-for="Level" class="form-label fw-semibold">
                                    Designation Level
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-bar-chart-steps"></i>
                                    </span>

                                    <input asp-for="Level"
                                           type="number"
                                           class="form-control"
                                           placeholder="Enter Level" />
                                </div>

                                <span asp-validation-for="Level" class="text-danger"></span>
                            </div>

                            <!-- Minimum Salary -->
                            <div class="col-md-4">
                                <label asp-for="MinSalary" class="form-label fw-semibold">
                                    Minimum Salary
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        ₹
                                    </span>

                                    <input asp-for="MinSalary"
                                           type="number"
                                           step="0.01"
                                           class="form-control"
                                           placeholder="Enter Minimum Salary" />
                                </div>

                                <span asp-validation-for="MinSalary" class="text-danger"></span>
                            </div>

                            <!-- Maximum Salary -->
                            <div class="col-md-4">
                                <label asp-for="MaxSalary" class="form-label fw-semibold">
                                    Maximum Salary
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        ₹
                                    </span>

                                    <input asp-for="MaxSalary"
                                           type="number"
                                           step="0.01"
                                           class="form-control"
                                           placeholder="Enter Maximum Salary" />
                                </div>

                                <span asp-validation-for="MaxSalary" class="text-danger"></span>
                            </div>

                        </div>

                        <!-- Footer Buttons -->
                        <div class="mt-5 d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-light border rounded-3 px-4">
                                <i class="bi bi-arrow-left"></i>
                                Back
                            </a>

                            <button type="submit"
                                    class="btn btn-success rounded-3 px-4">

                                <i class="bi bi-check-circle"></i>

                                @(string.IsNullOrEmpty(Model?.Id)
                                    ? "Save"
                                    : "Update")
                            </button>
                        </div>
                        <div class="col-md-6">
                            @if (TempData["Success"] != null)
                            {
                                <div class="alert alert-success alert-dismissible fade show"
                                     role="alert">

                                    <i class="bi bi-check-circle-fill"></i>

                                    @TempData["Success"]

                                    <button type="button"
                                            class="btn-close"
                                            data-bs-dismiss="alert">
                                    </button>
                                </div>
                            }
                        </div>
                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}