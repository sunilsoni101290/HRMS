@model PunchRequestDto

@{
    ViewData["Title"] = "Employee Attendance Punch";
}

<div class="panel panel-flat">
    <div class="panel-heading">

        <h5 class="panel-title">
            <i class="icon-fingerprint position-left"></i>
            Employee Attendance
        </h5>

        <div class="heading-elements">
            <span class="label bg-success">
                Live Attendance
            </span>
        </div>

    </div>

    <div class="panel-body">

        @if (ViewBag.NoEmployeeProfile == true)
        {
            <div class="alert alert-danger">
                <i class="icon-cross2 position-left"></i>
                Your login isn't linked to an employee profile, so attendance can't be punched from this account.
                Contact your admin to link an employee record to your user account.
            </div>
        }

        <!-- Status Summary -->

        <div class="row">

            <div class="col-md-3">
                <div class="panel bg-success-400">
                    <div class="panel-body text-center">
                        <h6 class="text-semibold">Current Status</h6>
                        <h5 id="CurrentStatus">-</h5>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="panel bg-primary-400">
                    <div class="panel-body text-center">
                        <h6 class="text-semibold">First In</h6>
                        <h5 id="FirstIn">-</h5>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="panel bg-info-400">
                    <div class="panel-body text-center">
                        <h6 class="text-semibold">Working Hours</h6>
                        <h5 id="WorkingHours">-</h5>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="panel bg-warning-400">
                    <div class="panel-body text-center">
                        <h6 class="text-semibold">Break Hours</h6>
                        <h5 id="BreakHours">-</h5>
                    </div>
                </div>
            </div>

        </div>

        <form asp-action="SavePunch" method="post">

            <input asp-for="EmployeeId" type="hidden" />

            <fieldset>

                <legend class="text-semibold">
                    <i class="icon-user position-left"></i>
                    Attendance Information
                </legend>

                <div class="row">

                    <div class="col-md-4">

                        <div class="form-group">

                            <label>Employee</label>

                            <p class="form-control-static">
                                <i class="icon-user2 position-left"></i>
                                <strong>@ViewBag.EmployeeDisplayName</strong>
                                <span class="text-muted">(punching in as yourself)</span>
                            </p>

                        </div>

                    </div>

                    <div class="col-md-2">

                        <div class="form-group">

                            <label>Punch Time</label>

                            <input asp-for="PunchTime"
                                   readonly
                                   id="PunchTime"
                                   class="form-control" />

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="form-group">

                            <label>Location</label>

                            <textarea asp-for="Location"
                                      id="Location"
                                      rows="2"
                                      class="form-control">
                        </textarea>

                        </div>

                    </div>

                </div>

            </fieldset>

            <!-- Action Buttons -->

            <div class="row" id="ActionButtons">

                <div class="col-md-3">

                    <button type="submit"
                            name="PunchType"
                            value="In"
                            class="btn bg-success btn-labeled btn-labeled-left btn-block">

                        <b>
                            <i class="icon-enter"></i>
                        </b>

                        Punch In

                    </button>

                </div>

                <div class="col-md-3">

                    <button type="submit"
                            name="PunchType"
                            value="BreakOut"
                            class="btn bg-warning btn-labeled btn-labeled-left btn-block">

                        <b>
                            <i class="icon-cup"></i>
                        </b>

                        Break Out

                    </button>

                </div>

                <div class="col-md-3">

                    <button type="submit"
                            name="PunchType"
                            value="BreakIn"
                            class="btn bg-info btn-labeled btn-labeled-left btn-block">

                        <b>
                            <i class="icon-loop3"></i>
                        </b>

                        Break In

                    </button>

                </div>

                <div class="col-md-3">

                    <button type="submit"
                            name="PunchType"
                            value="Out"
                            class="btn bg-danger btn-labeled btn-labeled-left btn-block">

                        <b>
                            <i class="icon-exit3"></i>
                        </b>

                        Punch Out

                    </button>

                </div>

            </div>

        </form>

    </div>
</div>


@section Scripts {

    <script>

        function updateTime() {

            let now = new Date();

            let formatted =
                now.getFullYear() + "-" +
                String(now.getMonth() + 1).padStart(2, '0') + "-" +
                String(now.getDate()).padStart(2, '0') + "T" +
                String(now.getHours()).padStart(2, '0') + ":" +
                String(now.getMinutes()).padStart(2, '0');

            document.getElementById("PunchTime")
                .value = formatted;
        }

        updateTime();

        setInterval(updateTime, 1000);

        // GPS

        if (navigator.geolocation) {

            navigator.geolocation.getCurrentPosition(

                async function(position) {

                    let lat = position.coords.latitude;

                    let lng = position.coords.longitude;

                    let url =
                        `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`;

                    let response = await fetch(url);

                    let data = await response.json();

                    if (data.display_name) {

                        document.getElementById("Location")
                            .value = data.display_name;
                    }
                }

            );

        }

    </script>
    <script>

        $(document).ready(function () {

            // Hide buttons initially
            $("#ActionButtons").empty();

            @if (ViewBag.NoEmployeeProfile == true)
            {
                <text>
                // No linked employee - nothing to load, buttons stay hidden.
                return;
                </text>
            }

            loadMyStatus();

            function loadMyStatus() {

                $.ajax({

                    url: '@Url.Action("GetMyAttendanceStatus", "Attendance")',

                    type: 'GET',

                    success: function (response) {

                        console.log(response);

                        // =========================
                        // STATUS DATA
                        // =========================

                        $("#CurrentStatus").text(response.CurrentStatus ?? "-");

                        if (response.FirstIn) {

                            let firstInDate = new Date(response.FirstIn);

                            let formattedFirstIn =
                                firstInDate.getFullYear() + "-" +
                                String(firstInDate.getMonth() + 1).padStart(2, '0') + "-" +
                                String(firstInDate.getDate()).padStart(2, '0') + " " +
                                firstInDate.toLocaleTimeString([], {
                                    hour: '2-digit',
                                    minute: '2-digit',
                                    hour12: true
                                });

                            $("#FirstIn").text(formattedFirstIn);
                        }
                        else {

                            $("#FirstIn").text("-");
                        }

                        $("#WorkingHours").text(response.WorkingHours ?? 0);
                        $("#BreakHours").text(response.BreakHours ?? 0);

                        // =========================
                        // BUTTONS
                        // =========================

                        let buttons = "";

                        // Punch In
                        if (response.CanPunchIn === true) {

                            buttons += `
                            <div class="col-md-6">
                                <button type="submit"
                                        name="PunchType"
                                        value="In"
                                        class="btn btn-success btn-lg w-100">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    Punch In
                                </button>
                            </div>`;
                        }

                        // Break Out
                        if (response.CanBreakOut === true) {

                            buttons += `
                            <div class="col-md-6">
                                <button type="submit"
                                        name="PunchType"
                                        value="BreakOut"
                                        class="btn btn-warning btn-lg w-100">
                                    <i class="bi bi-cup-hot"></i>
                                    Break Out
                                </button>
                            </div>`;
                        }

                        // Break In
                        if (response.CanBreakIn === true) {

                            buttons += `
                            <div class="col-md-6">
                                <button type="submit"
                                        name="PunchType"
                                        value="BreakIn"
                                        class="btn btn-info btn-lg w-100">
                                    <i class="bi bi-arrow-repeat"></i>
                                    Break In
                                </button>
                            </div>`;
                        }

                        // Punch Out
                        if (response.CanPunchOut === true) {

                            buttons += `
                            <div class="col-md-6">
                                <button type="submit"
                                        name="PunchType"
                                        value="Out"
                                        class="btn btn-danger btn-lg w-100">
                                    <i class="bi bi-box-arrow-right"></i>
                                    Punch Out
                                </button>
                            </div>`;
                        }

                        // Render buttons
                        $("#ActionButtons").html(buttons);
                    },

                    error: function (xhr, status, error) {

                        console.log(xhr);
                        console.log(status);
                        console.log(error);

                        $("#ActionButtons").empty();

                        alert("Error loading employee attendance status.");
                    }

                });

            }

        });

    </script>

}