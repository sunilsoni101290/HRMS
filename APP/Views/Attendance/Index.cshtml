@model IEnumerable<AttendanceLogDto>

@{
    ViewData["Title"] = "Attendance Punch List";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h3 class="fw-bold mb-1">

                <i class="bi bi-fingerprint text-success"></i>
                Attendance Management

            </h3>

            <p class="text-muted mb-0">
                Employee punch in/out records
            </p>

        </div>

        <div>

            <a asp-action="Create"
               class="btn btn-success rounded-3 px-4">

                <i class="bi bi-plus-circle"></i>
                Add Punch

            </a>

        </div>

    </div>

    <!-- Search -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <input type="text"
                           id="searchInput"
                           class="form-control"
                           placeholder="Search Employee..." />

                </div>

                <div class="col-md-3">

                    <input type="date"
                           class="form-control" />

                </div>

                <div class="col-md-3">

                    <select class="form-select">

                        <option value="">
                            All Devices
                        </option>

                    </select>

                </div>

                <div class="col-md-2">

                    <button class="btn btn-outline-success w-100">

                        <i class="bi bi-funnel"></i>
                        Filter

                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- Table -->
    <div class="card border-0 shadow rounded-4">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>#</th>
                            <th>Employee</th>
                            <th>Punch Time</th>
                            <th>Punch Type</th>
                            <th>Device ID</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th width="140">Action</th>

                        </tr>

                    </thead>

                    <tbody id="punchTable">

                        @{
                            int sr = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @sr
                                </td>

                                <!-- Employee -->
                                <td>

                                    @(item.EmployeeId!=null && ViewBag.EmployeeNames != null &&
                                        ViewBag.EmployeeNames.ContainsKey(item.EmployeeId)
                                            ? ViewBag.EmployeeNames[item.EmployeeId]
                                            : "-")

                                </td>

                                <!-- Punch Time -->
                                <td>

                                    <span class="fw-semibold">

                                        @item.PunchTime.ToString("dd MMM yyyy hh:mm tt")

                                    </span>

                                </td>

                                <td>
                                    @item.PunchType
                                </td>

                                <!-- Device -->
                                <td>

                                    <span class="badge bg-dark">
                                        @(string.IsNullOrEmpty(item.DeviceId)
                                            ? "N/A"
                                            : item.DeviceId)
                                    </span>

                                </td>

                                <!-- Location -->
                                <td>

                                    @(string.IsNullOrEmpty(item.Location)
                                        ? "-"
                                        : item.Location)

                                </td>

                                <!-- Status -->
                                <td>

                                    <span class="badge bg-success">
                                        Recorded
                                    </span>

                                </td>

                                <!-- Action -->
                                <td>

                                    <div class="d-flex gap-2">

                                        <!-- View -->
                                        <a asp-action="Details"
                                           class="btn btn-sm btn-outline-info rounded-3">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <!-- Delete -->
                                        <a asp-action="Delete"
                                           onclick="return confirm('Delete this punch record?')"
                                           class="btn btn-sm btn-outline-danger rounded-3">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>

                            sr++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        // Search Table

        document.getElementById("searchInput")
            .addEventListener("keyup", function () {

                let value = this.value.toLowerCase();

                let rows = document.querySelectorAll("#punchTable tr");

                rows.forEach(function (row) {

                    let text = row.innerText.toLowerCase();

                    row.style.display =
                        text.includes(value) ? "" : "none";

                });

            });

    </script>

}