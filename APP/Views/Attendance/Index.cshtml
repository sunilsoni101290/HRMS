
@model IEnumerable<AttendanceDto>


@{
    ViewData["Title"] = "Attendance Dashboard";
    bool isAdmin = ViewBag.IsAdmin ?? true;

    var records = Model?.ToList() ?? new List<AttendanceDto>();

    var totalPresent = records.Count(x => x.StatusText == "Present");
    var totalAbsent = records.Count(x => x.StatusText == "Absent");
    var totalHalfDay = records.Count(x => x.StatusText == "HalfDay");

    var totalOtHours = records.Sum(x => x.OvertimeHours);
    var otHoursPart = (int)totalOtHours;
    var otMinutesPart = (int)Math.Round((totalOtHours - otHoursPart) * 60);
    var totalOtText = $"{otHoursPart:00}:{otMinutesPart:00}";
}

@* Uses the shared design system (wwwroot/css/design-system.css) - same
   "ent-*" classes as Dashboard/Employee List, so this list page matches
   the rest of the app instead of the old plain Bootstrap panel/label
   markup it had before. No data, route, or business logic changed. *@

<div class="ent-page-header">
    <div>
        <h4><i class="icon-calendar3 position-left"></i> @(ViewBag.ListTitle ?? "Attendance History") <span class="ent-count-badge">@records.Count</span></h4>
        <p>Daily attendance records, working hours and overtime</p>
    </div>

    @if (isAdmin)
    {
        <div class="ent-page-header-actions">
            <a asp-action="Create" class="btn bg-primary">
                <i class="icon-plus22 position-left"></i>
                Add Attendance
            </a>
        </div>
    }
</div>

<!-- Attendance summary KPIs -->
<div class="row ent-kpi-row">
    <div class="col-md-3 col-sm-6">
        <div class="ent-kpi-card">
            <div class="ent-kpi-icon ent-icon-green"><i class="icon-checkmark-circle"></i></div>
            <div class="ent-kpi-body">
                <h3>@totalPresent</h3>
                <span>Total Present</span>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="ent-kpi-card">
            <div class="ent-kpi-icon ent-icon-red"><i class="icon-cross2"></i></div>
            <div class="ent-kpi-body">
                <h3>@totalAbsent</h3>
                <span>Absent</span>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="ent-kpi-card">
            <div class="ent-kpi-icon ent-icon-orange"><i class="icon-hour-glass"></i></div>
            <div class="ent-kpi-body">
                <h3>@totalHalfDay</h3>
                <span>Half Day</span>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="ent-kpi-card">
            <div class="ent-kpi-icon ent-icon-indigo"><i class="icon-clock2"></i></div>
            <div class="ent-kpi-body">
                <h3>@totalOtText</h3>
                <span>Total OT Hours</span>
            </div>
        </div>
    </div>
</div>

<!-- Quick search - client-side only, filters the rendered rows already on
     the page (same pattern as Employee/Index.cshtml's filter toolbar). -->
<div class="ent-filter-card">
    <div class="row">
        <div class="col-md-4">
            <div class="ent-table-search">
                <i class="bi bi-search"></i>
                <input type="text" id="attendanceSearchInput" class="form-control" placeholder="Search employee, shift, status..." autocomplete="off" />
            </div>
        </div>
    </div>
</div>

<div class="ent-list-card">
    <div class="table-responsive">
        <table class="table ent-list-table table-hover datatable-basic">

            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Date</th>
                    <th>Shift</th>
                    <th>First In</th>
                    <th>Last Out</th>
                    <th>Working</th>
                    <th>Break</th>
                    <th>OT</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody id="attendanceTableBody">

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="attendance-row">

                            <td>
                                <div class="text-semibold">
                                    @item.EmployeeName
                                </div>

                                <span class="text-muted">
                                    @item.CompanyName
                                </span>
                            </td>

                            <td>
                                @item.Date.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @item.ShiftName
                            </td>

                            <td>
                                @(item.FirstIn?.ToString("hh:mm tt") ?? "-")
                            </td>

                            <td>
                                @(item.LastOut?.ToString("hh:mm tt") ?? "-")
                            </td>

                            <td>
                                <span class="ent-status-pill ent-badge-success">
                                    @item.WorkingHoursText
                                </span>
                            </td>

                            <td>
                                @item.BreakHours
                            </td>

                            <td>
                                @item.OvertimeHours
                            </td>

                            <td>
                                @if (item.StatusText == "Present")
                                {
                                    <span class="ent-status-pill ent-badge-success">Present</span>
                                }
                                else if (item.StatusText == "HalfDay")
                                {
                                    <span class="ent-status-pill ent-badge-warning">Half Day</span>
                                }
                                else
                                {
                                    <span class="ent-status-pill ent-badge-danger">Absent</span>
                                }
                            </td>

                            <td class="text-center ent-row-actions">
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-default btn-icon" data-popup="tooltip" title="View Details">
                                        <i class="icon-eye"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }

            </tbody>

        </table>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="ent-empty-state">
            <i class="icon-calendar3"></i>
            <p>No attendance records found.</p>
        </div>
    }

    <div id="attendanceNoResults" class="ent-empty-state" style="display:none;">
        <i class="icon-search4"></i>
        <p>No matching attendance records.</p>
    </div>
</div>

@section Scripts {

    <script>
        // Quick client-side search over the rows already rendered on this
        // page - filters by any visible text in the row (employee name,
        // shift, status, etc.). Replaces the previous script, which
        // referenced #searchInput / #attendancelist / #liveClock elements
        // that did not exist anywhere in this view and threw a JS error
        // in the console on every page load without ever doing anything.
        $(function () {
            var $rows = $('#attendanceTableBody .attendance-row');

            $('#attendanceSearchInput').on('keyup', function () {
                var value = $(this).val().toLowerCase().trim();
                var visibleCount = 0;

                $rows.each(function () {
                    var match = !value || $(this).text().toLowerCase().indexOf(value) !== -1;
                    $(this).toggle(match);
                    if (match) visibleCount++;
                });

                $('#attendanceNoResults').toggle(visibleCount === 0 && $rows.length > 0);
            });
        });
    </script>


    <script>
        // Auto-added: client-side pagination for this Index page's listing
        // table (DataTables). Safe to run even if this page already
        // initializes '.datatable-basic' itself above - 'retrieve: true'
        // makes DataTables return the existing instance instead of
        // re-initializing (and throwing) when that's the case.
        $(document).ready(function () {
            if ($.fn.DataTable) {
                var __indexDataTable = $('.datatable-basic').DataTable({
                    autoWidth: false,
                    paging: true,
                    ordering: true,
                    searching: true,
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                    language: { search: "_INPUT_", searchPlaceholder: "Search..." },
                    retrieve: true
                });
            }
        });
    </script>
}
