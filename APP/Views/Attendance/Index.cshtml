
@model IEnumerable<AttendanceDto>


@{
    ViewData["Title"] = "Attendance Dashboard";
}

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">
            <i class="icon-calendar3 position-left"></i>
            Attendance History
        </h5>

        <div class="heading-elements">

            <a asp-action="Create"
               class="btn bg-primary btn-sm">

                <i class="icon-plus22 position-left"></i>
                Add Attendance

            </a>

        </div>

    </div>

    <!-- Attendance Summary -->

    <div class="panel-body">

        <div class="row">

            <div class="col-md-3">

                <div class="panel bg-success-400">
                    <div class="panel-body text-center">
                        <h3 class="no-margin">248</h3>
                        <span>Total Present</span>
                    </div>
                </div>

            </div>

            <div class="col-md-3">

                <div class="panel bg-danger-400">
                    <div class="panel-body text-center">
                        <h3 class="no-margin">12</h3>
                        <span>Absent</span>
                    </div>
                </div>

            </div>

            <div class="col-md-3">

                <div class="panel bg-warning-400">
                    <div class="panel-body text-center">
                        <h3 class="no-margin">18</h3>
                        <span>Half Day</span>
                    </div>
                </div>

            </div>

            <div class="col-md-3">

                <div class="panel bg-info-400">
                    <div class="panel-body text-center">
                        <h3 class="no-margin">34:20</h3>
                        <span>Total OT Hours</span>
                    </div>
                </div>

            </div>

        </div>

    </div>

    <table class="table datatable-scroll-y table-hover">

        <thead>

            <tr>

                <th>Employee</th>
                <th>Date</th>
                <th>Shift</th>
                <th>First In</th>
                <th>Last Out</th>
                <th>Working</th>
                <th>Break</th>
                <th>OT</th>
                <th>Status</th>
                <th class="text-center">Actions</th>
            </tr>

        </thead>

        <tbody>

            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>

                        <td>

                            <div class="text-semibold">
                                @item.EmployeeName
                            </div>

                            <span class="text-muted">
                                @item.CompanyName
                            </span>

                        </td>

                        <td>
                            @item.Date.ToString("dd MMM yyyy")
                        </td>

                        <td>
                            @item.ShiftName
                        </td>

                        <td>
                            @(item.FirstIn?.ToString("hh:mm tt") ?? "-")
                        </td>

                        <td>
                            @(item.LastOut?.ToString("hh:mm tt") ?? "-")
                        </td>

                        <td>
                            <span class="label label-success">
                                @item.WorkingHoursText
                            </span>
                        </td>

                        <td>
                            @item.BreakHours
                        </td>

                        <td>
                            @item.OvertimeHours
                        </td>

                        <td>

                            @if (item.StatusText == "Present")
                            {
                                <span class="label label-success">
                                    Present
                                </span>
                            }
                            else if (item.StatusText == "HalfDay")
                            {
                                <span class="label label-warning">
                                    Half Day
                                </span>
                            }
                            else
                            {
                                <span class="label label-danger">
                                    Absent
                                </span>
                            }

                        </td>
                        <td class="text-center">

                            <ul class="icons-list">

                                <li>
                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       title="View">
                                        <i class="icon-eye"></i>
                                    </a>
                                </li>
                            </ul>

                        </td>
                    </tr>
                }
            }

        </tbody>

    </table>

</div>

@section Scripts {
   
    <script>

         setInterval(function () {

            document.getElementById("liveClock")
                .innerHTML =
                new Date().toLocaleTimeString();

        }, 1000);

        // Search Table

        document.getElementById("searchInput")
            .addEventListener("keyup", function () {

                let value = this.value.toLowerCase();

                let rows = document.querySelectorAll("#attendancelist tr");

                rows.forEach(function (row) {

                    let text = row.innerText.toLowerCase();

                    row.style.display =
                        text.includes(value) ? "" : "none";

                });

            });

    </script>

}