            // ============================================================
            // SEARCH / FILTER
            // ============================================================

            function getFilteredEmployees() {

                if (
                    !currentData ||
                    !currentData.employees
                ) {
                    return [];
                }


                var term =
                    (
                        $("#employeeSearch")
                            .val() || ""
                    )
                        .toLowerCase()
                        .trim();


                var status =
                    $("#statusFilter").val() ||
                    "all";


                return $.grep(
                    currentData.employees,
                    function(emp) {


                        // Status
                        if (
                            status !== "all" &&
                            statusOf(emp) !== status
                        ) {
                            return false;
                        }


                        // Search
                        if (term) {

                            var name =
                                (
                                    emp.employeeName ||
                                    ""
                                ).toLowerCase();


                            var code =
                                (
                                    emp.employeeCode ||
                                    ""
                                ).toLowerCase();


                            if (
                                name.indexOf(term) === -1 &&
                                code.indexOf(term) === -1
                            ) {
                                return false;
                            }
                        }


                        return true;
                    }
                );
            }


            function requestFilterRender() {

                clearTimeout(
                    searchDebounce
                );


                searchDebounce =
                    setTimeout(
                        function() {

                            renderEmployees(
                                getFilteredEmployees()
                            );

                        },
                        180
                    );
            }


            // ============================================================
            // KPI SUMMARY
            // ============================================================

            function renderSummary() {

                if (
                    !currentData ||
                    !currentData.employees
                ) {
                    return;
                }


                var eligibleCount = 0;
                var processedCount = 0;
                var warningsCount = 0;

                var gross = 0;
                var deductions = 0;
                var net = 0;

                var selectedCount = 0;


                // --------------------------------------------------------
                // Employee counts
                // --------------------------------------------------------

                $.each(
                    currentData.employees,
                    function(i, emp) {

                        if (
                            rowEligible(emp)
                        ) {
                            eligibleCount++;
                        }


                        if (
                            emp.alreadyProcessed
                        ) {
                            processedCount++;
                        }


                        if (
                            emp.warnings &&
                            emp.warnings.length > 0
                        ) {
                            warningsCount++;
                        }
                    }
                );


                // --------------------------------------------------------
                // Selected totals
                // --------------------------------------------------------

                $.each(
                    selectedIds,
                    function(
                        employeeId,
                        isSelected
                    ) {

                        if (!isSelected) {
                            return;
                        }


                        var emp =
                            employeesById[
                            String(employeeId)
                            ];


                        if (!emp) {
                            return;
                        }


                        selectedCount++;


                        gross +=
                            numericValue(
                                emp.grossSalary
                            );


                        deductions +=
                            numericValue(
                                emp.totalDeductions
                            );


                        net +=
                            numericValue(
                                emp.netSalary
                            );
                    }
                );


                // --------------------------------------------------------
                // KPI
                // --------------------------------------------------------

                $("#kpiEligible")
                    .text(eligibleCount);


                $("#kpiSelected")
                    .text(selectedCount);


                $("#kpiProcessed")
                    .text(processedCount);


                $("#kpiWarnings")
                    .text(warningsCount);


                $("#kpiGross")
                    .text(
                        fmtCurrency(gross)
                    );


                $("#kpiDeductions")
                    .text(
                        fmtCurrency(deductions)
                    );


                $("#kpiNet")
                    .text(
                        fmtCurrency(net)
                    );


                $("#selectedSummary")
                    .text(
                        "Selected: " +
                        selectedCount
                    );


                updateProcessBar(
                    selectedCount,
                    gross,
                    deductions,
                    net
                );
            }


            // ============================================================
            // PROCESS FOOTER
            // ============================================================

            function updateProcessBar(
                selectedCount,
                gross,
                deductions,
                net
            ) {

                $("#footerSelectedCount")
                    .text(selectedCount);


                $("#footerGross")
                    .text(
                        fmt(gross)
                    );


                $("#footerDeductions")
                    .text(
                        fmt(deductions)
                    );


                $("#footerNet")
                    .text(
                        fmt(net)
                    );


                $("#processFooter")
                    .toggle(
                        selectedCount > 0
                    );
            }


            // ============================================================
            // SELECTION
            // ============================================================

            function updateSelection() {

                $(".emp-check")
                    .each(
                        function() {

                            var $cb =
                                $(this);


                            var id =
                                String(
                                    $cb.val()
                                );


                            selectedIds[id] =
                                $cb.is(":checked");
                        }
                    );


                updateSelectAllState();

                renderSummary();
            }


            function updateSelectAllState() {

                var $visible =
                    $(".emp-check:not(:disabled)");


                var total =
                    $visible.length;


                var checked =
                    $visible
                        .filter(":checked")
                        .length;


                var allSelected =
                    total > 0 &&
                    total === checked;


                $("#selectAllEmp")
                    .prop(
                        "checked",
                        allSelected
                    );


                $("#selectAllBtn")
                    .html(
                        '<i class="bi bi-check2-square"></i> ' +
                        (
                            allSelected
                                ? "Deselect All"
                                : "Select All"
                        )
                    );
            }


            function setAllVisibleSelected(select) {

                $(".emp-check:not(:disabled)")
                    .prop(
                        "checked",
                        select
                    );


                updateSelection();
            }


