            // ============================================================
            // PROCESS SALARY AJAX
            // ============================================================

            function processSalary(employeeIds) {

                if (isProcessing) {
                    return;
                }


                var year =
                    $("#salaryYear").val();


                var month =
                    $("#salaryMonth").val();


                var companyId =
                    $("#companyId").val();


                var $button =
                    $("#processSalaryBtn");


                var originalHtml =
                    $button.html();


                isProcessing = true;


                $button
                    .prop(
                        "disabled",
                        true
                    )
                    .html(
                        '<i class="bi bi-arrow-repeat" ' +
                        'style="animation:ent-spin .8s linear infinite;display:inline-block;"></i> ' +
                        'Processing Salary...'
                    );


                // --------------------------------------------------------
                // FORM DATA
                // --------------------------------------------------------

                var formData =
                    new FormData();


                formData.append(
                    "salaryYear",
                    year
                );


                formData.append(
                    "salaryMonth",
                    month
                );


                formData.append(
                    "companyId",
                    companyId || ""
                );


                $.each(
                    employeeIds,
                    function(i, id) {

                        formData.append(
                            "EmployeeIds",
                            id
                        );
                    }
                );


                // --------------------------------------------------------
                // ANTI FORGERY TOKEN
                // --------------------------------------------------------

                var token =
                    $(
                        '#processForm input[name="__RequestVerificationToken"]'
                    ).val();


                if (token) {

                    formData.append(
                        "__RequestVerificationToken",
                        token
                    );
                }


                // --------------------------------------------------------
                // AJAX
                // --------------------------------------------------------

                $.ajax({

                    url:
                        "@Url.Action("ProcessSalary", "Payroll")",

                    type:
                        "POST",

                    data:
                        formData,

                    processData:
                        false,

                    contentType:
                        false,

                    cache:
                        false,


                    success: function(response) {

                        console.log(
                            "ProcessSalary response:",
                            response
                        );


                        if (!response) {

                            handleProcessError(
                                null,
                                "Server returned an empty response."
                            );

                            return;
                        }


                        // ------------------------------------------------
                        // Support PascalCase and camelCase
                        // ------------------------------------------------

                        var success =
                            prop(
                                response,
                                "Success",
                                "success",
                                false
                            );


                        var message =
                            prop(
                                response,
                                "Message",
                                "message",
                                ""
                            );


                        var processedCount =
                            prop(
                                response,
                                "ProcessedCount",
                                "processedCount",
                                null
                            );


                        if (success === true) {

                            handleProcessSuccess({

                                success:
                                    true,

                                message:
