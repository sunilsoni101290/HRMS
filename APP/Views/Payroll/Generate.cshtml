                </thead>
                <tbody id="reviewRows"></tbody>
            </table>
        </div>

        <div id="reviewNoMatch" class="ent-empty-state" style="display:none;padding:26px;">
            <i class="bi bi-search"></i>
            <p>No employees match your search/filter.</p>
        </div>
    </div>

    <!-- ==================== 9. Sticky bottom process bar ==================== -->
    <div class="pg-process-bar" id="processFooter" style="display:none;">
        <div class="pg-process-bar-inner">
            <div class="pg-process-count"><strong id="footerSelectedCount">0</strong> Employees Selected</div>
            <div class="pg-process-totals">
                <div><span>Gross</span><strong id="footerGross">0.00</strong></div>
                <div><span>Deductions</span><strong id="footerDeductions">0.00</strong></div>
                <div class="pg-total-net"><span>Net</span><strong id="footerNet">0.00</strong></div>
            </div>
            <button type="button" id="processSalaryBtn" class="btn btn-success pg-process-btn">
