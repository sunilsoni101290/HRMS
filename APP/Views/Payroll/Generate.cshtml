            <div class="ent-kpi-body"><h3 id="kpiWarnings">0</h3><span>Warnings</span></div>
        </div>
        <div class="ent-kpi-card">
            <div class="ent-kpi-icon ent-icon-teal"><i class="bi bi-cash-stack"></i></div>
            <div class="ent-kpi-body"><h3 id="kpiGross">&#8377;0.00</h3><span>Gross Salary</span></div>
        </div>
        <div class="ent-kpi-card">
            <div class="ent-kpi-icon ent-icon-red"><i class="bi bi-dash-circle-fill"></i></div>
            <div class="ent-kpi-body"><h3 id="kpiDeductions">&#8377;0.00</h3><span>Deductions</span></div>
        </div>
        <div class="ent-kpi-card">
            <div class="ent-kpi-icon ent-icon-green"><i class="bi bi-wallet2"></i></div>
            <div class="ent-kpi-body"><h3 id="kpiNet">&#8377;0.00</h3><span>Net Salary</span></div>
