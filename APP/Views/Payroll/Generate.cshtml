            // ============================================================
            // LOAD PREVIEW
            // ============================================================

            function loadPreview() {

                if (isLoading) {
                    return;
                }


                var year =
                    $("#salaryYear").val();


                var month =
                    $("#salaryMonth").val();


                var companyId =
                    $("#companyId").val();


                if (!year || !month) {

                    swal({
                        title: "Required",
                        text: "Please select Year and Month.",
                        type: "warning"
                    });

                    return;
                }


                isLoading = true;


                showLoading();


                $.ajax({

                    url:
                        "@Url.Action("LoadPreview", "Payroll")",

                    type: "GET",

                    data: {

                        salaryYear:
                            year,

                        salaryMonth:
                            month,

                        companyId:
                            companyId
                    },


                    success: function(data) {

                        hideLoading();

                        isLoading = false;


                        console.log(
                            "LoadPreview raw response:",
                            data
                        );


                        // ------------------------------------------------
                        // Empty response
                        // ------------------------------------------------

                        if (!data) {

                            showError(
                                "Server returned an empty response."
                            );

                            return;
                        }


                        // ------------------------------------------------
                        // Support both Error and error
                        // ------------------------------------------------

                        var serverError =
                            prop(
                                data,
                                "Error",
                                "error",
                                null
                            );


                        if (serverError) {

                            showError(
                                serverError
                            );

                            return;
                        }


                        // ------------------------------------------------
                        // NORMALIZE RESPONSE
                        //
                        // This is the IMPORTANT FIX.
                        //
                        // Controller:
                        //     Employees
                        //
                        // UI:
                        //     employees
                        // ------------------------------------------------

                        var normalized =
                            normalizePreviewResponse(
                                data
                            );


                        if (!normalized) {

                            showError(
                                "Could not read the salary preview response."
                            );

                            return;
                        }


                        currentData =
                            normalized;


                        employeesById = {};

                        selectedIds = {};


                        // ------------------------------------------------
                        // BUILD EMPLOYEE MAP
                        // ------------------------------------------------

                        $.each(
                            currentData.employees,
                            function(i, emp) {

                                var id =
                                    String(
                                        emp.employeeId
                                    );


                                employeesById[id] =
                                    emp;


                                if (
                                    rowEligible(emp)
                                ) {

                                    selectedIds[id] =
                                        true;
                                }
                            }
                        );


                        // ------------------------------------------------
                        // SHOW KPI
                        // ------------------------------------------------

                        $("#kpiGrid")
                            .show();


                        $("#employeeSearch")
                            .val("");


                        $("#statusFilter")
                            .val("all");


                        // ------------------------------------------------
                        // EMPTY
                        // ------------------------------------------------

                        if (
                            !currentData.employees ||
                            currentData.employees.length === 0
                        ) {

                            var monthName =
                                currentData.monthName ||
                                $("#salaryMonth option:selected").text() ||
                                "this period";


                            showEmptyState(

                                currentData
                                    .employeesMatchingFilterCount ||
                                0,

                                year,

                                monthName
                            );


                            renderSummary();


                            return;
                        }


                        // ------------------------------------------------
                        // HIDE EMPTY STATE
                        // ------------------------------------------------

                        $("#reviewEmpty")
                            .hide();


                        // ------------------------------------------------
                        // RENDER EMPLOYEES
                        // ------------------------------------------------

                        renderEmployees(
                            getFilteredEmployees()
                        );


                        $("#reviewTableWrap")
                            .show();


                        // ------------------------------------------------
                        // SUMMARY
                        // ------------------------------------------------

                        renderSummary();
                    },


                    error: function(xhr) {

                        hideLoading();

                        isLoading = false;


                        showError(
                            extractErrorMessage(
                                xhr,
                                "Could not load attendance for this period."
                            )
                        );
                    }
                });
            }


