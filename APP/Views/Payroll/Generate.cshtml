</div>

<!-- Anti-forgery token only - Process Salary is submitted via AJAX, never
     a real form post (see JS below). -->
<form id="processForm">@Html.AntiForgeryToken()</form>

@section Scripts {
    @if (TempData["Success"] != null)
    {
        <script>$(function(){ swal({ title:"Success", text:"@TempData["Success"]", type:"success" }); });</script>
    }
    @if (TempData["Info"] != null)
    {
        <script>$(function(){ swal({ title:"Some employees were skipped", text:"@TempData["Info"]", type:"info" }); });</script>
    }
    @if (TempData["Error"] != null)
    {
        <script>$(function(){ swal({ title:"Error", text:"@TempData["Error"]", type:"error" }); });</script>
    }

    <script>
        $(function() {

            // ============================================================
            // GLOBAL STATE
            // ============================================================

            var currentData = null;
            var employeesById = {};
            var selectedIds = {};
            var isLoading = false;
            var isProcessing = false;
            var searchDebounce = null;


            // ============================================================
            // GENERIC PROPERTY HELPER
            //
            // Supports BOTH:
            //   Employees / employees
            //   EmployeeId / employeeId
            //
            // This prevents JSON serializer casing problems.
            // ============================================================

            function prop(obj, pascalName, camelName, defaultValue) {

                if (!obj) {
                    return defaultValue;
                }

                if (
                    obj[pascalName] !== undefined &&
                    obj[pascalName] !== null
                ) {
                    return obj[pascalName];
                }

                if (
                    obj[camelName] !== undefined &&
                    obj[camelName] !== null
                ) {
                    return obj[camelName];
                }

                return defaultValue;
            }


            // ============================================================
            // NORMALIZE EMPLOYEE
            // ============================================================

            function normalizeEmployee(emp) {

                if (!emp) {
                    return null;
                }

                return {

                    employeeId:
                        prop(emp, "EmployeeId", "employeeId", ""),

                    employeeName:
                        prop(emp, "EmployeeName", "employeeName", ""),

                    employeeCode:
                        prop(emp, "EmployeeCode", "employeeCode", ""),

                    monthlySalary:
                        prop(emp, "MonthlySalary", "monthlySalary", 0),

                    prorationBasisUsedName:
                        prop(
                            emp,
                            "ProrationBasisUsedName",
                            "prorationBasisUsedName",
                            "-"
                        ),

                    totalDaysInPeriod:
                        prop(
                            emp,
                            "TotalDaysInPeriod",
                            "totalDaysInPeriod",
                            null
                        ),

                    presentDays:
                        prop(
                            emp,
                            "PresentDays",
                            "presentDays",
                            null
                        ),

                    paidLeaveDays:
                        prop(
                            emp,
                            "PaidLeaveDays",
                            "paidLeaveDays",
                            null
                        ),

                    payableDays:
                        prop(
                            emp,
                            "PayableDays",
                            "payableDays",
                            null
                        ),

                    grossSalary:
                        prop(
                            emp,
                            "GrossSalary",
                            "grossSalary",
                            0
                        ),

                    totalDeductions:
                        prop(
                            emp,
                            "TotalDeductions",
                            "totalDeductions",
                            0
                        ),

                    netSalary:
                        prop(
                            emp,
                            "NetSalary",
                            "netSalary",
                            0
                        ),

                    canProcess:
                        prop(
                            emp,
                            "CanProcess",
                            "canProcess",
                            false
                        ),

                    alreadyProcessed:
                        prop(
                            emp,
                            "AlreadyProcessed",
                            "alreadyProcessed",
                            false
                        ),

                    blockReason:
                        prop(
                            emp,
                            "BlockReason",
                            "blockReason",
                            ""
                        ),

                    existingPayrollStatus:
                        prop(
                            emp,
                            "ExistingPayrollStatus",
                            "existingPayrollStatus",
                            ""
                        ),

                    warnings:
                        prop(
                            emp,
                            "Warnings",
                            "warnings",
                            []
                        ) || []
                };
            }


            // ============================================================
            // NORMALIZE LOAD PREVIEW RESPONSE
            //
            // Your Controller currently returns:
            //
            // Employees
            // EmployeesMatchingFilterCount
            // MonthName
            // SalaryMonth
            // SalaryYear
            //
            // The UI internally uses camelCase.
            // ============================================================

            function normalizePreviewResponse(data) {

                if (!data) {
                    return null;
                }

                var rawEmployees =
                    prop(
                        data,
                        "Employees",
                        "employees",
                        []
                    ) || [];


                var employees = [];


                $.each(
                    rawEmployees,
                    function(i, rawEmployee) {

                        var employee =
                            normalizeEmployee(rawEmployee);

                        if (employee) {
                            employees.push(employee);
                        }
                    }
                );


                return {

                    employees: employees,

                    employeesMatchingFilterCount:
                        prop(
                            data,
                            "EmployeesMatchingFilterCount",
                            "employeesMatchingFilterCount",
                            0
                        ),

                    monthName:
                        prop(
                            data,
                            "MonthName",
                            "monthName",
                            ""
                        ),

                    salaryMonth:
                        prop(
                            data,
                            "SalaryMonth",
                            "salaryMonth",
                            null
                        ),

                    salaryYear:
                        prop(
                            data,
                            "SalaryYear",
                            "salaryYear",
                            null
                        )
                };
            }


            // ============================================================
            // FORMAT HELPERS
            // ============================================================

            function fmt(n) {

                var value =
                    parseFloat(n);

                if (isNaN(value)) {
                    value = 0;
                }

                return value.toLocaleString(
                    "en-IN",
                    {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }
                );
            }


            function fmtCurrency(n) {

                return "₹" + fmt(n);
            }


            function fmtDays(n) {

                if (
                    n === null ||
                    n === undefined ||
                    n === ""
                ) {
                    return "-";
                }

                var value =
                    parseFloat(n);

                if (isNaN(value)) {
                    return "-";
                }

                return (
                    Math.round(value * 10) / 10
                ).toString();
            }


            function numericValue(value) {

                if (
                    value === null ||
                    value === undefined ||
                    value === ""
                ) {
                    return 0;
                }

                var number =
                    parseFloat(value);

                return isNaN(number)
                    ? 0
                    : number;
            }


            function escapeHtml(value) {

                if (
                    value === null ||
                    value === undefined
                ) {
                    return "";
                }

                return $("<div>")
                    .text(value)
                    .html();
            }


            // ============================================================
            // ELIGIBILITY
            // ============================================================

            function rowEligible(emp) {

                return emp &&
                    emp.canProcess === true &&
                    emp.alreadyProcessed !== true;
            }


            // ============================================================
            // STATUS
            // ============================================================

            function statusOf(emp) {

                if (emp.alreadyProcessed) {
                    return "processed";
                }

                if (!emp.canProcess) {
                    return "blocked";
                }

                if (
                    emp.warnings &&
                    emp.warnings.length > 0
                ) {
                    return "warning";
                }

                return "ready";
            }


            function statusBadge(status, emp) {

                switch (status) {

                    case "processed":

                        return (
                            '<span class="ent-status-pill ent-badge-success">' +
                            'Already ' +
                            escapeHtml(
                                emp.existingPayrollStatus ||
                                "Processed"
                            ) +
                            '</span>'
                        );


                    case "blocked":

                        return (
                            '<span class="ent-status-pill ent-badge-danger">' +
                            'Blocked' +
                            '</span>'
                        );


                    case "warning":

                        return (
                            '<span class="ent-status-pill ent-badge-warning">' +
                            'Warning' +
                            '</span>'
                        );


                    default:

                        return (
                            '<span class="ent-status-pill ent-badge-info">' +
                            'Ready' +
                            '</span>'
                        );
                }
            }


            // ============================================================
            // RENDER EMPLOYEE ROWS
            // ============================================================

            function renderEmployees(list) {

                var html = [];


                $.each(
                    list,
                    function(i, emp) {

                        var eligible =
                            rowEligible(emp);

                        var status =
                            statusOf(emp);

                        var checked =
                            eligible &&
                            !!selectedIds[
                            String(emp.employeeId)
                            ];


                        // ------------------------------------------------
                        // CHECKBOX
                        // ------------------------------------------------

                        var checkboxHtml;


                        if (eligible) {

                            checkboxHtml =
                                '<input ' +
                                'type="checkbox" ' +
                                'class="emp-check" ' +
                                'value="' +
                                escapeHtml(emp.employeeId) +
                                '" ' +
                                (
                                    checked
                                        ? "checked "
                                        : ""
                                ) +
                                '/>';
                        }
                        else {

