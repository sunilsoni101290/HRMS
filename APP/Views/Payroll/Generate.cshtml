@model PayrollGenerateDto

@{
    ViewData["Title"] = "Process Salary";
}

@*
    Redesigned to the enterprise ERP visual system (design-system.css -
    "ent-*" classes, already loaded globally via _LayoutMain.cshtml, same
    as HolidayGroup/DatabaseManagement/Employee). This project ships
    Bootstrap 3.3.7, not 4/5 - Bootstrap 4/5 utility classes like d-flex/
    gap-2 are NOT actually wired up anywhere in wwwroot despite appearing
    in a couple of other views, so this page does not rely on them; all
    layout here is done with real Bootstrap 3 grid classes (col-md-*) plus
    a small page-scoped <style> block below (".pg-*" classes) for the
    pieces design-system.css doesn't already cover (search/filter toolbar,
    sticky table header, sticky bottom process bar, KPI flex grid).

    Business logic, DTO contracts and the AJAX endpoints this page calls
    are UNCHANGED:
      - GET  Payroll/LoadPreview (salaryYear, salaryMonth, companyId)
      - POST Payroll/ProcessSalary (salaryYear, salaryMonth, companyId,
        EmployeeIds[], __RequestVerificationToken)
    ProcessSalary's controller action now returns JSON instead of a
    TempData+Redirect (see APP/Controllers/PayrollController.cs) so this
    page's AJAX call - which was already written to expect
    response.success/message - actually works; the underlying
    _apiService.PostAsync("payroll/process", dto) call, the DTO it sends,
    and PayrollBusinessService.ProcessAsync are all untouched.
*@

<style>

    /* ============================================================
       Page header - breadcrumb + title/description + Back button
       ============================================================ */
    .pg-breadcrumb { font-size: 12px; color: #8896ad; margin-bottom: 4px; }
    .pg-breadcrumb a { color: #8896ad; }
    .pg-breadcrumb a:hover { color: #4e9cff; text-decoration: none; }

    /* ============================================================
       Compact business-rule info panel - visually secondary, replaces
       the old large .alert-info block.
       ============================================================ */
    .pg-info-note {
        display: flex; gap: 12px; align-items: flex-start;
        background: #f7f9fc; border: 1px solid #edf0f5; border-radius: 8px;
        padding: 12px 16px; margin-bottom: 20px; font-size: 12.5px; color: #6b7488;
    }
    .pg-info-note > i { font-size: 16px; color: #8896ad; margin-top: 1px; flex-shrink: 0; }
    .pg-info-note strong { color: #45526b; font-size: 12.5px; }
    .pg-info-note p { margin: 3px 0 0; line-height: 1.5; }
    .pg-info-note .pg-formula {
        font-family: "Courier New", monospace; background: #fff; border: 1px solid #edf0f5;
        border-radius: 5px; padding: 5px 10px; display: inline-block; margin-top: 6px; color: #45526b;
    }

    /* ============================================================
       KPI grid - flexbox, no Bootstrap utility-class dependency.
       Reuses .ent-kpi-card/.ent-kpi-icon/.ent-kpi-body from
       design-system.css, just supplies the flex-wrap container.
       ============================================================ */
    .pg-kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 18px; align-items: stretch; }
    .pg-kpi-grid .ent-kpi-card { margin-bottom: 0; min-width: 0; height: 100%; }
    .pg-kpi-grid .ent-kpi-body h3 { font-size: 20px; }
    @@media (max-width: 991px) {
        .pg-kpi-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @@media (max-width: 480px) {
        .pg-kpi-grid { grid-template-columns: 1fr; }
    }

    /* ============================================================
       Employee review toolbar (search + status filter + select-all +
       selected count) above the table.
       ============================================================ */
    .pg-toolbar-right { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .pg-status-filter { width: 168px; }

    /* ============================================================
       Table - sticky header, right-aligned currency, centered day
       counts, compact rows, horizontal scroll contained to the table
       area only (never the page).
       ============================================================ */
    .pg-table-scroll { max-height: 560px; overflow-y: auto; overflow-x: auto; }
    .pg-table thead th {
        position: sticky; top: 0; z-index: 2;
    }
    .pg-table tbody td { padding-top: 9px; padding-bottom: 9px; }
    .pg-table .text-right { text-align: right; }
    .pg-table .text-center { text-align: center; }
    .pg-table tbody tr.pg-row-disabled { color: #b6bccb; background: #fbfbfc; }
    .pg-details-btn {
        border: 1px solid #edf0f5; background: #fff; color: #8896ad; border-radius: 6px;
        width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;
        cursor: pointer;
    }
    .pg-details-btn:hover, .pg-details-btn:focus { color: #4e9cff; border-color: #4e9cff; outline: none; }

    /* ============================================================
       Sticky bottom process summary bar - only shown when >=1 selected.
       ============================================================ */
    .pg-process-bar {
        position: sticky; bottom: 0; left: 0; right: 0; z-index: 50;
        background: #fff; border: 1px solid #edf0f5; border-radius: 10px;
        box-shadow: 0 -4px 18px rgba(20,30,60,.12);
        margin-top: 18px; padding: 14px 20px;
    }
    .pg-process-bar-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; }
    .pg-process-count { font-size: 13.5px; color: #1b2a4a; font-weight: 600; flex: 0 0 auto; }
    .pg-process-count strong { font-size: 18px; color: var(--ent-blue-dark, #2b6fd9); margin-right: 4px; }
    .pg-process-totals { display: flex; gap: 22px; flex-wrap: wrap; }
    .pg-process-totals > div { text-align: right; }
    .pg-process-totals span { display: block; font-size: 10.5px; text-transform: uppercase; letter-spacing: .4px; color: #8896ad; }
    .pg-process-totals strong { font-size: 15px; color: #1b2a4a; }
    .pg-process-totals .pg-total-net strong { color: #1e8e4e; }
    .pg-process-btn { padding: 10px 26px; font-weight: 600; }

    @@media (max-width: 767px) {
        .pg-process-bar-inner { justify-content: center; text-align: center; }
        .pg-process-totals { justify-content: center; }
        .pg-toolbar-right { width: 100%; }
        .pg-status-filter { flex: 1 1 auto; width: auto; }
    }

</style>

<div class="ent-page-header">
    <div>
        <div class="pg-breadcrumb"><a asp-action="Index">Payroll</a> / Process Salary</div>
        <h4><i class="bi bi-cash-coin" style="color:#4e9cff;margin-right:6px;"></i> Process Salary</h4>
        <p>Process monthly employee payroll based on attendance, leave and salary structure.</p>
    </div>
    <div class="ent-page-header-actions">
        <a asp-action="Index" class="btn btn-default"><i class="icon-arrow-left13"></i> Back</a>
    </div>
</div>

<!-- ==================== 1. Salary Processing Period ==================== -->
<div class="ent-filter-card">
    <div style="font-size:13px;font-weight:700;color:#1b2a4a;margin-bottom:14px;">
        <i class="bi bi-calendar-range" style="color:#4e9cff;margin-right:4px;"></i> Salary Processing Period
    </div>
    <div class="row">
        <div class="col-md-2 col-sm-4 col-xs-6">
            <label for="salaryYear">Year</label>
            <select id="salaryYear" class="form-control" aria-label="Salary Year">
                @for (int y = DateTime.UtcNow.Year; y >= DateTime.UtcNow.Year - 5; y--)
                {
                    <option value="@y">@y</option>
                }
            </select>
        </div>
        <div class="col-md-3 col-sm-4 col-xs-6">
            <label for="salaryMonth">Month</label>
            <select id="salaryMonth" class="form-control" aria-label="Salary Month">
                @for (int m = 1; m <= 12; m++)
                {
                    var name = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m);
                    if (m == DateTime.UtcNow.Month)
                    {
                        <option value="@m" selected>@name</option>
                    }
                    else
                    {
                        <option value="@m">@name</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-4 col-sm-4 col-xs-12">
            <label for="companyId">Company</label>
            <select id="companyId" class="form-control" aria-label="Company" asp-items="ViewBag.CompanyList">
                <option value="">All Companies</option>
            </select>
        </div>
        <div class="col-md-3 col-sm-12 col-xs-12">
            <label class="hidden-xs" style="visibility:hidden;">Action</label>
            <button type="button" id="loadAttendanceBtn" class="btn btn-primary btn-block">
                <i class="bi bi-cloud-download"></i> Load Attendance
            </button>
        </div>
    </div>
</div>

<!-- ==================== 2. Business rule info panel ==================== -->
<div class="pg-info-note">
    <i class="bi bi-info-circle"></i>
    <div>
        <strong>Salary Calculation</strong>
        <p>Monthly Salary is prorated according to the employee's attendance policy and payable days.</p>
        <span class="pg-formula">Monthly Salary &divide; Applicable Period Days &times; Payable Days &nbsp;&middot;&nbsp; Payable Days = Present Days + Paid Leave</span>
        <p>Employees already processed for this period cannot be processed again. Use <strong>Recalculate</strong> from the existing payroll record when required.</p>
    </div>
</div>

<div id="reviewSection" style="display:none;">

    <!-- ==================== 3. KPI summary ==================== -->
    <div class="pg-kpi-grid" id="kpiGrid">
        <div class="ent-kpi-card">
            <div class="ent-kpi-icon ent-icon-blue"><i class="bi bi-people-fill"></i></div>
            <div class="ent-kpi-body"><h3 id="kpiEligible">0</h3><span>Eligible Employees</span></div>
        </div>
        <div class="ent-kpi-card">
            <div class="ent-kpi-icon ent-icon-indigo"><i class="bi bi-check2-square"></i></div>
