@model PayrollDto

@{
    ViewData["Title"] = "Payroll Details";

    string StatusLabel(string? s) => s switch
    {
        "Draft" => "bg-grey",
        "Processed" => "bg-primary",
        "Paid" => "bg-success",
        _ => "bg-info"
    };
}

<div class="panel panel-flat">
    <div class="panel-heading">
        <h5 class="panel-title">
            <i class="icon-cash3 position-left"></i> @Model.EmployeeName — @Model.MonthName @Model.SalaryYear
            <span class="label @StatusLabel(Model.Status)" style="margin-left:8px;">@Model.Status</span>
        </h5>
        <div class="heading-elements">
            <a asp-action="Payslip" asp-route-id="@Model.Id" target="_blank" class="btn btn-info btn-xs"><i class="icon-printer"></i> Payslip</a>
            @if (Model.Status != "Paid")
            {
                <button type="button" class="btn btn-warning btn-xs" id="recalcBtn" data-toggle="modal" data-target="#recalcModal"><i class="icon-loop2"></i> Recalculate</button>
            }
            <a asp-action="Index" class="btn btn-default btn-xs"><i class="icon-arrow-left13"></i> Back</a>
        </div>
    </div>
    <div class="panel-body">
        <div class="row">
            <div class="col-md-3">
                <div class="content-group text-center">
                    <h6 class="text-muted no-margin">Gross</h6>
                    <h4 class="text-success no-margin-top">₹ @Model.GrossSalary.ToString("N2")</h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="content-group text-center">
                    <h6 class="text-muted no-margin">Earnings (Prorated)</h6>
                    <h4 class="no-margin-top">₹ @Model.TotalEarnings.ToString("N2")</h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="content-group text-center">
                    <h6 class="text-muted no-margin">Deductions</h6>
                    <h4 class="text-danger no-margin-top">₹ @Model.TotalDeductions.ToString("N2")</h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="content-group text-center">
                    <h6 class="text-muted no-margin">Net Pay</h6>
                    <h4 class="text-primary no-margin-top">₹ @Model.NetSalary.ToString("N2")</h4>
                </div>
            </div>
        </div>

        <hr />

        <p>
            <strong>Employee Code:</strong> @Model.EmployeeCode &nbsp;|&nbsp;
            <strong>Basis:</strong> @(Model.ProrationBasisUsedName ?? "-") &nbsp;|&nbsp;
            <strong>Total Days:</strong> @(Model.TotalWorkingDays?.ToString("0.#") ?? "-") &nbsp;|&nbsp;
            <strong>Present:</strong> @(Model.PresentDays?.ToString("0.#") ?? "-") &nbsp;|&nbsp;
            <strong>Paid Leave:</strong> @(Model.PaidLeaveDays?.ToString("0.#") ?? "-") &nbsp;|&nbsp;
            <strong>Unpaid Leave:</strong> @(Model.UnpaidLeaveDays?.ToString("0.#") ?? "-") &nbsp;|&nbsp;
            <strong>Payable Days:</strong> @(Model.PayableDays?.ToString("0.#") ?? "-")
        </p>

        @if (Model.RecalculatedCount > 0)
        {
            <p class="text-warning">
                <i class="icon-warning22"></i>
                Recalculated @Model.RecalculatedCount time(s) - last on @(Model.LastRecalculatedOn?.ToString("dd MMM yyyy HH:mm") ?? "-") by @(Model.LastRecalculatedBy ?? "-").
            </p>
        }

        <div class="row">
            <div class="col-md-6">
                <table class="table table-striped">
                    <thead><tr><th>Earnings</th><th class="text-right">Amount (₹)</th></tr></thead>
                    <tbody>
                        @foreach (var d in Model.Details.Where(x => x.IsEarning))
                        {
                            <tr><td>@d.SalaryComponentName</td><td class="text-right">@d.Amount.ToString("N2")</td></tr>
                        }
                    </tbody>
                    <tfoot><tr><th>Total Earnings</th><th class="text-right text-success">₹ @Model.TotalEarnings.ToString("N2")</th></tr></tfoot>
                </table>
            </div>
            <div class="col-md-6">
                <table class="table table-striped">
                    <thead><tr><th>Deductions</th><th class="text-right">Amount (₹)</th></tr></thead>
                    <tbody>
                        @foreach (var d in Model.Details.Where(x => !x.IsEarning))
                        {
                            <tr><td>@d.SalaryComponentName</td><td class="text-right">@d.Amount.ToString("N2")</td></tr>
                        }
                    </tbody>
                    <tfoot><tr><th>Total Deductions</th><th class="text-right text-danger">₹ @Model.TotalDeductions.ToString("N2")</th></tr></tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@if (Model.Status != "Paid")
{
    <div class="modal fade" id="recalcModal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <form asp-action="Recalculate" method="post">
                <input type="hidden" name="payrollId" value="@Model.Id" />
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h5 class="modal-title">Recalculate Payroll</h5>
                    </div>
                    <div class="modal-body">
                        <p>This re-runs Salary Processing for @Model.EmployeeName - @Model.MonthName @Model.SalaryYear against current attendance and leave data, and replaces the amounts above.</p>
                        @if (Model.Status == "Processed")
                        {
                            <div class="form-group">
                                <label>Reason (required - this payroll is already Processed)</label> <span class="text-danger">*</span>
                                <textarea name="remarks" class="form-control" rows="2" required placeholder="Why is this being recalculated?"></textarea>
                            </div>
                        }
                        else
                        {
                            <div class="form-group">
                                <label>Remarks (optional)</label>
                                <textarea name="remarks" class="form-control" rows="2"></textarea>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning"><i class="icon-loop2"></i> Recalculate</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    @if (TempData["Success"] != null)
    {
        <script>$(function(){ swal({ title:"Success", text:"@TempData["Success"]", type:"success" }); });</script>
    }
    @if (TempData["Error"] != null)
    {
        <script>$(function(){ swal({ title:"Error", text:"@TempData["Error"]", type:"error" }); });</script>
    }
}
