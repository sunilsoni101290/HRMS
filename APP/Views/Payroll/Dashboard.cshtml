@model PayrollDashboardDto

@{
    ViewData["Title"] = "Payroll Dashboard";
}

@*
    Redesigned to the enterprise ERP visual system (design-system.css -
    "ent-*" classes, loaded globally via the shared layout, same convention
    as Payroll/Generate.cshtml). Bootstrap 3.3.7 grid only (col-md-*), plus
    a page-scoped <style> block (".pdb-*") for pieces design-system.css
    doesn't already cover.

    ALL figures below come straight from PayrollDashboardDto
    (Application/DTOs/Payroll/PayrollDtos.cs), populated by
    PayrollBusinessService.GetDashboardAsync - no value here is computed or
    recalculated in this view. GetDashboardAsync returns null on an
    unexpected error (existing try/catch), so this view guards for that
    instead of throwing a NullReferenceException.
*@

<style>
    .pdb-breadcrumb { font-size: 12px; color: #8896ad; margin-bottom: 4px; }
    .pdb-breadcrumb a { color: #8896ad; }
    .pdb-breadcrumb a:hover { color: #4e9cff; text-decoration: none; }

    .pdb-header {
        display: flex; align-items: flex-start; justify-content: space-between;
        flex-wrap: wrap; gap: 16px; margin-bottom: 20px;
    }
    .pdb-header-left { display: flex; gap: 14px; align-items: flex-start; }
    .pdb-header-icon {
        width: 52px; height: 52px; border-radius: 12px; flex-shrink: 0;
        background: linear-gradient(135deg, var(--ent-blue), var(--ent-indigo-dark));
        color: #fff; display: flex; align-items: center; justify-content: center; font-size: 22px;
    }
    .pdb-title { margin: 0; font-size: 22px; font-weight: 700; color: var(--ent-text-heading); }
    .pdb-subtitle { margin: 2px 0 0; color: var(--ent-text-muted); font-size: 13px; }
    .pdb-period-form { display: flex; align-items: flex-end; gap: 10px; flex-wrap: wrap; }
    .pdb-period-label { font-size: 11px; text-transform: uppercase; letter-spacing: .4px; color: var(--ent-text-muted); display: block; margin-bottom: 4px; }

    /* KPI cards - pastel background variant, page-scoped so the shared
       .ent-kpi-card used elsewhere (white background) is untouched. */
    .pdb-kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 20px; }
    .pdb-kpi-card {
        border-radius: var(--ent-radius-lg); padding: 18px; display: flex; gap: 14px; align-items: flex-start;
        border: 1px solid var(--ent-border); box-shadow: var(--ent-shadow-sm);
    }
    .pdb-kpi-icon {
        width: 46px; height: 46px; border-radius: 12px; flex-shrink: 0; color: #fff;
        display: flex; align-items: center; justify-content: center; font-size: 19px;
    }
    .pdb-kpi-green  { background: #e9f9f2; } .pdb-kpi-green  .pdb-kpi-icon { background: var(--ent-green-dark); }
    .pdb-kpi-blue   { background: #eaf3ff; } .pdb-kpi-blue   .pdb-kpi-icon { background: var(--ent-blue-dark); }
    .pdb-kpi-red    { background: #fdecec; } .pdb-kpi-red    .pdb-kpi-icon { background: var(--ent-red-dark); }
    .pdb-kpi-purple { background: #f2ecff; } .pdb-kpi-purple .pdb-kpi-icon { background: var(--ent-indigo-dark); }
    .pdb-kpi-title { font-size: 12.5px; font-weight: 600; color: var(--ent-text-body); margin: 0 0 2px; }
    .pdb-kpi-value { font-size: 21px; font-weight: 700; color: var(--ent-text-heading); line-height: 1.25; }
    .pdb-kpi-sub { font-size: 11px; color: var(--ent-text-muted); }

    @@media (max-width: 991px) { .pdb-kpi-grid { grid-template-columns: repeat(2, 1fr); } }
    @@media (max-width: 480px) { .pdb-kpi-grid { grid-template-columns: 1fr; } }

    .pdb-panel { background: var(--ent-surface); border: 1px solid var(--ent-border); border-radius: var(--ent-radius-lg); box-shadow: var(--ent-shadow-sm); margin-bottom: 20px; }
    .pdb-panel-head { display: flex; align-items: center; justify-content: space-between; padding: 16px 18px; border-bottom: 1px solid var(--ent-border-soft); flex-wrap: wrap; gap: 8px; }
    .pdb-panel-title { margin: 0; font-size: 14.5px; font-weight: 700; color: var(--ent-text-heading); display: flex; align-items: center; gap: 8px; }
    .pdb-panel-title i { color: var(--ent-blue-dark); }
    .pdb-panel-body { padding: 16px 18px; }

    .pdb-legend-row { display: flex; align-items: center; justify-content: space-between; padding: 8px 0; border-bottom: 1px dashed var(--ent-border-soft); font-size: 12.5px; }
    .pdb-legend-row:last-child { border-bottom: none; }
    .pdb-legend-dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; margin-right: 8px; }
    .pdb-legend-name { color: var(--ent-text-body); }
    .pdb-legend-pct { color: var(--ent-text-muted); width: 42px; display: inline-block; text-align: right; }
    .pdb-legend-amt { font-weight: 600; color: var(--ent-text-heading); width: 108px; display: inline-block; text-align: right; }

    .pdb-empty { text-align: center; color: var(--ent-text-muted); padding: 30px 10px; font-size: 13px; }
    .pdb-table td, .pdb-table th { vertical-align: middle; }
    .pdb-net { color: var(--ent-indigo-dark); font-weight: 700; }
</style>

<div class="pdb-breadcrumb">
    <a asp-controller="Home" asp-action="Index"><i class="icon-home2"></i> Home</a> &gt;
    <a asp-action="Index">Payroll</a> &gt; <strong>Payroll Dashboard</strong>
</div>

@if (Model == null)
{
    <div class="alert alert-danger">
        <i class="icon-warning22 position-left"></i>
        Could not load the payroll dashboard right now. Please try again in a moment.
    </div>
    return;
}

<div class="pdb-header">
    <div class="pdb-header-left">
        <div class="pdb-header-icon"><i class="icon-coin-dollar"></i></div>
        <div>
            <h4 class="pdb-title">Payroll Dashboard</h4>
            <p class="pdb-subtitle">Overview of payroll, payments and employee salary details</p>
        </div>
    </div>

    <form asp-action="Dashboard" method="get" class="pdb-period-form">
        <div>
            <label class="pdb-period-label"><i class="icon-calendar3"></i> Payroll Period</label>
            <div style="display:flex; gap:6px;">
                <select name="month" class="form-control">
                    @for (int m = 1; m <= 12; m++)
                    {
                        var name = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m);
                        if (m == Model.Month) { <option value="@m" selected>@name</option> }
                        else { <option value="@m">@name</option> }
                    }
                </select>
                <select name="year" class="form-control">
                    @for (int y = DateTime.UtcNow.Year; y >= DateTime.UtcNow.Year - 5; y--)
                    {
                        if (y == Model.Year) { <option value="@y" selected>@y</option> }
                        else { <option value="@y">@y</option> }
                    }
                </select>
            </div>
        </div>
        <button type="submit" class="btn bg-primary"><i class="icon-search4 position-left"></i> Search</button>
    </form>
</div>

<!-- KPI cards -->
<div class="pdb-kpi-grid">
    <div class="pdb-kpi-card pdb-kpi-green">
        <span class="pdb-kpi-icon"><i class="icon-users"></i></span>
        <div>
            <p class="pdb-kpi-title">Total Employees</p>
            <div class="pdb-kpi-value">@Model.TotalActiveEmployees</div>
            <span class="pdb-kpi-sub">Active Employees</span>
        </div>
    </div>
    <div class="pdb-kpi-card pdb-kpi-blue">
        <span class="pdb-kpi-icon"><i class="icon-wallet"></i></span>
        <div>
            <p class="pdb-kpi-title">Total Gross Salary</p>
            <div class="pdb-kpi-value">₹ @Model.TotalGross.ToString("N2")</div>
            <span class="pdb-kpi-sub">For @Model.MonthName @Model.Year</span>
        </div>
    </div>
    <div class="pdb-kpi-card pdb-kpi-red">
        <span class="pdb-kpi-icon"><i class="icon-minus-circle2"></i></span>
        <div>
            <p class="pdb-kpi-title">Total Deductions</p>
            <div class="pdb-kpi-value">₹ @Model.TotalDeductions.ToString("N2")</div>
            <span class="pdb-kpi-sub">For @Model.MonthName @Model.Year</span>
        </div>
    </div>
    <div class="pdb-kpi-card pdb-kpi-purple">
        <span class="pdb-kpi-icon"><i class="icon-coin-dollar"></i></span>
        <div>
            <p class="pdb-kpi-title">Net Pay</p>
            <div class="pdb-kpi-value">₹ @Model.TotalNet.ToString("N2")</div>
            <span class="pdb-kpi-sub">For @Model.MonthName @Model.Year</span>
        </div>
    </div>
</div>

<div class="row">
    <!-- Payroll Trend -->
    <div class="col-md-8">
        <div class="pdb-panel">
            <div class="pdb-panel-head">
                <h6 class="pdb-panel-title"><i class="icon-stats-bars"></i> Payroll Trend (Last 6 Months)</h6>
            </div>
            <div class="pdb-panel-body">
                @if (Model.MonthlyTrend != null && Model.MonthlyTrend.Any(x => x.Count > 0))
                {
                    <div id="pdbTrendChart" style="height:300px;"></div>
                }
                else
                {
                    <div class="pdb-empty"><i class="icon-stats-bars" style="font-size:28px;display:block;margin-bottom:8px;opacity:.4;"></i>No payroll history yet for the last 6 months.</div>
                }
            </div>
        </div>
    </div>

    <!-- Salary Distribution -->
    <div class="col-md-4">
        <div class="pdb-panel">
            <div class="pdb-panel-head">
                <h6 class="pdb-panel-title"><i class="icon-pie-chart3"></i> Salary Distribution (@Model.MonthName @Model.Year)</h6>
            </div>
            <div class="pdb-panel-body">
                @if (Model.SalaryDistribution != null && Model.SalaryDistribution.Any())
                {
                    <div id="pdbDistChart" style="height:190px;"></div>
                    <div style="margin-top:8px;">
                        @{ string[] palette = { "#4e9cff", "#4cd39b", "#ffb547", "#c084fc", "#ff8a8a", "#8896ad" }; int ci = 0; }
                        @foreach (var d in Model.SalaryDistribution)
                        {
                            <div class="pdb-legend-row">
                                <span><span class="pdb-legend-dot" style="background:@palette[ci % palette.Length];"></span><span class="pdb-legend-name">@d.ComponentName</span></span>
                                <span><span class="pdb-legend-pct">@d.Percentage.ToString("0.#")%</span><span class="pdb-legend-amt">₹ @d.Amount.ToString("N2")</span></span>
                            </div>
                            ci++;
                        }
                    </div>
                }
                else
                {
                    <div class="pdb-empty"><i class="icon-pie-chart3" style="font-size:28px;display:block;margin-bottom:8px;opacity:.4;"></i>No earnings data for this month yet.</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Recent Payroll Payments -->
<div class="pdb-panel">
    <div class="pdb-panel-head">
        <h6 class="pdb-panel-title"><i class="icon-file-text2"></i> Recent Payroll Payments</h6>
        <div>
            <a asp-action="Generate" class="btn bg-primary btn-sm"><i class="icon-plus3 position-left"></i> Process Payroll</a>
            <a asp-action="Report" class="btn btn-default btn-sm"><i class="icon-list3 position-left"></i> View All</a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-striped pdb-table">
            <thead>
                <tr>
                    <th width="40">#</th>
                    <th>Employee Code</th>
                    <th>Employee Name</th>
                    <th>Department</th>
                    <th>Month</th>
                    <th class="text-right">Gross Salary (₹)</th>
                    <th class="text-right">Deductions (₹)</th>
                    <th class="text-right">Net Pay (₹)</th>
                    <th>Status</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentPayments != null && Model.RecentPayments.Any())
                {
                    int i = 1;
                    foreach (var p in Model.RecentPayments)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@(p.EmployeeCode ?? "-")</td>
                            <td>@(p.EmployeeName ?? "-")</td>
                            <td>@(p.DepartmentName ?? "-")</td>
                            <td>@p.MonthName @p.SalaryYear</td>
                            <td class="text-right">@p.GrossSalary.ToString("N2")</td>
                            <td class="text-right">@p.Deductions.ToString("N2")</td>
                            <td class="text-right pdb-net">@p.NetSalary.ToString("N2")</td>
                            <td>
                                @{
                                    string badge = p.Status switch { "Paid" => "bg-success", "Processed" => "bg-primary", "Draft" => "bg-grey", _ => "bg-warning" };
                                }
                                <span class="label @badge">@p.Status</span>
                            </td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-default btn-icon btn-xs" title="View Payroll Details"><i class="icon-eye"></i></a>
                                <a asp-action="Payslip" asp-route-id="@p.Id" target="_blank" class="btn btn-default btn-icon btn-xs" title="Payslip / PDF"><i class="icon-file-pdf"></i></a>
                            </td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr><td colspan="10" class="pdb-empty">No payroll payments recorded yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/global_assets/js/plugins/visualization/echarts/echarts.min.js"></script>
    <script>
        $(function () {
            var trendLabels = [@Html.Raw(string.Join(",", (Model.MonthlyTrend ?? new List<PayrollTrendPointDto>()).Select(x => "'" + (x.MonthName ?? "").Substring(0, Math.Min(3, (x.MonthName ?? "").Length)) + " " + x.Year + "'")))];
            var grossData = [@Html.Raw(string.Join(",", (Model.MonthlyTrend ?? new List<PayrollTrendPointDto>()).Select(x => x.TotalGross.ToString(System.Globalization.CultureInfo.InvariantCulture))))];
            var dedData = [@Html.Raw(string.Join(",", (Model.MonthlyTrend ?? new List<PayrollTrendPointDto>()).Select(x => x.TotalDeductions.ToString(System.Globalization.CultureInfo.InvariantCulture))))];
            var netData = [@Html.Raw(string.Join(",", (Model.MonthlyTrend ?? new List<PayrollTrendPointDto>()).Select(x => x.TotalNet.ToString(System.Globalization.CultureInfo.InvariantCulture))))];

            var trendEl = document.getElementById('pdbTrendChart');
            if (trendEl && typeof echarts !== 'undefined') {
                var trendChart = echarts.init(trendEl);
                trendChart.setOption({
                    tooltip: { trigger: 'axis', valueFormatter: function (v) { return '₹ ' + Number(v).toLocaleString('en-IN', { minimumFractionDigits: 2 }); } },
                    legend: { data: ['Gross Salary', 'Deductions', 'Net Pay'], bottom: 0 },
                    grid: { left: '3%', right: '4%', top: '10%', bottom: '15%', containLabel: true },
                    xAxis: { type: 'category', data: trendLabels },
                    yAxis: { type: 'value' },
                    series: [
                        { name: 'Gross Salary', type: 'bar', barGap: '20%', itemStyle: { color: '#4cd39b' }, data: grossData },
                        { name: 'Deductions', type: 'bar', itemStyle: { color: '#ff8a8a' }, data: dedData },
                        { name: 'Net Pay', type: 'bar', itemStyle: { color: '#4e9cff' }, data: netData }
                    ]
                });
                window.addEventListener('resize', function () { trendChart.resize(); });
            }

            var distEl = document.getElementById('pdbDistChart');
            if (distEl && typeof echarts !== 'undefined') {
                var distNames = [@Html.Raw(string.Join(",", (Model.SalaryDistribution ?? new List<PayrollSalaryDistributionItemDto>()).Select(x => "'" + (x.ComponentName ?? "").Replace("'", "") + "'")))];
                var distValues = [@Html.Raw(string.Join(",", (Model.SalaryDistribution ?? new List<PayrollSalaryDistributionItemDto>()).Select(x => x.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture))))];
                var palette = ['#4e9cff', '#4cd39b', '#ffb547', '#c084fc', '#ff8a8a', '#8896ad'];
                var distChart = echarts.init(distEl);
                var seriesData = [];
                for (var i = 0; i < distNames.length; i++) {
                    seriesData.push({ name: distNames[i], value: distValues[i] });
                }
                distChart.setOption({
                    tooltip: { trigger: 'item', valueFormatter: function (v) { return '₹ ' + Number(v).toLocaleString('en-IN', { minimumFractionDigits: 2 }); } },
                    color: palette,
                    series: [{
                        type: 'pie', radius: ['55%', '78%'],
                        label: { show: false },
                        data: seriesData
                    }]
                });
                window.addEventListener('resize', function () { distChart.resize(); });
            }
        });
    </script>
}
