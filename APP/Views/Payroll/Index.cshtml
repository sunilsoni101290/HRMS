@model IEnumerable<PayrollListDto>

@{
    ViewData["Title"] = "Payroll";
    int selYear = ViewBag.Year != null ? (int)ViewBag.Year : DateTime.UtcNow.Year;
    int selMonth = ViewBag.Month != null ? (int)ViewBag.Month : 0;

    string StatusLabel(string? s) => s switch
    {
        "Draft" => "bg-grey",
        "Processed" => "bg-primary",
        "Paid" => "bg-success",
        _ => "bg-info"
    };
}

<div class="panel panel-flat">

    <div class="panel-heading">
        <h5 class="panel-title">
            <i class="icon-cash3 position-left"></i> Payroll
        </h5>
        <div class="heading-elements">
            <a asp-action="Generate" class="btn bg-primary">
                <i class="icon-gear"></i> Process Salary
            </a>
        </div>
    </div>

    <div class="panel-body">
        <form asp-action="Index" method="get" class="form-inline">
            <div class="form-group">
                <label>Year</label>
                <select name="year" class="form-control" style="margin:0 8px;">
                    @for (int y = DateTime.UtcNow.Year; y >= DateTime.UtcNow.Year - 5; y--)
                    {
                        if (y == selYear)
                        {
                            <option value="@y" selected>@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Month</label>
                <select name="month" class="form-control" style="margin:0 8px;">
                    <option value="0">All</option>
                    @for (int m = 1; m <= 12; m++)
                    {
                        var name = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m);
                        if (m == selMonth)
                        {
                            <option value="@m" selected>@name</option>
                        }
                        else
                        {
                            <option value="@m">@name</option>
                        }
                    }
                </select>
            </div>
            <button type="submit" class="btn bg-primary"><i class="icon-search4"></i> Filter</button>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-striped">
            <thead>
                <tr>
                    <th width="50">#</th>
                    <th>Employee</th>
                    <th>Code</th>
                    <th>Period</th>
                    <th class="text-center">Present / Total Days</th>
                    <th class="text-center">Payable Days</th>
                    <th class="text-right">Gross</th>
                    <th class="text-right">Net</th>
                    <th>Status</th>
                    <th width="230">Action</th>
                </tr>
            </thead>
            <tbody>
                @{ int sr = 1; }
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@sr</td>
                            <td><strong>@item.EmployeeName</strong></td>
                            <td>@item.EmployeeCode</td>
                            <td>@item.MonthName @item.SalaryYear</td>
                            <td class="text-center">
                                @(item.PresentDays?.ToString("0.#") ?? "-") / @(item.TotalWorkingDays?.ToString("0.#") ?? "-")
                            </td>
                            <td class="text-center">
                                @(item.PayableDays?.ToString("0.#") ?? "-")
                                @if (item.RecalculatedCount > 0)
                                {
                                    <br /><small class="text-warning" title="Recalculated @item.RecalculatedCount time(s)"><i class="icon-loop2"></i> recalculated</small>
                                }
                            </td>
                            <td class="text-right">₹ @item.GrossSalary.ToString("N2")</td>
                            <td class="text-right"><strong>₹ @item.NetSalary.ToString("N2")</strong></td>
                            <td><span class="label @StatusLabel(item.Status)">@item.Status</span></td>
                            <td>
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-default btn-icon" title="View"><i class="icon-eye"></i></a>
                                    <a asp-action="Payslip" asp-route-id="@item.Id" target="_blank" class="btn btn-info btn-icon" title="Payslip"><i class="icon-file-text2"></i></a>
                                    @if (item.Status == "Draft")
                                    {
                                        <form asp-action="Process" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-primary btn-icon" title="Process"><i class="icon-checkmark3"></i></button>
                                        </form>
                                    }
                                    @if (item.Status == "Processed")
                                    {
                                        <form asp-action="MarkPaid" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-success btn-icon" title="Mark Paid"><i class="icon-coin-dollar"></i></button>
                                        </form>
                                    }
                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                       onclick="return confirmSweetDelete(event, this, 'Delete this payroll?');"
                                       class="btn btn-danger btn-icon" title="Delete"><i class="icon-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                        sr++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted" style="padding:30px;">
                            <i class="icon-cash3" style="font-size:32px;"></i><br />
                            No payroll records found for this period.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    @if (TempData["Success"] != null)
    {
        <script>$(function(){ swal({ title:"Success", text:"@TempData["Success"]", type:"success" }); });</script>
    }
    <style>
        .table > thead > tr > th { font-weight: 600; }
        .table > tbody > tr > td { vertical-align: middle; }
        .label { font-size: 11px; }
        .btn-icon { width: 34px; }
    </style>
}
