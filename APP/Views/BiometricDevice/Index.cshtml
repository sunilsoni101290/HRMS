@model IEnumerable<BiometricDeviceDto>

@{
    ViewData["Title"] = "Biometric Devices";

    var devices = Model ?? new List<BiometricDeviceDto>();
    var totalCount = devices.Count();
    var connectedCount = devices.Count(x => x.IsOnline);
    var disconnectedCount = totalCount - connectedCount;
    var neverSyncedCount = devices.Count(x => !x.LastSyncDate.HasValue);

    var companyNames = ViewBag.CompanyNames as Dictionary<string, string> ?? new();
    var branchNames = ViewBag.BranchNames as Dictionary<string, string> ?? new();
}

<div class="panel panel-flat biometric-panel">

    <!-- Page Header -->

    <div class="panel-heading">

        <h5 class="panel-title">
            <i class="bi bi-fingerprint position-left"></i>
            Biometric Device Management
        </h5>

        <div class="heading-elements">

            <a asp-action="Health"
               class="btn btn-default btn-icon-text"
               data-popup="tooltip"
               title="View health &amp; sync status of every device">
                <i class="bi bi-speedometer2 position-left"></i>
                Device Health
            </a>

            @if (ViewBag.IsDevelopment == true)
            {
                <a asp-controller="BiometricSimulator"
                   asp-action="Index"
                   class="btn btn-default btn-icon-text"
                   data-popup="tooltip"
                   title="Development only - fire test punches without a physical device">
                    <i class="icon-fingerprint position-left"></i>
                    Biometric Simulator
                </a>
            }

            <a asp-action="SyncAll"
               class="btn bg-warning btn-icon-text"
               onclick="return confirm('Sync all active devices now?');">
                <i class="icon-sync position-left"></i>
                Sync All Devices
            </a>

            <a asp-action="Create"
               class="btn bg-primary btn-icon-text">
                <i class="icon-plus22 position-left"></i>
                Add Device
            </a>

        </div>

    </div>

    <!-- Summary Cards -->

    <div class="panel-body summary-cards">

        <div class="row">

            <div class="col-md-3 col-sm-6">
                <div class="stat-card stat-primary">
                    <div class="stat-icon"><i class="bi bi-fingerprint"></i></div>
                    <div class="stat-body">
                        <h3 class="no-margin">@totalCount</h3>
                        <span>Total Devices</span>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <div class="stat-card stat-success">
                    <div class="stat-icon"><i class="icon-checkmark-circle"></i></div>
                    <div class="stat-body">
                        <h3 class="no-margin">@connectedCount</h3>
                        <span>Connected Devices</span>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <div class="stat-card stat-danger">
                    <div class="stat-icon"><i class="icon-cancel-circle2"></i></div>
                    <div class="stat-body">
                        <h3 class="no-margin">@disconnectedCount</h3>
                        <span>Disconnected Devices</span>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <div class="stat-card stat-info">
                    <div class="stat-icon"><i class="icon-watch2"></i></div>
                    <div class="stat-body">
                        <h3 class="no-margin">@neverSyncedCount</h3>
                        <span>Never Synced</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- Filters -->

        <div class="row filter-row">

            <div class="col-md-4 col-sm-6">
                <div class="form-group">
                    <label class="filter-label">Search</label>
                    <div class="input-group">
                        <span class="input-group-addon"><i class="icon-search4"></i></span>
                        <input type="text"
                               id="searchInput"
                               class="form-control"
                               placeholder="Search by name, code, IP or username..." />
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <div class="form-group">
                    <label class="filter-label">Company</label>
                    <select id="CompanyFilter" class="form-control select-search" asp-items="ViewBag.CompanyList">
                        <option value="">All Companies</option>
                    </select>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <div class="form-group">
                    <label class="filter-label">Status</label>
                    <select id="StatusFilter" class="form-control select-search">
                        <option value="">All Statuses</option>
                        <option value="connected">Connected</option>
                        <option value="disconnected">Disconnected</option>
                    </select>
                </div>
            </div>

            <div class="col-md-2 col-sm-6">
                <div class="form-group">
                    <label class="filter-label">&nbsp;</label>
                    <button type="button" id="clearFilters" class="btn btn-default btn-block">
                        <i class="icon-cross2 position-left"></i>
                        Clear
                    </button>
                </div>
            </div>

        </div>

    </div>

    <!-- Device Table -->

    <div class="table-responsive">

        <table class="table table-hover table-striped datatable-basic">

            <thead>
                <tr>
                    <th width="60">#</th>
                    <th>Device</th>
                    <th>Company / Branch</th>
                    <th>Agent</th>
                    <th>Network</th>
                    <th>Last Seen</th>
                    <th>Last Sync</th>
                    <th width="100" class="text-center">Status</th>
                    <th width="190" class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody id="deviceTable">
                @{
                    int sr = 1;
                }

                @foreach (var item in devices)
                {
                    var companyName = item.CompanyId != null && companyNames.ContainsKey(item.CompanyId)
                        ? companyNames[item.CompanyId]
                        : null;

                    var branchName = item.BranchId != null && branchNames.ContainsKey(item.BranchId)
                        ? branchNames[item.BranchId]
                        : null;

                    <tr data-status="@(item.IsOnline ? "connected" : "disconnected")"
                        data-company="@companyName">

                        <td>@sr</td>

                        <td>
                            <div class="text-semibold">
                                <i class="bi bi-fingerprint text-primary position-left"></i>
                                @item.DeviceName
                            </div>
                            <small class="text-muted">Code: @item.DeviceCode</small>
                        </td>

                        <td>
                            @if (companyName != null)
                            {
                                <span class="label bg-primary-400">@companyName</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                            <br />
                            @if (branchName != null)
                            {
                                <small class="text-muted">@branchName</small>
                            }
                        </td>

                        <td class="agent-cell">
                            @if (!string.IsNullOrEmpty(item.AgentId))
                            {
                                <a asp-controller="BiometricAgent" asp-action="Details" asp-route-id="@item.AgentId">
                                    @(item.AgentName ?? "View agent")
                                </a>
                            }
                            else
                            {
                                <span class="label label-warning" data-popup="tooltip" title="No agent assigned - this device will never be polled.">Unassigned</span>
                            }
                        </td>

                        <td>
                            <div>@item.IPAddress<span class="text-muted">:@item.Port</span></div>
                            <small class="text-muted">@item.DeviceType / @item.CommunicationType</small>
                        </td>

                        <td>
                            @if (item.LastSeen.HasValue)
                            {
                                <span>@item.LastSeen.Value.ToString("g")</span>
                            }
                            else
                            {
                                <span class="label label-default">Never</span>
                            }
                        </td>

                        <td>
                            @if (item.LastSyncDate.HasValue)
                            {
                                <span>@item.LastSyncDate.Value.ToString("g")</span>
                            }
                            else
                            {
                                <span class="label label-default">Never</span>
                            }
                        </td>

                        <td class="text-center">
                            @if (item.IsOnline)
                            {
                                <span class="label label-success" data-popup="tooltip" title="Agent synced within the last 15 minutes.">Connected</span>
                            }
                            else
                            {
                                <span class="label label-danger" data-popup="tooltip" title="No agent sync within the last 15 minutes.">Disconnected</span>
                            }
                            @if (!item.IsActive)
                            {
                                <br />
                                <small class="text-muted">(Disabled)</small>
                            }
                        </td>

                        <td class="text-center">

                            <div class="btn-group">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-default btn-icon"
                                   data-popup="tooltip"
                                   title="View">
                                    <i class="icon-eye"></i>
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-primary btn-icon"
                                   data-popup="tooltip"
                                   title="Edit">
                                    <i class="icon-pencil7"></i>
                                </a>

                                <button type="button"
                                        class="btn bg-success btn-icon test-connection-btn"
                                        data-id="@item.Id"
                                        data-popup="tooltip"
                                        title="Test Connection">
                                    <i class="icon-connection"></i>
                                </button>

                                <a asp-action="SyncNow"
                                   asp-route-id="@item.Id"
                                   class="btn bg-warning btn-icon"
                                   data-popup="tooltip"
                                   title="Sync Now"
                                   onclick="return confirm('Pull and process punches from this device now?');">
                                    <i class="icon-sync"></i>
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger btn-icon"
                                   data-popup="tooltip"
                                   title="Delete"
                                   onclick="return confirm('Are you sure you want to delete this device? Any BiometricAgent still using its Device Key will start failing.');">
                                    <i class="icon-trash"></i>
                                </a>

                            </div>

                        </td>

                    </tr>

                    sr++;
                }

                @if (!devices.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted">
                            No biometric devices configured yet. Click <strong>Add Device</strong> to create one.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@section Scripts {

    @if (TempData["Success"] != null)
    {
        <script>
            $(function () {
                swal({
                    title: "Success",
                    text: @Html.Raw(Json.Serialize(TempData["Success"])),
                    type: "success"
                });
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            $(function () {
                swal({
                    title: "Error",
                    text: @Html.Raw(Json.Serialize(TempData["Error"])),
                    type: "error"
                });
            });
        </script>
    }

    <script>

        $(document).ready(function () {

            // -----------------------------
            // Tooltips
            // -----------------------------

            $('[data-popup="tooltip"]').tooltip();

            // -----------------------------
            // Chosen selects
            // -----------------------------

            if ($.fn.chosen) {
                $(".select-search").chosen({ width: "100%", search_contains: true });
            }

            // -----------------------------
            // DataTable
            // -----------------------------

            var table = null;

            if ($.fn.DataTable) {
                table = $('.datatable-basic').DataTable({
                    autoWidth: false,
                    paging: true,
                    ordering: true,
                    searching: false,
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                    columnDefs: [{ orderable: false, targets: [0, 8] }],
                    language: { search: "_INPUT_", searchPlaceholder: "Search..." }
                });
            }

            // -----------------------------
            // Search + Filters (client-side)
            // -----------------------------

            function applyFilters() {

                var term = ($("#searchInput").val() || "").toLowerCase();
                var company = $("#CompanyFilter option:selected").text().toLowerCase();
                var status = $("#StatusFilter").val();

                $("#deviceTable > tr").each(function () {

                    var row = $(this);
                    var rowText = row.text().toLowerCase();

                    var matchesTerm = term === "" || rowText.indexOf(term) > -1;
                    var matchesCompany = company === "" || company === "all companies" ||
                        (row.data("company") || "").toString().toLowerCase() === company;
                    var matchesStatus = status === "" || row.data("status") === status;

                    row.toggle(matchesTerm && matchesCompany && matchesStatus);
                });
            }

            $("#searchInput").on("keyup", applyFilters);
            $("#CompanyFilter, #StatusFilter").on("change", applyFilters);

            $("#clearFilters").on("click", function () {
                $("#searchInput").val("");
                $("#CompanyFilter, #StatusFilter").val("").trigger("chosen:updated").trigger("change");
                applyFilters();
            });

            // -----------------------------
            // Test Connection (AJAX) - kicks off a REAL device-level test
            // (HRMS -> API -> BiometricAgent -> ESSL SDK -> device), then
            // polls for the outcome since the agent is outbound-poll-only
            // and can take up to ~a minute to pick the request up.
            // -----------------------------

            function biometricStageMessage(deviceCode, agentName, response) {
                var agentLabel = agentName || "assigned";

                if (response.success) {
                    return "ESSL device " + deviceCode + " is responding through the " + agentLabel + " agent." +
                        (response.deviceInfo ? " (" + response.deviceInfo + ")" : "");
                }

                switch (response.stage) {
                    case "AgentInactive":
                        return "The assigned biometric agent is inactive.";
                    case "AgentUnavailable":
                        return "The " + agentLabel + " biometric agent is unavailable.";
                    case "DeviceUnreachable":
                        return "The " + agentLabel + " biometric agent could not reach ESSL device " + deviceCode + ".";
                    case "SdkConnectionFailed":
                        return "The ESSL device could not be initialized or did not respond.";
                    default:
                        return response.message || "The device did not respond.";
                }
            }

            function biometricPollStatus(id, requestId, row, btn, originalIcon, deviceCode, agentName, attemptsLeft) {
                if (attemptsLeft <= 0) {
                    biometricShowTestResult(row, btn, originalIcon, false,
                        "Connection Failed",
                        "The biometric agent did not respond in time. Confirm the Windows Service is running.");
                    return;
                }

                $.ajax({
                    url: '@Url.Action("TestConnectionStatusAjax")',
                    type: "GET",
                    data: { id: id, requestId: requestId },
                    success: function (response) {
                        if (!response.complete) {
                            setTimeout(function () {
                                biometricPollStatus(id, requestId, row, btn, originalIcon, deviceCode, agentName, attemptsLeft - 1);
                            }, 3000);
                            return;
                        }

                        biometricShowTestResult(row, btn, originalIcon, response.success,
                            response.success ? "Connection Successful" : "Connection Failed",
                            biometricStageMessage(deviceCode, agentName, response));
                    },
                    error: function () {
                        biometricShowTestResult(row, btn, originalIcon, false, "Connection Failed",
                            "Unable to check the test connection status. Please try again.");
                    }
                });
            }

            function biometricShowTestResult(row, btn, originalIcon, success, title, message) {
                // Reflect the fresh result in this row's Status badge
                // immediately, without a full page reload.
                var statusCell = row.find("td.text-center").first();

                statusCell.find(".label").first()
                    .removeClass("label-success label-danger")
                    .addClass(success ? "label-success" : "label-danger")
                    .text(success ? "Connected" : "Disconnected");

                row.attr("data-status", success ? "connected" : "disconnected");

                if (typeof swal === "function") {
                    swal({ title: title, text: message, type: success ? "success" : "error" });
                } else {
                    alert(title + ": " + message);
                }

                btn.prop("disabled", false).html(originalIcon);
            }

            $(document).on("click", ".test-connection-btn", function () {

                var btn = $(this);
                var id = btn.data("id");
                var row = btn.closest("tr");
                var deviceCode = row.find("small.text-muted").first().text().replace("Code:", "").trim();
                var agentName = row.find("td.agent-cell").first().text().trim() || "assigned";
                var originalIcon = btn.html();

                btn.prop("disabled", true).html('<i class="icon-spinner2 spinner"></i>');

                $.ajax({
                    url: '@Url.Action("TestConnectionAjax")',
                    type: "POST",
                    data: { id: id },
                    success: function (response) {
                        if (response.complete) {
                            // Pre-flight failure (inactive device, no agent
                            // assigned, agent offline, ...) - nothing to poll for.
                            biometricShowTestResult(row, btn, originalIcon, false, "Connection Failed", response.message);
                            return;
                        }

                        // ~30 attempts * 3s = up to 90s, matching the API's own TestRequestTimeout.
                        biometricPollStatus(id, response.requestId, row, btn, originalIcon, deviceCode, agentName, 30);
                    },
                    error: function () {
                        biometricShowTestResult(row, btn, originalIcon, false, "Connection Failed", "Unable to test connection. Please try again.");
                    }
                });

            });

        });

    </script>

    <style>

        .biometric-panel .panel-heading { padding: 18px 20px; }
        .biometric-panel .panel-title { font-weight: 600; }
        .biometric-panel .heading-elements .btn { margin-left: 6px; }

        .summary-cards .stat-card {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 16px 18px;
            border-radius: 6px;
            margin-bottom: 20px;
            color: #fff;
        }

        .summary-cards .stat-icon {
            font-size: 26px;
            width: 46px;
            height: 46px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,.18);
            flex-shrink: 0;
        }

        .summary-cards .stat-body h3 { font-size: 24px; font-weight: 700; }
        .summary-cards .stat-body span { font-size: 12.5px; opacity: .9; }

        .stat-primary { background: linear-gradient(135deg,#4e9cff,#2b6fd9); }
        .stat-success { background: linear-gradient(135deg,#3ecf8e,#1f9d63); }
        .stat-danger { background: linear-gradient(135deg,#ff6b6b,#e64545); }
        .stat-info { background: linear-gradient(135deg,#5bc8f5,#2196cf); }

        .filter-row { margin-top: 4px; }
        .filter-label { font-size: 11.5px; font-weight: 600; text-transform: uppercase; color: #7a869a; margin-bottom: 4px; }

        .table > thead > tr > th {
            background: #fafafa;
            font-size: 12.5px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .3px;
            vertical-align: middle;
        }

        .table > tbody > tr > td { vertical-align: middle; font-size: 13px; }

        .btn-icon { width: 34px; height: 34px; padding: 8px; }

        .label { font-size: 11px; padding: 4px 8px; }

        .text-semibold { font-weight: 600; }

        .chosen-container { width: 100% !important; }

        .spinner { animation: biometric-spin 0.8s linear infinite; display: inline-block; }
        @@keyframes biometric-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

        @@media (max-width: 767px) {
            .biometric-panel .heading-elements .btn { margin: 4px 4px 0 0; }
        }

    </style>

}
