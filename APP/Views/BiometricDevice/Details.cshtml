@model BiometricDeviceDto

@{
    ViewData["Title"] = "Biometric Device Details";
}

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">
            <i class="icon-fingerprint position-left"></i>
            Biometric Device Details
        </h5>

        <div class="heading-elements">

            @if (Model.IsActive)
            {
                <span class="label label-success">
                    Active
                </span>
            }
            else
            {
                <span class="label label-danger">
                    Inactive
                </span>
            }

        </div>

    </div>

    <div class="panel-body">

        <!-- Summary Cards -->

        <div class="row">

            <div class="col-md-3">

                <div class="panel bg-primary-400">
                    <div class="panel-body text-center">
                        <i class="icon-fingerprint icon-2x"></i>
                        <h5 class="no-margin">@Model.DeviceCode</h5>
                        <span>Device Code</span>
                    </div>
                </div>

            </div>

            <div class="col-md-3">

                <div class="panel bg-success-400">
                    <div class="panel-body text-center">
                        <i class="icon-connection icon-2x"></i>
                        <h5 class="no-margin">@Model.IPAddress</h5>
                        <span>IP Address</span>
                    </div>
                </div>

            </div>

            <div class="col-md-3">

                <div class="panel bg-info-400">
                    <div class="panel-body text-center">
                        <i class="icon-switch2 icon-2x"></i>
                        <h5 class="no-margin">@Model.Port</h5>
                        <span>Port</span>
                    </div>
                </div>

            </div>

            <div class="col-md-3">

                <div class="panel @(Model.IsActive ? "bg-success-400" : "bg-danger-400")">
                    <div class="panel-body text-center">
                        <i class="icon-checkmark-circle icon-2x"></i>
                        <h5 class="no-margin">
                            @(Model.IsActive ? "Online" : "Offline")
                        </h5>
                        <span>Status</span>
                    </div>
                </div>

            </div>

        </div>

        <div class="row">

            <!-- Device Information -->

            <div class="col-md-6">

                <div class="panel panel-bordered">

                    <div class="panel-heading">
                        <h6 class="panel-title">
                            <i class="icon-fingerprint position-left"></i>
                            Device Information
                        </h6>
                    </div>

                    <table class="table table-striped">

                        <tbody>

                            <tr>
                                <th width="180">Device Name</th>
                                <td>@Model.DeviceName</td>
                            </tr>

                            <tr>
                                <th>Device Code</th>
                                <td>@Model.DeviceCode</td>
                            </tr>

                            <tr>
                                <th>IP Address</th>
                                <td>@Model.IPAddress</td>
                            </tr>

                            <tr>
                                <th>Port</th>
                                <td>@Model.Port</td>
                            </tr>

                            <tr>
                                <th>Status</th>
                                <td>
                                    @if (Model.IsActive)
                                    {
                                        <span class="label label-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="label label-danger">Inactive</span>
                                    }
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

            <!-- Organization Information -->

            <div class="col-md-6">

                <div class="panel panel-bordered">

                    <div class="panel-heading">
                        <h6 class="panel-title">
                            <i class="icon-office position-left"></i>
                            Organization Information
                        </h6>
                    </div>

                    <table class="table table-striped">

                        <tbody>

                            <tr>
                                <th width="180">Tenant Id</th>
                                <td>@Model.TenantId</td>
                            </tr>

                            <tr>
                                <th>Company Id</th>
                                <td>@Model.CompanyId</td>
                            </tr>

                            <tr>
                                <th>Branch Id</th>
                                <td>@Model.BranchId</td>
                            </tr>

                            <tr>
                                <th>Username</th>
                                <td>@Model.Username</td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <!-- API Configuration -->

        <div class="panel panel-flat">

            <div class="panel-heading">
                <h6 class="panel-title">
                    <i class="icon-link position-left"></i>
                    API Configuration
                </h6>
            </div>

            <table class="table table-bordered">

                <tbody>

                    <tr>

                        <th width="250">
                            API URL
                        </th>

                        <td>
                            @Model.ApiUrl
                        </td>

                    </tr>

                    <tr>

                        <th>
                            Authentication
                        </th>

                        <td>
                            <span class="label label-info">
                                Secured Credential
                            </span>
                        </td>

                    </tr>

                    <tr>

                        <th>
                            Password
                        </th>

                        <td>
                            ************
                        </td>

                    </tr>

                    <tr>

                        <th>
                            Device Key
                            <div class="text-muted font-size-sm">
                                Used by the on-site BiometricAgent to authenticate
                                punch pushes to /api/BiometricSync/ingest.
                            </div>
                        </th>

                        <td>
                            @if (!string.IsNullOrEmpty(Model.DeviceKey))
                            {
                                <code>@Model.DeviceKey</code>
                            }
                            else
                            {
                                <span class="text-muted">Not set.</span>
                            }
                        </td>

                    </tr>

                    <tr>

                        <th>
                            Last Sync
                        </th>

                        <td>
                            @(Model.LastSyncDate.HasValue
                                ? Model.LastSyncDate.Value.ToString("g")
                                : "Never")
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

        <!-- Device Actions -->

        <div class="text-right">

            <a asp-action="TestConnection"
               asp-route-id="@Model.Id"
               class="btn bg-success">

                <i class="icon-connection"></i>
                Test Connection

            </a>

            <a asp-action="SyncNow"
               asp-route-id="@Model.Id"
               class="btn bg-warning"
               onclick="return confirm('Pull and process punches from this device now?');">

                <i class="icon-sync"></i>
                Sync Now

            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn bg-primary">

                <i class="icon-pencil7"></i>
                Edit

            </a>

            <a asp-action="Index"
               class="btn btn-default">

                <i class="icon-arrow-left13"></i>
                Back

            </a>

        </div>

    </div>

</div>