@model BiometricDeviceDto

@{
    ViewData["Title"] = "Biometric Device Details";
    var companyName = ViewBag.CompanyName as string;
    var branchName = ViewBag.BranchName as string;
    var agentCode = ViewBag.AgentCode as string;
}

<div class="panel panel-flat biometric-details-panel">

    <div class="panel-heading">

        <h5 class="panel-title">
            <i class="bi bi-fingerprint position-left"></i>
            @Model.DeviceName
            <small class="text-muted">(@Model.DeviceCode)</small>
        </h5>

        <div class="heading-elements">
            @if (Model.IsOnline)
            {
                <span class="label label-success">Connected</span>
            }
            else
            {
                <span class="label label-danger">Disconnected</span>
            }
            @if (!Model.IsActive)
            {
                <span class="label label-default">Disabled</span>
            }
        </div>

    </div>

    <div class="panel-body">

        <!-- Summary Cards -->

        <div class="row">

            <div class="col-md-3 col-sm-6">
                <div class="stat-card stat-primary">
                    <div class="stat-icon"><i class="bi bi-fingerprint"></i></div>
                    <div class="stat-body">
                        <h5 class="no-margin">@Model.DeviceCode</h5>
                        <span>Device Code</span>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <div class="stat-card stat-success">
                    <div class="stat-icon"><i class="icon-connection"></i></div>
                    <div class="stat-body">
                        <h5 class="no-margin">@Model.IPAddress</h5>
                        <span>IP Address</span>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <div class="stat-card stat-info">
                    <div class="stat-icon"><i class="icon-switch2"></i></div>
                    <div class="stat-body">
                        <h5 class="no-margin">@Model.Port</h5>
                        <span>Port</span>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <div class="stat-card @(Model.IsActive ? "stat-success" : "stat-danger")">
                    <div class="stat-icon"><i class="icon-checkmark-circle"></i></div>
                    <div class="stat-body">
                        <h5 class="no-margin">@(Model.IsActive ? "Enabled" : "Disabled")</h5>
                        <span>Admin Setting</span>
                    </div>
                </div>
            </div>

        </div>

        <div class="row">

            <!-- Device Information -->

            <div class="col-md-6">

                <div class="panel panel-bordered detail-card">

                    <div class="panel-heading">
                        <h6 class="panel-title">
                            <i class="bi bi-fingerprint position-left"></i>
                            Device Information
                        </h6>
                    </div>

                    <table class="table table-striped">
                        <tbody>
                            <tr>
                                <th width="180">Device Name</th>
                                <td>@Model.DeviceName</td>
                            </tr>
                            <tr>
                                <th>Device Code</th>
                                <td>@Model.DeviceCode</td>
                            </tr>
                            <tr>
                                <th>Serial Number</th>
                                <td>@(string.IsNullOrEmpty(Model.SerialNumber) ? "—" : Model.SerialNumber)</td>
                            </tr>
                            <tr>
                                <th>IP Address</th>
                                <td>@Model.IPAddress</td>
                            </tr>
                            <tr>
                                <th>Port</th>
                                <td>@Model.Port</td>
                            </tr>
                            <tr>
                                <th>Device Type / Comm.</th>
                                <td>@Model.DeviceType / @Model.CommunicationType</td>
                            </tr>
                            <tr>
                                <th>Status</th>
                                <td id="deviceStatusCell">
                                    @if (Model.IsOnline)
                                    {
                                        <span class="label label-success">Connected</span>
                                    }
                                    else
                                    {
                                        <span class="label label-danger">Disconnected</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </div>

            </div>

            <!-- Organization Information -->

            <div class="col-md-6">

                <div class="panel panel-bordered detail-card">

                    <div class="panel-heading">
                        <h6 class="panel-title">
                            <i class="icon-office position-left"></i>
                            Organization Information
                        </h6>
                    </div>

                    <table class="table table-striped">
                        <tbody>
                            <tr>
                                <th width="180">Company</th>
                                <td>@(companyName ?? "—")</td>
                            </tr>
                            <tr>
                                <th>Branch</th>
                                <td>@(branchName ?? "—")</td>
                            </tr>
                            <tr>
                                <th>Last Seen</th>
                                <td>
                                    @(Model.LastSeen.HasValue
                                        ? Model.LastSeen.Value.ToString("g")
                                        : "Never")
                                </td>
                            </tr>
                            <tr>
                                <th>Last Sync</th>
                                <td>
                                    @(Model.LastSyncDate.HasValue
                                        ? Model.LastSyncDate.Value.ToString("g")
                                        : "Never")
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </div>

            </div>

        </div>

        <!-- Biometric Agent -->
        <!--
            Explicit device -> agent relationship, kept visually separate from
            "Device Information" so it's obvious this device does not talk to
            the ERP/HRMS directly: it communicates through this named
            BiometricAgent Windows Service, which in turn talks to the ESSL SDK.
        -->

        <div class="panel panel-bordered detail-card biometric-agent-card">

            <div class="panel-heading">
                <h6 class="panel-title">
                    <i class="icon-cog4 position-left"></i>
                    Biometric Agent
                </h6>
            </div>

            @if (!string.IsNullOrEmpty(Model.AgentId))
            {
                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <th width="250">Agent</th>
                            <td>
                                <a asp-controller="BiometricAgent" asp-action="Details" asp-route-id="@Model.AgentId">
                                    @(Model.AgentName ?? "View agent")
                                </a>
                            </td>
                        </tr>
                        <tr>
                            <th>Agent Code</th>
                            <td>@(string.IsNullOrEmpty(agentCode) ? "—" : agentCode)</td>
                        </tr>
                    </tbody>
                </table>
                <p class="text-muted font-size-sm biometric-agent-note">
                    This device communicates through the <strong>@(Model.AgentName ?? "assigned")</strong> agent -
                    the on-site Windows Service that connects to the ESSL device over its own network and
                    relays punches/test results back to this HRMS ERP. This server never talks to the device
                    directly.
                </p>
            }
            else
            {
                <div class="alert alert-warning no-margin">
                    <i class="icon-warning2 position-left"></i>
                    No biometric agent is assigned to this device - it will never be polled and
                    <strong>Test Connection</strong> will fail immediately. Assign one on the
                    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> page.
                </div>
            }

        </div>

        <!-- API Configuration -->

        <div class="panel panel-bordered detail-card">

            <div class="panel-heading">
                <h6 class="panel-title">
                    <i class="icon-link position-left"></i>
                    API Configuration
                </h6>
            </div>

            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th width="250">API URL</th>
                        <td>@(string.IsNullOrEmpty(Model.ApiUrl) ? "—" : Model.ApiUrl)</td>
                    </tr>
                    <tr>
                        <th>Authentication</th>
                        <td><span class="label label-info">Secured Credential</span></td>
                    </tr>
                    <tr>
                        <th>Password</th>
                        <td>••••••••••••</td>
                    </tr>
                    <tr>
                        <th>
                            Device Key
                            <div class="text-muted font-size-sm">
                                Used by the on-site BiometricAgent to authenticate
                                punch pushes to /api/BiometricSync/ingest.
                            </div>
                        </th>
                        <td>
                            @if (!string.IsNullOrEmpty(Model.DeviceKey))
                            {
                                <div class="device-key-row">
                                    <code id="deviceKey">@Model.DeviceKey</code>
                                    <button type="button"
                                            class="btn btn-default btn-xs copy-key-btn"
                                            data-popup="tooltip"
                                            title="Copy to clipboard">
                                        <i class="icon-copy3"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">Not set.</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>Last Sync</th>
                        <td>
                            @(Model.LastSyncDate.HasValue
                                ? Model.LastSyncDate.Value.ToString("g")
                                : "Never")
                        </td>
                    </tr>
                </tbody>
            </table>

        </div>

        <!-- Test Connection Result -->

        <div id="testConnectionResult" class="alert" style="display:none;"></div>

        <!-- Device Actions -->

        <div class="text-right form-actions">

            <button type="button" id="testConnectionBtn" class="btn bg-success" data-id="@Model.Id">
                <i class="icon-connection position-left"></i>
                Test Connection
            </button>

            <a asp-action="SyncNow"
               asp-route-id="@Model.Id"
               class="btn bg-warning"
               onclick="return confirm('Pull and process punches from this device now?');">
                <i class="icon-sync position-left"></i>
                Sync Now
            </a>

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn bg-primary">
                <i class="icon-pencil7 position-left"></i>
                Edit
            </a>

            <a asp-action="Index" class="btn btn-default">
                <i class="icon-arrow-left13 position-left"></i>
                Back
            </a>

        </div>

    </div>

</div>

@section Scripts {

    @if (TempData["Success"] != null)
    {
        <script>
            $(function () {
                swal({
                    title: "Success",
                    text: @Html.Raw(Json.Serialize(TempData["Success"])),
                    type: "success"
                });
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            $(function () {
                swal({
                    title: "Error",
                    text: @Html.Raw(Json.Serialize(TempData["Error"])),
                    type: "error"
                });
            });
        </script>
    }

    <script>

        $(document).ready(function () {

            $('[data-popup="tooltip"]').tooltip();

            var deviceCode = @Html.Raw(Json.Serialize(Model.DeviceCode));
            var agentName = @Html.Raw(Json.Serialize(string.IsNullOrEmpty(Model.AgentName) ? "the assigned" : Model.AgentName));

            // Real Test Connection is async under the hood (HRMS -> API ->
            // BiometricAgent -> ESSL SDK -> device) - the agent only polls
            // the API, it can't be called synchronously. So: kick off the
            // request, then poll TestConnectionStatusAjax every few seconds
            // until it completes or we give up waiting.
            function showResult(resultBox, success, html) {
                resultBox
                    .removeClass("alert-success alert-danger alert-info")
                    .addClass(success === null ? "alert-info" : (success ? "alert-success" : "alert-danger"))
                    .html(html)
                    .show();
            }

            function applyStatusBadge(success) {
                var text = success ? "Connected" : "Disconnected";

                $(".heading-elements .label-success, .heading-elements .label-danger").first()
                    .removeClass("label-success label-danger")
                    .addClass(success ? "label-success" : "label-danger")
                    .text(text);

                $("#deviceStatusCell .label")
                    .removeClass("label-success label-danger")
                    .addClass(success ? "label-success" : "label-danger")
                    .text(text);
            }

            function stageMessage(response) {
                // Distinct, specific copy per failure stage rather than a
                // single vague "Connection failed." - matches what each
                // Stage from BiometricDeviceService/BiometricAgent means.
                if (response.success) {
                    return "&#10003; Connection successful<br/>ESSL device " + deviceCode + " is responding through the " + agentName + " agent." +
                        (response.deviceInfo ? "<br/><small>" + response.deviceInfo + "</small>" : "");
                }

                switch (response.stage) {
                    case "AgentInactive":
                        return "&#10007; Connection failed<br/>The assigned biometric agent is inactive.";
                    case "AgentUnavailable":
                        return "&#10007; Connection failed<br/>The " + agentName + " biometric agent is unavailable.";
                    case "DeviceUnreachable":
                        return "&#10007; Connection failed<br/>The " + agentName + " biometric agent could not reach ESSL device " + deviceCode + ".";
                    case "SdkConnectionFailed":
                        return "&#10007; Connection failed<br/>The ESSL device could not be initialized or did not respond.";
                    default:
                        return "&#10007; Connection failed<br/>" + (response.message || "The device did not respond.");
                }
            }

            function pollStatus(id, requestId, resultBox, btn, originalHtml, attemptsLeft) {
                if (attemptsLeft <= 0) {
                    showResult(resultBox, false, "&#10007; Connection failed.<br/>The biometric agent did not respond in time. Confirm the Windows Service is running.");
                    applyStatusBadge(false);
                    btn.prop("disabled", false).html(originalHtml);
                    return;
                }

                $.ajax({
                    url: '@Url.Action("TestConnectionStatusAjax")',
                    type: "GET",
                    data: { id: id, requestId: requestId },
                    success: function (response) {
                        if (!response.complete) {
                            setTimeout(function () {
                                pollStatus(id, requestId, resultBox, btn, originalHtml, attemptsLeft - 1);
                            }, 3000);
                            return;
                        }

                        showResult(resultBox, response.success, stageMessage(response));
                        applyStatusBadge(response.success);
                        btn.prop("disabled", false).html(originalHtml);
                    },
                    error: function () {
                        showResult(resultBox, false, "&#10007; Connection failed.<br/>Unable to check the test connection status. Please try again.");
                        btn.prop("disabled", false).html(originalHtml);
                    }
                });
            }

            $("#testConnectionBtn").on("click", function () {

                var btn = $(this);
                var id = btn.data("id");
                var originalHtml = btn.html();
                var resultBox = $("#testConnectionResult");

                btn.prop("disabled", true)
                    .html('<i class="icon-spinner2 spinner position-left"></i> Testing...');

                showResult(resultBox, null, '<i class="icon-spinner2 spinner position-left"></i>Testing connection... (waiting for the biometric agent - this can take up to a minute)');

                $.ajax({
                    url: '@Url.Action("TestConnectionAjax")',
                    type: "POST",
                    data: { id: id },
                    success: function (response) {
                        if (response.complete) {
                            // Pre-flight failure (inactive device, no agent
                            // assigned, agent offline, ...) - nothing to poll for.
                            showResult(resultBox, false, "&#10007; Connection failed.<br/>" + response.message);
                            btn.prop("disabled", false).html(originalHtml);
                            return;
                        }

                        // ~30 attempts * 3s = up to 90s, matching the API's
                        // own TestRequestTimeout.
                        pollStatus(id, response.requestId, resultBox, btn, originalHtml, 30);
                    },
                    error: function () {
                        showResult(resultBox, false, "&#10007; Connection failed.<br/>Unable to test connection. Please try again.");
                        btn.prop("disabled", false).html(originalHtml);
                    }
                });

            });

            $(".copy-key-btn").on("click", function () {
                var text = $("#deviceKey").text().trim();

                if (navigator.clipboard) {
                    navigator.clipboard.writeText(text).then(function () {
                        if (typeof swal === "function") {
                            swal({ title: "Copied", text: "Device key copied to clipboard.", type: "success", timer: 1200, showConfirmButton: false });
                        }
                    });
                }
            });

        });

    </script>

    <style>

        .biometric-details-panel .stat-card {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 16px 18px;
            border-radius: 6px;
            margin-bottom: 20px;
            color: #fff;
        }

        .biometric-details-panel .stat-icon {
            font-size: 22px;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,.18);
            flex-shrink: 0;
        }

        .stat-primary { background: linear-gradient(135deg,#4e9cff,#2b6fd9); }
        .stat-success { background: linear-gradient(135deg,#3ecf8e,#1f9d63); }
        .stat-danger { background: linear-gradient(135deg,#ff6b6b,#e64545); }
        .stat-info { background: linear-gradient(135deg,#5bc8f5,#2196cf); }

        .detail-card { margin-bottom: 20px; }
        .detail-card .table th { width: 40%; color: #66707e; font-weight: 600; }

        .biometric-agent-card .biometric-agent-note { padding: 0 18px 16px; margin-bottom: 0; }

        .device-key-row { display: flex; align-items: center; gap: 8px; }
        .device-key-row code { word-break: break-all; }

        .form-actions { border-top: 1px solid #eef1f5; padding-top: 16px; }

        .spinner { animation: biometric-details-spin 0.8s linear infinite; display: inline-block; }
        @@keyframes biometric-details-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

    </style>

}
