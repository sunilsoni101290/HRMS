@model BiometricDeviceDto

@{
    ViewData["Title"] = "Biometric Device Details";
    var companyName = ViewBag.CompanyName as string;
    var branchName = ViewBag.BranchName as string;
}

<div class="panel panel-flat biometric-details-panel">

    <div class="panel-heading">

        <h5 class="panel-title">
            <i class="bi bi-fingerprint position-left"></i>
            @Model.DeviceName
            <small class="text-muted">(@Model.DeviceCode)</small>
        </h5>

        <div class="heading-elements">
            @if (Model.IsActive)
            {
                <span class="label label-success">Active</span>
            }
            else
            {
                <span class="label label-danger">Inactive</span>
            }
        </div>

    </div>

    <div class="panel-body">

        <!-- Summary Cards -->

        <div class="row">

            <div class="col-md-3 col-sm-6">
                <div class="stat-card stat-primary">
                    <div class="stat-icon"><i class="bi bi-fingerprint"></i></div>
                    <div class="stat-body">
                        <h5 class="no-margin">@Model.DeviceCode</h5>
                        <span>Device Code</span>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <div class="stat-card stat-success">
                    <div class="stat-icon"><i class="icon-connection"></i></div>
                    <div class="stat-body">
                        <h5 class="no-margin">@Model.IPAddress</h5>
                        <span>IP Address</span>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <div class="stat-card stat-info">
                    <div class="stat-icon"><i class="icon-switch2"></i></div>
                    <div class="stat-body">
                        <h5 class="no-margin">@Model.Port</h5>
                        <span>Port</span>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <div class="stat-card @(Model.IsActive ? "stat-success" : "stat-danger")">
                    <div class="stat-icon"><i class="icon-checkmark-circle"></i></div>
                    <div class="stat-body">
                        <h5 class="no-margin">@(Model.IsActive ? "Enabled" : "Disabled")</h5>
                        <span>Status</span>
                    </div>
                </div>
            </div>

        </div>

        <div class="row">

            <!-- Device Information -->

            <div class="col-md-6">

                <div class="panel panel-bordered detail-card">

                    <div class="panel-heading">
                        <h6 class="panel-title">
                            <i class="bi bi-fingerprint position-left"></i>
                            Device Information
                        </h6>
                    </div>

                    <table class="table table-striped">
                        <tbody>
                            <tr>
                                <th width="180">Device Name</th>
                                <td>@Model.DeviceName</td>
                            </tr>
                            <tr>
                                <th>Device Code</th>
                                <td>@Model.DeviceCode</td>
                            </tr>
                            <tr>
                                <th>Serial Number</th>
                                <td>@(string.IsNullOrEmpty(Model.SerialNumber) ? "—" : Model.SerialNumber)</td>
                            </tr>
                            <tr>
                                <th>IP Address</th>
                                <td>@Model.IPAddress</td>
                            </tr>
                            <tr>
                                <th>Port</th>
                                <td>@Model.Port</td>
                            </tr>
                            <tr>
                                <th>Status</th>
                                <td>
                                    @if (Model.IsActive)
                                    {
                                        <span class="label label-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="label label-danger">Inactive</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </div>

            </div>

            <!-- Organization Information -->

            <div class="col-md-6">

                <div class="panel panel-bordered detail-card">

                    <div class="panel-heading">
                        <h6 class="panel-title">
                            <i class="icon-office position-left"></i>
                            Organization Information
                        </h6>
                    </div>

                    <table class="table table-striped">
                        <tbody>
                            <tr>
                                <th width="180">Company</th>
                                <td>@(companyName ?? "—")</td>
                            </tr>
                            <tr>
                                <th>Branch</th>
                                <td>@(branchName ?? "—")</td>
                            </tr>
                            <tr>
                                <th>Username</th>
                                <td>@Model.Username</td>
                            </tr>
                            <tr>
                                <th>Last Sync</th>
                                <td>
                                    @(Model.LastSyncDate.HasValue
                                        ? Model.LastSyncDate.Value.ToString("g")
                                        : "Never")
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </div>

            </div>

        </div>

        <!-- API Configuration -->

        <div class="panel panel-bordered detail-card">

            <div class="panel-heading">
                <h6 class="panel-title">
                    <i class="icon-link position-left"></i>
                    API Configuration
                </h6>
            </div>

            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th width="250">API URL</th>
                        <td>@(string.IsNullOrEmpty(Model.ApiUrl) ? "—" : Model.ApiUrl)</td>
                    </tr>
                    <tr>
                        <th>Authentication</th>
                        <td><span class="label label-info">Secured Credential</span></td>
                    </tr>
                    <tr>
                        <th>Password</th>
                        <td>••••••••••••</td>
                    </tr>
                    <tr>
                        <th>
                            Device Key
                            <div class="text-muted font-size-sm">
                                Used by the on-site BiometricAgent to authenticate
                                punch pushes to /api/BiometricSync/ingest.
                            </div>
                        </th>
                        <td>
                            @if (!string.IsNullOrEmpty(Model.DeviceKey))
                            {
                                <div class="device-key-row">
                                    <code id="deviceKey">@Model.DeviceKey</code>
                                    <button type="button"
                                            class="btn btn-default btn-xs copy-key-btn"
                                            data-popup="tooltip"
                                            title="Copy to clipboard">
                                        <i class="icon-copy3"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">Not set.</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>Last Sync</th>
                        <td>
                            @(Model.LastSyncDate.HasValue
                                ? Model.LastSyncDate.Value.ToString("g")
                                : "Never")
                        </td>
                    </tr>
                </tbody>
            </table>

        </div>

        <!-- Test Connection Result -->

        <div id="testConnectionResult" class="alert" style="display:none;"></div>

        <!-- Device Actions -->

        <div class="text-right form-actions">

            <button type="button" id="testConnectionBtn" class="btn bg-success" data-id="@Model.Id">
                <i class="icon-connection position-left"></i>
                Test Connection
            </button>

            <a asp-action="SyncNow"
               asp-route-id="@Model.Id"
               class="btn bg-warning"
               onclick="return confirm('Pull and process punches from this device now?');">
                <i class="icon-sync position-left"></i>
                Sync Now
            </a>

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn bg-primary">
                <i class="icon-pencil7 position-left"></i>
                Edit
            </a>

            <a asp-action="Index" class="btn btn-default">
                <i class="icon-arrow-left13 position-left"></i>
                Back
            </a>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        $(document).ready(function () {

            $('[data-popup="tooltip"]').tooltip();

            $("#testConnectionBtn").on("click", function () {

                var btn = $(this);
                var id = btn.data("id");
                var originalHtml = btn.html();
                var resultBox = $("#testConnectionResult");

                btn.prop("disabled", true)
                    .html('<i class="icon-spinner2 spinner position-left"></i> Testing...');

                resultBox.hide();

                $.ajax({
                    url: '@Url.Action("TestConnectionAjax")',
                    type: "POST",
                    data: { id: id },
                    success: function (response) {
                        resultBox
                            .removeClass("alert-success alert-danger")
                            .addClass(response.success ? "alert-success" : "alert-danger")
                            .html(
                                '<i class="icon-' + (response.success ? "checkmark-circle" : "cancel-circle2") +
                                ' position-left"></i>' + response.message
                            )
                            .show();
                    },
                    error: function () {
                        resultBox
                            .removeClass("alert-success")
                            .addClass("alert-danger")
                            .html('<i class="icon-cancel-circle2 position-left"></i>Unable to test connection. Please try again.')
                            .show();
                    },
                    complete: function () {
                        btn.prop("disabled", false).html(originalHtml);
                    }
                });

            });

            $(".copy-key-btn").on("click", function () {
                var text = $("#deviceKey").text().trim();

                if (navigator.clipboard) {
                    navigator.clipboard.writeText(text).then(function () {
                        if (typeof swal === "function") {
                            swal({ title: "Copied", text: "Device key copied to clipboard.", type: "success", timer: 1200, showConfirmButton: false });
                        }
                    });
                }
            });

        });

    </script>

    <style>

        .biometric-details-panel .stat-card {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 16px 18px;
            border-radius: 6px;
            margin-bottom: 20px;
            color: #fff;
        }

        .biometric-details-panel .stat-icon {
            font-size: 22px;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,.18);
            flex-shrink: 0;
        }

        .stat-primary { background: linear-gradient(135deg,#4e9cff,#2b6fd9); }
        .stat-success { background: linear-gradient(135deg,#3ecf8e,#1f9d63); }
        .stat-danger { background: linear-gradient(135deg,#ff6b6b,#e64545); }
        .stat-info { background: linear-gradient(135deg,#5bc8f5,#2196cf); }

        .detail-card { margin-bottom: 20px; }
        .detail-card .table th { width: 40%; color: #66707e; font-weight: 600; }

        .device-key-row { display: flex; align-items: center; gap: 8px; }
        .device-key-row code { word-break: break-all; }

        .form-actions { border-top: 1px solid #eef1f5; padding-top: 16px; }

        .spinner { animation: biometric-details-spin 0.8s linear infinite; display: inline-block; }
        @@keyframes biometric-details-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

    </style>

}
