@model APP.Models.DTOs.PagedResult<ErrorLogDto>
@{
    ViewData["Title"] = "Error Log";
    var filter = ViewBag.Filter as ErrorLogFilterDto ?? new ErrorLogFilterDto();
    var totalPages = Model.PageSize > 0 ? (int)Math.Ceiling(Model.TotalRecords / (double)Model.PageSize) : 1;
    if (totalPages < 1) totalPages = 1;
}

<div class="panel panel-flat">

    <div class="panel-heading">
        <h5 class="panel-title">
            <i class="bi bi-bug-fill position-left"></i>
            Error Log
        </h5>
        <div class="heading-elements">
            <span class="text-muted">System Configurator only - centralized application error/exception log</span>
        </div>
    </div>

    <div class="panel-body">

        <form asp-action="Index" method="get" class="row">

            <div class="col-md-2">
                <label>Date From</label>
                <input type="date" name="DateFrom" class="form-control"
                       value="@(filter.DateFrom?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="col-md-2">
                <label>Date To</label>
                <input type="date" name="DateTo" class="form-control"
                       value="@(filter.DateTo?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="col-md-2">
                <label>Module</label>
                <select name="ModuleName" class="form-control">
                    <option value="">-- All Modules --</option>
                    <option value="Biometric Device Integration" selected="@(filter.ModuleName == "Biometric Device Integration")">Biometric Device Integration</option>
                    <option value="HRMS" selected="@(filter.ModuleName == "HRMS")">HRMS</option>
                </select>
            </div>

            <div class="col-md-2">
                <label>Controller / Feature</label>
                <input type="text" name="Controller" class="form-control" placeholder="e.g. BiometricDevice"
                       value="@filter.Controller" />
            </div>

            <div class="col-md-2">
                <label>User</label>
                <input type="text" name="UserName" class="form-control" placeholder="Username"
                       value="@filter.UserName" />
            </div>

            <div class="col-md-2">
                <label>Status</label>
                <select name="IsResolved" class="form-control">
                    <option value="">-- All --</option>
                    <option value="false" selected="@(filter.IsResolved == false)">Unresolved</option>
                    <option value="true" selected="@(filter.IsResolved == true)">Resolved</option>
                </select>
            </div>

            <div class="col-md-4" style="margin-top:10px;">
                <label>Error Message contains</label>
                <input type="text" name="ErrorMessage" class="form-control" placeholder="Search error message..."
                       value="@filter.ErrorMessage" />
            </div>

            <div class="col-md-8 text-right" style="margin-top:34px;">
                <button type="submit" class="btn btn-default">
                    <i class="icon-search4 position-left"></i>
                    Filter
                </button>
                <a asp-action="Index" class="btn btn-link">
                    <i class="icon-cross2 position-left"></i>
                    Clear
                </a>
            </div>

        </form>

    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover datatable-basic">
            <thead>
                <tr>
                    <th>Date / Time</th>
                    <th>Module / Feature</th>
                    <th>Error Message</th>
                    <th>Controller / Action</th>
                    <th>User</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Data != null)
                {
                    @foreach (var item in Model.Data)
                    {
                        <tr>
                            <td>@item.ErrorTime.ToLocalTime().ToString("dd-MMM-yyyy hh:mm tt")</td>
                            <td>
                                <span class="label label-info">@(item.ModuleName ?? "—")</span>
                                <div class="text-muted font-size-sm">@item.FeatureName</div>
                            </td>
                            <td>
                                <span title="@item.ErrorMessage">
                                    @(item.ErrorMessage != null && item.ErrorMessage.Length > 80
                                        ? item.ErrorMessage.Substring(0, 80) + "…"
                                        : item.ErrorMessage)
                                </span>
                                @if (!string.IsNullOrEmpty(item.ExceptionType))
                                {
                                    <div class="text-muted font-size-sm"><code>@item.ExceptionType</code></div>
                                }
                            </td>
                            <td>@item.Controller / @item.Action</td>
                            <td>@(string.IsNullOrEmpty(item.UserName) ? "—" : item.UserName)</td>
                            <td>
                                @if (item.IsResolved)
                                {
                                    <span class="label label-success">Resolved</span>
                                }
                                else
                                {
                                    <span class="label label-danger">Unresolved</span>
                                }
                            </td>
                            <td class="text-center">
                                <ul class="icons-list">
                                    <li>
                                        <a href="#" class="view-details-btn" data-id="@item.Id" title="View Details">
                                            <i class="icon-eye"></i>
                                        </a>
                                    </li>
                                    @if (!item.IsResolved)
                                    {
                                        <li>
                                            <a href="#" class="resolve-btn" data-id="@item.Id" title="Mark as Resolved">
                                                <i class="icon-checkmark3"></i>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </td>
                        </tr>
                    }
                }
                @if (Model.Data == null || !Model.Data.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted">No error log entries match this filter.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="panel-body">
        <div class="row">
            <div class="col-md-6 text-muted">
                Showing page @Model.PageNumber of @totalPages (@Model.TotalRecords total)
            </div>
            <div class="col-md-6 text-right">
                @if (Model.PageNumber > 1)
                {
                    <a class="btn btn-default btn-sm"
                       asp-action="Index"
                       asp-all-route-data="@GetPageRouteData(filter, Model.PageNumber - 1)">
                        <i class="icon-arrow-left8"></i> Previous
                    </a>
                }
                @if (Model.PageNumber < totalPages)
                {
                    <a class="btn btn-default btn-sm"
                       asp-action="Index"
                       asp-all-route-data="@GetPageRouteData(filter, Model.PageNumber + 1)">
                        Next <i class="icon-arrow-right8"></i>
                    </a>
                }
            </div>
        </div>
    </div>

</div>

<!-- Details Modal -->
<div class="modal fade" id="errorDetailsModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h5>Error Details</h5>
            </div>
            <div class="modal-body" id="errorDetailsBody">
                <div class="text-center text-muted">Loading...</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Resolve Modal -->
<div class="modal fade" id="resolveModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h5>Mark Error as Resolved</h5>
            </div>
            <div class="modal-body">
                <input type="hidden" id="resolveErrorId" />
                <div class="form-group">
                    <label>Resolution Remark</label>
                    <textarea id="resolveRemarks" class="form-control" rows="3"
                              placeholder="Optional - describe the fix / root cause..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn bg-primary" id="confirmResolveBtn">
                    <i class="icon-checkmark3 position-left"></i>
                    Mark Resolved
                </button>
            </div>
        </div>
    </div>
</div>

@functions {
    private Dictionary<string, string> GetPageRouteData(ErrorLogFilterDto filter, int page)
    {
        var d = new Dictionary<string, string>
        {
            ["PageNumber"] = page.ToString(),
            ["PageSize"] = filter.PageSize.ToString()
        };
        if (filter.DateFrom.HasValue) d["DateFrom"] = filter.DateFrom.Value.ToString("yyyy-MM-dd");
        if (filter.DateTo.HasValue) d["DateTo"] = filter.DateTo.Value.ToString("yyyy-MM-dd");
        if (!string.IsNullOrEmpty(filter.ModuleName)) d["ModuleName"] = filter.ModuleName;
        if (!string.IsNullOrEmpty(filter.Controller)) d["Controller"] = filter.Controller;
        if (!string.IsNullOrEmpty(filter.UserName)) d["UserName"] = filter.UserName;
        if (!string.IsNullOrEmpty(filter.ErrorMessage)) d["ErrorMessage"] = filter.ErrorMessage;
        if (filter.IsResolved.HasValue) d["IsResolved"] = filter.IsResolved.Value.ToString();
        return d;
    }
}

@section Scripts {
    <script>
        $(document).ready(function () {

            $(".view-details-btn").on("click", function (e) {
                e.preventDefault();
                var id = $(this).data("id");

                $("#errorDetailsBody").html('<div class="text-center text-muted">Loading...</div>');
                $("#errorDetailsModal").modal("show");

                $.get("@Url.Action("Details")", { id: id })
                    .done(function (html) {
                        $("#errorDetailsBody").html(html);
                    })
                    .fail(function () {
                        $("#errorDetailsBody").html('<div class="alert alert-danger">Unable to load error details.</div>');
                    });
            });

            $(".resolve-btn").on("click", function (e) {
                e.preventDefault();
                $("#resolveErrorId").val($(this).data("id"));
                $("#resolveRemarks").val("");
                $("#resolveModal").modal("show");
            });

            $("#confirmResolveBtn").on("click", function () {
                var btn = $(this);
                var id = $("#resolveErrorId").val();
                var remarks = $("#resolveRemarks").val();

                btn.prop("disabled", true).html('<i class="icon-spinner2 spinner position-left"></i> Saving...');

                $.ajax({
                    url: "@Url.Action("Resolve")",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify({ Id: id, Remarks: remarks }),
                    success: function (resp) {
                        btn.prop("disabled", false).html('<i class="icon-checkmark3 position-left"></i> Mark Resolved');
                        $("#resolveModal").modal("hide");

                        if (resp.success) {
                            swal({ title: "Success", text: resp.message || "Error marked as resolved.", type: "success" }, function () {
                                location.reload();
                            });
                        } else {
                            swal("Error", resp.message || "Unable to resolve this error.", "error");
                        }
                    },
                    error: function () {
                        btn.prop("disabled", false).html('<i class="icon-checkmark3 position-left"></i> Mark Resolved');
                        swal("Error", "Unable to reach the ERP API.", "error");
                    }
                });
            });

        });
    </script>

    <style>
        .font-size-sm { font-size: 12px; }
    </style>

    <script>
        // Auto-added: client-side pagination for this Index page's listing
        // table (DataTables). Safe to run even if this page already
        // initializes '.datatable-basic' itself above - 'retrieve: true'
        // makes DataTables return the existing instance instead of
        // re-initializing (and throwing) when that's the case.
        $(document).ready(function () {
            if ($.fn.DataTable) {
                var __indexDataTable = $('.datatable-basic').DataTable({
                    autoWidth: false,
                    paging: true,
                    ordering: true,
                    searching: true,
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                    language: { search: "_INPUT_", searchPlaceholder: "Search..." },
                    retrieve: true
                });
            }
        });
    </script>
}
