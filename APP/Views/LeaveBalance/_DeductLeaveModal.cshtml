@model LeaveAdjustmentRequestDto


<div class="modal fade"
     id="deductModal">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5>Deduct Leave</h5>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="DeductEmployeeId" />

                <input type="hidden"
                       id="DeductLeaveTypeId" />

                <label>Days</label>

                <input type="number"
                       id="DeductDays"
                       class="form-control" />

            </div>

            <div class="modal-footer">

                <button type="button"
                        id="btnDeduct"
                        class="btn btn-danger">

                    Deduct

                </button>

            </div>

        </div>

    </div>

</div>


