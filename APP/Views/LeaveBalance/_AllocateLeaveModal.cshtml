@model AllocateLeaveRequestDto

<div class="modal fade"
     id="allocateModal">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5>Allocate Leave</h5>

            </div>

            <div class="modal-body">

                <div class="mb-3">

                    <label>Employee</label>

                    <select id="AllocateEmployeeId"
                            class="form-control">
                    </select>

                </div>

                <div class="mb-3">

                    <label>Year</label>

                    <input type="number"
                           id="AllocateYear"
                           value="@DateTime.Now.Year"
                           class="form-control" />

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        id="btnAllocate"
                        class="btn btn-primary">

                    Save

                </button>

            </div>

        </div>

    </div>

</div>