@model LeaveAdjustmentRequestDto

<div class="modal fade"
     id="creditModal">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5>Credit Leave</h5>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="CreditEmployeeId" />

                <input type="hidden"
                       id="CreditLeaveTypeId" />

                <label>Days</label>

                <input type="number"
                       id="CreditDays"
                       class="form-control" />

            </div>

            <div class="modal-footer">

                <button type="button"
                        id="btnCredit"
                        class="btn btn-success">

                    Credit

                </button>

            </div>

        </div>

    </div>

</div>