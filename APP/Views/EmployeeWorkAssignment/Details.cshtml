@model APP.Models.DTOs.EmployeeWorkAssignmentDto
@{
    ViewData["Title"] = "Assignment Details";
}

<div class="panel panel-flat">
    <div class="panel-heading">
        <h5 class="panel-title"><i class="icon-briefcase position-left"></i> @Model.JobNumber @(Model.JobItemCode != null ? "/ " + Model.JobItemCode : "")</h5>
        <div class="heading-elements">
            <a asp-action="Index" class="btn btn-default btn-sm"><i class="icon-arrow-left13 position-left"></i> Back</a>
        </div>
    </div>

    <div class="panel-body">

        @if (Model.RejectionReason != null && Model.Status == 5)
        {
            <div class="alert alert-danger"><strong>Rejected:</strong> @Model.RejectionReason</div>
        }

        @if (Model.IsOverUtilized)
        {
            <div class="alert alert-warning">
                <i class="icon-warning22 position-left"></i>
                Actual hours (@Model.ActualHours.ToString("0.##")) exceeded estimated hours (@Model.EstimatedHours?.ToString("0.##")) by @((Model.ActualHours - (Model.EstimatedHours ?? 0)).ToString("0.##")) hours.
            </div>
        }

        <div class="row">
            <div class="col-md-3"><label class="text-muted">Job</label><p><strong>@Model.JobNumber</strong> - @Model.JobName</p></div>
            <div class="col-md-3"><label class="text-muted">Client</label><p>@(Model.ClientName ?? "-")</p></div>
            <div class="col-md-3"><label class="text-muted">Job Type</label><p>@(Model.JobTypeName ?? "-")</p></div>
            <div class="col-md-3"><label class="text-muted">Structure/Equipment</label><p>@(Model.JobItemCode ?? "Any (whole job)")</p></div>
        </div>

        <div class="row">
            <div class="col-md-3"><label class="text-muted">Assigned Activity</label><p>@(Model.WorkActivityName ?? "Any")</p></div>
            <div class="col-md-3"><label class="text-muted">Assigned By</label><p>@(Model.AssignedByName ?? "-")</p></div>
            <div class="col-md-3"><label class="text-muted">Start Date</label><p>@(Model.StartDate?.ToString("dd-MMM-yyyy") ?? "-")</p></div>
            <div class="col-md-3"><label class="text-muted">Expected End Date</label><p>@(Model.ExpectedEndDate?.ToString("dd-MMM-yyyy") ?? "-")</p></div>
        </div>

        <div class="row">
            <div class="col-md-3"><label class="text-muted">Estimated Hours</label><p>@(Model.EstimatedHours?.ToString("0.##") ?? "-")</p></div>
            <div class="col-md-3"><label class="text-muted">Actual Hours (Logged)</label><p>@Model.ActualHours.ToString("0.##")</p></div>
            <div class="col-md-3"><label class="text-muted">Remaining Hours</label><p>@(Model.RemainingHours?.ToString("0.##") ?? "-")</p></div>
            <div class="col-md-3"><label class="text-muted">Current Status</label><p><span class="label bg-primary">@Model.StatusName</span></p></div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Instructions))
        {
            <div class="row">
                <div class="col-md-12">
                    <label class="text-muted">Instructions</label>
                    <p class="well well-sm">@Model.Instructions</p>
                </div>
            </div>
        }

        <hr />

        <div id="statusActions">
            @if (Model.Status == 1)
            {
                <button type="button" class="btn bg-success btnStatus" data-status="2">
                    <i class="icon-checkmark3 position-left"></i> Accept
                </button>
                <button type="button" class="btn btn-danger btnStatus" data-status="5" data-needs-reason="1">
                    <i class="icon-cross2 position-left"></i> Reject
                </button>
            }
            else if (Model.Status == 2)
            {
                <button type="button" class="btn bg-primary btnStatus" data-status="3">
                    <i class="icon-play3 position-left"></i> Start Work (In Progress)
                </button>
            }
            else if (Model.Status == 3)
            {
                <button type="button" class="btn bg-success btnStatus" data-status="4">
                    <i class="icon-checkmark4 position-left"></i> Mark Completed
                </button>
                <a asp-controller="DailyWorkEntry" asp-action="Index" class="btn btn-default">
                    <i class="icon-calendar3 position-left"></i> Log Today's Work
                </a>
            }
            else
            {
                <span class="text-muted">No further action available for this assignment.</span>
            }
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/global_assets/js/plugins/notifications/sweet_alert.min.js"></script>
    <script>
        $(".btnStatus").on("click", function () {
            var status = $(this).data("status");
            var needsReason = $(this).data("needs-reason") === 1;

            function submit(remarks) {
                $.ajax({
                    url: "@Url.Action("UpdateStatus")/@Model.Id",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify({ Status: status, Remarks: remarks }),
                    success: function (res) {
                        if (res.success) {
                            swal({ title: "Updated", text: res.message || "Assignment status updated.", type: "success" }, function () { location.reload(); });
                        } else {
                            swal("Something went wrong", res.message || "Unable to update status.", "error");
                        }
                    },
                    error: function () {
                        swal("Something went wrong", "Unable to reach the server.", "error");
                    }
                });
            }

            if (needsReason) {
                swal({
                    title: "Reason for rejection",
                    text: "Please explain why you are rejecting this assignment:",
                    type: "input",
                    showCancelButton: true,
                    confirmButtonText: "Reject Assignment",
                    inputPlaceholder: "Reason..."
                }, function (value) {
                    if (value === false) return;
                    if (!value || !$.trim(value)) { swal.showInputError("A reason is required."); return; }
                    submit(value);
                });
            } else {
                swal({
                    title: "Are you sure?",
                    text: "This will update the assignment status.",
                    type: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#66BB6A",
                    confirmButtonText: "Yes, confirm"
                }, function (confirmed) {
                    if (!confirmed) return;
                    submit(null);
                });
            }
        });
    </script>
}
