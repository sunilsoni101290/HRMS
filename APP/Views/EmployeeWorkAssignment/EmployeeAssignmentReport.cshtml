@model List<APP.Models.DTOs.EmployeeAssignmentReportRowDto>
@{
    ViewData["Title"] = "Employee Assignment Report";
}

<div class="panel panel-flat">
    <div class="panel-heading">
        <h5 class="panel-title"><i class="icon-stats-bars2 position-left"></i> Employee Assignment Report</h5>
    </div>

    <div class="panel-body">

        @if (Model == null || Model.Count == 0)
        {
            <div class="text-center text-muted" style="padding:40px 0;">No assignment data available.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped datatable-basic">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Job</th>
                            <th>Structure</th>
                            <th>Activity</th>
                            <th>Assigned By</th>
                            <th>Assigned Date</th>
                            <th>Estimated Hours</th>
                            <th>Actual Hours</th>
                            <th>Remaining Hours</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td><strong>@r.EmployeeName</strong><br /><small class="text-muted">@r.EmployeeCode</small></td>
                                <td>@r.JobNumber</td>
                                <td>@(r.JobItemCode ?? "-")</td>
                                <td>@(r.WorkActivityName ?? "-")</td>
                                <td>@(r.AssignedByName ?? "-")</td>
                                <td>@r.AssignedDate.ToString("dd-MMM-yyyy")</td>
                                <td>@(r.EstimatedHours?.ToString("0.##") ?? "-")</td>
                                <td>@r.ActualHours.ToString("0.##")</td>
                                <td>@(r.RemainingHours?.ToString("0.##") ?? "-")</td>
                                <td>@r.StatusName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>
