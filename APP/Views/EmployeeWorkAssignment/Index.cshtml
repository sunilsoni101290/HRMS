@model List<APP.Models.DTOs.EmployeeWorkAssignmentSummaryDto>
@{
    ViewData["Title"] = "My Assigned Jobs";
}

<div class="panel panel-flat">
    <div class="panel-heading">
        <h5 class="panel-title"><i class="icon-briefcase position-left"></i> My Assigned Jobs</h5>
        <div class="heading-elements">
            <a asp-controller="DailyWorkEntry" asp-action="Index" class="btn btn-link btn-sm"><i class="icon-calendar3 position-left"></i> Daily Work Entry</a>
        </div>
    </div>

    <div class="panel-body">

        <div class="row" id="myWorkDashboard" style="display:none;">
            <div class="col-md-2 col-sm-4"><div class="well well-sm text-center"><div class="text-size-large text-bold" id="dashAssignedJobs">-</div><div class="text-muted text-size-small">Assigned Jobs</div></div></div>
            <div class="col-md-2 col-sm-4"><div class="well well-sm text-center"><div class="text-size-large text-bold" id="dashInProgress">-</div><div class="text-muted text-size-small">In Progress</div></div></div>
            <div class="col-md-2 col-sm-4"><div class="well well-sm text-center"><div class="text-size-large text-bold" id="dashCompleted">-</div><div class="text-muted text-size-small">Completed</div></div></div>
            <div class="col-md-2 col-sm-4"><div class="well well-sm text-center"><div class="text-size-large text-bold" id="dashTodayHours">-</div><div class="text-muted text-size-small">Today's Hours</div></div></div>
            <div class="col-md-2 col-sm-4"><div class="well well-sm text-center"><div class="text-size-large text-bold" id="dashWeekHours">-</div><div class="text-muted text-size-small">This Week</div></div></div>
            <div class="col-md-2 col-sm-4"><div class="well well-sm text-center"><div class="text-size-large text-bold" id="dashMonthHours">-</div><div class="text-muted text-size-small">This Month</div></div></div>
        </div>

        @if (Model == null || Model.Count == 0)
        {
            <div class="text-center text-muted" style="padding:40px 0;">
                <i class="icon-briefcase" style="font-size:40px; opacity:.3; display:block; margin-bottom:10px;"></i>
                No jobs have been assigned to you yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Job</th>
                            <th>Client</th>
                            <th>Structure</th>
                            <th>Activity</th>
                            <th>Est. Hours</th>
                            <th>Actual Hours</th>
                            <th>Remaining</th>
                            <th>Status</th>
                            <th>Expected End</th>
                            <th width="160">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td><strong>@a.JobNumber</strong></td>
                                <td>@(a.ClientName ?? "-")</td>
                                <td>@(a.JobItemCode ?? "Any")</td>
                                <td>@(a.WorkActivityName ?? "Any")</td>
                                <td>@(a.EstimatedHours?.ToString("0.##") ?? "-")</td>
                                <td>
                                    @a.ActualHours.ToString("0.##")
                                    @if (a.IsOverUtilized)
                                    {
                                        <span class="label bg-danger" title="Actual hours exceeded estimated hours" style="margin-left:4px;">
                                            <i class="icon-warning22"></i>
                                        </span>
                                    }
                                </td>
                                <td>@(a.RemainingHours?.ToString("0.##") ?? "-")</td>
                                <td>
                                    @{
                                        var badgeClass = a.Status switch
                                        {
                                            1 => "bg-info",
                                            2 => "bg-primary",
                                            3 => "bg-warning",
                                            4 => "bg-success",
                                            5 => "bg-danger",
                                            _ => "bg-grey"
                                        };
                                    }
                                    <span class="label @badgeClass">@a.StatusName</span>
                                    @if (a.IsOverdue)
                                    {
                                        <span class="label bg-danger-300" style="margin-left:4px;">Overdue</span>
                                    }
                                </td>
                                <td>@(a.ExpectedEndDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@a.Id" class="btn btn-default btn-icon btn-xs" title="View">
                                        <i class="icon-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>

@section Scripts {
    <script>
        $.get("@Url.Action("GetMyWorkDashboard")", function (res) {
            if (!res || !res.data) return;
            var d = res.data;
            $("#dashAssignedJobs").text(d.assignedJobs);
            $("#dashInProgress").text(d.inProgress);
            $("#dashCompleted").text(d.completed);
            $("#dashTodayHours").text(parseFloat(d.todayHours || 0).toFixed(2));
            $("#dashWeekHours").text(parseFloat(d.thisWeekHours || 0).toFixed(2));
            $("#dashMonthHours").text(parseFloat(d.thisMonthHours || 0).toFixed(2));
            $("#myWorkDashboard").show();
        });
    </script>
}
