@model IEnumerable<NotificationListDto>

@{
    ViewData["Title"] = "Manage Notifications";
}

<div class="panel panel-flat">

    <div class="panel-heading">
        <h5 class="panel-title"><i class="icon-bell2 position-left"></i> Sent Notifications</h5>
        <div class="heading-elements">
            <a asp-action="Create" class="btn bg-primary"><i class="icon-plus22"></i> Send Notification</a>
            <a asp-action="Index" class="btn btn-default"><i class="icon-envelop"></i> My Inbox</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-striped">
            <thead>
                <tr>
                    <th width="50">#</th>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Priority</th>
                    <th class="text-center">Recipients</th>
                    <th class="text-center">Read</th>
                    <th>Sent</th>
                    <th width="90">Action</th>
                </tr>
            </thead>
            <tbody>
                @{ int sr = 1; }
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@sr</td>
                            <td><strong>@item.Title</strong><br /><small class="text-muted">@item.Message</small></td>
                            <td><span class="label bg-info">@item.NotificationType</span></td>
                            <td><span class="label @(item.Priority == 1 ? "bg-danger" : "bg-warning")">@(item.Priority == 1 ? "High" : "Normal")</span></td>
                            <td class="text-center">@item.RecipientCount</td>
                            <td class="text-center">@item.ReadCount / @item.RecipientCount</td>
                            <td>@item.CreatedOn.ToString("dd MMM yyyy HH:mm")</td>
                            <td>
                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   onclick="return confirm('Delete this notification?');"
                                   class="btn btn-danger btn-icon" title="Delete"><i class="icon-trash"></i></a>
                            </td>
                        </tr>
                        sr++;
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center text-muted" style="padding:30px;"><i class="icon-bell2" style="font-size:32px;"></i><br />No notifications sent yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    @if (TempData["Success"] != null)
    {
        <script>$(function(){ swal({ title:"Success", text:"@TempData["Success"]", type:"success" }); });</script>
    }
    <style>
        .table > tbody > tr > td { vertical-align: middle; }
        .label { font-size: 11px; }
        .btn-icon { width: 34px; }
    </style>
}
