@model LocationDto

@{
    ViewData["Title"] = "Location Details";
}

<div class="panel panel-flat">

    <!-- Header -->

    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-location4 position-left"></i>

            Location Details

        </h5>

        <div class="heading-elements">

            <a asp-action="Index"
               class="btn btn-default">

                <i class="icon-arrow-left13"></i>
                Back

            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn bg-primary">

                <i class="icon-pencil7"></i>
                Edit

            </a>

        </div>

    </div>

    <div class="panel-body">

        <!-- Profile Header -->

        <div class="row">

            <div class="col-md-2 text-center">

                <div class="content-group">

                    <div class="icon-object border-warning text-warning"
                         style="width:100px;height:100px;line-height:100px;font-size:42px;margin:auto;">

                        <i class="icon-location4"></i>

                    </div>

                </div>

            </div>

            <div class="col-md-6">

                <h2 class="text-semibold no-margin">

                    @Model.LocationName

                </h2>

                <br />

                <span class="label bg-primary">

                    @Model.LocationCode

                </span>

                @if (Model.IsDefault)
                {
                    <span class="label bg-success">
                        Default Location
                    </span>
                }
                else
                {
                    <span class="label bg-grey">
                        Secondary Location
                    </span>
                }

                <br /><br />

                <i class="icon-office"></i>

                @Model.BranchName

            </div>

            <div class="col-md-4">

                <div class="panel bg-warning-400">

                    <div class="panel-body">

                        <h3 class="no-margin">

                            @(Model.ModifiedOn?.ToString("dd-MMM-yyyy") ?? "-")

                        </h3>

                        Last Modified

                    </div>

                </div>

            </div>

        </div>

        <hr />

        <div class="row">

            <!-- Location Information -->

            <div class="col-md-6">

                <div class="panel panel-bordered">

                    <div class="panel-heading">

                        <h6 class="panel-title">
                            <i class="icon-info22 position-left"></i>
                            Location Information
                        </h6>

                    </div>

                    <table class="table table-bordered">

                        <tr>
                            <th width="180">Location Name</th>
                            <td>@Model.LocationName</td>
                        </tr>

                        <tr>
                            <th>Location Code</th>
                            <td>@Model.LocationCode</td>
                        </tr>

                        <tr>
                            <th>Branch</th>
                            <td>@Model.BranchName</td>
                        </tr>

                        <tr>
                            <th>Default Location</th>
                            <td>

                                @if (Model.IsDefault)
                                {
                                    <span class="label bg-success">
                                        Yes
                                    </span>
                                }
                                else
                                {
                                    <span class="label bg-grey">
                                        No
                                    </span>
                                }

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

            <!-- Audit Information -->

            <div class="col-md-6">

                <div class="panel panel-bordered">

                    <div class="panel-heading">

                        <h6 class="panel-title">
                            <i class="icon-history position-left"></i>
                            Audit Information
                        </h6>

                    </div>

                    <table class="table table-bordered">

                        <tr>
                            <th width="180">Created By</th>
                            <td>@Model.CreatedBy</td>
                        </tr>

                        <tr>
                            <th>Modified By</th>
                            <td>@(string.IsNullOrEmpty(Model.ModifiedBy) ? "-" : Model.ModifiedBy)</td>
                        </tr>

                        <tr>
                            <th>Modified On</th>
                            <td>@(Model.ModifiedOn?.ToString("dd-MMM-yyyy") ?? "-")</td>
                        </tr>

                    </table>

                </div>

            </div>

        </div>

        <!-- Address -->

        <div class="panel panel-bordered">

            <div class="panel-heading">

                <h6 class="panel-title">

                    <i class="icon-home position-left"></i>

                    Address Information

                </h6>

            </div>

            <div class="panel-body">

                @if (string.IsNullOrWhiteSpace(Model.Address))
                {
                    <div class="alert alert-warning">

                        No address available.

                    </div>
                }
                else
                {
                    <blockquote>

                        @Model.Address

                    </blockquote>
                }

            </div>

        </div>

    </div>
 
</div>

<style>

    .panel-bordered {
        border: 1px solid #ddd;
        margin-bottom: 20px;
    }

        .panel-bordered .panel-heading {
            background: #fafafa;
            border-bottom: 1px solid #ddd;
        }

    .table > tbody > tr > th {
        width: 180px;
        background: #fafafa;
        font-weight: 600;
    }

    .icon-object {
        border: 3px solid #ffb300;
        border-radius: 50%;
    }

</style>
