@model LocationDto

@{
    ViewData["Title"] = "Location Details";
}

<div class="container-fluid py-4">

    <div class="card shadow border-0 rounded-4 overflow-hidden">

        <!-- Header -->
        <div class="card-header bg-warning py-4">

            <div class="d-flex align-items-center">

                <div class="me-3">

                    <div class="bg-white text-warning rounded-circle d-flex align-items-center justify-content-center"
                         style="width:80px;height:80px;">

                        <i class="bi bi-geo-alt-fill fs-1"></i>

                    </div>

                </div>

                <div>

                    <h2 class="mb-1">@Model.LocationName</h2>

                    <p class="mb-0 opacity-75">

                        Location Code :
                        @(string.IsNullOrEmpty(Model.LocationCode)
                            ? "-"
                            : Model.LocationCode)

                    </p>

                </div>

            </div>

        </div>

        <!-- Body -->
        <div class="card-body p-4">

            <div class="row g-4">

                <!-- Basic Information -->
                <div class="col-lg-6">

                    <div class="card border-0 shadow-sm rounded-4 h-100">

                        <div class="card-header bg-light">

                            <h5 class="mb-0">

                                <i class="bi bi-info-circle text-warning"></i>
                                Location Information

                            </h5>

                        </div>

                        <div class="card-body">

                            <table class="table table-borderless">

                                <tr>

                                    <th width="180">
                                        Location Name
                                    </th>

                                    <td>
                                        @Model.LocationName
                                    </td>

                                </tr>

                                <tr>

                                    <th>
                                        Location Code
                                    </th>

                                    <td>

                                        @(string.IsNullOrEmpty(Model.LocationCode)
                                            ? "-"
                                            : Model.LocationCode)

                                    </td>

                                </tr>

                                <tr>

                                    <th>
                                        Branch
                                    </th>

                                    <td>

                                        <span class="badge bg-primary">
                                            @Model.BranchName
                                        </span>

                                    </td>

                                </tr>

                                <tr>

                                    <th>
                                        Default Location
                                    </th>

                                    <td>

                                        @if (Model.IsDefault)
                                        {
                                            <span class="badge bg-success">
                                                Yes
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                No
                                            </span>
                                        }

                                    </td>

                                </tr>

                            </table>

                        </div>

                    </div>

                </div>

                <!-- Audit Information -->
                <div class="col-lg-6">

                    <div class="card border-0 shadow-sm rounded-4 h-100">

                        <div class="card-header bg-light">

                            <h5 class="mb-0">

                                <i class="bi bi-clock-history text-primary"></i>
                                Audit Information

                            </h5>

                        </div>

                        <div class="card-body">

                            <table class="table table-borderless">

                                <tr>

                                    <th width="180">
                                        Created By
                                    </th>

                                    <td>
                                        @Model.CreatedBy
                                    </td>

                                </tr>

                                <tr>

                                    <th>
                                        Modified By
                                    </th>

                                    <td>

                                        @(string.IsNullOrEmpty(Model.ModifiedBy)
                                            ? "-"
                                            : Model.ModifiedBy)

                                    </td>

                                </tr>

                                <tr>

                                    <th>
                                        Modified On
                                    </th>

                                    <td>

                                        @(Model.ModifiedOn.HasValue
                                            ? Model.ModifiedOn.Value.ToString("dd MMM yyyy")
                                            : "-")

                                    </td>

                                </tr>

                            </table>

                        </div>

                    </div>

                </div>

                <!-- Address -->
                <div class="col-lg-12">

                    <div class="card border-0 shadow-sm rounded-4">

                        <div class="card-header bg-light">

                            <h5 class="mb-0">

                                <i class="bi bi-geo-alt text-danger"></i>
                                Address Information

                            </h5>

                        </div>

                        <div class="card-body">

                            <div class="border rounded-4 p-4 bg-light">

                                @if (string.IsNullOrEmpty(Model.Address))
                                {
                                    <span class="text-muted">
                                        No address available
                                    </span>
                                }
                                else
                                {
                                    @Model.Address
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Footer -->
            <div class="mt-4 text-end">

                <a asp-action="Index"
                   class="btn btn-light border rounded-3 px-4">

                    <i class="bi bi-arrow-left"></i>
                    Back

                </a>

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-warning rounded-3 px-4">

                    <i class="bi bi-pencil-square"></i>
                    Edit Location

                </a>

            </div>

        </div>

    </div>

</div>