@model IEnumerable<LocationDto>

@{
    ViewData["Title"] = "Location Management";
}

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">

            <i class="icon-location4 position-left"></i>

            Location Management

        </h5>

        <div class="heading-elements">

            <a asp-action="Export"
               class="btn btn-default">

                <i class="icon-file-download"></i>

                Export

            </a>

            <a asp-action="DownloadImportTemplate"
               class="btn bg-success">

                <i class="icon-file-spreadsheet"></i>

                Download Template

            </a>

            <a asp-action="Import"
               class="btn bg-info">

                <i class="icon-upload3"></i>

                Import

            </a>

            <a asp-action="Create"
               class="btn bg-primary">

                <i class="icon-plus22"></i>

                Add Location

            </a>

            <a asp-action="Create"
               asp-controller="Branch"
               class="btn bg-success">

                <i class="icon-office"></i>

                Add Branch

            </a>

        </div>

    </div>

    <!-- Search -->

    <div class="panel-body">

        <div class="row">

            <div class="col-md-4">

                <input type="text"
                       id="searchInput"
                       class="form-control"
                       placeholder="Search Location..." />

            </div>

            <div class="col-md-4">

                <select class="form-control">

                    <option value="">
                        All Branches
                    </option>

                </select>

            </div>

            <div class="col-md-2">

                <button class="btn bg-primary btn-block">

                    <i class="icon-search4"></i>

                    Search

                </button>

            </div>

        </div>

    </div>

    <!-- Grid -->

    <table class="table table-striped table-hover datatable-basic">

        <thead>

            <tr>

                <th width="60">#</th>

                <th>Location</th>

                <th>Location Code</th>

                <th>Company</th>

                <th>Branch</th>

                <th>Default</th>

                <th>Modified</th>

                <th width="170">Action</th>

            </tr>

        </thead>

        <tbody id="locationTable">

            @{
                int sr = 1;
            }

            @foreach (var item in Model)
            {

                <tr>

                    <td>@sr</td>

                    <td>

                        <strong>@item.LocationName</strong>

                        <br />

                        <small class="text-muted">

                            @item.Address

                        </small>

                    </td>

                    <td>

                        <span class="label bg-primary">

                            @item.LocationCode

                        </span>

                    </td>

                    <td>

                        @item.CompanyName

                    </td>

                    <td>

                        @item.BranchName

                    </td>

                    <td>

                        @if (item.IsDefault)
                        {
                            <span class="label bg-success">
                                Yes
                            </span>
                        }
                        else
                        {
                            <span class="label bg-grey">
                                No
                            </span>
                        }

                    </td>

                    <td>

                        @(item.ModifiedOn?.ToString("dd-MMM-yyyy") ?? "-")

                    </td>

                    <td>

                        <div class="btn-group">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-default btn-icon"
                               title="View">

                                <i class="icon-eye"></i>

                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-primary btn-icon"
                               title="Edit">

                                <i class="icon-pencil7"></i>

                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               onclick="return confirmSweetDelete(event, this, 'Are you sure you want to delete this location?');"
                               class="btn btn-danger btn-icon"
                               title="Delete">

                                <i class="icon-trash"></i>

                            </a>

                        </div>

                    </td>

                </tr>

                sr++;
            }

        </tbody>

    </table>
</div>

@section Scripts {

    <script>

        // Search Table

        document.getElementById("searchInput")
            .addEventListener("keyup", function () {

                let value = this.value.toLowerCase();

                let rows = document.querySelectorAll("#locationTable tr");

                rows.forEach(function (row) {

                    let text = row.innerText.toLowerCase();

                    row.style.display =
                        text.includes(value) ? "" : "none";

                });

            });

    </script>

}