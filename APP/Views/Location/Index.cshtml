@model IEnumerable<LocationDto>

@{
    ViewData["Title"] = "Location List";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h3 class="fw-bold mb-1">

                <i class="bi bi-geo-alt-fill text-warning"></i>
                Location Management

            </h3>

            <p class="text-muted mb-0">
                Manage branch locations and offices
            </p>

        </div>

        <div>

            <a asp-action="Create"
               class="btn btn-warning rounded-3 px-4">

                <i class="bi bi-plus-circle"></i>
                Add Location

            </a>
            <a asp-action="Create" asp-controller="Branch"
               class="btn btn-warning rounded-3 px-4">

                <i class="bi bi-plus-circle"></i>
                Add Branch

            </a>
        </div>

    </div>

    <!-- Search -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-5">

                    <input type="text"
                           id="searchInput"
                           class="form-control"
                           placeholder="Search Location..." />

                </div>

                <div class="col-md-5">

                    <select class="form-select">

                        <option value="">
                            All Branches
                        </option>

                    </select>

                </div>

                <div class="col-md-2">

                    <button class="btn btn-outline-warning w-100">

                        <i class="bi bi-search"></i>
                        Search

                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- Grid -->
    <div class="card border-0 shadow rounded-4">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>#</th>
                            <th>Location</th>
                            <th>Branch</th>
                            <th>Address</th>
                            <th>Default</th>
                            <th>Modified On</th>
                            <th width="170">Action</th>

                        </tr>

                    </thead>

                    <tbody id="locationTable">

                        @{
                            int sr = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- Sr -->
                                <td>
                                    @sr
                                </td>

                                <!-- Location -->
                                <td>

                                    <div class="fw-semibold">

                                        <i class="bi bi-geo-alt text-warning"></i>
                                        @item.LocationName

                                    </div>

                                    <small class="text-muted">

                                        @(string.IsNullOrEmpty(item.LocationCode)
                                            ? "-"
                                            : item.LocationCode)

                                    </small>

                                </td>

                                <!-- Branch -->
                                <td>

                                    <span class="badge bg-primary">
                                        @item.BranchName
                                    </span>

                                </td>

                                <!-- Address -->
                                <td>

                                    @(string.IsNullOrEmpty(item.Address)
                                        ? "-"
                                        : item.Address)

                                </td>

                                <!-- Default -->
                                <td>

                                    @if (item.IsDefault)
                                    {
                                        <span class="badge bg-success">
                                            Default
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            No
                                        </span>
                                    }

                                </td>

                                <!-- Modified -->
                                <td>

                                    @(item.ModifiedOn.HasValue
                                        ? item.ModifiedOn.Value.ToString("dd MMM yyyy")
                                        : "-")

                                </td>

                                <!-- Action -->
                                <td>

                                    <div class="d-flex gap-2">

                                        <!-- Details -->
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info rounded-3">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <!-- Edit -->
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-warning rounded-3">

                                            <i class="bi bi-pencil-square"></i>

                                        </a>

                                        <!-- Delete -->
                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           onclick="return confirm('Delete this location?')"
                                           class="btn btn-sm btn-outline-danger rounded-3">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>

                            sr++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        // Search Table

        document.getElementById("searchInput")
            .addEventListener("keyup", function () {

                let value = this.value.toLowerCase();

                let rows = document.querySelectorAll("#locationTable tr");

                rows.forEach(function (row) {

                    let text = row.innerText.toLowerCase();

                    row.style.display =
                        text.includes(value) ? "" : "none";

                });

            });

    </script>

}