@model LocationDto

@{
    ViewData["Title"] = "Location";
}

<div class="container-fluid py-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow border-0 rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="card-header bg-warning py-4">

                    <div class="d-flex align-items-center">

                        <div class="me-3">

                            <div class="bg-white text-warning rounded-circle d-flex align-items-center justify-content-center"
                                 style="width:80px;height:80px;">

                                <i class="bi bi-geo-alt-fill fs-1"></i>

                            </div>

                        </div>

                        <div>

                            <h3 class="mb-1">

                                @(string.IsNullOrEmpty(Model?.Id)
                                    ? "Create Location"
                                    : "Edit Location")

                            </h3>

                            <p class="mb-0 opacity-75">
                                Manage branch locations and addresses
                            </p>

                        </div>

                    </div>

                </div>

                <!-- Body -->
                <div class="card-body p-4">

                    <form asp-action="@(Model.Id == null ? "Create" : "Edit")" method="post"
                          enctype="multipart/form-data">

                        <!-- Hidden -->
                        <input asp-for="Id" type="hidden" />
                        <input asp-for="CreatedBy" type="hidden" />
                        <input asp-for="ModifiedBy" type="hidden" />
                        <input asp-for="ModifiedOn" type="hidden" />

                        <div class="row g-4">

                            <!-- Location Name -->
                            <div class="col-md-6">

                                <label asp-for="LocationName"
                                       class="form-label fw-semibold">
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">

                                        <i class="bi bi-buildings"></i>

                                    </span>

                                    <input asp-for="LocationName"
                                           class="form-control"
                                           placeholder="Enter Location Name" />

                                </div>

                                <span asp-validation-for="LocationName"
                                      class="text-danger"></span>

                            </div>

                            <!-- Location Code -->
                            <div class="col-md-6">

                                <label asp-for="LocationCode"
                                       class="form-label fw-semibold">
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">

                                        <i class="bi bi-upc-scan"></i>

                                    </span>

                                    <input asp-for="LocationCode"
                                           class="form-control"
                                           placeholder="Enter Location Code" />

                                </div>

                                <span asp-validation-for="LocationCode"
                                      class="text-danger"></span>

                            </div>

                            <!-- Company -->
                            <div class="col-md-6">

                                <label asp-for="CompanyId"
                                       class="form-label fw-semibold">
                                </label>

                                <select asp-for="CompanyId"
                                        asp-items="ViewBag.CompanyList"
                                        class="form-select"
                                        id="CompanyId">

                                    <option value="">
                                        -- Select Company --
                                    </option>

                                </select>

                                <span asp-validation-for="CompanyId"
                                      class="text-danger"></span>

                            </div>
                            <!-- Branch -->
                            <div class="col-md-6">

                                <label asp-for="BranchId"
                                       class="form-label fw-semibold">
                                </label>

                                <select asp-for="BranchId"
                                        asp-items="ViewBag.BranchList"
                                        class="form-select"
                                        id="BranchId">

                                    <option value="">
                                        -- Select Branch --
                                    </option>

                                </select>

                                <span asp-validation-for="BranchId"
                                      class="text-danger"></span>

                            </div>

                            <!-- Address -->
                            <div class="col-md-12">

                                <label asp-for="Address"
                                       class="form-label fw-semibold">
                                </label>

                                <textarea asp-for="Address"
                                          rows="4"
                                          class="form-control"
                                          placeholder="Enter Location Address"></textarea>

                            </div>

                            <!-- Default -->
                            <div class="col-md-12">

                                <div class="form-check form-switch mt-2">

                                    <input asp-for="IsDefault"
                                           class="form-check-input"
                                           type="checkbox" />

                                    <label asp-for="IsDefault"
                                           class="form-check-label fw-semibold">
                                    </label>

                                </div>

                            </div>

                        </div>

                        <!-- Footer -->
                        <div class="mt-5 d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-light border rounded-3 px-4">

                                <i class="bi bi-arrow-left"></i>
                                Back

                            </a>

                            <button type="submit"
                                    class="btn btn-warning rounded-3 px-4">

                                <i class="bi bi-check-circle"></i>

                                @(string.IsNullOrEmpty(Model?.Id)
                                    ? "Save Location"
                                    : "Update Location")

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>

        $(document).ready(function () {

        $(document).on("change", "#CompanyId", function () {

        debugger;

        let companyId = $(this).val();

        console.log(companyId);

        if (companyId == null || companyId === "") {

        $("#BranchId").html(
        '<option value="">-- Select Branch --</option>'
        );

        return;
        }

        $.ajax({

        url: '@Url.Action("GetBranchByCompanyId")',

        type: 'GET',

        data: { companyId: companyId },

        success: function (response) {

        let html = '<option value="">-- Select Branch --</option>';

        $.each(response, function (i, item) {

        html += `<option value="${item.value}">
        ${item.text}
        </option>`;
        });

        $("#BranchId").html(html);
        },

        error: function (xhr) {

        console.log(xhr);

        alert("Error loading branches");
        }
        });

        });

        });

    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}