@model LocationDto

@{
    ViewData["Title"] = "Location";
}

<form asp-action="@(string.IsNullOrEmpty(Model?.Id) ? "Create" : "Edit")"
      method="post">

    ```
    <input asp-for="Id" type="hidden" />
    <input asp-for="CreatedBy" type="hidden" />
    <input asp-for="ModifiedBy" type="hidden" />
    <input asp-for="ModifiedOn" type="hidden" />

    <div class="panel panel-flat">

        <div class="panel-heading">

            <h5 class="panel-title">

                <i class="icon-location4 position-left"></i>

                @(string.IsNullOrEmpty(Model?.Id)
                    ? "Create Location"
                    : "Edit Location")

            </h5>

            <div class="heading-elements">

                <a asp-action="Index"
                   class="btn btn-default">

                    <i class="icon-arrow-left13"></i>

                    Back

                </a>

            </div>

        </div>

        <div class="panel-body">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <!-- Basic Information -->

            <fieldset>

                <legend class="text-semibold">

                    <i class="icon-info22 position-left"></i>

                    Basic Information

                </legend>

                <div class="row">

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="LocationName"></label>

                            <input asp-for="LocationName"
                                   class="form-control"
                                   placeholder="Enter Location Name" />

                            <span asp-validation-for="LocationName"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="LocationCode"></label>

                            <input asp-for="LocationCode"
                                   class="form-control"
                                   placeholder="Enter Location Code" />

                            <span asp-validation-for="LocationCode"
                                  class="text-danger"></span>

                        </div>

                    </div>

                </div>

            </fieldset>

            <!-- Organization -->

            <fieldset>

                <legend class="text-semibold">

                    <i class="icon-office position-left"></i>

                    Organization

                </legend>

                <div class="row">

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="CompanyId"></label>

                            <select asp-for="CompanyId"
                                    asp-items="ViewBag.CompanyList"
                                    class="form-control"
                                    id="CompanyId">

                                <option value="">
                                    Select Company
                                </option>

                            </select>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="BranchId"></label>

                            <select asp-for="BranchId"
                                    asp-items="ViewBag.BranchList"
                                    class="form-control"
                                    id="BranchId">

                                <option value="">
                                    Select Branch
                                </option>

                            </select>

                        </div>

                    </div>

                </div>

            </fieldset>

            <!-- Address -->

            <fieldset>

                <legend class="text-semibold">

                    <i class="icon-home position-left"></i>

                    Address

                </legend>

                <div class="row">

                    <div class="col-md-12">

                        <div class="form-group">

                            <label asp-for="Address"></label>

                            <textarea asp-for="Address"
                                      rows="4"
                                      class="form-control"
                                      placeholder="Enter Complete Address">
                        </textarea>

                        </div>

                    </div>

                </div>

            </fieldset>

            <!-- Settings -->

            <fieldset>

                <legend class="text-semibold">

                    <i class="icon-cog3 position-left"></i>

                    Settings

                </legend>

                <div class="checkbox">

                    <label>

                        <input asp-for="IsDefault"
                               type="checkbox" />

                        Set as Default Location

                    </label>

                </div>

            </fieldset>

        </div>

        <div class="panel-footer text-right">

            <button type="reset"
                    class="btn btn-default">

                <i class="icon-reset"></i>

                Reset

            </button>

            <button type="submit"
                    class="btn bg-primary">

                <i class="icon-floppy-disk"></i>

                @(string.IsNullOrEmpty(Model?.Id)
                    ? "Save"
                    : "Update")

            </button>

        </div>

    </div>
    ```

</form>


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>

        $(document).ready(function () {

        $(document).on("change", "#CompanyId", function () {

        debugger;

        let companyId = $(this).val();

        console.log(companyId);

        if (companyId == null || companyId === "") {

        $("#BranchId").html(
        '<option value="">-- Select Branch --</option>'
        );

        return;
        }

        $.ajax({

        url: '@Url.Action("GetBranchByCompanyId")',

        type: 'GET',

        data: { companyId: companyId },

        success: function (response) {

        let html = '<option value="">-- Select Branch --</option>';

        $.each(response, function (i, item) {

        html += `<option value="${item.value}">
        ${item.text}
        </option>`;
        });

        $("#BranchId").html(html);
        },

        error: function (xhr) {

        console.log(xhr);

        alert("Error loading branches");
        }
        });

        });

        });

    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}