@model IEnumerable<CompOffCandidateDto>

@{
    ViewData["Title"] = "Comp Off - Pending Review";

    string StatusBadgeClass(int status) => status switch
    {
        (int)EnumExtensions.CompOffCandidateStatus.PendingReview => "bg-warning",
        (int)EnumExtensions.CompOffCandidateStatus.Approved => "bg-success",
        (int)EnumExtensions.CompOffCandidateStatus.Rejected => "bg-danger",
        _ => "bg-grey"
    };

    string StatusText(CompOffCandidateDto item) =>
        !string.IsNullOrEmpty(item.StatusName)
            ? item.StatusName
            : ((EnumExtensions.CompOffCandidateStatus)item.Status).ToString();
}

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">
            <i class="icon-checkmark4 position-left"></i>
            Comp Off - Pending Review
        </h5>

        <div class="heading-elements">

            <a asp-action="MyHistory" class="btn btn-default">
                <i class="icon-list"></i>
                My Comp Off History
            </a>

        </div>

    </div>

    <div class="panel-body">

        <form asp-action="PendingReview" method="get" class="row">

            <div class="col-md-4">
                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search by employee name/code..." />
            </div>

            <div class="col-md-3">
                <button type="submit" class="btn btn-default">
                    <i class="icon-search4"></i>
                    Search
                </button>
            </div>

        </form>

    </div>

    <div class="table-responsive">

        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>Worked Date</th>
                    <th>Hours Worked</th>
                    <th>Trigger Reason</th>
                    <th>Credited Days</th>
                    <th>Status</th>
                    <th width="160">Action</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.EmployeeName
                                <br />
                                <span class="text-muted text-size-small">@item.EmployeeCode</span>
                            </td>

                            <td>@(item.DepartmentName ?? "-")</td>

                            <td>@item.WorkedDate.ToString("dd-MMM-yyyy")</td>

                            <td class="text-center">@item.HoursWorked</td>

                            <td>
                                <span class="text-muted text-size-small">
                                    @(item.TriggerReason?.Length > 40 ? item.TriggerReason.Substring(0, 40) + "..." : item.TriggerReason)
                                </span>
                            </td>

                            <td class="text-center">@item.CreditedDays</td>

                            <td>
                                <span class="label @StatusBadgeClass(item.Status)">@StatusText(item)</span>
                            </td>

                            <td style="padding: 10px 15px;">

                                <div class="btn-group">

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-default btn-icon"
                                       data-popup="tooltip"
                                       title="View">

                                        <i class="icon-eye"></i>

                                    </a>

                                    @if (item.Status == (int)EnumExtensions.CompOffCandidateStatus.PendingReview)
                                    {
                                        <button type="button"
                                                class="btn btn-success btn-icon btnApprove"
                                                data-id="@item.Id"
                                                data-popup="tooltip"
                                                title="Approve">

                                            <i class="icon-checkmark4"></i>

                                        </button>

                                        <button type="button"
                                                class="btn btn-danger btn-icon btnReject"
                                                data-id="@item.Id"
                                                data-popup="tooltip"
                                                title="Reject">

                                            <i class="icon-cross2"></i>

                                        </button>
                                    }

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted" style="padding:30px;">
                            <i class="icon-checkmark-circle" style="font-size:32px;"></i><br />
                            Nothing pending review.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<!-- Approve form (no extra input needed - simple hidden-id POST) -->
<form id="approveForm" asp-action="Approve" method="post" style="display:none;">
    <input type="hidden" id="ApproveCompOffId" name="id" />
</form>

<partial name="_RejectModal" />

<script src="~/global_assets/js/plugins/notifications/sweet_alert.min.js"></script>

@section Scripts {

    <script>

        @if (TempData["Success"] != null)
        {
            <text>
                swal({
                    title: 'Success',
                    text: '@Html.Raw(TempData["Success"])',
                    type: 'success',
                    confirmButtonColor: '#66BB6A'
                });
            </text>
        }

        @if (TempData["GlobalError"] != null)
        {
            <text>
                swal({
                    title: 'Error',
                    text: '@Html.Raw(TempData["GlobalError"])',
                    type: 'error',
                    confirmButtonColor: '#EF5350'
                });
            </text>
        }

    </script>

    <script>

        $(document).ready(function () {

            $('[data-popup="tooltip"]').tooltip();

            // Approve - confirm, then submit the hidden form.
            $(document).on('click', '.btnApprove', function () {

                var id = $(this).data('id');

                swal({
                    title: 'Approve this Comp Off?',
                    text: 'The employee will be credited Comp Off leave balance for this entry.',
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#66BB6A',
                    confirmButtonText: 'Yes, approve it'
                }, function (isConfirm) {
                    if (isConfirm) {
                        $('#ApproveCompOffId').val(id);
                        $('#approveForm').submit();
                    }
                });

            });

            // Reject
            $(document).on('click', '.btnReject', function () {

                var id = $(this).data('id');

                $('#RejectCompOffId').val(id);

                $('#rejectModal').modal('show');

            });

        });

    </script>

}
