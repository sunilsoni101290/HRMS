@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Sync Biometric Attendance (Month Wise)";
}

@*
    Standalone "Sync Biometric Attendance (Month Wise)" screen - a brand-new,
    COMPLETELY SEPARATE page from Views/EsslAttendance/Index.cshtml and
    Views/HistoricalAttendanceSync/Index.cshtml (neither is modified or
    referenced here). Wraps ONE call to
    dbo.usp_SyncBiometricAttendance_MonthWise: for the picked Year/Month it
    takes the FIRST punch of each mapped employee per calendar day and
    inserts one Attendance row per employee/day using the single Shift/
    Status chosen below - it does not resolve a per-employee shift and does
    not run the AttendanceService business-rule engine. See that SP's own
    header comment (root-level "add MonthWise Biometric Attendance Sync
    stored procedure.sql") for the full behavior.

    This project ships Bootstrap 3.3.7 (jQuery-based), not 4/5 - see
    Views/EsslAttendance/Index.cshtml's <style> block for the full
    explanation. This view reuses that same plain-CSS "ent-panel" card style
    + small Bootstrap 4/5 utility-class shim (kept local to this view, same
    as every other redesigned view in this codebase) and builds the modal
    itself with real Bootstrap 3 markup (.modal/.modal-dialog/.modal-content,
    data-toggle/data-target/data-dismiss, col-md-6) - no d-flex/mb-3/gap-2/
    text-end/bare col-12/data-bs-*/.card anywhere in the modal markup.
*@

<div class="ent-page">
    <div class="ent-panel">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="ent-icon-badge" style="background:#eaf0fe;color:#2b6fd9;"><i class="bi bi-calendar-range"></i></span>
            <h5 class="mb-0" style="font-weight:700;color:#1b2a4a;">Sync Biometric Attendance (Month Wise)</h5>
        </div>
        <p class="text-muted mb-3">
            Bulk-assigns one Attendance record per employee per day for an entire month, from the
            first biometric punch of each day, using a single Shift and Status you choose. This is a
            simple bulk-assign tool - it does not resolve each employee's own shift and does not run
            the same late/early-exit/working-hours engine used by eSSL Sync Now or Historical
            Attendance Sync.
        </p>

        <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#monthWiseSyncModal">
            <i class="bi bi-arrow-repeat"></i> Sync Biometric Attendance (Month Wise)
        </button>
    </div>
</div>

<!-- ==================================================================
     Modal - Bootstrap 3 markup (.modal/.modal-dialog/.modal-content,
     data-dismiss="modal"), NOT Bootstrap 4/5.
     ================================================================== -->
<div class="modal fade" id="monthWiseSyncModal" tabindex="-1" role="dialog" aria-labelledby="monthWiseSyncModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="mwbs-modal-header">
                <button type="button" class="close mwbs-modal-close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <div class="d-flex align-items-center gap-2">
                    <span class="mwbs-header-icon"><i class="bi bi-arrow-repeat"></i></span>
                    <div>
                        <h4 class="modal-title" id="monthWiseSyncModalLabel">Sync Biometric Attendance (Month Wise)</h4>
                        <div class="mwbs-header-sub">
                            This will fetch the first punch-in of each employee for the selected month and sync data
                            from BiometricAttendanceLogs to AttendanceLogs and Attendances tables.
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-body">
                <form id="monthWiseSyncForm">
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="control-label">Year <span class="text-danger">*</span></label>
                            <select id="mwsYear" class="form-control" required>
                                @{
                                    var currentYear = DateTime.Now.Year;
                                }
                                @for (var y = currentYear + 1; y >= currentYear - 4; y--)
                                {
                                    if (y == currentYear)
                                    {
                                        <option value="@y" selected="selected">@y</option>
                                    }
                                    else
                                    {
                                        <option value="@y">@y</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6 form-group">
                            <label class="control-label">Month <span class="text-danger">*</span></label>
                            <select id="mwsMonth" class="form-control" required>
                                <option value="1">January</option>
                                <option value="2">February</option>
                                <option value="3">March</option>
                                <option value="4">April</option>
                                <option value="5">May</option>
                                <option value="6">June</option>
                                <option value="7">July</option>
                                <option value="8">August</option>
                                <option value="9">September</option>
                                <option value="10">October</option>
                                <option value="11">November</option>
                                <option value="12">December</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="control-label">Tenant <span class="text-danger">*</span></label>
                            @Html.DropDownList("mwsTenant", (SelectList)ViewBag.TenantList, "-- Select Tenant --", new { @class = "form-control", id = "mwsTenant", required = "required" })
                        </div>
                        <div class="col-md-6 form-group">
                            <label class="control-label">Company <span class="text-danger">*</span></label>
                            @Html.DropDownList("mwsCompany", (SelectList)ViewBag.CompanyList, "-- Select Company --", new { @class = "form-control", id = "mwsCompany", required = "required" })
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="control-label">Shift <span class="text-danger">*</span></label>
                            @Html.DropDownList("mwsShift", (SelectList)ViewBag.ShiftList, "-- Select Shift --", new { @class = "form-control", id = "mwsShift", required = "required" })
                        </div>
                        <div class="col-md-6 form-group">
                            <label class="control-label">Select Branch (Optional)</label>
                            @Html.DropDownList("mwsBranch", (SelectList)ViewBag.BranchList, "-- Select Branch (Optional) --", new { @class = "form-control", id = "mwsBranch" })
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="control-label">Created By</label>
                            <input type="text" id="mwsCreatedBy" class="form-control" value="@ViewBag.DefaultCreatedBy" />
                        </div>
                        <div class="col-md-6 form-group">
                            <label class="control-label">Status</label>
                            <select id="mwsStatus" class="form-control">
                                @foreach (var s in Enum.GetValues(typeof(Domain.Enums.EnumExtensions.AttendanceStatus)))
                                {
                                    var val = (int)s;
                                    if (val == 1)
                                    {
                                        <option value="@val" selected="selected">@val - @s.ToString()</option>
                                    }
                                    else
                                    {
                                        <option value="@val">@val - @s.ToString()</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </form>

                <div class="mwbs-note">
                    <ul>
                        <li>This process will process only the first punch-in of each employee per day.</li>
                        <li>Existing attendance records for the same employee and date will be skipped.</li>
                        <li>Already synchronized biometric logs will be skipped.</li>
                        <li>This process may take some time for large data. Please do not close the window until it completes.</li>
                    </ul>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" id="mwsExecuteBtn" class="btn btn-primary">
                    <i class="bi bi-play-fill"></i> Execute
                </button>
            </div>

        </div>
    </div>
</div>

<style>
    /* ===================================================================
       Same enterprise card + Bootstrap 4/5 utility-class shim used on
       Views/EsslAttendance/Index.cshtml / Views/HistoricalAttendanceSync/
       Index.cshtml - see EsslAttendance/Index.cshtml's <style> block for
       the full explanation of why this project's real Bootstrap 3.3.7
       stylesheet needs it. Kept local to this view, same convention.
       =================================================================== */
    .ent-page { background:#f4f6fb; padding:18px; border-radius:10px; }
    .ent-panel { background:#fff; border:1px solid #e7ebf3; border-radius:10px; padding:16px 18px; }
    .ent-icon-badge { width:34px; height:34px; border-radius:8px; display:inline-flex; align-items:center; justify-content:center; font-size:16px; }

    .d-flex { display: flex !important; }
    .align-items-center { align-items: center !important; }
    .gap-2 { gap: .5rem !important; }
    .mb-0 { margin-bottom: 0 !important; }
    .mb-2 { margin-bottom: .5rem !important; }
    .mb-3 { margin-bottom: 1rem !important; }

    /* Modal header - blue gradient, per the requested mockup. Real
       Bootstrap 3 .modal-header has no such styling by default, so this is
       plain CSS on our own wrapper class rather than overriding .modal-header. */
    .mwbs-modal-header {
        background: linear-gradient(135deg, #2b6fd9 0%, #1b4fa0 100%);
        color: #fff;
        padding: 18px 20px;
        border-top-left-radius: 6px;
        border-top-right-radius: 6px;
        position: relative;
    }
    .mwbs-modal-header .modal-title { color: #fff; font-weight: 700; margin: 0; }
    .mwbs-header-icon {
        width: 40px; height: 40px; border-radius: 8px;
        background: rgba(255,255,255,.18);
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 20px; flex: none;
    }
    .mwbs-header-sub { font-size: 12.5px; color: rgba(255,255,255,.9); margin-top: 4px; max-width: 560px; }
    .mwbs-modal-close {
        position: absolute; top: 14px; right: 16px;
        color: #fff; opacity: .85; text-shadow: none;
    }
    .mwbs-modal-close:hover { color: #fff; opacity: 1; }

    .mwbs-note {
        background: #f4f8ff;
        border: 1px solid #dbe7fb;
        border-radius: 8px;
        padding: 12px 16px;
        margin-top: 4px;
    }
    .mwbs-note ul { margin: 0; padding-left: 18px; }
    .mwbs-note li { font-size: 12.5px; color: #3a4a68; margin-bottom: 4px; }
    .mwbs-note li:last-child { margin-bottom: 0; }
</style>

@section Scripts {
    <script>
        (function () {
            // Same "typeof swal === 'function'" defensive guard used on
            // Views/EsslAttendance/Index.cshtml, in case SweetAlert hasn't
            // loaded on some layout.
            function notify(title, text, type) {
                if (typeof swal === 'function') swal(title, text, type);
                else alert(title + ': ' + text);
            }

            $('#mwsCompany').on('change', function () {
                var companyId = $(this).val();
                var $branch = $('#mwsBranch');
                $branch.html('<option value="">-- Select Branch (Optional) --</option>');

                if (!companyId) return;

                $.ajax({
                    url: '@Url.Action("GetBranchByCompanyId", "MonthWiseBiometricSync")',
                    type: 'GET',
                    data: { companyId: companyId },
                    success: function (branches) {
                        (branches || []).forEach(function (b) {
                            $branch.append($('<option>').val(b.value).text(b.text));
                        });
                    }
                });
            });

            function getRequest() {
                return {
                    year: parseInt($('#mwsYear').val(), 10),
                    month: parseInt($('#mwsMonth').val(), 10),
                    tenantId: $('#mwsTenant').val() || null,
                    companyId: $('#mwsCompany').val(),
                    shiftId: $('#mwsShift').val(),
                    branchId: $('#mwsBranch').val() || null,
                    createdBy: $('#mwsCreatedBy').val() || 'SYSTEM',
                    status: parseInt($('#mwsStatus').val(), 10)
                };
            }

            function validate(req) {
                if (!req.year || !req.month) { notify('Missing Fields', 'Please select both Year and Month.', 'warning'); return false; }
                if (!req.tenantId) { notify('Missing Fields', 'Please select a Tenant.', 'warning'); return false; }
                if (!req.companyId) { notify('Missing Fields', 'Please select a Company.', 'warning'); return false; }
                if (!req.shiftId) { notify('Missing Fields', 'Please select a Shift.', 'warning'); return false; }
                return true;
            }

            $('#mwsExecuteBtn').on('click', function () {
                var req = getRequest();
                if (!validate(req)) return;

                var $btn = $(this).prop('disabled', true);
                var original = $btn.html();
                $btn.html('<i class="bi bi-hourglass-split"></i> Processing...');

                $.ajax({
                    url: '@Url.Action("Execute", "MonthWiseBiometricSync")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(req),
                    success: function (resp) {
                        $btn.prop('disabled', false).html(original);

                        if (!resp || !resp.success) {
                            notify('Sync Not Completed', (resp && resp.message) || 'Unable to run Sync Biometric Attendance (Month Wise).', 'warning');
                            return;
                        }

                        var d = resp.data || {};
                        var summary =
                            'Attendances Inserted: ' + (d.attendancesInserted != null ? d.attendancesInserted : 0) + '\n' +
                            'Attendance Logs Inserted: ' + (d.attendanceLogsInserted != null ? d.attendanceLogsInserted : 0) + '\n' +
                            'Skipped Records: ' + (d.skippedRecords != null ? d.skippedRecords : 0) + '\n' +
                            'Status: ' + (d.syncStatus || 'Success');

                        if (typeof swal === 'function') {
                            swal({ title: 'Sync Completed', text: summary, type: 'success' }, function () {
                                $('#monthWiseSyncModal').modal('hide');
                            });
                        } else {
                            alert('Sync Completed\n\n' + summary);
                            $('#monthWiseSyncModal').modal('hide');
                        }
                    },
                    error: function () {
                        $btn.prop('disabled', false).html(original);
                        notify('Error', 'Unable to reach the ERP API.', 'error');
                    }
                });
            });
        })();
    </script>
}
