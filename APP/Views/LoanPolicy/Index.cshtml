@model IEnumerable<LoanPolicyDto>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Loan Policies";
}

<div class="panel panel-flat">

    <div class="panel-heading">

        <h5 class="panel-title">
            <i class="bi bi-journal-check position-left"></i>
            Loan Policies
        </h5>

        <div class="heading-elements">
            <a asp-action="Create" class="btn bg-primary">
                <i class="icon-plus22"></i>
                New Policy
            </a>
        </div>

    </div>

    <div class="panel-body">

        <form asp-action="Index" method="get" class="row">

            <div class="col-md-4">
                <select name="loanTypeId" class="form-control">
                    <option value="">-- All Loan Types --</option>
                    @if (ViewBag.LoanTypeList is SelectList ltList)
                    {
                        foreach (SelectListItem item in ltList)
                        {
                            <option value="@item.Value" selected="@(item.Value == (string)ViewBag.LoanTypeId)">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-4">
                <select name="companyId" class="form-control">
                    <option value="">-- All Companies --</option>
                    @if (ViewBag.CompanyList is SelectList cList)
                    {
                        foreach (SelectListItem item in cList)
                        {
                            <option value="@item.Value" selected="@(item.Value == (string)ViewBag.CompanyId)">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-4">
                <button type="submit" class="btn btn-default">
                    <i class="icon-search4"></i>
                    Filter
                </button>
            </div>

        </form>

    </div>

    <div class="table-responsive">

        <table class="table table-bordered table-striped datatable-basic">

            <thead>
                <tr>
                    <th>Loan Type</th>
                    <th>Company / Branch</th>
                    <th>Amount Range</th>
                    <th>Tenure Range</th>
                    <th>Max Deduction %</th>
                    <th>Levels</th>
                    <th>Version</th>
                    <th>Status</th>
                    <th width="120">Action</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.LoanTypeName</td>
                            <td>@(item.CompanyName ?? "All Companies")@(item.BranchName != null ? " / " + item.BranchName : "")</td>
                            <td>@item.MinAmount.ToString("N0") - @item.MaxAmount.ToString("N0")</td>
                            <td>@item.MinTenureMonths - @item.MaxTenureMonths mo.</td>
                            <td>@item.MaxDeductionPercentOfNetSalary.ToString("N0")%</td>
                            <td>@item.ApprovalLevels.Count</td>
                            <td>v@item.VersionNumber</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Superseded</span>
                                }
                            </td>
                            <td style="padding: 10px 15px;">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-default btn-icon" title="Edit (creates a new version)">
                                    <i class="icon-pencil7"></i>
                                </a>
                                @if (item.IsActive)
                                {
                                    <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" style="display:inline;"
                                          onsubmit="return confirmSweetDeleteForm(event, this, 'Deactivate this Loan Policy? Employees will no longer be able to submit against it.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-default btn-icon" title="Deactivate">
                                            <i class="icon-blocked"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted" style="padding:30px;">
                            <i class="bi bi-journal-check" style="font-size:32px;"></i><br />
                            No Loan Policies configured yet.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<script src="~/global_assets/js/plugins/notifications/sweet_alert.min.js"></script>
<script src="~/global_assets/js/plugins/tables/datatables/datatables.min.js"></script>

@section Scripts {
    <script>
        @if (TempData["Success"] != null)
        {
            <text>swal({ title: 'Success', text: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(TempData["Success"]?.ToString() ?? string.Empty)), type: 'success', confirmButtonColor: '#66BB6A' });</text>
        }
        @if (TempData["GlobalError"] != null)
        {
            <text>swal({ title: 'Error', text: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(TempData["GlobalError"]?.ToString() ?? string.Empty)), type: 'error', confirmButtonColor: '#EF5350' });</text>
        }

        if ($.fn.DataTable) {
            $(".datatable-basic").DataTable({
                autoWidth: false,
                paging: true,
                ordering: true,
                info: true,
                searching: true,
                pageLength: 10,
                lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                order: [[0, 'asc']],
                columnDefs: [{ orderable: false, searchable: false, targets: -1 }],
                language: { search: "_INPUT_", searchPlaceholder: "Search Loan Policies..." }
            });
        }
    </script>
}
