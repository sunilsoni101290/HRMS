
@using APP.Models.DTOs
@model LoginDto

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in · Acme HRMS</title>
    <meta name="description" content="Secure enterprise HRMS sign in portal for Acme Corporation employees and administrators." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="~/css/login-style.css" rel="stylesheet" />
</head>
<body>
    <main class="shell">
        <!-- LEFT: Brand panel -->
        <aside class="brand" aria-label="Acme HRMS branding">
            <div class="brand-orb"></div>
            <div class="brand-orb two"></div>
            <div class="logo">
                <div class="logo-mark">A</div>
                <span>Acme <small style="font-weight:500;color:#94a3b8;">HRMS</small></span>
            </div>
            <div class="brand-content">
                <span class="eyebrow"><span class="dot"></span>Enterprise Workforce Suite</span>
                @* <h1 class="headline">One platform to <span>run your people operations.</span></h1> *@
                <p class="lede">From hiring and onboarding to payroll, performance and analytics — Acme HRMS unifies every workforce workflow with enterprise-grade security.</p>
                <div class="features">
                    <div class="feature">
                        <div class="ic">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                        </div>
                        <div>
                            <h4>SOC 2 Type II &amp; ISO 27001</h4>
                            <p>Bank-grade encryption, SSO/SAML, and granular role-based access control.</p>
                        </div>
                    </div>
                    <div class="feature">
                        <div class="ic">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18" /><path d="M7 14l4-4 4 4 5-5" /></svg>
                        </div>
                        <div>
                            <h4>Real-time people analytics</h4>
                            <p>Headcount, attrition, payroll and DEI insights — instantly across every region.</p>
                        </div>
                    </div>
                    <div class="feature">
                        <div class="ic">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="7" r="4" /><path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /></svg>
                        </div>
                        <div>
                            <h4>Trusted by 4,200+ teams</h4>
                            <p>Powering global enterprises across 60+ countries and 12 languages.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="brand-foot">
                <span>© 2026 Acme Corporation</span>
                <div class="badges">
                    <span class="badge">SOC 2</span>
                    <span class="badge">GDPR</span>
                    <span class="badge">HIPAA</span>
                </div>
            </div>
        </aside>
        <!-- RIGHT: Form -->
        <section class="form-panel">
            <div class="card">
                <div class="top-meta">
                    <span>Need an account?</span>
                    <a href="#">Contact your admin →</a>
                </div>
                <h2>Welcome back</h2>
                <p class="sub">Sign in to your Acme HRMS workspace to continue.</p>
                @* <div class="sso">
                    <button type="button">
                        <svg viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.76h3.55c2.08-1.92 3.29-4.74 3.29-8.09z" /><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.55-2.76c-.98.66-2.23 1.06-3.73 1.06-2.87 0-5.3-1.94-6.16-4.55H2.18v2.85A11 11 0 0 0 12 23z" /><path fill="#FBBC05" d="M5.84 14.09a6.6 6.6 0 0 1 0-4.18V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.85z" /><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A11 11 0 0 0 2.18 7.06l3.66 2.85C6.7 7.32 9.13 5.38 12 5.38z" /></svg>
                        Google
                    </button>
                    <button type="button">
                        <svg viewBox="0 0 24 24" fill="#0a1733"><path d="M2 3h9v9H2zM13 3h9v9h-9zM2 13h9v9H2zM13 13h9v9h-9z" /></svg>
                        Microsoft
                    </button>
                </div>
                <div class="divider">OR SIGN IN WITH EMAIL</div> *@
                <form asp-action="Login" method="post">
                    <div class="field">
                        <label for="email">Work username</label>
                        <div class="input-wrap">
                            <span class="ic">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 5L2 7" /></svg>
                            </span>
                            <input id="username" asp-for="Username" type="text" placeholder="Enter your username" autocomplete="off" required />
                        </div>
                    </div>
                    <div class="field">
                        <label for="password">Password</label>
                        <div class="input-wrap">
                            <span class="ic">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                            </span>
                            <input id="password" asp-for="Password" type="password" placeholder="Enter your password" autocomplete="current-password" required />
                            <button type="button" class="toggle-pw" aria-label="Show password" onclick="togglePw(this)">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z" /><circle cx="12" cy="12" r="3" /></svg>
                            </button>
                        </div>
                    </div>
                    <div class="row">
                        <label class="check"><input type="checkbox" /> Keep me signed in</label>
                        <a class="forgot" href="#">Forgot password?</a>
                    </div>
                    <button type="submit" class="submit">
                        Sign in securely
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                    </button>
                </form>
                @* <p class="help">Sign in with <a href="#">SSO / SAML</a> · <a href="#">Use magic link</a></p> *@
                <p class="legal">
                    By continuing, you agree to Acme's <a href="#">Terms</a> &amp; <a href="#">Privacy Policy</a>.<br />
                    Protected by enterprise-grade encryption.
                </p>
            </div>
        </section>
    </main>
    <script>
            function togglePw(btn){
              const input = btn.parentElement.querySelector('input');
              input.type = input.type === 'password' ? 'text' : 'password';
            }
    </script>
</body>
</html>


@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}