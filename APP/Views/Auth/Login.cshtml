
@using APP.Models.DTOs
@model LoginDto

@{
    ViewData["Title"] = "Login";
    Layout = null;
}



<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<link rel="apple-touch-icon" sizes="180x180" href="~/images/favicon_io/apple-touch-icon.png">
	<link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon_io/favicon-32x32.png">
	<link rel="icon" type="image/png" sizes="16x16" href="~/images/favicon_io/favicon-16x16.png">
	<link rel="manifest" href="~/images/favicon_io/site.webmanifest">
	<title>PROSAEC TOTAL | HRMS </title>

	<!-- Global stylesheets -->
	<link href="https://fonts.googleapis.com/css?family=Roboto:400,300,100,500,700,900" rel="stylesheet" type="text/css">
	<link href="~/global_assets/css/icons/icomoon/styles.css" rel="stylesheet" type="text/css">
	<link href="~/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css">
	<link href="~/assets/css/core.min.css" rel="stylesheet" type="text/css">
	<link href="~/assets/css/components.min.css" rel="stylesheet" type="text/css">
	<link href="~/assets/css/colors.min.css" rel="stylesheet" type="text/css">
	<!-- Bootstrap Icons (reused from _LayoutMain.cshtml, same version) - used only for the
	     decorative branding/feature icons on this page; the existing functional icons
	     (username/password/eye-toggle/arrow) keep using icomoon as before. -->
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" type="text/css">
	<!-- /global stylesheets -->
	<!-- Core JS files -->
	<script src="~/global_assets/js/plugins/loaders/pace.min.js"></script>
	<script src="~/global_assets/js/core/libraries/jquery.min.js"></script>
	<script src="~/global_assets/js/core/libraries/bootstrap.min.js"></script>
	<script src="~/global_assets/js/plugins/loaders/blockui.min.js"></script>
	<!-- /core JS files -->
	<!-- Theme JS files -->
	<script src="~/global_assets/js/plugins/forms/styling/uniform.min.js"></script>

	<script src="~/assets/js/app.js"></script>
	<!-- /theme JS files -->

	<style>

		/* =========================================================
		   0. Design tokens - scoped values reused across this page.
		   ========================================================= */
		:root {
			--login-primary: #2563D9;
			--login-secondary: #C83769;
			--login-dark: #082B5C;
			--login-blue: #1458C8;
			--login-cyan: #4DB8FF;
			--login-muted: #7A8AA3;
			--login-border: #DCE4EF;
			--login-radius: 12px;
		}

		html, body {
			height: 100%;
		}

		body {
			margin: 0;
			font-family: "Roboto", sans-serif;
		}

		/* =========================================================
		   1. Page shell - two column on desktop (58% / 42%), fills
		   the viewport with no forced vertical scroll, stacks to a
		   single column on mobile. Scoped entirely to this view
		   (Layout = null), everything below lives under .login-page.
		   ========================================================= */

		.login-page {
			display: flex;
			align-items: stretch;
			min-height: 100vh;
			width: 100%;
			/* No forced overflow:hidden / fixed height here on purpose:
			   the card's own padding/spacing below is tuned to fit
			   comfortably within 100vh at the resolutions this page
			   targets (1366x768 and up), so no scrollbar appears in
			   normal use. Using min-height instead of a hard height
			   means that if a viewport is ever too short for the
			   content, the browser's own page scroll kicks in as a
			   graceful fallback instead of clipping or forcing an
			   awkward nested scrollbar inside the card.

			   The two panels below are stretched to fill this
			   container's full resolved height via align-items:stretch
			   (the flex default, spelled out here for clarity) rather
			   than via height:100% on the panels themselves - a
			   percentage height on a flex item resolves unreliably
			   when its flex-container parent only has a min-height
			   (not a definite height), which was previously leaving
			   both panels shorter than the viewport and exposing a
			   blank gap below them. Stretch sidesteps that entirely. */
		}

		/* =========================================================
		   2. Left branding panel
		   ========================================================= */

		.login-brand-panel {
			position: relative;
			flex: 0 0 58%;
			max-width: 58%;
			display: flex;
			flex-direction: column;
			align-items: center;
			padding: 48px 72px;
			background: linear-gradient(150deg, var(--login-dark) 0%, var(--login-blue) 48%, #4B3186 100%);
			color: #fff;
			overflow: hidden;
			/* Logo (top) and foot (bottom) are normal-flow children here,
			   not absolutely positioned - see .login-brand-logo /
			   .login-brand-foot below. That is what guarantees they can
			   never overlap .login-brand-content: the content block is
			   the only flex:1 child, so it only ever occupies whatever
			   space is actually left over after the logo and foot take
			   what they need, instead of being independently centered
			   across the panel's full height and potentially colliding
			   with them. */
		}

		/* -- 2.1 decorative layer (kept strictly behind the content,
		   z-index:0, and intentionally low-contrast so it never
		   competes with the copy on top of it) -- */

		.login-brand-decor {
			position: absolute;
			inset: 0;
			z-index: 0;
			pointer-events: none;
			overflow: hidden;
		}

		.login-brand-decor .decor-glow {
			position: absolute;
			top: -20%;
			left: -10%;
			width: 75%;
			height: 75%;
			background: radial-gradient(circle, rgba(77, 184, 255, 0.18) 0%, rgba(77, 184, 255, 0) 70%);
		}

		.login-brand-decor .decor-arc-1 {
			position: absolute;
			width: 460px;
			height: 460px;
			border-radius: 50%;
			border: 1px solid rgba(255, 255, 255, 0.08);
			background: rgba(255, 255, 255, 0.04);
			top: -160px;
			right: -160px;
		}

		.login-brand-decor .decor-arc-2 {
			position: absolute;
			width: 320px;
			height: 320px;
			border-radius: 50%;
			background: rgba(255, 255, 255, 0.05);
			bottom: -140px;
			left: -100px;
		}

		.login-brand-decor .decor-arc-3 {
			position: absolute;
			width: 200px;
			height: 200px;
			border-radius: 50%;
			border: 1px solid rgba(255, 255, 255, 0.10);
			bottom: 12%;
			right: 8%;
		}

		.login-brand-decor .decor-square {
			position: absolute;
			width: 140px;
			height: 140px;
			border: 1px solid rgba(255, 255, 255, 0.08);
			transform: rotate(18deg);
			top: 38%;
			left: -40px;
			border-radius: 24px;
		}

		/* very subtle dotted pattern */
		.login-brand-decor .decor-dots {
			position: absolute;
			inset: 0;
			background-image: radial-gradient(rgba(255, 255, 255, 0.14) 1px, transparent 1px);
			background-size: 22px 22px;
			-webkit-mask-image: radial-gradient(ellipse 60% 55% at 78% 30%, #000 0%, transparent 70%);
			mask-image: radial-gradient(ellipse 60% 55% at 78% 30%, #000 0%, transparent 70%);
			opacity: .6;
		}

		/* faint "office building" silhouette effect - approximated in
		   pure CSS (no photographic asset shipped with this project),
		   sitting low and dim along the panel's bottom edge */
		.login-brand-decor .decor-skyline {
			position: absolute;
			left: 0;
			right: 0;
			bottom: 0;
			height: 34%;
			background-image:
				linear-gradient(to top, rgba(8, 43, 92, 0.35), transparent),
				repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.05) 0 26px, transparent 26px 54px);
			opacity: .5;
		}

		/* -- 2.2 top-left logo block: mark + wordmark + tagline -- */

		.login-brand-logo {
			position: relative;
			z-index: 2;
			flex: 0 0 auto;
			width: 100%;
			margin-bottom: 32px;
		}

		.login-brand-logo-row {
			display: flex;
			align-items: center;
			gap: 12px;
		}

		.login-brand-logo-row img {
			width: 44px;
			height: 44px;
			object-fit: contain;
			background: rgba(255, 255, 255, 0.92);
			border-radius: 10px;
			padding: 5px;
		}

		.login-brand-logo-text {
			display: flex;
			flex-direction: column;
			line-height: 1.15;
		}

		.login-brand-logo-name {
			font-size: 17px;
			font-weight: 700;
			letter-spacing: .4px;
			color: #fff;
		}

		.login-brand-logo-sub {
			font-size: 12px;
			font-weight: 500;
			color: rgba(255, 255, 255, 0.75);
		}

		.login-brand-tagline {
			margin: 8px 0 0;
			font-size: 11.5px;
			font-weight: 500;
			letter-spacing: .8px;
			text-transform: uppercase;
			color: rgba(255, 255, 255, 0.65);
		}

		/* -- 2.3 main marketing content, vertically centered -- */

		.login-brand-content {
			position: relative;
			z-index: 1;
			flex: 1 1 auto;
			display: flex;
			flex-direction: column;
			justify-content: center;
			max-width: 560px;
			width: 100%;
			margin: 0 auto;
			min-height: 0;
		}

		.login-brand-heading {
			font-size: 46px;
			font-weight: 700;
			line-height: 1.18;
			margin: 0 0 20px;
			color: #fff;
		}

		.login-brand-heading .accent {
			background: linear-gradient(90deg, var(--login-cyan), #A8E6FF);
			-webkit-background-clip: text;
			background-clip: text;
			-webkit-text-fill-color: transparent;
			color: var(--login-cyan);
		}

		.login-brand-desc {
			font-size: 18px;
			line-height: 1.6;
			max-width: 560px;
			color: rgba(255, 255, 255, 0.75);
			margin: 0 0 44px;
		}

		/* -- 2.4 feature row: four compact horizontal items, evenly
		   spaced, icon above a short bold title (not large cards) -- */

		.login-feature-row {
			display: flex;
			align-items: flex-start;
			justify-content: space-between;
			gap: 16px;
		}

		.login-feature {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 10px;
			flex: 1 1 0;
			min-width: 0;
		}

		.login-feature-icon {
			flex: 0 0 auto;
			width: 60px;
			height: 60px;
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 22px;
			color: #fff;
		}

		.login-feature:nth-child(1) .login-feature-icon { background: linear-gradient(135deg, #3B6FE0, #7C5CE0); }
		.login-feature:nth-child(2) .login-feature-icon { background: linear-gradient(135deg, #E0559E, #C83769); }
		.login-feature:nth-child(3) .login-feature-icon { background: linear-gradient(135deg, #2FD3B8, #4DB8FF); }
		.login-feature:nth-child(4) .login-feature-icon { background: linear-gradient(135deg, #F5A623, #F08A3C); }

		.login-feature-title {
			font-size: 16px;
			font-weight: 700;
			color: #fff;
			margin: 0;
			line-height: 1.25;
		}

		/* -- 2.5 bottom strip: trust line (lower-left) + decorative
		   cursive lockup (lower-right) - purely decorative, kept clear
		   of the readable content above it -- */

		.login-brand-foot {
			position: relative;
			z-index: 1;
			flex: 0 0 auto;
			width: 100%;
			margin-top: 24px;
			display: flex;
			align-items: flex-end;
			justify-content: space-between;
			pointer-events: none;
		}

		.login-brand-trust {
			margin: 0;
			font-size: 12.5px;
			font-weight: 500;
			letter-spacing: .3px;
			color: rgba(255, 255, 255, 0.55);
		}

		.login-brand-cursive {
			margin: 0;
			text-align: right;
			font-family: "Brush Script MT", "Segoe Script", "Lucida Handwriting", cursive;
			font-size: 26px;
			line-height: 1.15;
			color: rgba(255, 255, 255, 0.35);
		}

		/* -------------------- Right login panel -------------------- */

		.login-form-panel {
			position: relative;
			flex: 0 0 42%;
			max-width: 42%;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 40px;
			background: linear-gradient(160deg, #F4F7FC 0%, #EAF2FF 100%);
			overflow: hidden;
		}

		.login-card {
			position: relative;
			width: 680px;
			max-width: calc(100% - 80px);
			background: #fff;
			border-radius: 22px;
			box-shadow: 0 20px 60px rgba(30, 60, 110, 0.15);
			padding: 40px 64px 28px;
			margin: auto;
		}

		/* -- language selector: top-right, inside the card -- */

		.login-lang-select {
			position: absolute;
			top: 24px;
			right: 28px;
			display: inline-flex;
			align-items: center;
			gap: 6px;
			padding: 7px 14px;
			border-radius: 999px;
			border: 1px solid var(--login-border);
			background: #fff;
			color: #5c6b82;
			font-size: 12.5px;
			font-weight: 500;
			cursor: default;
		}

		.login-lang-select i {
			font-size: 14px;
			color: var(--login-primary);
		}

		.login-logo {
			display: flex;
			align-items: center;
			justify-content: center;
			margin: 0 auto 10px;
			width: 100px;
			height: 64px;
		}

		.login-logo img {
			max-width: 100%;
			max-height: 100%;
			object-fit: contain;
		}

		.login-card-title {
			text-align: center;
			font-size: 21px;
			font-weight: 700;
			color: #2a3142;
			margin-bottom: 4px;
		}

		.login-card-subtitle {
			text-align: center;
			font-size: 13.5px;
			color: var(--login-muted);
			margin-bottom: 18px;
		}

		.login-form label.login-label {
			display: block;
			font-size: 12.5px;
			font-weight: 600;
			color: #5c6b82;
			margin-bottom: 6px;
		}

		.login-form .form-group {
			margin-bottom: 14px;
		}

		.login-input {
			height: 60px;
			border-radius: 12px;
			border: 1px solid var(--login-border);
			box-shadow: none;
			font-size: 14px;
			padding-left: 44px;
		}

		.login-input:focus {
			border-color: var(--login-primary);
			box-shadow: 0 0 0 4px rgba(37, 99, 217, 0.12);
		}

		.login-form .form-control-feedback {
			line-height: 60px;
			left: 4px;
			color: var(--login-muted);
		}

		.toggle-password {
			cursor: pointer;
			pointer-events: auto !important;
		}

		.toggle-password:focus,
		.login-lang-select:focus {
			outline: 2px solid var(--login-primary);
			outline-offset: 2px;
		}

		/* -- Remember me / Forgot password row: explicitly flagged as
		   misaligned last pass - flex row with vertically centered
		   items on both ends fixes it for good. -- */

		.login-actions {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin-bottom: 16px;
		}

		.login-actions .checkbox-inline {
			display: flex;
			align-items: center;
			gap: 8px;
			font-size: 13.5px;
			color: #5c6b82;
			margin: 0;
			padding-left: 0;
			line-height: 1;
		}

		.login-actions .checkbox-inline input[type="checkbox"] {
			margin: 0;
			position: static;
		}

		.login-actions a {
			font-size: 13.5px;
			color: var(--login-primary);
			font-weight: 500;
			line-height: 1;
		}

		.login-actions a:hover,
		.login-actions a:focus {
			text-decoration: underline;
		}

		.login-primary-btn {
			width: 100%;
			height: 60px;
			border-radius: 10px;
			font-weight: 700;
			font-size: 18px;
			letter-spacing: .3px;
			color: #fff;
			border: none;
			background: linear-gradient(90deg, var(--login-primary), var(--login-secondary));
			transition: filter .15s ease, transform .15s ease;
		}

		.login-primary-btn:hover,
		.login-primary-btn:focus {
			filter: brightness(0.92);
			transform: translateY(-1px);
			color: #fff;
		}

		.login-divider {
			display: flex;
			align-items: center;
			gap: 12px;
			margin: 18px 0 14px;
			font-size: 11px;
			font-weight: 600;
			letter-spacing: .4px;
			color: var(--login-muted);
			text-transform: uppercase;
		}

		.login-divider::before,
		.login-divider::after {
			content: "";
			flex: 1 1 auto;
			height: 1px;
			background: var(--login-border);
		}

		.login-social-actions {
			display: flex;
			gap: 14px;
			margin-bottom: 4px;
		}

		.login-social-btn {
			flex: 1 1 0;
			width: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 8px;
			height: 58px;
			border-radius: 10px;
			border: 1px solid var(--login-border);
			background: #fff;
			color: #5c6b82;
			font-size: 14px;
			font-weight: 500;
			cursor: not-allowed;
		}

		.login-social-btn i {
			font-size: 16px;
		}

		.login-footer {
			text-align: center;
			margin-top: 14px;
			font-size: 12px;
			color: var(--login-muted);
		}

		.global-msg {
			margin-top: 14px;
			font-size: 13px;
			text-align: center;
		}

		.alert-login {
			border-radius: 8px;
			font-size: 13px;
			padding: 10px 14px;
			margin-bottom: 18px;
		}

		/* =========================================================
		   3. Responsive
		   ->= 1200px : two-column layout as above (58% / 42%)
		   768-1199px : still two columns, tighter spacing/type on
		                the left panel
		   <768px     : single column, decorative background hidden,
		                marketing content simplified, near-full-width
		                card, no horizontal scroll, touch-friendly
		                control sizing
		   ========================================================= */

		@@media (max-width: 1199px) {
			.login-brand-panel {
				padding: 36px 44px;
			}

			.login-brand-logo {
				margin-bottom: 24px;
			}

			.login-brand-heading {
				font-size: 34px;
			}

			.login-brand-desc {
				font-size: 16px;
				margin-bottom: 30px;
			}

			.login-feature-icon {
				width: 48px;
				height: 48px;
				font-size: 18px;
			}

			.login-feature-title {
				font-size: 14px;
			}

			.login-brand-foot {
				margin-top: 18px;
			}

			.login-card {
				padding: 44px 40px 32px;
			}
		}

		@@media (max-width: 767px) {
			.login-page {
				flex-direction: column;
				height: auto;
				min-height: 100vh;
				overflow: visible;
			}

			.login-brand-panel,
			.login-form-panel {
				flex-basis: auto;
				max-width: 100%;
				height: auto;
			}

			.login-brand-panel {
				padding: 28px 24px 24px;
			}

			.login-brand-decor {
				display: none;
			}

			.login-brand-logo {
				position: static;
				margin-bottom: 16px;
			}

			.login-brand-content {
				max-width: 100%;
			}

			.login-brand-heading {
				font-size: 26px;
				margin-bottom: 12px;
			}

			.login-brand-desc {
				font-size: 14.5px;
				margin-bottom: 22px;
			}

			.login-feature-row {
				flex-wrap: wrap;
				row-gap: 18px;
			}

			.login-feature {
				flex: 1 1 40%;
			}

			.login-feature-icon {
				width: 46px;
				height: 46px;
				font-size: 17px;
			}

			.login-brand-foot {
				position: static;
				flex-direction: column;
				align-items: flex-start;
				gap: 6px;
				margin-top: 24px;
			}

			.login-brand-cursive {
				text-align: left;
			}

			.login-form-panel {
				padding: 24px 16px 32px;
				background: #fff;
			}

			.login-card {
				width: 100%;
				max-width: 100%;
				max-height: none;
				overflow-y: visible;
				border-radius: 16px;
				box-shadow: 0 10px 30px rgba(30, 60, 110, 0.12);
				padding: 32px 22px 26px;
				margin: 0;
			}

			.login-lang-select span {
				display: none;
			}

			.login-input,
			.login-primary-btn,
			.login-social-btn {
				height: 52px;
			}

			.login-social-actions {
				flex-direction: column;
			}

			.login-social-btn {
				width: 100%;
			}
		}

	</style>

</head>

<body>

	<div class="login-page">

		<!-- ==================== Left branding panel ==================== -->
		<div class="login-brand-panel">

			<!-- decorative layer - purely visual, sits behind the content -->
			<div class="login-brand-decor" aria-hidden="true">
				<div class="decor-glow"></div>
				<div class="decor-arc-1"></div>
				<div class="decor-arc-2"></div>
				<div class="decor-arc-3"></div>
				<div class="decor-square"></div>
				<div class="decor-dots"></div>
				<div class="decor-skyline"></div>
			</div>

			<div class="login-brand-logo">
				<div class="login-brand-logo-row">
					<img src="~/images/PT-01.png" alt="PROSAEC Total logo">
					<div class="login-brand-logo-text">
						<span class="login-brand-logo-name">PROSAEC</span>
						<span class="login-brand-logo-sub">Total HRMS</span>
					</div>
				</div>
				<p class="login-brand-tagline">People &bull; Process &bull; Progress</p>
			</div>

			<div class="login-brand-content">

				<h1 class="login-brand-heading">
					Empowering<br>
					Your Workforce<br>
					<span class="accent">for a Brighter Tomorrow</span>
				</h1>

				<p class="login-brand-desc">A complete HRMS solution to manage your people, processes and performance &mdash; all in one place.</p>

				<div class="login-feature-row">

					<div class="login-feature">
						<div class="login-feature-icon"><i class="bi bi-people-fill" aria-hidden="true"></i></div>
						<p class="login-feature-title">Employee Management</p>
					</div>

					<div class="login-feature">
						<div class="login-feature-icon"><i class="bi bi-calendar-check-fill" aria-hidden="true"></i></div>
						<p class="login-feature-title">Attendance &amp; Leave</p>
					</div>

					<div class="login-feature">
						<div class="login-feature-icon"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></div>
						<p class="login-feature-title">Performance &amp; Analytics</p>
					</div>

					<div class="login-feature">
						<div class="login-feature-icon"><i class="bi bi-shield-lock-fill" aria-hidden="true"></i></div>
						<p class="login-feature-title">Secure &amp; Reliable</p>
					</div>

				</div>

			</div>

			<div class="login-brand-foot">
				<p class="login-brand-trust">Trusted by growing businesses</p>
				<p class="login-brand-cursive">Building<br>People Success</p>
			</div>

		</div>

		<!-- ==================== Right login panel ==================== -->
		<div class="login-form-panel">

			<div class="login-card">

				<!-- Language selector - UI shell only, no multi-language support exists
				     in this application yet, so it is intentionally inert. -->
				<div class="login-lang-select" role="button" tabindex="0" aria-label="Language: English (selection not yet available)" title="Language selection coming soon">
					<i class="bi bi-globe2" aria-hidden="true"></i>
					<span>English</span>
					<i class="bi bi-chevron-down" aria-hidden="true" style="font-size:10px;"></i>
				</div>

				<div class="login-logo">
					<img src="~/images/PT-01.png" alt="PROSAEC Total logo">
				</div>

				<div class="login-card-title">PROSAEC Total HRMS</div>
				<div class="login-card-subtitle">Sign in to your account to continue</div>

				@if (TempData["Success"] != null)
				{
					<div class="alert alert-success alert-login">@TempData["Success"]</div>
				}

				@if (TempData["GlobalError"] != null)
				{
					<div class="alert alert-danger alert-login">@TempData["GlobalError"]</div>
				}

				<form asp-action="Login" asp-controller="Auth" method="POST" autocomplete="off" class="login-form">

					<input asp-for="IpAddress" type="hidden" />

					<div class="form-group has-feedback has-feedback-left">
						<label for="Username" class="login-label">Username</label>
						<input type="text" asp-for="Username" class="form-control login-input" placeholder="Enter your username" autofocus>
						<div class="form-control-feedback">
							<i class="icon-user text-muted"></i>
						</div>
						<span asp-validation-for="Username" class="text-danger error-msg"></span>
					</div>

					<div class="form-group has-feedback has-feedback-left">
						<label for="Password" class="login-label">Password</label>
						<input type="password" asp-for="Password" id="Password" class="form-control login-input" placeholder="Enter your password">
						<div class="form-control-feedback">
							<i class="icon-lock2 text-muted"></i>
						</div>
						<div class="form-control-feedback toggle-password" id="togglePassword" style="right: 0; left: auto;" role="button" tabindex="0" aria-label="Show password" aria-pressed="false">
							<i class="icon-eye-blocked2 text-muted" id="togglePasswordIcon"></i>
						</div>
						<span asp-validation-for="Password" class="text-danger error-msg"></span>
					</div>

					<div class="login-actions">
						<label class="checkbox-inline">
							<input type="checkbox" asp-for="RememberMe" class="styled">
							Remember me
						</label>

						<a asp-action="ForgotPassword" asp-controller="Auth">Forgot password?</a>
					</div>

					<input type="hidden" asp-for="IpAddress" />

					<div class="form-group">
						<button type="submit" class="btn login-primary-btn">
							Login <i class="icon-arrow-right14 position-right"></i>
						</button>
					</div>

					@* <div class="login-divider">Or continue with</div>

					<div class="login-social-actions">
						<!-- Windows Login: no backing controller action/SSO integration exists yet
						     in AuthController - UI shell only, intentionally disabled so it cannot
						     be mistaken for working functionality. -->
						<button type="button" class="login-social-btn" disabled aria-disabled="true" title="Windows Login is not yet available">
							<i class="bi bi-microsoft" aria-hidden="true"></i> Windows
						</button>
						<!-- SSO Login: same as above - no backing action exists yet. -->
						<button type="button" class="login-social-btn" disabled aria-disabled="true" title="SSO Login is not yet available">
							<i class="bi bi-shield-check" aria-hidden="true"></i> SSO
						</button>
					</div> *@

				</form>

				<div class="login-footer">
					&copy; @DateTime.Now.Year Prosaec Total HRMS. All rights reserved.
				</div>

			</div>

		</div>

	</div>

	@{
		// This page has Layout = null (it's a standalone login shell, not
		// part of the app's normal Razor layout), so a @section Scripts
		// block here would never actually render - there's no layout
		// calling RenderSectionAsync("Scripts") to pull it in. The
		// password-toggle JS silently never ran because of this. Scripts
		// must be written directly into the page body instead.
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}

	<script>

		$(function () {

			$('#togglePassword').on('click', function () {

				var input = $('#Password');
				var icon = $('#togglePasswordIcon');

				if (input.attr('type') === 'password') {
					input.attr('type', 'text');
					icon.removeClass('icon-eye-blocked2').addClass('icon-eye8');
					$(this).attr('aria-label', 'Hide password').attr('aria-pressed', 'true');
				} else {
					input.attr('type', 'password');
					icon.removeClass('icon-eye8').addClass('icon-eye-blocked2');
					$(this).attr('aria-label', 'Show password').attr('aria-pressed', 'false');
				}

			});

			// Keyboard support for the password-toggle control (unchanged
			// click handler above still does the actual work).
			$('#togglePassword').on('keydown', function (e) {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					$(this).trigger('click');
				}
			});

		});

	</script>

</body>
</html>
