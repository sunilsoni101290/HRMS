                {
                    <div class="bg-red-100 text-red-700 p-3 rounded mb-4">
                        @ViewBag.Error
                    </div>
                }
            </div>

        </div>

    </div>

</body> *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In · HRMS Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="~/css/styles.css" rel="stylesheet" />
</head>
<body>
    <div class="auth">
        <div class="brand-side">
            <div style="position:relative">
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:50px">
                    <div style="width:42px;height:42px;border-radius:10px;background:rgba(255,255,255,.2);display:grid;place-items:center;font-weight:700;font-size:18px">N</div>
                    <div><div style="font-size:18px;font-weight:600">HRMS PORTAL</div><div style="opacity:.7;font-size:12px">Enterprise Suite</div></div>
                </div>
                <h1>Your complete Human Resource Management solution.</h1>
                
                <p>Manage employees, payroll, attendance, performance and recruitment — all in one elegant workspace.</p>
            </div>
            <div style="position:relative;display:flex;gap:24px;font-size:13px;opacity:.85">
                <div><div style="font-size:24px;font-weight:700;color:#fff">1,284</div><div>Employees managed</div></div>
                <div><div style="font-size:24px;font-weight:700;color:#fff">99.9%</div><div>Uptime SLA</div></div>
                <div><div style="font-size:24px;font-weight:700;color:#fff">42</div><div>Countries</div></div>
            </div>
        </div>
        <div class="form-side">
            <form class="auth-form" asp-action="Login" method="post">
                <h2>Welcome back</h2>
                <div class="sub">Sign in to your account</div>
                <div class="field"><label>Username</label><input type="text" asp-for="Username" placeholder="Enter your username" required /></div>
                <div class="field"><label>Password</label><input type="password" asp-for="Password" placeholder="Enter your passowrd" required /></div>
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;font-size:13px">
                    <label style="display:flex;gap:8px;align-items:center"><input asp-for="RememberMe" checked /> Remember me</label>
                    <a href="#" style="color:var(--primary);font-weight:500">Forgot password?</a>
                </div>
                <button class="btn btn-primary" style="width:100%;justify-content:center;padding:12px">Sign In</button>
                
            </form>
        </div>
    </div>
</body>
</html>

@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

