
@using APP.Models.DTOs
@model LoginDto

@{
    ViewData["Title"] = "Login";
    Layout = null;
}



<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<link rel="apple-touch-icon" sizes="180x180" href="~/images/favicon_io/apple-touch-icon.png">
	<link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon_io/favicon-32x32.png">
	<link rel="icon" type="image/png" sizes="16x16" href="~/images/favicon_io/favicon-16x16.png">
	<link rel="manifest" href="~/images/favicon_io/site.webmanifest">
	<title>PROSAEC TOTAL | HRMS </title>

	<!-- Global stylesheets -->
	<link href="https://fonts.googleapis.com/css?family=Roboto:400,300,100,500,700,900" rel="stylesheet" type="text/css">
	<link href="~/global_assets/css/icons/icomoon/styles.css" rel="stylesheet" type="text/css">
	<link href="~/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css">
	<link href="~/assets/css/core.min.css" rel="stylesheet" type="text/css">
	<link href="~/assets/css/components.min.css" rel="stylesheet" type="text/css">
	<link href="~/assets/css/colors.min.css" rel="stylesheet" type="text/css">
	<!-- /global stylesheets -->
	<!-- Core JS files -->
	<script src="~/global_assets/js/plugins/loaders/pace.min.js"></script>
	<script src="~/global_assets/js/core/libraries/jquery.min.js"></script>
	<script src="~/global_assets/js/core/libraries/bootstrap.min.js"></script>
	<script src="~/global_assets/js/plugins/loaders/blockui.min.js"></script>
	<!-- /core JS files -->
	<!-- Theme JS files -->
	<script src="~/global_assets/js/plugins/forms/styling/uniform.min.js"></script>

	<script src="~/assets/js/app.js"></script>
	<!-- /theme JS files -->

	<style>

		html, body {
			height: 100%;
		}

		body.login-container {
			display: flex;
			align-items: center;
			justify-content: center;
			min-height: 100vh;
			margin: 0;
			padding: 24px 16px;
			background: linear-gradient(135deg, #1e3c72 0%, #2a5298 45%, #d63447 130%);
			background-attachment: fixed;
			font-family: "Roboto", sans-serif;
		}

		.login-shell {
			width: 100%;
			max-width: 420px;
		}

		.login-card {
			background: #fff;
			border-radius: 12px;
			box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
			padding: 40px 36px 32px;
		}

		.login-logo-wrap {
			display: flex;
			align-items: center;
			justify-content: center;
			margin: 0 auto 18px;
			width: 140px;
			height: 100px;
		}

		.login-logo-wrap img {
			max-width: 100%;
			max-height: 100%;
			object-fit: contain;
		}

		.login-title {
			text-align: center;
			font-size: 20px;
			font-weight: 600;
			color: #2a3142;
			margin-bottom: 2px;
		}

		.login-subtitle {
			text-align: center;
			font-size: 13px;
			color: #8f9cb3;
			margin-bottom: 26px;
		}

		.login-card .form-control {
			height: 44px;
			border-radius: 6px;
		}

		.login-card .form-control-feedback {
			line-height: 44px;
		}

		.login-options label.checkbox-inline {
			font-size: 13px;
			color: #5c6b82;
		}

		.login-options a {
			font-size: 13px;
			color: #2a5298;
			font-weight: 500;
		}

		.login-options a:hover {
			text-decoration: underline;
		}

		.btn-login {
			height: 46px;
			border-radius: 6px;
			font-weight: 600;
			letter-spacing: .3px;
			background: linear-gradient(135deg, #2a5298 0%, #d63447 130%);
			border: none;
		}

		.btn-login:hover,
		.btn-login:focus {
			opacity: .92;
			color: #fff;
		}

		.toggle-password {
			cursor: pointer;
			pointer-events: auto !important;
		}

		.login-footer {
			text-align: center;
			margin-top: 22px;
			font-size: 12px;
			color: rgba(255, 255, 255, 0.85);
		}

		.global-msg {
			margin-top: 14px;
			font-size: 13px;
			text-align: center;
		}

		.alert-login {
			border-radius: 6px;
			font-size: 13px;
			padding: 10px 14px;
			margin-bottom: 18px;
		}

	</style>

</head>

<body class="login-container">

	<div class="login-shell">

		<div class="login-card">

			<div class="login-logo-wrap">
				<img src="~/images/PT-01.png" alt="PROSAEC Total logo">
			</div>

			<div class="login-title">PROSAEC Total HRMS</div>
			<div class="login-subtitle">Sign in to your account to continue</div>

			@if (TempData["Success"] != null)
			{
				<div class="alert alert-success alert-login">@TempData["Success"]</div>
			}

			@if (TempData["GlobalError"] != null)
			{
				<div class="alert alert-danger alert-login">@TempData["GlobalError"]</div>
			}

			<form asp-action="Login" asp-controller="Auth" method="POST" autocomplete="off">

				<input asp-for="IpAddress" type="hidden" />

				<div class="form-group has-feedback has-feedback-left">
					<input type="text" asp-for="Username" class="form-control" placeholder="Username" autofocus>
					<div class="form-control-feedback">
						<i class="icon-user text-muted"></i>
					</div>
					<span asp-validation-for="Username" class="text-danger error-msg"></span>
				</div>

				<div class="form-group has-feedback has-feedback-left">
					<input type="password" asp-for="Password" id="Password" class="form-control" placeholder="Password">
					<div class="form-control-feedback">
						<i class="icon-lock2 text-muted"></i>
					</div>
					<div class="form-control-feedback toggle-password" id="togglePassword" style="right: 0; left: auto;">
						<i class="icon-eye-blocked2 text-muted" id="togglePasswordIcon"></i>
					</div>
					<span asp-validation-for="Password" class="text-danger error-msg"></span>
				</div>

				<div class="form-group login-options">
					<div class="row">
						<div class="col-sm-6">
							<label class="checkbox-inline">
								<input type="checkbox" asp-for="RememberMe" class="styled">
								Remember me
							</label>
						</div>

						<div class="col-sm-6 text-right">
							<a asp-action="ForgotPassword" asp-controller="Auth">Forgot password?</a>
						</div>
					</div>
				</div>

				<input type="hidden" asp-for="IpAddress" />

				<div class="form-group">
					<button type="submit" class="btn bg-blue btn-block btn-login">
						Login <i class="icon-arrow-right14 position-right"></i>
					</button>
				</div>

			</form>

		</div>

		<div class="login-footer">
			&copy; @DateTime.Now.Year Prosaec Total &middot; HRMS
		</div>

	</div>

	@{
		// This page has Layout = null (it's a standalone login shell, not
		// part of the app's normal Razor layout), so a @section Scripts
		// block here would never actually render - there's no layout
		// calling RenderSectionAsync("Scripts") to pull it in. The
		// password-toggle JS silently never ran because of this. Scripts
		// must be written directly into the page body instead.
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}

	<script>

		$(function () {

			$('#togglePassword').on('click', function () {

				var input = $('#Password');
				var icon = $('#togglePasswordIcon');

				if (input.attr('type') === 'password') {
					input.attr('type', 'text');
					icon.removeClass('icon-eye-blocked2').addClass('icon-eye8');
				} else {
					input.attr('type', 'password');
					icon.removeClass('icon-eye8').addClass('icon-eye-blocked2');
				}

			});

		});

	</script>

</body>
</html>
