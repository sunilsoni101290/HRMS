@model UserListDto

@{
    ViewData["Title"] = "User Details";
}

<div class="container-fluid py-4">

    <div class="row justify-content-center">

        <div class="col-lg-10">

            <div class="card shadow border-0 rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="card-header bg-primary text-white py-4">

                    <div class="d-flex align-items-center">

                        <!-- Avatar -->
                        <div class="me-3">

                            <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center fw-bold"
                                 style="width:80px;height:80px;font-size:32px;">

                                @NameHelper.GetNamePrefix(Model.Username)

                            </div>

                        </div>

                        <!-- User Info -->
                        <div>

                            <h3 class="mb-1">
                                @Model.Username
                            </h3>

                            <div class="opacity-75">

                                <i class="bi bi-envelope"></i>
                                @Model.Email

                            </div>

                            <div class="opacity-75">

                                <i class="bi bi-telephone"></i>
                                @Model.PhoneNumber

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Body -->
                <div class="card-body p-4">

                    <div class="row g-4">

                        <!-- Basic Information -->
                        <div class="col-md-6">

                            <div class="card border-0 shadow-sm rounded-4 h-100">

                                <div class="card-header bg-light">

                                    <h5 class="mb-0">

                                        <i class="bi bi-person-circle text-primary"></i>
                                        Basic Information

                                    </h5>

                                </div>

                                <div class="card-body">

                                    <table class="table table-borderless align-middle mb-0">

                                        <tr>

                                            <th width="180">
                                                Username
                                            </th>

                                            <td>
                                                @Model.Username
                                            </td>

                                        </tr>

                                        <tr>

                                            <th>
                                                Email
                                            </th>

                                            <td>
                                                @Model.Email
                                            </td>

                                        </tr>

                                        <tr>

                                            <th>
                                                Phone Number
                                            </th>

                                            <td>
                                                @Model.PhoneNumber
                                            </td>

                                        </tr>

                                    </table>

                                </div>

                            </div>

                        </div>

                        <!-- Organization Information -->
                        <div class="col-md-6">

                            <div class="card border-0 shadow-sm rounded-4 h-100">

                                <div class="card-header bg-light">

                                    <h5 class="mb-0">

                                        <i class="bi bi-building text-primary"></i>
                                        Organization Information

                                    </h5>

                                </div>

                                <div class="card-body">

                                    <table class="table table-borderless align-middle mb-0">

                                        <tr>

                                            <th width="180">
                                                Company
                                            </th>

                                            <td>

                                                @(Model.CompanyName ?? "-")

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>
                                                Branch
                                            </th>

                                            <td>

                                                @(Model.BranchName ?? "-")

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>
                                                Employee
                                            </th>

                                            <td>

                                                @(Model.EmployeeName ?? "-")

                                            </td>

                                        </tr>
                                    </table>

                                </div>

                            </div>

                        </div>

                        <!-- Security Information -->
                        <div class="col-md-12">

                            <div class="card border-0 shadow-sm rounded-4">

                                <div class="card-header bg-light">

                                    <h5 class="mb-0">

                                        <i class="bi bi-shield-lock text-primary"></i>
                                        Security Information

                                    </h5>

                                </div>

                                <div class="card-body">

                                    <div class="row">

                                        <div class="col-md-4">

                                            <div class="border rounded-4 p-3 text-center">

                                                <i class="bi bi-person-check-fill text-success fs-1"></i>

                                                <h6 class="mt-2 mb-1">
                                                    Account Status
                                                </h6>

                                                <span class="badge bg-success">
                                                    Active
                                                </span>

                                            </div>

                                        </div>

                                        <div class="col-md-4">

                                            <div class="border rounded-4 p-3 text-center">

                                                <i class="bi bi-shield-check text-primary fs-1"></i>

                                                <h6 class="mt-2 mb-1">
                                                    Password Security
                                                </h6>

                                                <span class="badge bg-primary">
                                                    Protected
                                                </span>

                                            </div>

                                        </div>

                                        <div class="col-md-4">

                                            <div class="border rounded-4 p-3 text-center">

                                                <i class="bi bi-building-lock text-warning fs-1"></i>

                                                <h6 class="mt-2 mb-1">
                                                    Tenant Access
                                                </h6>

                                                <span class="badge bg-warning text-dark">
                                                    Assigned
                                                </span>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Footer Buttons -->
                    <div class="mt-4 text-end">

                        <a asp-action="Index"
                           class="btn btn-light border rounded-3 px-4">

                            <i class="bi bi-arrow-left"></i>
                            Back

                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@Model.Username"
                           class="btn btn-primary rounded-3 px-4">

                            <i class="bi bi-pencil-square"></i>
                            Edit User

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>