@model UserListDto

@{
    ViewData["Title"] = "User Details";
}

<div class="panel panel-flat">

    <!-- Profile Header -->

    <div class="panel-heading bg-primary">

        <div class="media">

            <div class="media-left">

                <div class="img-circle bg-white text-primary text-center"
                     style="width:80px;height:80px;line-height:80px;font-size:28px;font-weight:bold;">

                    @NameHelper.GetNamePrefix(Model.Username)

                </div>

            </div>

            <div class="media-body">

                <h4 class="text-white no-margin">
                    @Model.Username
                </h4>

                <span class="text-white">
                    @Model.Email
                </span>

                <br />

                <span class="text-white">
                    @Model.PhoneNumber
                </span>

            </div>

            <div class="media-right">

                <span class="label bg-success">
                    Active User
                </span>

            </div>

        </div>

    </div>

    <div class="panel-body">

        <!-- Summary -->

        <div class="row" style="margin-top:10px;">

            <div class="col-md-4">

                <div class="panel bg-success-400">
                    <div class="panel-body text-center">

                        <i class="icon-user-check icon-2x"></i>

                        <h6>Account Status</h6>

                        <h4>Active</h4>

                    </div>
                </div>

            </div>

            <div class="col-md-4">

                <div class="panel bg-primary-400">
                    <div class="panel-body text-center">

                        <i class="icon-shield-check icon-2x"></i>

                        <h6>Password Security</h6>

                        <h4>Protected</h4>

                    </div>
                </div>

            </div>

            <div class="col-md-4">

                <div class="panel bg-warning-400">
                    <div class="panel-body text-center">

                        <i class="icon-office icon-2x"></i>

                        <h6>Tenant Access</h6>

                        <h4>Assigned</h4>

                    </div>
                </div>

            </div>

        </div>

        <div class="row">

            <!-- Basic Information -->

            <div class="col-md-6">

                <div class="panel panel-bordered">

                    <div class="panel-heading">

                        <h6 class="panel-title">
                            <i class="icon-user position-left"></i>
                            Basic Information
                        </h6>

                    </div>

                    <table class="table table-striped">

                        <tbody>

                            <tr>
                                <th width="180">Username</th>
                                <td>@Model.Username</td>
                            </tr>

                            <tr>
                                <th>Email</th>
                                <td>@Model.Email</td>
                            </tr>

                            <tr>
                                <th>Phone Number</th>
                                <td>@Model.PhoneNumber</td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

            <!-- Organization Information -->

            <div class="col-md-6">

                <div class="panel panel-bordered">

                    <div class="panel-heading">

                        <h6 class="panel-title">
                            <i class="icon-office position-left"></i>
                            Organization Information
                        </h6>

                    </div>

                    <table class="table table-striped">

                        <tbody>

                            <tr>
                                <th width="180">Company</th>
                                <td>@(Model.CompanyName ?? "-")</td>
                            </tr>

                            <tr>
                                <th>Branch</th>
                                <td>@(Model.BranchName ?? "-")</td>
                            </tr>

                            <tr>
                                <th>Employee</th>
                                <td>@(Model.EmployeeName ?? "-")</td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <!-- Security Information -->

        <div class="panel panel-flat">

            <div class="panel-heading">

                <h6 class="panel-title">
                    <i class="icon-shield2 position-left"></i>
                    Security Information
                </h6>

            </div>

            <table class="table table-bordered">

                <tbody>

                    <tr>

                        <th width="250">
                            Account Status
                        </th>

                        <td>
                            <span class="label label-success">
                                Active
                            </span>
                        </td>

                    </tr>

                    <tr>

                        <th>
                            Email Confirmed
                        </th>

                        <td>

                            @if (Model.EmailConfirmed)
                            {
                                <span class="label label-success">
                                    Confirmed
                                </span>
                            }
                            else
                            {
                                <span class="label label-danger">
                                    Not Confirmed
                                </span>
                            }

                        </td>

                    </tr>

                    <tr>

                        <th>
                            Phone Confirmed
                        </th>

                        <td>

                            @if (Model.PhoneConfirmed)
                            {
                                <span class="label label-success">
                                    Confirmed
                                </span>
                            }
                            else
                            {
                                <span class="label label-danger">
                                    Not Confirmed
                                </span>
                            }

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

        <!-- Action Buttons -->

        <div class="text-right">

            <a asp-action="Index"
               class="btn btn-default">

                <i class="icon-arrow-left13"></i>
                Back

            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Username"
               class="btn bg-primary">

                <i class="icon-pencil7"></i>
                Edit User

            </a>

        </div>

    </div>

</div>