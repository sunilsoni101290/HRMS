@using APP.Models.DTOs
@model ForgotPasswordDto

@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<link rel="apple-touch-icon" sizes="180x180" href="~/images/favicon_io/apple-touch-icon.png">
	<link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon_io/favicon-32x32.png">
	<link rel="icon" type="image/png" sizes="16x16" href="~/images/favicon_io/favicon-16x16.png">
	<link rel="manifest" href="~/images/favicon_io/site.webmanifest">
	<title>Forgot Password | PROSAEC TOTAL HRMS</title>

	<!-- Global stylesheets -->
	<link href="https://fonts.googleapis.com/css?family=Roboto:400,300,100,500,700,900" rel="stylesheet" type="text/css">
	<link href="~/global_assets/css/icons/icomoon/styles.css" rel="stylesheet" type="text/css">
	<link href="~/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css">
	<link href="~/assets/css/core.min.css" rel="stylesheet" type="text/css">
	<link href="~/assets/css/components.min.css" rel="stylesheet" type="text/css">
	<link href="~/assets/css/colors.min.css" rel="stylesheet" type="text/css">
	<!-- /global stylesheets -->
	<!-- Core JS files -->
	<script src="~/global_assets/js/plugins/loaders/pace.min.js"></script>
	<script src="~/global_assets/js/core/libraries/jquery.min.js"></script>
	<script src="~/global_assets/js/core/libraries/bootstrap.min.js"></script>
	<script src="~/global_assets/js/plugins/loaders/blockui.min.js"></script>
	<!-- /core JS files -->
	<!-- Theme JS files -->
	<script src="~/global_assets/js/plugins/forms/styling/uniform.min.js"></script>

	<script src="~/assets/js/app.js"></script>
	<!-- /theme JS files -->

	<style>

		html, body {
			height: 100%;
		}

		body.login-container {
			display: flex;
			align-items: center;
			justify-content: center;
			min-height: 100vh;
			margin: 0;
			padding: 24px 16px;
			background: linear-gradient(135deg, #1e3c72 0%, #2a5298 45%, #d63447 130%);
			background-attachment: fixed;
			font-family: "Roboto", sans-serif;
		}

		.login-shell {
			width: 100%;
			max-width: 440px;
		}

		.login-card {
			background: #fff;
			border-radius: 12px;
			box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
			padding: 40px 36px 32px;
		}

		.login-logo-wrap {
			display: flex;
			align-items: center;
			justify-content: center;
			margin: 0 auto 18px;
			width: 140px;
			height: 100px;
		}

		.login-logo-wrap img {
			max-width: 100%;
			max-height: 100%;
			object-fit: contain;
		}

		.login-title {
			text-align: center;
			font-size: 20px;
			font-weight: 600;
			color: #2a3142;
			margin-bottom: 2px;
		}

		.login-subtitle {
			text-align: center;
			font-size: 13px;
			color: #8f9cb3;
			margin-bottom: 26px;
		}

		.login-card .form-control {
			height: 44px;
			border-radius: 6px;
		}

		.login-card .form-control-feedback {
			line-height: 44px;
		}

		.btn-login {
			height: 46px;
			border-radius: 6px;
			font-weight: 600;
			letter-spacing: .3px;
			background: linear-gradient(135deg, #2a5298 0%, #d63447 130%);
			border: none;
		}

		.btn-login:hover,
		.btn-login:focus {
			opacity: .92;
			color: #fff;
		}

		.toggle-password {
			cursor: pointer;
			pointer-events: auto !important;
		}

		.login-footer {
			text-align: center;
			margin-top: 22px;
			font-size: 12px;
			color: rgba(255, 255, 255, 0.85);
		}

		.alert-login {
			border-radius: 6px;
			font-size: 13px;
			padding: 10px 14px;
			margin-bottom: 18px;
		}

		.back-to-login {
			text-align: center;
			margin-top: 16px;
			font-size: 13px;
		}

		.back-to-login a {
			color: #2a5298;
			font-weight: 500;
		}

		.back-to-login a:hover {
			text-decoration: underline;
		}

	</style>

</head>

<body class="login-container">

	<div class="login-shell">

		<div class="login-card">

			<div class="login-logo-wrap">
				<img src="~/images/PT-04.png" alt="Prosaec Total logo">
			</div>

			<div class="login-title">Forgot Password</div>
			<div class="login-subtitle">
				Confirm your Username and Email, then choose a new password.
			</div>

			<div asp-validation-summary="ModelOnly" class="alert alert-danger alert-login"></div>

			<form asp-action="ForgotPassword" asp-controller="Auth" method="POST" autocomplete="off">

				<div class="form-group has-feedback has-feedback-left">
					<input type="text" asp-for="Username" class="form-control" placeholder="Username">
					<div class="form-control-feedback">
						<i class="icon-user text-muted"></i>
					</div>
					<span asp-validation-for="Username" class="text-danger error-msg"></span>
				</div>

				<div class="form-group has-feedback has-feedback-left">
					<input type="email" asp-for="Email" class="form-control" placeholder="Registered Email">
					<div class="form-control-feedback">
						<i class="icon-mail5 text-muted"></i>
					</div>
					<span asp-validation-for="Email" class="text-danger error-msg"></span>
				</div>

				<div class="form-group has-feedback has-feedback-left">
					<input type="password" asp-for="NewPassword" id="NewPassword" class="form-control" placeholder="New Password">
					<div class="form-control-feedback">
						<i class="icon-lock2 text-muted"></i>
					</div>
					<div class="form-control-feedback toggle-password" data-target="#NewPassword" style="right: 0; left: auto;">
						<i class="icon-eye-blocked2 text-muted toggle-password-icon"></i>
					</div>
					<span asp-validation-for="NewPassword" class="text-danger error-msg"></span>
				</div>

				<div class="form-group has-feedback has-feedback-left">
					<input type="password" asp-for="ConfirmPassword" id="ConfirmPassword" class="form-control" placeholder="Confirm New Password">
					<div class="form-control-feedback">
						<i class="icon-lock2 text-muted"></i>
					</div>
					<div class="form-control-feedback toggle-password" data-target="#ConfirmPassword" style="right: 0; left: auto;">
						<i class="icon-eye-blocked2 text-muted toggle-password-icon"></i>
					</div>
					<span asp-validation-for="ConfirmPassword" class="text-danger error-msg"></span>
				</div>

				<div class="form-group">
					<button type="submit" class="btn bg-blue btn-block btn-login">
						Reset Password <i class="icon-checkmark4 position-right"></i>
					</button>
				</div>

			</form>

			<div class="back-to-login">
				<a asp-action="Login" asp-controller="Auth">
					<i class="icon-arrow-left13 position-left"></i>
					Back to Login
				</a>
			</div>

		</div>

		<div class="login-footer">
			&copy; @DateTime.Now.Year Prosaec Total &middot; HRMS
		</div>

	</div>

	@{
		// Layout = null on this page - a @section Scripts block never
		// actually renders here (no layout calls RenderSectionAsync for
		// it), so scripts have to be written directly into the body.
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}

	<script>

		$(function () {

			$('.toggle-password').on('click', function () {

				var target = $($(this).data('target'));
				var icon = $(this).find('.toggle-password-icon');

				if (target.attr('type') === 'password') {
					target.attr('type', 'text');
					icon.removeClass('icon-eye-blocked2').addClass('icon-eye8');
				} else {
					target.attr('type', 'password');
					icon.removeClass('icon-eye8').addClass('icon-eye-blocked2');
				}

			});

		});

	</script>

</body>
</html>
