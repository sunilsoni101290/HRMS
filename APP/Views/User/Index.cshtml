@model IEnumerable<UserListDto>

@{
    ViewData["Title"] = "User Management";
}

<div class="panel panel-flat">

    <div class="panel-heading">
        <h5 class="panel-title"><i class="icon-users position-left"></i> User Management</h5>
        <div class="heading-elements">
            <a asp-action="Create" class="btn bg-primary"><i class="icon-plus22"></i> Add User</a>
        </div>
    </div>

    <div class="panel-body">
        <div class="row">
            <div class="col-md-4">
                <input type="text" id="searchInput" class="form-control" placeholder="Search username, email, role..." />
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-striped">
            <thead>
                <tr>
                    <th width="50">#</th>
                    <th>Username</th>
                    <th>Email / Phone</th>
                    <th>Role</th>
                    <th>Employee</th>
                    <th>Status</th>
                    <th>Last Login</th>
                    <th width="240">Action</th>
                </tr>
            </thead>
            <tbody id="dataTable">
                @{ int sr = 1; }
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@sr</td>
                            <td><strong>@item.Username</strong></td>
                            <td>@item.Email @(string.IsNullOrEmpty(item.PhoneNumber) ? "" : " · " + item.PhoneNumber)</td>
                            <td><span class="label bg-primary">@(item.RoleName ?? "-")</span></td>
                            <td>@(item.EmployeeName ?? "-")</td>
                            <td>
                                <span class="label @(item.IsActive ? "bg-success" : "bg-grey")">@(item.IsActive ? "Active" : "Inactive")</span>
                                @if (item.IsLocked) { <span class="label bg-danger"><i class="icon-lock"></i> Locked</span> }
                            </td>
                            <td>@(item.LastLoginDate.HasValue ? item.LastLoginDate.Value.ToString("dd MMM yyyy HH:mm") : "-")</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-icon" title="Edit"><i class="icon-pencil7"></i></a>

                                <button type="button" class="btn btn-info btn-icon resetBtn" data-id="@item.Id" data-username="@item.Username" title="Reset Password"><i class="icon-key"></i></button>

                                <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" style="display:inline;">
                                    <button type="submit" class="btn @(item.IsActive ? "btn-warning" : "btn-success") btn-icon" title="@(item.IsActive ? "Deactivate" : "Activate")">
                                        <i class="@(item.IsActive ? "icon-blocked" : "icon-checkmark3")"></i>
                                    </button>
                                </form>

                                <form asp-action="ToggleLock" asp-route-id="@item.Id" method="post" style="display:inline;">
                                    <button type="submit" class="btn btn-default btn-icon" title="@(item.IsLocked ? "Unlock" : "Lock")">
                                        <i class="@(item.IsLocked ? "icon-unlocked" : "icon-lock")"></i>
                                    </button>
                                </form>

                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   onclick="return confirm('Delete this user?');"
                                   class="btn btn-danger btn-icon" title="Delete"><i class="icon-trash"></i></a>
                            </td>
                        </tr>
                        sr++;
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center text-muted" style="padding:30px;"><i class="icon-users" style="font-size:32px;"></i><br />No users found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Reset Password modal. Admin can either type a specific new password or
     leave it blank to have the server generate a random one - either way,
     the password is only ever visible in the response shown right after
     submitting; nothing plaintext is ever stored. -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form id="resetForm" asp-action="ResetPassword" method="post">
            <input type="hidden" name="id" id="resetId" />
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h5 class="modal-title" id="resetPasswordModalLabel">Reset Password</h5>
                </div>
                <div class="modal-body">
                    <p>Set a new password for <strong id="resetUsername"></strong>. Their current password stops working immediately once you submit.</p>

                    <div class="form-group">
                        <label for="newPasswordInput" class="control-label">New Password</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="newPasswordInput" name="newPassword"
                                   placeholder="Leave blank to auto-generate" minlength="6" />
                            <span class="input-group-btn">
                                <button type="button" class="btn btn-default" id="generatePasswordBtn" title="Generate a random password">
                                    <i class="icon-loop2"></i> Generate
                                </button>
                            </span>
                        </div>
                        <span class="help-block">At least 6 characters. Leave blank to have the system generate one.</span>
                        <div class="text-danger" id="newPasswordError" style="display:none;">Password must be at least 6 characters.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info" id="resetSubmitBtn">Reset Password</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @if (TempData["NewPassword"] != null)
    {
        <script>
            $(function(){
                swal({
                    title: "Password Reset",
                    text: "New password (share this with the employee now - it will not be shown again):\n\n@TempData["NewPassword"]",
                    type: "success"
                });
            });
        </script>
    }
    else if (TempData["Success"] != null)
    {
        <script>$(function(){ swal({ title:"Success", text:"@TempData["Success"]", type:"success" }); });</script>
    }
    <script>
        $(function () {
            $("#searchInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#dataTable tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            $(".resetBtn").on("click", function () {
                var id = $(this).data("id");
                var username = $(this).data("username");

                $("#resetId").val(id);
                $("#resetUsername").text(username);
                $("#newPasswordInput").val("");
                $("#newPasswordError").hide();

                // This project ships Bootstrap 3.3.7 (jQuery plugin API),
                // not Bootstrap 5 - "new bootstrap.Modal(...)" doesn't exist
                // here and was throwing "bootstrap.Modal is not a
                // constructor", which killed this handler before it ever
                // opened anything.
                $("#resetPasswordModal").modal("show");
            });

            function randomPassword(length) {
                var chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@@#$%";
                var result = "";
                for (var i = 0; i < length; i++) {
                    result += chars.charAt(Math.floor(Math.random() * chars.length));
                }
                return result;
            }

            $("#generatePasswordBtn").on("click", function () {
                $("#newPasswordInput").val(randomPassword(10));
                $("#newPasswordError").hide();
            });

            $("#resetForm").on("submit", function (e) {
                var val = $("#newPasswordInput").val();
                if (val.length > 0 && val.length < 6) {
                    e.preventDefault();
                    $("#newPasswordError").show();
                    return false;
                }

                if (!confirm("Reset this user's password now? Their current password will stop working immediately.")) {
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
    <style>
        .table > thead > tr > th { font-weight: 600; }
        .table > tbody > tr > td { vertical-align: middle; }
        .label { font-size: 11px; }
        .btn-icon { width: 34px; }
    </style>
}
