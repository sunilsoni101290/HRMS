@model UserDto

@{
    ViewData["Title"] = "User";
    bool isEdit = !string.IsNullOrEmpty(Model?.Id);
}

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-controller="User" asp-route-id="@Model?.Id" method="post">

    <input asp-for="Id" type="hidden" />
    <input asp-for="TenantId" type="hidden" />
    <input asp-for="CreatedBy" type="hidden" />

    <div class="panel panel-flat">

        <div class="panel-heading">
            <h5 class="panel-title">
                <i class="icon-user-plus position-left"></i>
                @(isEdit ? "Edit User" : "Create User")
            </h5>
            <div class="heading-elements">
                <a asp-action="Index" class="btn btn-default"><i class="icon-arrow-left13"></i> Back</a>
            </div>
        </div>

        <div class="panel-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <fieldset>
                <legend class="text-semibold"><i class="icon-user position-left"></i> Account</legend>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="Username"></label> <span class="text-danger">*</span>
                            <input asp-for="Username" class="form-control" placeholder="Login username" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="Email"></label>
                            <input asp-for="Email" class="form-control" placeholder="email@example.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="PhoneNumber"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="Phone" />
                        </div>
                    </div>
                </div>
                @if (!isEdit)
                {
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Password"></label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="Leave blank for default (Welcome@123)" />
                            </div>
                        </div>
                    </div>
                }
            </fieldset>

            <fieldset>
                <legend class="text-semibold"><i class="icon-shield position-left"></i> Role &amp; Organization</legend>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="RoleIds"></label> <span class="text-danger">*</span>
                            <select asp-for="RoleIds" asp-items="ViewBag.RoleList" class="form-control" multiple size="4"></select>
                            <span asp-validation-for="RoleIds" class="text-danger"></span>
                            <small class="text-muted">Hold Ctrl (Cmd on Mac) to select more than one role.</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="EmployeeId"></label>
                            <select asp-for="EmployeeId" asp-items="ViewBag.EmployeeList" class="form-control">
                                <option value="">Link Employee (optional)</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="CompanyId"></label>
                            <select asp-for="CompanyId" asp-items="ViewBag.CompanyList" class="form-control" id="CompanyId">
                                <option value="">Select Company</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="BranchId"></label>
                            <select asp-for="BranchId" asp-items="ViewBag.BranchList" class="form-control" id="BranchId">
                                <option value="">Select Branch</option>
                            </select>
                        </div>
                    </div>
                </div>
            </fieldset>

            <fieldset>
                <legend class="text-semibold"><i class="icon-cog3 position-left"></i> Status</legend>
                <div class="checkbox-inline">
                    <label><input asp-for="IsActive" type="checkbox" /> Active</label>
                </div>
                &nbsp;&nbsp;
                <div class="checkbox-inline">
                    <label><input asp-for="IsLocked" type="checkbox" /> Locked</label>
                </div>
            </fieldset>
        </div>

        <div class="panel-footer text-right">
            <button type="submit" class="btn bg-primary"><i class="icon-floppy-disk"></i> @(isEdit ? "Update" : "Save")</button>
        </div>
    </div>
</form>

@section Scripts {
    @if (TempData["Success"] != null)
    {
        <script>$(function(){ swal({ title:"Success", text:"@TempData["Success"]", type:"success" }); });</script>
    }
    <script>
        $(document).ready(function () {
            $(document).on("change", "#CompanyId", function () {
                var companyId = $(this).val();
                if (!companyId) { $("#BranchId").html('<option value="">Select Branch</option>'); return; }
                $.ajax({
                    url: '@Url.Action("GetBranchByCompanyId")',
                    type: 'GET',
                    data: { companyId: companyId },
                    success: function (response) {
                        var html = '<option value="">Select Branch</option>';
                        $.each(response, function (i, item) {
                            html += '<option value="' + item.value + '">' + item.text + '</option>';
                        });
                        $("#BranchId").html(html);
                    }
                });
            });
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}
