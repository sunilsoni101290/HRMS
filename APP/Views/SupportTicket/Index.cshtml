@model IEnumerable<APP.Models.DTOs.SupportTicketListDto>

@{
    ViewData["Title"] = "Support Tickets";
    bool isAdmin = ViewBag.IsAdmin ?? false;
    string listTitle = ViewBag.ListTitle ?? "Support Tickets";
    bool noProfile = ViewBag.NoEmployeeProfile ?? false;

    string StatusLabel(int s) => s switch
    {
        1 => "bg-warning",   // Open
        2 => "bg-info",      // InProgress
        3 => "bg-success",   // Resolved
        4 => "bg-grey",      // Closed
        _ => "bg-grey"
    };

    string PriorityLabel(int p) => p switch
    {
        1 => "bg-slate",     // Low
        2 => "bg-info",      // Medium
        3 => "bg-warning",   // High
        4 => "bg-danger",    // Urgent
        _ => "bg-grey"
    };
}

<div class="panel panel-flat">

    <div class="panel-heading">
        <h5 class="panel-title"><i class="icon-support position-left"></i> @listTitle</h5>
        <div class="heading-elements">
            @if (isAdmin)
            {
                <a asp-action="Index" class="btn btn-default @(listTitle == "All Support Tickets" ? "active" : "")"><i class="icon-list3"></i> All Tickets</a>
            }
            <a asp-action="MyTickets" class="btn btn-default @(listTitle == "My Support Tickets" ? "active" : "")"><i class="icon-user"></i> My Tickets</a>
            <a asp-action="Create" class="btn bg-primary"><i class="icon-plus22"></i> Raise Ticket</a>
        </div>
    </div>

    @if (noProfile)
    {
        <div class="alert alert-warning m-15">
            Your login isn't linked to an employee profile, so tickets can't be shown here.
        </div>
    }

    <div class="panel-body">
        <div class="row">
            <div class="col-md-4">
                <input type="text" id="searchInput" class="form-control" placeholder="Search tickets..." />
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-striped datatable-basic">
            <thead>
                <tr>
                    <th width="50">#</th>
                    @if (isAdmin)
                    {
                        <th>Employee</th>
                    }
                    <th>Subject</th>
                    <th>Category</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Replies</th>
                    <th>Raised On</th>
                    <th width="90">Action</th>
                </tr>
            </thead>
            <tbody id="dataTable">
                @{ int sr = 1; }
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@sr</td>
                            @if (isAdmin)
                            {
                                <td>@item.EmployeeName <br /><small class="text-muted">@item.EmployeeCode</small></td>
                            }
                            <td>@item.Subject</td>
                            <td>@item.CategoryText</td>
                            <td><span class="label @PriorityLabel(item.Priority)">@item.PriorityText</span></td>
                            <td><span class="label @StatusLabel(item.Status)">@item.StatusText</span></td>
                            <td><span class="badge bg-slate-400">@item.ReplyCount</span></td>
                            <td>@item.CreatedOn.ToString("dd MMM yyyy")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-default btn-icon" title="View"><i class="icon-eye"></i></a>
                            </td>
                        </tr>
                        sr++;
                    }
                }
                else
                {
                    <tr><td colspan="@(isAdmin ? 8 : 7)" class="text-center text-muted" style="padding:30px;"><i class="icon-support" style="font-size:32px;"></i><br />No support tickets found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    @if (TempData["Success"] != null)
    {
        <script>$(function(){ swal({ title:"Success", text:"@TempData["Success"]", type:"success" }); });</script>
    }
    <script>
        $(function () {
            $("#searchInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#dataTable tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
        });
    </script>
    <style>
        .table > thead > tr > th { font-weight: 600; }
        .table > tbody > tr > td { vertical-align: middle; }
        .label { font-size: 11px; }
        .btn-icon { width: 34px; }
    </style>

    <script>
        // Auto-added: client-side pagination for this Index page's listing
        // table (DataTables). Safe to run even if this page already
        // initializes '.datatable-basic' itself above - 'retrieve: true'
        // makes DataTables return the existing instance instead of
        // re-initializing (and throwing) when that's the case.
        $(document).ready(function () {
            if ($.fn.DataTable) {
                var __indexDataTable = $('.datatable-basic').DataTable({
                    autoWidth: false,
                    paging: true,
                    ordering: true,
                    searching: false,
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                    language: { search: "_INPUT_", searchPlaceholder: "Search..." },
                    retrieve: true
                });

            // Rewire the page's existing search box to drive DataTables'
            // own filtering pipeline (instead of any legacy row .toggle()
            // logic still bound above), so search results stay correct once
            // rows are split across pages.
            $('#searchInput').on('keyup', function () {
                __indexDataTable.search($(this).val() || '').draw();
            });
            }
        });
    </script>
}
