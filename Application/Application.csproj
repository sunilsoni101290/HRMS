<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="DTOs\Holidays\**" />
    <Compile Remove="Interfaces\Employee\**" />
    <Compile Remove="Services\EmployeeSer\**" />
    <EmbeddedResource Remove="DTOs\Holidays\**" />
    <EmbeddedResource Remove="Interfaces\Employee\**" />
    <EmbeddedResource Remove="Services\EmployeeSer\**" />
    <None Remove="DTOs\Holidays\**" />
    <None Remove="Interfaces\Employee\**" />
    <None Remove="Services\EmployeeSer\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Services\Attendances\BiometricService.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Interfaces\KPI\" />
    <Folder Include="Validators\" />
  </ItemGroup>

  <!--
    Same reasoning as Infrastructure.csproj: ErrorLogService.cs needs
    ASP.NET Core routing types, but the old "Microsoft.AspNetCore.Routing"
    2.3.11 NuGet package is a pre-3.0 package whose assemblies conflict with
    the real ones loaded from the .NET 9 shared framework at runtime -
    that's what was causing app.MapControllers() to throw
    ReflectionTypeLoadException on startup. Use FrameworkReference instead.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
